pkg ProductApp
  use ddd
  use di
  use harness

  ctx Storefront
    group domain
      agg Widget
        root
          id: Id
          name: Str

      port WidgetRepo
        find(id: Id) -> Res!<Opt<Widget>>
        list_all() -> Res!<List<Widget>>
        save(widget: Widget) -> Res!

    group application
      svc ListWidgets
        input
          @dep
          widget_repo: WidgetRepo
        step query
          items = widget_repo.list_all!()
          ret items

      svc GetWidget
        input
          id: Id
          @dep
          widget_repo: WidgetRepo
        step load
          w = widget_repo.find!(id)
          ret w

      svc CreateWidget
        input
          name: Str
          @dep
          widget_repo: WidgetRepo
        step persist
          w = Widget.new(name)
          widget_repo.save!(w)
          ret w

    group infrastructure
      @dep
      impl MemWidgetRepo for WidgetRepo
        impl find(id)
          ret null
        impl list_all()
          ret []
        impl save(widget)
          ret Ok

    group presentation
      deps StorefrontDeps
        widget_repo: WidgetRepo

      compose StorefrontLocal
        bundle: StorefrontDeps
        wire
          widget_repo: MemWidgetRepo

      endpoint ListWidgetsHttp
        method: GET
        path: "/api/widgets"
        handle: ListWidgets

      endpoint GetWidgetHttp
        method: GET
        path: "/api/widgets/{id}"
        handle: GetWidget
        bind
          id: path

      endpoint CreateWidgetHttp
        method: POST
        path: "/api/widgets"
        handle: CreateWidget
        bind
          name: body
