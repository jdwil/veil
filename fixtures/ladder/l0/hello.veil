pkg LadderL0
  use ddd
  use di
  use harness

  ctx Greet
    group domain
      agg Greeting
        root
          id: Id
          message: Str

      port GreetingRepo
        list_all() -> Res!<List<Greeting>>
        save(greeting: Greeting) -> Res!

    group application
      svc ListGreetings
        input
          @dep
          greeting_repo: GreetingRepo
        step query
          items = greeting_repo.list_all!()
          ret items

      svc CreateGreeting
        input
          message: Str
          @dep
          greeting_repo: GreetingRepo
        step persist
          g = Greeting.new(message)
          greeting_repo.save!(g)
          ret g

    group infrastructure
      @dep
      impl MemGreetingRepo for GreetingRepo
        impl list_all()
          ret []
        impl save(greeting)
          ret Ok

    group presentation
      deps GreetDeps
        greeting_repo: GreetingRepo

      compose GreetLocal
        bundle: GreetDeps
        wire
          greeting_repo: MemGreetingRepo

      endpoint ListGreetingsHttp
        method: GET
        path: "/api/greetings"
        handle: ListGreetings

      endpoint CreateGreetingHttp
        method: POST
        path: "/api/greetings"
        handle: CreateGreeting
        bind
          message: body
