pkg LadderL3
  use ddd
  use di
  use reqwest
  use harness

  ctx Ping
    group domain
      agg Note
        root
          id: Id
          title: Str

      port NoteRepo
        find(id: Id) -> Res!<Opt<Note>>
        list_all() -> Res!<List<Note>>
        save(note: Note) -> Res!

      port Pinger
        ping(url: Str) -> Res!

    group application
      svc ListNotes
        input
          @dep
          note_repo: NoteRepo
        step query
          items = note_repo.list_all!()
          ret items

      svc DoPing
        input
          url: Str
          @dep
          pinger: Pinger
        step go
          pinger.ping!(url)
          ret Ok

    group infrastructure
      @dep
      impl MemNoteRepo for NoteRepo
        impl find(id)
          ret null
        impl list_all()
          ret []
        impl save(note)
          ret Ok

      @dep
      @field(client: Client)
      @env(API_BASE)
      impl HttpPinger for Pinger
        impl ping(url)
          ret Ok

    group presentation
      deps PingDeps
        note_repo: NoteRepo
        pinger: Pinger

      compose PingLocal
        bundle: PingDeps
        wire
          note_repo: MemNoteRepo
          pinger: HttpPinger

      endpoint ListNotesHttp
        method: GET
        path: "/api/notes"
        handle: ListNotes

      endpoint DoPingHttp
        method: POST
        path: "/api/ping"
        handle: DoPing
        bind
          url: body
