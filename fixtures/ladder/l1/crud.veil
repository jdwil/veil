pkg LadderL1
  use ddd
  use di
  use harness

  ctx Catalog
    group domain
      agg Item
        root
          id: Id
          name: Str

      port ItemRepo
        find(id: Id) -> Res!<Opt<Item>>
        list_all() -> Res!<List<Item>>
        save(item: Item) -> Res!

    group application
      svc ListItems
        input
          @dep
          item_repo: ItemRepo
        step query
          items = item_repo.list_all!()
          ret items

      svc GetItem
        input
          id: Id
          @dep
          item_repo: ItemRepo
        step load
          item = item_repo.find!(id)
          ret item

      svc CreateItem
        input
          name: Str
          @dep
          item_repo: ItemRepo
        step validate
          guard name != "", "name required"
        step persist
          item = Item.new(name)
          item_repo.save!(item)
          ret item

    group infrastructure
      @dep
      impl MemItemRepo for ItemRepo
        impl find(id)
          ret null
        impl list_all()
          ret []
        impl save(item)
          ret Ok

    group presentation
      deps CatalogDeps
        item_repo: ItemRepo

      compose CatalogLocal
        bundle: CatalogDeps
        wire
          item_repo: MemItemRepo

      endpoint ListItemsHttp
        method: GET
        path: "/api/items"
        handle: ListItems

      endpoint GetItemHttp
        method: GET
        path: "/api/items/{id}"
        handle: GetItem
        bind
          id: path

      endpoint CreateItemHttp
        method: POST
        path: "/api/items"
        handle: CreateItem
        bind
          name: body
