pkg LocalRun
  use ddd_fullstack
  use di
  use harness
  use rust

  ctx Catalog
    group domain
      val Item
        id: UUID
        name: Str

      port ItemRepo
        save(item: Item) -> Res!
        find(id: UUID) -> Res!<Opt<Item>>

    group application
      svc CreateItem
        input
          name: Str
          @dep
          item_repo: ItemRepo
        step validate
          guard name != "", "name required"
        step persist
          item = Item.new(name)
          ItemRepo.save(item)
        ret item.id

    group infrastructure
      adapter MemItemRepo for ItemRepo
        impl save(item)
          ret Ok
        impl find(id)
          ret Ok(None)

    group presentation
      deps CatalogDeps
        item_repo: ItemRepo

      compose CatalogLocal
        bundle: CatalogDeps
        wire
          item_repo: MemItemRepo

      endpoint CreateItemHttp
        method: POST
        path: "/api/items"
        handle: CreateItem
        bind
          name: body

  @main
  fn bootstrap
    step demo
      run_local_demo()
