pkg rest_rpc v1
  desc "RPC-style REST — no name-derived routes; require declared endpoint constructs"
  author "VEIL"

  # Clear English prefixes so stacked layers cannot leave List/Get/… active.
  # (http_name_policy "none" = explicit clear; see LayerRegistry merge.)
  http_name_policy
    list_prefix none
    get_prefix none
    create_prefix none
    update_prefix none
    delete_prefix none
    path_prefix none

  prompt
    REST pack (rest_rpc):
    - Name-derived routes are OFF. Every dual-loop HTTP surface must be a
      declared `endpoint` (role:http_endpoint) — method, path, handle, bind.
    - Do not write API `@route` on svc/handler. Svelte page `@route` is separate
      and must never gain role:http_route.
    - Use this pack when handler names are not English REST verbs.
