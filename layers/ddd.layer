pkg ddd v1
  desc "Domain-Driven Design abstraction layer"
  author "VEIL"

  # Policy packs (INV-001) — override with rest_rpc / veil.toml [codegen] / forks.
  # After the flip: use ddd includes endpoint / deps / compose.
  # Opt-out: [harness] emit_bin = "never"
  # Pre-deploy hooks (role:deploy_hook). Keyword `hook` is layer spelling.

  # INV-006: FK / identity conventions (opt-in; off without this block)
  identity_policy
    ref_suffix _id
    identity_field id

  # Domain error model — the engine generates this enum in veil_shared::ports.
  error_model DomainError
    external External
    not_found NotFound
    validation Validation

  construct Context
    kw ctx
    mt mod
    au
    desc "A bounded context — autonomous domain boundary"
    cst
      requires_groups domain, application, infrastructure, presentation
    visual
      icon "📦"
      color "#8b5cf6"
      label "Bounded Context"
    in top
    # IDE views (docs/PRESENTATION.md) — construct names, not keywords
    present
      # Default: domain model tree (native outline). Layers tabs still available;
      # tab bodies also render as tree (SvelteFlow is reserved for real control-flow).
      view model
        label "Domain model"
        layout tree
        members by_host_children
        roots Aggregate
        # AST nesting first (evt/cmd declared inside agg), then FK ownership via identity_policy
        nest Event under Aggregate when declared_in_parent
        nest Command under Aggregate when declared_in_parent
        nest Entity under Aggregate when declared_in_parent
        nest ValueObject under Aggregate when declared_in_parent
        nest Entity under Aggregate when references
        nest ValueObject under Aggregate when references
        nest Aggregate under Aggregate when references
        orphan_policy list
        default
      view groups
        label "Layers"
        layout tabs
        members by_source_group
        tabs domain, application, infrastructure, presentation

  construct Orchestrator
    kw orchestrator
    mt mod
    desc "Orchestrator — dedicated container for cross-context sagas"
    cst
      only Saga
      requires_groups domain, application, infrastructure, presentation
    visual
      icon "🎯"
      color "#dc2626"
      label "Orchestrator"
    in top
    present
      view groups
        label "Layers"
        layout tabs
        members by_source_group
        tabs domain, application, infrastructure, presentation
        default

  construct Aggregate
    kw agg
    mt struct
    in Context
    desc "Aggregate root — consistency boundary with state, events, and commands"
    has id: Id
    has
      root: struct
      state: enum
      fn[]
      Event[]
      Command[]
    cst
      must_have root
      mutations_through_methods
    visual
      icon "🧩"
      color "#ec4899"
      label "Aggregate"
    ann
      # role:invariant — smart-constructor validation (INV-001)
      invariant: "Domain constraint validation" expr role:invariant
    group domain
    present
      role container
      nestable_in model as root

  construct Entity
    kw ent
    mt struct
    in Context
    desc "Entity — domain object with identity"
    has id: Id
    visual
      icon "🔑"
      color "#f43f5e"
      label "Entity"
    group domain
    present
      role leaf
      nestable_in model under Aggregate

  construct ValueObject
    kw val
    mt struct
    in Context
    desc "Value Object — immutable, identity-less domain concept"
    cst
      equality_by_value
      deny_calls trait
    visual
      icon "💎"
      color "#14b8a6"
      label "Value Object"
    ann
      invariant: "Validation rule" expr
    group domain
    present
      role leaf
      nestable_in model under Aggregate

  construct Event
    kw evt
    mt struct
    desc "Domain Event — something that happened in the domain"
    cst
      immutable
    visual
      icon "⚡"
      color "#f59e0b"
      label "Domain Event"
    group domain
    in Aggregate
    present
      role leaf
      nestable_in model under Aggregate
      lens critical

  construct Command
    kw cmd
    mt struct
    desc "Command — intent to change domain state"
    visual
      icon "📨"
      color "#3b82f6"
      label "Command"
    ann
      idempotent: "Command is idempotent"
      validate: "Run validation before execution" expr
    group domain
    in Aggregate
    present
      role leaf
      nestable_in model under Aggregate

  construct Query
    kw qry
    mt struct
    desc "Query — request for data, no side effects"
    visual
      icon "🔍"
      color "#06b6d4"
      label "Query"
    group domain

  construct Port
    kw port
    mt trait
    in Context
    desc "Port — interface contract for external dependencies"
    cst
      requires_implementation
    visual
      icon "🔌"
      color "#10b981"
      label "Port"
    ann
      # role:runtime_strategy — runtime-provided adapter selection (e.g. cognito)
      strategy: "Runtime provider strategy key" value role:runtime_strategy
    group domain
    present
      role leaf
      lens integration
      lens critical

  construct Adapter
    kw adapter
    mt impl
    in Context
    desc "Adapter — implementation of a port for a specific technology"
    cst
      must_implement_port
    visual
      icon "🔗"
      color "#a855f7"
      label "Adapter"
    ann
      # role:adapter_env / adapter_field — harness wiring (INV-001)
      env: "Required environment variables" vars role:adapter_env
      field: "SDK/client field from stub harness_field" name_type role:adapter_field
    group infrastructure
    tgt Port, Repository
    dg infrastructure
    present
      role leaf
      lens integration
      lens critical

  construct Repository
    kw repo
    mt trait
    in Context
    desc "Repository — persistence interface for an aggregate"
    cst
      crud_for_aggregate
      requires_implementation
    visual
      icon "🗄️"
      color "#10b981"
      label "Repository"
    group domain

  construct DomainService
    kw svc
    mt fn
    in Context
    desc "Domain Service — orchestrates operations across aggregates within a context"
    visual
      icon "🖥️"
      color "#0ea5e9"
      label "Domain Service"
    ann
      trace: "Add distributed tracing" method
      timeout: "Service-level timeout" ms
    group domain

  construct ApplicationService
    kw handler
    mt fn
    in Context
    desc "Application Service — use case handler that orchestrates domain objects to fulfill commands"
    visual
      icon "📡"
      color "#6366f1"
      label "Application Service"
    ann
      trace: "Add distributed tracing" method
      timeout: "Service-level timeout" ms
      # role:permission — required permission key (harness/host may enforce)
      auth: "Required permission claim, e.g. relay.admin" permission role:permission
    group application

  construct Saga
    kw saga
    mt fn
    desc "Saga — cross-context orchestration with compensation semantics"
    cst
      steps_have_compensation
      spans_contexts
    visual
      icon "🔄"
      color "#dc2626"
      label "Saga"
    ann
      trace: "Add distributed tracing" method
      timeout: "Overall saga timeout" ms
    # Steps are NOT inlined: each is lowered to an `impl SagaStep` and handed to
    # the `run_saga` coordinator (declared below). The main step body fills
    # `action`; the `compensate` sub-block fills `compensate`.
    runtime run_saga SagaStep
      compensate -> compensate
    in Orchestrator
    present
      role container
      lens critical
      lens integration

  # Statement extensions (built on top of core statement shapes)
  statement emit
    mt call
    desc "Emit a domain event from within an aggregate"
    sem domain_event_emit
    # No lowers_to: emit is shape-specialized in rust codegen (events buffer).
    visual
      icon "⚡"
      color "#f59e0b"
      label "Emit"

  # dispatch / invoke / request are NOT DDD. A message bus is user-land:
  # the product defines `port …` and adapters, and may declare those verbs
  # in a product layer (`statement dispatch` / `mt YourPort.method`).

  statement guard
    mt if
    desc "Precondition check — fails the step if condition is false"
    sem precondition_fail_step
    visual
      icon "🛡️"
      color "#ef4444"
      label "Guard"

  # ─── LLM Prompt (RAG context for code-generating agents) ─────────────────────
  prompt
    You are writing code using the DDD (Domain-Driven Design) layer for VEIL.

    ## What this layer is
    Pure domain vocabulary ONLY: aggregates, entities, value objects, ports,
    services, contexts, sagas, handlers, orchestrators. Plus `error_model
    DomainError` with External/NotFound/Validation variants (generated into
    veil_shared::ports).

    For infrastructure, compose with other layers:
    - `harness` — axum HTTP endpoints, composition root, CORS, auth middleware
    - `bus` / `bus_handle` — InProcessBus with invoke/dispatch/request
    - `tokio_ddd` — async runtime bridged per DDD role
    - `auth_local` — AllowAllAuth for local dev
    - `deploy` — pre-deploy hooks
    - Or use `ddd_fullstack` for all of the above in one import.

    ## MUST — domain vocabulary (non-negotiable)
    When this package has `use ddd`, emit **layer keywords**, not base primitives:

    | Concept | Use keyword | Do NOT use |
    |---------|-------------|------------|
    | Aggregate root | `agg` | `struct` |
    | Value object | `val` | `struct` |
    | Entity | `ent` | `struct` |
    | Repository | `repo` | `trait` |
    | Port | `port` | `trait` |
    | Application service | `handler` | bare `fn` / cosmetic-only `flow` |
    | Domain service | `svc` | bare `fn` |
    | Bounded context | `ctx` | bare `mod` alone |

    - Cosmetic `group Aggregates` / `group Repositories` wrapping `struct`/`trait`
      is **not** a DDD remodel — the outline will still show Structs/Traits.
    - `enum` remains base (DDD has no separate enum keyword).
    - To customize DDD itself, fork to a new layer name (`acme-ddd.layer` + `use acme-ddd`);
      never hand-edit platform `ddd.layer`.
    - `agg` roots need `id`. `repo` needs `delete`.
    - If using `flow`, use **block** form (fields + `-> Ret`), not paren form.

    ## Structure
    Every pkg using `use ddd` organizes code into bounded contexts (`ctx`), each
    containing groups: `domain`, `application`, `infrastructure`, and optionally
    `presentation`.

    ## IDE views (presentation)
    Drilling into a `ctx` offers two views (layer-declared, not hardcoded):
    - **Layers** — tabs for domain / application / infrastructure / presentation
    - **Domain model** — Aggregates as roots. Nest `evt`/`cmd` when declared under
      an aggregate in source; nest freestyle `ent`/`val` and child aggregates via
      FK ownership (`*_id` fields → IR `References` edges, opt-in identity_policy).
      The canvas shows the full domain with ownership edges; selecting a node
      highlights related constructs and dims the rest.

    ## Domain Group
    Contains the pure domain model:
    - `agg` (Aggregate) — the consistency boundary. Has a `root` block with fields,
      optional `state` (enum with transitions), `evt` (domain events), and `fn` methods.
    - `ent` (Entity) — subordinate to an aggregate, has identity (id field).
    - `val` (ValueObject) — immutable, identity-less. Use `@invariant(expr)` for validation.
    - `repo` (Repository/Port) — trait interface for persistence. Methods use `!` suffix
      for async operations: `find!(id: Id) -> Opt<T>`, `save!(entity: T)`, `delete!(id: Id)`.

    ## Application Group
    Contains orchestration:
    - `handler` (ApplicationService) — receives commands/queries. Inputs use `@dep` annotation
      to declare injected dependencies (repos, services). Body contains `step` blocks.
    - `hook` (DeployHook, role:deploy_hook) — runs on the provisioner after compile,
      before code is published. Takes `DeployContext`. Not an HTTP or runtime handler.
    - Steps contain expressions: assignments, repo calls, `guard(condition, "message")` for
      preconditions, and `ret value` to return data.

    ## A message bus is user-land (not this layer)
    DDD does **not** inject a `Bus` and does **not** provide `dispatch` /
    `invoke` / `request`. Those are product vocabulary.

    If the product needs messaging:
    1. Define a `port` with the contract you want (any name: `Bus`,
       `EventTransport`, …).
    2. Implement adapters that call stub types (`@field(sns: aws_sdk_sns.Client)`,
       `AttributeValue.S(s)`, `Blob.new(body)`).
    3. Inject it like any other port (`@dep bus: Bus`).
    4. Optional: in a **product** layer, declare `statement dispatch` /
       `mt YourPort.method` if you want keyword sugar.
    The runtime is told how to construct that dependency via `@field` / `@env`
    / `compose` — it does not ship a bus.

    This layer *does* inject: `trait SagaStep`, `fn run_saga`, `fn unwind`,
    `trait EntityRepo<T>`, `trait AuthService`, `struct Principal`.
    Do not redefine those names (`shadows_layer_declare`).

    ## Infrastructure Group
    Contains adapter implementations:
    - `adapter PgFooRepo for FooRepo` — implements a port with concrete code.
      Annotate with `@env(DATABASE_URL)` to declare required config
      (`@env(VAR)` parens required; `@env VAR` is also accepted).
      `@env(TABLE_NAME)` is `self.table_name` (full lowercased var).
      Never write the ALL_CAPS name in a body — that is an error.
      `DATABASE_URL` is the special case `self.pool`.
      Each `impl method(params)` contains the body (e.g., SQL via sqlx DSL).
    - **Third-party I/O uses a `.stub` as the contract** (any crate — HTTP, SQL, AWS, …).
      Never invent `aws_sns` / `http.post`. Those fail check and smoke.
      1. `stub_search` / `stub_install` the crate
      2. `use <stub-name>`
      3. Qualify the stub type by crate and name the field after that crate —
         `@field(sns: aws_sdk_sns.Client)`, never bare `Client` when more than
         one stub exports it. Field names: `sns`, `sqs`, `ddb`, not generic `client`.
      4. Call that field's methods **exactly as the stub shows**. `stub_search`
         the method before writing the call. Single-letter params (`U`, `T`, `B`)
         are rust generics — pass `Str`, do not construct a `U`.
      The transpiler adds the Cargo crate and imports from the stub.

    ## Stub value types (required for a compiling adapter)
    The stub signature is the contract. `Map<Str, Str>` is **not** a stand-in
    for SDK maps. Bare `{ k: v }` is `Map<Str, T>` of the values you wrote.

    - Incremental setters take `(key, stubValue)`:
      `self.ddb.put_item().table_name(self.table_name).item("id", AttributeValue.S(id.to_string())).send!()`
      `self.sns.publish().topic_arn(arn).message(body).message_attributes("event", attr).send!()`
    - Whole-map setters take `Map<Str, StubValue>`, never `Map<Str, Str>`.
    - Construct stub enums as `Type.Variant(args)`: `AttributeValue.S(s)`.
    - Construct builder types as `Type.builder()…build()`:
      `attr = aws_sdk_sns.MessageAttributeValue.builder().data_type("String").string_value(s).build()`
      Qualify when two stubs export the same name.
    - Binary / text conversions (language, any crate):
      `Blob.new(s)` accepts `Str` or `Bytes` (utf-8).
      `bytes = Bytes.from_str(s)` or `s.as_bytes()`.
      `s = blob.to_str()` / `bytes.to_str()` / `Str.from_bytes(bytes)`.
      `blob.as_ref()` in a `Str` slot is the same utf-8 decode.
      Port `-> Str` cannot return a Blob — decode first:
      `ret (require result.payload).to_str()`.
    - Clock / parse (language, not a stub — do not invent other clock methods):
      `now = Str.now_iso8601()` is ISO-8601 UTC text.
      `unix = Int.now_unix()` is unix seconds (`Int`) for elapsed / TTL.
      `n = s.parse_int()` is Str → Int. `av.as_n!()` is the numeric extractor (`Int`).
      `av.as_s!()` is text. `Dt.now()` is a `DateTime`, not a `Str`.
      There is no `Dt.parse`, `seconds_since`, or `Str.seconds_since`.
    - Opt returns from adapters:
      `ret value` is Some. `ret null` or `ret ()` is None.
      `if item.is_some` / `item.is_some()` is Bool.
      Do **not** return the stub map as the domain value — construct it:
      `map = require result.item()` then `endpoint = require map.get("endpoint").as_s()`
      (or `map["endpoint"].as_s()`) and fill the value object. `get`/`[]` yield
      the map value (AttributeValue); `as_s()` is the Str.
    - Prefer `ret expr` when you would bind once and immediately return.
      `response = call!()` then `ret response` is valid; do not write `mut`.
    - Unit tests: `tests HandleX` / `it "name"` / `stub Port.method -> value`
      / `given` / `then result == …`. They compile to cargo tests. Do not
      hand-write tests in generated/.
    - `match` arms must produce one type. A fire-and-forget arm of an
      `Opt<T>` method ends with `null` after the side-effect. Wrap a `Str`
      in the domain value (`Token { id: s }`), do not leave a bare `Str`
      next to a unit `send!()`.
    - Domain ports stay domain-shaped. Convert in the adapter — do not wrap
      an SDK in a port whose signature lies (`publish(attributes: Map<Str, Str>)`
      then pass that map to the stub).
    - A `-> ()` method cannot use `!` or `?`. If the call can fail, declare
      `method!(…) -> ()` (that is Res!).
    - `{ k: v }` passed to a `Map<Str, T>` port param is a HashMap, not JSON.
    - Bare `match status { Healthy -> … }` is legal VEIL; the compiler
      qualifies the variant.
    - `@dep store: RecordStore` → `self.store.get!(name)` (or the bare
      field name; prefer `self.`).

    ## Key Patterns
    - Dependencies are always injected via `@dep` — never construct adapters in handlers.
    - Repos return `Opt<T>` for single lookups, `List<T>` for collections.
    - Use `guard(expr, "msg")` for precondition checks — it short-circuits with a validation error.
    - Use `ret variable` to return query results from handlers.
    - Cross-context work is a product port you inject (`@dep`), not a DDD keyword.
    - Sagas use the `saga` keyword with `step`/`compensate` blocks for distributed transactions.
    - **Bang / Opt / Res (docs/BANG_CONTRACT.md) — ACS-010 portable (default):**
      `entity = repo.find!(id)` yields `Opt<T>` (bang unwraps Res / try only).
      Soft absence after bang is valid (`.is_some()` / `.is_none()`).
      When the value must exist: `require repo.find!(id)` or `.unwrap()` → `T`
      (NotFound / layer policy). Never assume bang silently forces Opt→T.

    ## Example Handler
    ```
    # Soft GET — find! yields Opt; ret Opt is valid
    handler HandleGetCohort
      input
        id: Id
        @dep cohort_repo: CohortRepo
      step query
        cohort = cohort_repo.find!(id)
        ret cohort

    # Hard path — force present before mutate/save
    handler HandleUpdateCohort
      input
        id: Id
        @dep cohort_repo: CohortRepo
      step load
        cohort = require cohort_repo.find!(id)   # or .unwrap()
        # … mutate …
        cohort_repo.save!(cohort)
        ret cohort
    ```

    ## Example Adapter
    ```
    adapter PgCohortRepo for CohortRepo
      @env(DATABASE_URL)
      impl find(id)
        sqlx.Query.new("SELECT * FROM cohorts WHERE id = $1").bind(id).fetch_optional!(pool)
      impl save(cohort)
        sqlx.Query.new("INSERT INTO cohorts (id) VALUES ($1) ON CONFLICT (id) DO UPDATE SET updated_on = now()").bind(cohort.id).execute!(pool)
    ```

  # ─── Declared constructs (injected into every solution using this layer) ─────
  # No Bus. Messaging is a product port + adapters (see prompt).
  declare
    # Generic persistence port — monomorphize with type alias:
    #   type WearTestRepo = EntityRepo<WearTest>
    # Implementation lives in VEIL (e.g. adapter DynamoJsonRepo<T> for EntityRepo<T>);
    # monomorphized empty adapters copy those VEIL bodies with T substituted.
    # Declared as `trait` (core keyword) so inject_declarations can parse
    # without layer keywords in the __decl__ wrapper.
    trait EntityRepo<T>
      find!(id: Id) -> Opt<T>
      list_by_tenant!(tenant_id: Id) -> List<T>
      save!(entity: T)
      delete!(id: Id)

    # ─── Auth service (runtime-injected authentication & authorization) ─────
    # The runtime provides the concrete implementation: Cognito, Auth0, custom
    # RBAC, or a BusAuthAdapter that delegates to a VEIL-authored auth context.
    # Domain code calls these methods via the Deps struct like any other port.
    # @strategy selects the runtime adapter (e.g. cognito, auth0, bus).
    @strategy(bus)
    trait AuthService
      validate_token(token: Str) -> Res!<Principal>
      check_permission(principal: Principal, permission: Str) -> Res!<Bool>

    struct Principal
      id: Str
      roles: List<Str>
      claims: Map<Str, Str>

    # ─── Saga runtime (the transactional coordinator), written in VEIL ─────
    # A saga step is a unit of work with a compensating action. Steps share a
    # JSON `state`: each `action` reads prior results from it and returns the
    # updated state, so later steps see earlier results. `run_saga` threads the
    # state forward and, on the first failure, replays the completed steps'
    # compensations in reverse. Messaging is a product port, not this coordinator.
    trait SagaStep
      action(state: Json) -> Res!<Json>
      compensate(state: Json) -> Res!

    # Replay compensations for the first `upto` steps, most-recent first.
    fn unwind(steps: List<SagaStep>, upto: Int, state: Json) -> Res!
      mut i = upto
      while i > 0
        i = i - 1
        call steps.get(i).compensate(state)
      ret Ok

    # Run steps forward, threading state; on failure, unwind and propagate.
    fn run_saga(steps: List<SagaStep>) -> Res!
      mut state = {}
      mut i = 0
      while i < steps.len()
        match call steps.get(i).action(state)
          Ok next ->
            state = next
            i = i + 1
          Err e ->
            call unwind(steps, i, state)
            ret Err(e)
      ret Ok

