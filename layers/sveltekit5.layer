pkg sveltekit5 v1
  desc "SvelteKit 5"
  use svelte5

  codegen typescript
    scaffold "package.json"
      emit """
        {
          "name": "veil-app",
          "version": "0.1.0",
          "private": true,
          "type": "module",
          "scripts": {
            "dev": "vite dev",
            "build": "vite build",
            "preview": "vite preview"
          },
          "devDependencies": {
            "@sveltejs/adapter-static": "^3.0.0",
            "@sveltejs/kit": "^2.21.0",
            "@sveltejs/vite-plugin-svelte": "^5.0.0",
            "svelte": "^5.34.0",
            "typescript": "^5.8.0",
            "vite": "^6.3.0"
          }
        }
      """

    scaffold "svelte.config.js"
      emit """
        import adapter from '@sveltejs/adapter-static';
        export default { kit: { adapter: adapter({ fallback: 'index.html' }) } };
      """

    # Default when no @proxy. Overridden by match App where has_annotation("proxy").
    scaffold "vite.config.ts"
      emit """
        import { sveltekit } from '@sveltejs/kit/vite';
        import { defineConfig } from 'vite';
        // server.watch.ignored: dual-loop gen rewrites these; watching them
        // restarts Vite mid-HMR and can crash the process (Node HMR race).
        export default defineConfig({
          plugins: [sveltekit()],
          server: {
            watch: {
              ignored: [
                '**/svelte.config.js',
                '**/tsconfig.json',
                '**/package.json',
                '**/package-lock.json',
              ],
            },
          },
        });
      """

    scaffold "src/app.html"
      emit """
        <!doctype html>
        <html lang="en">
          <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1" />
            %sveltekit.head%
          </head>
          <body>
            <div style="display: contents">%sveltekit.body%</div>
          </body>
        </html>
      """

    scaffold "src/app.css"
      emit """
        :root { --bg:#0f0f0f; --surface:#1a1a1a; --border:#2e2e2e; --text:#e5e5e5; --text-dim:#737373; --accent:#a5b4fc; --accent-hover:#c7d2fe; --radius:8px; }
        * { box-sizing:border-box; margin:0; }
        body { font-family:Inter,system-ui,sans-serif; background:var(--bg); color:var(--text); line-height:1.6; min-height:100vh; }
        h1 { font-size:1.8rem; margin-bottom:0.5rem; }
        h2 { font-size:1.4rem; margin-bottom:0.5rem; }
        p { color:var(--text-dim); margin-bottom:1rem; }
        a { color:var(--accent); text-decoration:none; }
        a:hover { color:var(--accent-hover); }
        nav { display:flex; gap:1rem; margin-bottom:1.5rem; }
        .btn { display:inline-block; background:var(--surface); color:var(--accent); padding:0.5rem 1rem; border-radius:var(--radius); font-weight:600; font-size:0.875rem; text-decoration:none; border:1px solid var(--border); }
        .btn:hover { background:var(--border); color:var(--accent-hover); }
        table { width:100%; border-collapse:collapse; margin-top:1rem; }
        th,td { padding:0.75rem 1rem; text-align:left; border-bottom:1px solid var(--border); }
        th { font-size:0.75rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-dim); }
        form { display:flex; flex-direction:column; gap:1rem; max-width:480px; }
        label { display:flex; flex-direction:column; gap:0.25rem; font-size:0.875rem; color:var(--text-dim); }
        input,textarea,select { background:var(--surface); border:1px solid var(--border); color:var(--text); padding:0.5rem 0.75rem; border-radius:var(--radius); font-size:0.9rem; }
        input:focus,textarea:focus { outline:none; border-color:var(--accent); }
        textarea { min-height:80px; resize:vertical; }
        button[type="submit"] { background:var(--surface); color:var(--accent); border:1px solid var(--accent); padding:0.6rem 1.2rem; border-radius:var(--radius); font-weight:600; cursor:pointer; align-self:flex-start; }
        button[type="submit"]:hover { background:var(--border); }
        .card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:1.5rem; margin-bottom:1rem; }
        dl { display:grid; grid-template-columns:120px 1fr; gap:0.5rem; }
        dt { color:var(--text-dim); font-size:0.85rem; }
        dd { color:var(--text); }
        main { max-width:960px; margin:0 auto; padding:2rem; }
      """

    # Frontend runtime shim: defines the browser helpers that svelte5 `declare`
    # constructs (navigate, Env, LocalStorage, ApiClient, location_*, OAuth PKCE)
    # are emitted as bare global calls against. SvelteKit auto-loads
    # src/hooks.client.ts once on the client at startup, so installing these on
    # globalThis makes the generated stores/pages functional. Generic — no app,
    # provider, or route specifics.
    scaffold "src/hooks.client.ts"
      emit """
        // VEIL frontend runtime shim (generated). Installs browser helpers that
        // generated code references as globals. Provider-agnostic.
        function b64url(buf: ArrayBuffer): string {
          return btoa(String.fromCharCode(...new Uint8Array(buf)))
            .replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');
        }
        const g = globalThis as any;

        g.location_pathname = () => (typeof window !== 'undefined' ? window.location.pathname : '');
        g.location_last_segment = () => {
          if (typeof window === 'undefined') return '';
          const parts = window.location.pathname.split('/').filter(Boolean);
          return parts.length ? parts[parts.length - 1] : '';
        };
        g.navigate = (url: string) => { window.location.href = url; };
        g.goto = (url: string) => { window.location.href = url; };

        // Client-side (SPA) navigation without a full page reload. Pushes a new
        // history entry and dispatches a synthetic popstate so listeners (e.g. a
        // harness that derives the active route from window.location.pathname)
        // re-resolve. Use for in-app links where the app owns routing.
        g.spa_navigate = (path: string) => {
          if (typeof window === 'undefined') return;
          if (window.location.pathname === path) return;
          history.pushState(null, '', path);
          window.dispatchEvent(new PopStateEvent('popstate'));
        };
        // Current browser path (SSR-safe). Pairs with spa_navigate for
        // location-derived routing in single-page harness shells.
        g.current_path = () => (typeof window !== 'undefined' ? window.location.pathname : '/');

        g.Env = {
          get_or: (k: string, d: string) => (localStorage.getItem(k) ?? d),
          get_opt: (k: string) => (localStorage.getItem(k) ?? null),
        };
        g.LocalStorage = {
          get_or: (k: string, d: string) => (localStorage.getItem(k) ?? d),
          get_opt: (k: string) => localStorage.getItem(k),
          set: (k: string, v: string) => localStorage.setItem(k, v),
        };

        function authHeaders(base: Record<string, string> = {}): Record<string, string> {
          const h = { ...base };
          const t = localStorage.getItem('veil_auth_token');
          if (t) h['Authorization'] = 'Bearer ' + t;
          return h;
        }
        g.ApiClient = {
          fetch: async (endpoint: string, params: any) => {
            const u = new URL(endpoint, window.location.origin);
            const p = (params ?? {}) as Record<string, unknown>;
            for (const [k, v] of Object.entries(p)) if (v != null && v !== '') u.searchParams.set(k, String(v));
            const r = await fetch(u.toString(), { headers: authHeaders() });
            if (!r.ok) { const e: any = new Error(await r.text()); e.status = r.status; throw e; }
            return await r.json();
          },
          mutate: async (endpoint: string, body: any) => {
            const r = await fetch(endpoint, { method: 'POST', headers: authHeaders({ 'Content-Type': 'application/json' }), body: JSON.stringify(body) });
            if (!r.ok) { const e: any = new Error(await r.text()); e.status = r.status; throw e; }
            const t = await r.text(); return t ? JSON.parse(t) : null;
          },
          put: async (endpoint: string, body: any) => {
            const r = await fetch(endpoint, { method: 'PUT', headers: authHeaders({ 'Content-Type': 'application/json' }), body: JSON.stringify(body) });
            if (!r.ok) { const e: any = new Error(await r.text()); e.status = r.status; throw e; }
            const t = await r.text(); return t ? JSON.parse(t) : null;
          },
          delete: async (endpoint: string) => {
            const r = await fetch(endpoint, { method: 'DELETE', headers: authHeaders() });
            if (!r.ok) { const e: any = new Error(await r.text()); e.status = r.status; throw e; }
            const t = await r.text(); return t ? JSON.parse(t) : null;
          },
          // Non-throwing transport. Returns an envelope { ok, data, error, status }
          // and NEVER rejects. Use from declarative components (e.g. designkit
          // CrudResource) that cannot express try/catch in structured VEIL — an
          // unguarded `await ApiClient.fetch(...)` on mount surfaces as an
          // "Uncaught (in promise) Error" in the harness bundle when the backend
          // errors or is unreachable. `send` folds every failure (non-2xx,
          // network, or JSON parse) into the envelope so the caller can drive a
          // visible error/loading state instead of crashing the page.
          send: async (method: string, endpoint: string, body: any) => {
            const m = (method || 'GET').toUpperCase();
            try {
              let url = endpoint;
              const init: any = { method: m, headers: authHeaders() };
              if (m === 'POST' || m === 'PUT' || m === 'PATCH') {
                init.headers = authHeaders({ 'Content-Type': 'application/json' });
                init.body = JSON.stringify(body ?? {});
              } else if (m === 'GET' && body && typeof body === 'object') {
                const u = new URL(endpoint, window.location.origin);
                for (const [k, v] of Object.entries(body as Record<string, unknown>)) if (v != null && v !== '') u.searchParams.set(k, String(v));
                url = u.toString();
              }
              const r = await fetch(url, init);
              const t = await r.text();
              if (!r.ok) return { ok: false, data: null, error: t || ('HTTP ' + r.status), status: r.status };
              const data = t ? JSON.parse(t) : null;
              return { ok: true, data, error: '', status: r.status };
            } catch (e: any) {
              return { ok: false, data: null, error: (e && e.message) ? e.message : String(e), status: 0 };
            }
          },
        };

        // JWT expiry check: true if the stored token is missing/expired (with 30s skew).
        g.token_expired = (token: string) => {
          if (!token) return true;
          try {
            const payload = JSON.parse(atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));
            const exp = payload.exp;
            if (!exp) return false; // no exp claim → treat as non-expiring
            return (exp * 1000) <= (Date.now() + 30000);
          } catch { return true; } // malformed → treat as expired
        };

        // OAuth2 Authorization-Code + PKCE (generic).
        g.oauth_pkce_login = async (authorizeBase: string, clientId: string, redirectUri: string, scope: string, idp: string) => {
          const rnd = new Uint8Array(32); crypto.getRandomValues(rnd);
          const verifier = b64url(rnd.buffer);
          const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(verifier));
          const challenge = b64url(digest);
          localStorage.setItem('pkce_verifier', verifier);
          const p = new URLSearchParams({ client_id: clientId, response_type: 'code', redirect_uri: redirectUri, scope, code_challenge: challenge, code_challenge_method: 'S256' });
          if (idp) p.set('identity_provider', idp);
          window.location.href = authorizeBase + '/oauth2/authorize?' + p.toString();
        };
        g.oauth_pkce_exchange = async (tokenEndpoint: string, clientId: string, redirectUri: string, code: string) => {
          const verifier = localStorage.getItem('pkce_verifier') ?? '';
          const body = new URLSearchParams({ grant_type: 'authorization_code', client_id: clientId, code, redirect_uri: redirectUri, code_verifier: verifier });
          const r = await fetch(tokenEndpoint, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body.toString() });
          localStorage.removeItem('pkce_verifier');
          if (!r.ok) throw new Error(await r.text());
          return await r.json();
        };
        g.oauth_callback_code = () => (new URLSearchParams(window.location.search).get('code') ?? '');
        // OAuth2 Implicit grant (token in URL fragment).
        g.oauth_implicit_login = (authorizeBase: string, clientId: string, redirectUri: string, scope: string, idp: string) => {
          const p = new URLSearchParams({ client_id: clientId, response_type: 'token', redirect_uri: redirectUri, scope });
          if (idp) p.set('identity_provider', idp);
          window.location.href = authorizeBase + '/oauth2/authorize?' + p.toString();
        };
        g.oauth_implicit_tokens = () => {
          const h = (window.location.hash || '').replace(/^#/, '');
          const p = new URLSearchParams(h);
          const o: Record<string,string> = {};
          for (const [k, v] of p.entries()) o[k] = v;
          return o;
        };
        g.set_auth_token = (t: string) => localStorage.setItem('veil_auth_token', t);
        g.get_auth_token = () => (localStorage.getItem('veil_auth_token') ?? '');
        g.clear_url_hash = () => { try { history.replaceState(null, '', window.location.pathname + window.location.search); } catch {} };
        g.clear_auth_token = () => localStorage.removeItem('veil_auth_token');

        export {};
      """

    # Ambient declarations so the generated TypeScript (which calls the above as
    # bare identifiers) type-checks.
    scaffold "src/veil-shim.d.ts"
      emit """
        declare function location_pathname(): string;
        declare function location_last_segment(): string;
        declare function navigate(url: string): void;
        declare function goto(url: string): void;
        declare function spa_navigate(path: string): void;
        declare function current_path(): string;
        declare const Env: { get_or(k: string, d: string): string; get_opt(k: string): string | null };
        declare const LocalStorage: { get_or(k: string, d: string): string; get_opt(k: string): string | null; set(k: string, v: string): void };
        declare const ApiClient: {
          fetch(endpoint: string, params: any): Promise<any>;
          mutate(endpoint: string, body: any): Promise<any>;
          put(endpoint: string, body: any): Promise<any>;
          delete(endpoint: string): Promise<any>;
          send(method: string, endpoint: string, body: any): Promise<{ ok: boolean; data: any; error: string; status: number }>;
        };
        declare function oauth_pkce_login(authorizeBase: string, clientId: string, redirectUri: string, scope: string, idp: string): void;
        declare function oauth_pkce_exchange(tokenEndpoint: string, clientId: string, redirectUri: string, code: string): any;
        declare function oauth_callback_code(): string;
        declare function oauth_implicit_login(authorizeBase: string, clientId: string, redirectUri: string, scope: string, idp: string): void;
        declare function oauth_implicit_tokens(): Record<string, string>;
        declare function set_auth_token(t: string): void;
        declare function get_auth_token(): string;
        declare function token_expired(token: string): boolean;
        declare function clear_url_hash(): void;
        declare function clear_auth_token(): void;
      """

    scaffold "src/routes/+layout.svelte"
      emit """
        <script lang="ts">
          import '../app.css';
          let { children } = $props();
        </script>
        <main>{@render children()}</main>
      """

    match struct where subkind == "Page"
      emit_file "src/routes/{{route}}/+page.svelte"
      emit """
        <script lang="ts">
        {{imports}}
        {{props_decl}}
        {{state_decl}}
        {{raw_block:script}}
        </script>
        {{raw_block:template}}
      """

    # Dual-loop: @proxy(path, target) on app → SvelteKit hooks.server.ts proxy.
    # NOTE: Vite `server.proxy` does NOT work in SvelteKit — the SvelteKit dev
    # server middleware intercepts all requests before Vite's proxy runs.
    # The correct approach is a `hooks.server.ts` that proxies matching paths.
    match * where has_annotation("proxy")
      emit_file "vite.config.ts"
      emit """
        import { sveltekit } from '@sveltejs/kit/vite';
        import { defineConfig } from 'vite';
        export default defineConfig({
          plugins: [sveltekit()],
          optimizeDeps: {
            exclude: ['@aether-ui/core'],
          },
          ssr: {
            noExternal: ['@aether-ui/core'],
          },
          server: {
            watch: {
              ignored: [
                '**/svelte.config.js',
                '**/tsconfig.json',
                '**/package.json',
                '**/package-lock.json',
              ],
            },
          },
        });
      """

      emit_file "src/hooks.server.ts"
      emit """
        // Auto-generated API proxy — forwards {{annotation_arg:proxy:0}} requests to {{annotation_arg:proxy:1}}
        import type { Handle } from '@sveltejs/kit';

        const API_PREFIX = '{{annotation_arg:proxy:0}}';
        const BACKEND = '{{annotation_arg:proxy:1}}';

        export const handle: Handle = async ({ event, resolve }) => {
          if (event.url.pathname.startsWith(API_PREFIX)) {
            const target = BACKEND + event.url.pathname + event.url.search;
            const headers = new Headers(event.request.headers);
            headers.delete('host');
            const resp = await fetch(target, {
              method: event.request.method,
              headers,
              body: event.request.method !== 'GET' && event.request.method !== 'HEAD'
                ? await event.request.arrayBuffer()
                : undefined,
              duplex: 'half' as any,
            });
            return new Response(resp.body, {
              status: resp.status,
              statusText: resp.statusText,
              headers: resp.headers,
            });
          }
          return resolve(event);
        };
      """

    # Component bodies (props/state/effect/fn → TS) are emitted by the TypeScript
    # backend (`gen_svelte_file`). Layer only scaffolds the Kit project; do not
    # re-emit empty Component shells here or they overwrite real VEIL→TS output.

    match struct where subkind == "Store"
      emit_file "src/lib/stores/{{name_snake}}.svelte.ts"
      emit """
        // {{name}} — Svelte 5 rune-based store (generated by VEIL)
        {{store_state}}
        {{fn_declarations}}
      """

  prompt
    You are writing VEIL code using the sveltekit5 layer.
    Use `props` not `input` for component properties.
    Use `state` for reactive local fields (`$state`).
    Put markup only in `template` and CSS only in `style` (raw — no HTML/CSS target).
    Put logic in `fn` and `effect` VEIL bodies — they lower to TypeScript.
    Do NOT embed raw TypeScript/JavaScript; call ApiClient.fetch/mutate for REST.
    Call backend APIs over HTTPS (ApiClient) — not the Bus.
    All constructs must be inside an `app`.
    Pages must have @route annotation.
    For local dual-loop backends, annotate app with
    `@proxy("/api", "http://127.0.0.1:BACKEND_PORT")` so gen emits a SvelteKit hooks.server.ts proxy.
