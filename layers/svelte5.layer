pkg svelte5 v1
  desc "Svelte 5 component layer — runes-based reactivity, props, snippets"
  author "VEIL"

  # Frontend error model. The declared `ApiClient` / `goto` / `navigate` shims
  # return `Res!<...>` (browser fetch can fail). CHK-EM requires that any use of
  # `Res!` be backed by a layer-provided error_model so codegen never invents an
  # error type. A frontend package should NOT have to `use ddd` just to call an
  # API, so svelte5 provides its own lightweight model here. Standard variant
  # roles (external / not_found / validation) keep both codegen backends happy;
  # in the TypeScript target these lower to thrown `Error`s at the fetch shim.
  error_model FrontendError
    external NetworkError
    not_found NotFound
    validation ValidationError

  # Review presentation (PR Wizard) — component_sandbox target svelte5, fallback structural.
  review
    strategy component_sandbox
    target svelte5
    fallback structural
    secondary file_diff
    impact dependents

  # ─── Reactivity emission (MISSION: framework APIs live in layers) ───────
  # typescript.rs substitutes {name}/{type}/{default}/{expr}/{body} only.
  # It must NEVER hardcode $state / $derived / $props / $effect / $bindable.
  reactivity_policy
    props_call $props()
    state_line let {name}: {type} = $state({default});
    derived_line let {name} = $derived({expr});
    effect_sync   $effect(() => { // {name}
{body}
  });
    effect_async  $effect(() => { // {name}
    void (async () => {
{body}
    })();
  });
    bindable $bindable()
    bindable_default $bindable({default})

  # ─── Component Structure ────────────────────────────────────────────────

  construct App
    kw app
    mt mod
    au
    desc "A Svelte 5 application — top-level container for pages and layouts"
    cst
      requires_groups pages, components, stores
    visual
      icon "🔶"
      color "#ff3e00"
      label "Svelte App"
    ann
      # @proxy("/api", "http://127.0.0.1:3000") — dual-loop Vite proxy (sveltekit5.layer emits vite.config.ts)
      proxy: "Dev-server proxy path → backend URL" path, target
    in top
    # IDE views (docs/PRESENTATION.md) — different shape than DDD Context
    present
      view groups
        label "Folders"
        layout tabs
        members by_source_group
        tabs pages, components, stores
        default
      view routes
        label "Route tree"
        layout tree
        members by_host_children
        roots Layout, Page
        nest Page under Layout when declared_in_parent
        nest Component under Page when declared_in_parent
        nest Component under Layout when declared_in_parent
        orphan_policy list

  construct Page
    kw page
    mt struct
    desc "A routed page component (+page.svelte)"
    has
      props: struct
      state: struct
      template: raw
      script: raw
      style: raw
      fn[]
    lowers_to
      output_path: "src/routes/{{route}}/+page.svelte"
      typescript: """
<script lang="ts">
  {{props_decl}}{{state_decl}}{{script}}
</script>
{{template}}
{{#if style}}<style>{{style}}</style>{{/if}}
"""
    visual
      icon "📄"
      color "#ff6b35"
      label "Page"
    ann
      # role:ui_route — SvelteKit/SPA path. NEVER role:http_route (API harness).
      route: "URL route path" path role:ui_route
      load: "Server-side load function"
      guard: "Route guard condition" expr
    in App
    group pages
    present
      role container
      nestable_in routes as root
      nestable_in routes under Layout

  construct Layout
    kw layout
    mt struct
    desc "A layout component (+layout.svelte) wrapping child routes"
    has
      script: raw
      template: raw
      style: raw
      fn[]
    lowers_to
      output_path: "src/routes/{{route}}/+layout.svelte"
      typescript: """
<script lang="ts">
  let { children } = $props();
  {{script}}
</script>
{{template}}
{{#if style}}<style>{{style}}</style>{{/if}}
"""
    visual
      icon "📐"
      color "#e85d04"
      label "Layout"
    ann
      route: "URL route prefix" path role:ui_route
    in App
    group pages
    present
      role container
      nestable_in routes as root

  construct Component
    kw comp
    mt struct
    desc "A reusable Svelte 5 component with typed props and reactive state"
    has
      props: struct
      state: struct
      derived: struct
      effect[]
      template: raw
      script: raw
      style: raw
      fn[]
      Snippet[]
    lowers_to
      output_path: "src/lib/components/{{name}}.svelte"
      typescript: """
<script lang="ts">
  {{props_decl}}{{state_decl}}{{derived_decl}}{{fn_decl}}{{script}}{{effect_decl}}
</script>
{{template}}
{{#if style}}<style>{{style}}</style>{{/if}}
"""
    visual
      icon "🧩"
      color "#ff3e00"
      label "Component"
    ann
      bind: "Two-way bindable props" props
      export: "Exported component API methods"
    in App
    group components
    present
      role leaf
      nestable_in routes under Page
      nestable_in routes under Layout
      lens integration

  construct Snippet
    kw snippet
    mt fn
    desc "A reusable template snippet ({#snippet name(params)})"
    visual
      icon "✂️"
      color "#fb923c"
      label "Snippet"
    in Component
    group components

  # ─── Reactivity (Runes) ─────────────────────────────────────────────────

  construct Store
    kw store
    mt struct
    desc "A shared reactive store (module-level $state)"
    has
      state: struct
      derived: struct
      fn[]
    lowers_to
      output_path: "src/lib/stores/{{name_snake}}.svelte.ts"
      typescript: """
// {{name}} — Svelte 5 rune-based store (generated by VEIL)

{{store_state}}
{{fn_declarations}}
"""
    visual
      icon "🗂️"
      color "#c2410c"
      label "Store"
    ann
      persist: "Persist to localStorage/sessionStorage" key
      ssr: "Safe for server-side rendering"
    in App
    group stores
    present
      role leaf
      lens integration

  # ─── Statements (Svelte-specific operations) ────────────────────────────

  statement navigate
    mt call
    desc "Client-side navigation (goto)"
    sem client_navigation
    lowers_to
      typescript: "window.location.href = {arg0}"
    visual
      icon "🧭"
      color "#ff6b35"
      label "Navigate"

  statement goto
    mt call
    desc "Client-side navigation (goto alias)"
    sem client_navigation
    lowers_to
      typescript: "window.location.href = {arg0}"
    visual
      icon "🧭"
      color "#ff6b35"
      label "Goto"

  statement invalidate
    mt call
    desc "Invalidate a load function to re-fetch data"
    sem invalidate_load
    visual
      icon "🔄"
      color "#e85d04"
      label "Invalidate"

  statement dispatch
    mt call
    desc "Dispatch a custom event from a component"
    sem component_event
    visual
      icon "📡"
      color "#fb923c"
      label "Dispatch"

  # ─── Declared infrastructure ────────────────────────────────────────────

  declare
    # Typed fetch wrapper for calling backend APIs over HTTPS (not the Bus).
    # Codegen lowers these to browser `fetch` in the TypeScript target.
    trait ApiClient
      fetch(endpoint: Str, params: Json) -> Res!<Json>
        lowers_to
          typescript: "(async () => { const __u = new URL({arg0}, typeof window !== 'undefined' ? window.location.origin : 'http://localhost'); const __p = {arg1} as Record<string, unknown>; for (const [k, v] of Object.entries(__p)) { if (v != null && v !== '') __u.searchParams.set(k, String(v)); } const __h: Record<string,string> = {}; const __tok = typeof localStorage !== 'undefined' ? localStorage.getItem('veil_auth_token') : null; if (__tok) __h['Authorization'] = 'Bearer ' + __tok; const __r = await fetch(__u.toString(), { headers: __h }); if (!__r.ok) throw new Error(await __r.text()); return await __r.json(); })()"
      mutate(endpoint: Str, body: Json) -> Res!<Json>
        lowers_to
          typescript: "(async () => { const __h: Record<string,string> = { 'Content-Type': 'application/json' }; const __tok = typeof localStorage !== 'undefined' ? localStorage.getItem('veil_auth_token') : null; if (__tok) __h['Authorization'] = 'Bearer ' + __tok; const __r = await fetch({arg0}, { method: 'POST', headers: __h, body: JSON.stringify({arg1}) }); if (!__r.ok) throw new Error(await __r.text()); const __t = await __r.text(); return __t ? JSON.parse(__t) : null; })()"
      put(endpoint: Str, body: Json) -> Res!<Json>
        lowers_to
          typescript: "(async () => { const __h: Record<string,string> = { 'Content-Type': 'application/json' }; const __tok = typeof localStorage !== 'undefined' ? localStorage.getItem('veil_auth_token') : null; if (__tok) __h['Authorization'] = 'Bearer ' + __tok; const __r = await fetch({arg0}, { method: 'PUT', headers: __h, body: JSON.stringify({arg1}) }); if (!__r.ok) throw new Error(await __r.text()); const __t = await __r.text(); return __t ? JSON.parse(__t) : null; })()"
      delete(endpoint: Str) -> Res!<Json>
        lowers_to
          typescript: "(async () => { const __r = await fetch({arg0}, { method: 'DELETE' }); if (!__r.ok) throw new Error(await __r.text()); const __t = await __r.text(); return __t ? JSON.parse(__t) : null; })()"
      # Non-throwing transport. Returns an envelope { ok, data, error, status }
      # and NEVER rejects — folds non-2xx, network, and JSON-parse failures into
      # the envelope. Declarative components (e.g. designkit CrudResource) that
      # cannot express try/catch in structured VEIL use this to drive a visible
      # error/loading state on an on-mount load instead of leaking an
      # "Uncaught (in promise)" out of the harness bundle when the backend errors.
      send(method: Str, endpoint: Str, body: Json) -> Json
        lowers_to
          typescript: "(async () => { const __m = ({arg0} || 'GET').toUpperCase(); try { let __url = {arg1}; const __h: Record<string,string> = {}; const __tok = typeof localStorage !== 'undefined' ? localStorage.getItem('veil_auth_token') : null; if (__tok) __h['Authorization'] = 'Bearer ' + __tok; const __init: any = { method: __m, headers: __h }; if (__m === 'POST' || __m === 'PUT' || __m === 'PATCH') { __h['Content-Type'] = 'application/json'; __init.body = JSON.stringify({arg2} ?? {}); } else if (__m === 'GET' && {arg2} && typeof {arg2} === 'object') { const __u = new URL({arg1}, typeof window !== 'undefined' ? window.location.origin : 'http://localhost'); for (const [k, v] of Object.entries({arg2} as Record<string, unknown>)) { if (v != null && v !== '') __u.searchParams.set(k, String(v)); } __url = __u.toString(); } const __r = await fetch(__url, __init); const __t = await __r.text(); if (!__r.ok) return { ok: false, data: null, error: __t || ('HTTP ' + __r.status), status: __r.status }; return { ok: true, data: __t ? JSON.parse(__t) : null, error: '', status: __r.status }; } catch (__e: any) { return { ok: false, data: null, error: (__e && __e.message) ? __e.message : String(__e), status: 0 }; } })()"

    # Browser localStorage — lowered to localStorage.* in TS
    struct LocalStorage
      fn get_or(key: Str, default: Str) -> Str
        lowers_to
          typescript: "(localStorage.getItem({arg0}) ?? {arg1})"
      fn get_opt(key: Str) -> Opt<Str>
        lowers_to
          typescript: "localStorage.getItem({arg0})"
      fn set(key: Str, value: Str)
        lowers_to
          typescript: "localStorage.setItem({arg0}, {arg1})"

    # Form handling (Json payload until generics in declare are typecheck-clean)
    struct FormState
      data: Json
      errors: Map<Str, Str>
      submitting: Bool
      valid: Bool

    # Navigation — lowered to window.location / kit goto
    fn goto(url: Str) -> Res!
      lowers_to
        typescript: "window.location.href = {arg0}"
      navigate(url)
      ret Ok

    fn navigate(url: Str) -> Res!
      lowers_to
        typescript: "window.location.href = {arg0}"
      ret Ok

    # ── OAuth2 Authorization-Code + PKCE (generic, provider-agnostic) ──────────
    # Begin an Authorization-Code-with-PKCE login: generate a random verifier,
    # derive the S256 challenge, persist the verifier, and redirect the browser
    # to the authorization endpoint. `idp` (optional) pre-selects a hosted-UI
    # identity provider. All arguments are values supplied by the caller — this
    # helper knows nothing about any specific IdP.
    fn oauth_pkce_login(authorize_base: Str, client_id: Str, redirect_uri: Str, scope: Str, idp: Str) -> Res!
      lowers_to
        typescript: "(async () => { const b64url = (buf: ArrayBuffer) => btoa(String.fromCharCode(...new Uint8Array(buf))).replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,''); const rnd = new Uint8Array(32); crypto.getRandomValues(rnd); const verifier = b64url(rnd.buffer); const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(verifier)); const challenge = b64url(digest); localStorage.setItem('pkce_verifier', verifier); const p = new URLSearchParams({ client_id: {arg1}, response_type: 'code', redirect_uri: {arg2}, scope: {arg3}, code_challenge: challenge, code_challenge_method: 'S256' }); if ({arg4}) p.set('identity_provider', {arg4}); window.location.href = {arg0} + '/oauth2/authorize?' + p.toString(); })()"
      ret Ok

    # Exchange an authorization code for tokens at the token endpoint, using the
    # stored PKCE verifier. Returns the parsed token JSON (id_token, access_token,
    # …). Clears the verifier afterwards.
    fn oauth_pkce_exchange(token_endpoint: Str, client_id: Str, redirect_uri: Str, code: Str) -> Res!<Json>
      lowers_to
        typescript: "(async () => { const verifier = localStorage.getItem('pkce_verifier') ?? ''; const body = new URLSearchParams({ grant_type: 'authorization_code', client_id: {arg1}, code: {arg3}, redirect_uri: {arg2}, code_verifier: verifier }); const r = await fetch({arg0}, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body.toString() }); localStorage.removeItem('pkce_verifier'); if (!r.ok) throw new Error(await r.text()); return await r.json(); })()"
      ret Ok

    # Read the `code` query parameter from the current URL (OAuth callback).
    fn oauth_callback_code() -> Str
      lowers_to
        typescript: "(new URLSearchParams(window.location.search).get('code') ?? '')"
      ret ""

    # Implicit-flow login: redirect to the hosted UI with response_type=token.
    # The id_token/access_token come back in the URL fragment at the redirect_uri.
    fn oauth_implicit_login(authorize_base: Str, client_id: Str, redirect_uri: Str, scope: Str, idp: Str) -> Res!
      lowers_to
        typescript: "(() => { const p = new URLSearchParams({ client_id: {arg1}, response_type: 'token', redirect_uri: {arg2}, scope: {arg3} }); if ({arg4}) p.set('identity_provider', {arg4}); window.location.href = {arg0} + '/oauth2/authorize?' + p.toString(); })()"
      ret Ok

    # Parse the implicit-flow tokens from the URL fragment (#id_token=...&access_token=...).
    # Returns { id_token, access_token, ... } or an empty object if absent.
    fn oauth_implicit_tokens() -> Json
      lowers_to
        typescript: "(() => { const h = (typeof window !== 'undefined' ? window.location.hash : '').replace(/^#/, ''); const p = new URLSearchParams(h); const o: Record<string,string> = {}; for (const [k,v] of p.entries()) o[k] = v; return o; })()"
      ret "{}"

    # Persist / clear the bearer token that ApiClient attaches to requests.
    fn set_auth_token(token: Str) -> Res!
      lowers_to
        typescript: "localStorage.setItem('veil_auth_token', {arg0})"
      ret Ok

    fn clear_auth_token() -> Res!
      lowers_to
        typescript: "localStorage.removeItem('veil_auth_token')"
      ret Ok

    # Environment — browser uses localStorage (no process.env in SPA)
    struct Env
      fn get_or(key: Str, default: Str) -> Str
        lowers_to
          typescript: "(localStorage.getItem({arg0}) ?? {arg1})"
      fn get_opt(key: Str) -> Opt<Str>
        lowers_to
          typescript: "(localStorage.getItem({arg0}) ?? null)"

    # Browser path helpers (codegen → window.location)
    fn location_pathname() -> Str
      ret ""

    # Last path segment, or "" when empty / root. e.g. /wear-tests/{id} → id
    fn location_last_segment() -> Str
      ret ""

    fn invalidateAll() -> Res!
      invalidate("all")
      ret Ok

  prompt
    You are writing VEIL code using the Svelte 5 layer.

    ## Overview
    This layer provides constructs for modeling Svelte 5 applications: pages,
    layouts, components, stores, and reactive state. It uses Svelte 5's runes
    system ($state, $derived, $effect) rather than the older store-based API.

    ## Constructs
    - `app` (mod) — top-level Svelte application container
    - `page` (struct) — a routed page component (+page.svelte)
    - `layout` (struct) — a layout wrapper (+layout.svelte)
    - `comp` (struct) — a reusable component with typed props
    - `store` (struct) — a reactive store (Svelte 5 rune-based)

    ## Constraints
    - You MUST annotate pages with `@route("/path")` because SvelteKit uses
      file-based routing derived from these annotations.
    - You SHOULD annotate dual-loop backends with
      `@proxy("/api", "http://127.0.0.1:BACKEND_PORT")` **before** the `app` keyword
      (leading annotations attach to the next construct). sveltekit5 codegen then
      emits a SvelteKit `hooks.server.ts` proxy for relative `/api/*` requests.

    - You MUST declare component props as typed fields because they generate
      the `$props()` rune destructuring.
    - You SHOULD use `store` for shared state instead of module-level variables
      because stores integrate with Svelte's reactivity system.
    - You MUST NOT use Svelte 4 store syntax (`$:`, `writable()`) because this
      layer targets Svelte 5 runes (`$state`, `$derived`, `$effect`).
    - You SHOULD organize pages under the `pages` group and components under
      `components` because this maps to SvelteKit's directory conventions.

    ## Patterns
    ```
    app MyApp
      group pages
        page Dashboard
          @route("/dashboard")
          @load
          props
            user: UserDTO

      group components
        comp UserCard
          props
            name: Str
            avatar: Str
            online: Bool

      group stores
        store AppStore
          items: List<Item>
          loading: Bool
    ```

    ## Common Mistakes
    - Wrong: Using `input` on a comp — use `props` instead.
    - Wrong: Defining data types as comp — use `type` alias.
    - Wrong: Components outside an `app` — nest inside app.
    - Wrong: Using Svelte 4 `$:` reactive declarations — use `$derived` rune.
    - Wrong: Putting API calls directly in components — use a `@load` function
      on the page or call a service.
    - Right: Props are typed fields on components; state lives in stores.

    ## CRITICAL CORRECTIONS
    - You MUST use `props` (NOT `input`) for comp properties. `input` is for fn-shaped constructs only.
    - You MUST place all UI constructs inside an `app` construct.
    - You MUST NOT define data types as `comp` — use `type` aliases instead.
    - `comp` named sub-blocks: props, state, derived, template, style, fn, effect.
    - Logic is VEIL (`fn` / `effect`) lowered to TypeScript — NOT raw TS in a script block.
    - Only `template` (HTML) and `style` (CSS) are raw, because VEIL has no HTML/CSS target.
