pkg harness v1
  desc "Local app harness — InProcessBus + composition helpers (RT-001) + HttpHost (CAP-002)"
  author "VEIL"
  use base
  use di

  harness_policy
    profile axum_http
    bin veil_bin
    listen_env PORT
    listen_default 3000
    health /health
    cors localhost
    cors_outside_auth true
    auth api_key
    emit_bin on_entry
    bus_wire explicit
    collide error
    bind_defaults method
    delete_extras query

  construct DepsBundle
    kw deps
    mt struct
    role deps_bundle
    in any
    group application
    desc "Declared application dependency bundle — the Deps type"

  construct ComposeRoot
    kw compose
    mt struct
    role compose
    in any
    group infrastructure
    has
      bundle: ident
      wire: struct
    desc "Composition root: which adapter satisfies each deps field"

  construct HttpEndpoint
    kw endpoint
    mt struct
    role http_endpoint
    in any
    group presentation
    has
      method: ident
      path: path
      handle: ident
      bind: struct
    desc "Explicit HTTP endpoint — engineer-defined method/path/handler/binds"

  # CAP-002 / CAP-004: system + host ports provided by runtime trampoline.
  # Declared as traits (core shape); host implements via ProductHost / LocalFs.
  declare
    trait HttpHost
      mount_ide() -> Res!
      serve_dir(path: Str) -> Res!
      mount_bus() -> Res!
      listen(port: Int) -> Res!

    trait FileSystem
      read(path: Str) -> Res!<Str>
      write(path: Str, content: Str) -> Res!
      list(prefix: Str) -> Res!<List<Str>>

    trait GitRepo
      branches(repo: Str) -> Res!<List<Str>>
      log(repo: Str, limit: Int) -> Res!<List<Str>>

  # No domain vocabulary. App authors `use harness` for local wiring patterns.
  # InProcessBus is generated only when a loaded layer declares routing
  # statements (`mt SomePort.method`). DDD does not declare a Bus.
  # HttpHost is implemented by veil_server::ProductHost (link veil_server).

  prompt
    You are writing a VEIL-authored local harness (not handwritten bootstrap).

    ## Overview
    Packages with **context modules** get a generated `veil_bin` HTTP harness
    for local dual-loop even **without** `@main`. Use `@main` (di.layer) when
    you need Bus composition roots or ProductHost.

    The engine generates `InProcessBus` into `veil_shared` only when a loaded
    layer declares routing statements (`mt SomePort.method`). DDD does not.

    For the product host: `link veil_server` + `@main` emits ProductHost listen
    (CAP-002/006). FileSystem / GitRepo are provided_by runtime (CAP-004).

    ## Local REST routes (dual-loop harness)
    - Declare first-class `endpoint Name METHOD /path -> Handler` (or field form).
      The engine matches **role:http_endpoint**, not the keyword `endpoint`.
    - **Path params use brace form** `{id}`, `{cohort_id}`, … — not Express `:id`.
    - Do **not** put `@route` on svc/handler. Svelte page `@route("/path")` is a
      different surface and must never gain `role:http_route`.
    - Name-derived List/Get is compat-only (`[harness] compat = "auto"`).
      New projects default to `compat = "off"` — declare endpoints.
    - Bus message keys: optional `bus_policy.strip_name_prefix` in ddd (e.g. Handle).
    - Inspect routes via `list_routes` / `read_generated(what=harness)`.
    - Opt out of a generated bin: `[harness] emit_bin = "never"`.

    ## Patterns
    - Construct `InProcessBus.new()` in `@main` only if a product layer declared
      a routing port (the platform does not ship a Bus)
    - Wire `@dep` / `@pvd` for adapters
    - Prefer calling generated application `fn`s for local demos
    - Cross-context: inject a product port and call it
    - Product shell: `link veil_server` then `@main` bootstrap

    ## Constraints
    - You MUST NOT rely on eternal handwritten bootstrap for new apps
    - You SHOULD keep `@main` thin: wire + one demo invoke
    - For dual-loop REST APIs, declare `deps` / `compose` / `endpoint`
