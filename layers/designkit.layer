# ═══════════════════════════════════════════════════════════════════════════
# designkit — IDE vocabulary for reusable dual-loop UI chrome
# ═══════════════════════════════════════════════════════════════════════════
#
# WHAT THIS FILE IS
#   Layer = language for the IDE palette (what we call the components).
#   Implementation lives in designkit.veil (same product: dlx-designkit).
#
#   Products: `use designkit` → loads this layer + implicitly adapts
#   designkit.veil (stock components) when both resolve from the projects hub.
#
# UX SOURCE
#   dashlx core /vendors list (tile|list toggle) and /vendors/new sticky create
#   header (X/N required + Create) + required field indicators.
#
# WHO TOUCHES WHAT
#   · Language designers  → this file (constructs / visual / prompt)
#   · Product engineers   → designkit.veil (component bodies)
#   · App teams           → use designkit; configure components on mount
# ═══════════════════════════════════════════════════════════════════════════

pkg designkit v1
  desc "Design kit vocabulary: CollectionView, CreateFormShell, FormField, … (dashlx Vendors CRUD UX)"
  author "VEIL"
  use sveltekit5

  # Cross-project component provider: designkit vocabulary is implemented in a
  # separate library project. Any project that `use designkit` gets these
  # components materialized into its build tree automatically.
  implemented_by dlx-designkit
  provides CollectionView StatusPill EntityIdentity ViewModeToggle PageHeader EmptyState
  provides CreateFormShell DetailShell DetailField FormProgress FormSection FormField
  provides CrudResource Modal ConfirmDialog AlertDialog PromptDialog ContextMenu
  provides WizardShell ChoiceCards AgentSurface RepeatEditor

  # ─── Collection / list chrome ───────────────────────────────────────────

  construct CollectionView
    kw collection_view
    mt struct
    desc "Resource list with configurable layout. viewMode: tiles | list | both (toggle). columns: string labels OR {key,label,cell:text|pill|identity,showAvatar,pillMap}. showAvatar defaults identity monograms. Snippets tile/row optional when columns have keys."
    visual
      icon "🗂️"
      color "#148770"
      label "Collection View"
    in App
    group components
    ann
      viewMode: "tiles | list | both — force one layout or allow toggle (default both)"
      defaultLayout: "Initial layout when viewMode is both: tiles | list"
      showAvatar: "Default for identity monograms (true|false); per-column showAvatar overrides"
      items: "Array of records (any entity shape)"
      columns: "String labels or rich defs {key,label,cell,pillMap,showAvatar}"
      primaryHref: "Primary CTA link (e.g. /things/new)"
      primaryLabel: "Primary CTA label (e.g. Add Thing)"

  construct StatusPill
    kw status_pill
    mt struct
    desc "Status/label pill (dashlx badge). variant success|warning|info|error|neutral, or status string with pillMap."
    visual
      icon "⬤"
      color "#34d399"
      label "Status Pill"
    in App
    group components
    ann
      variant: "success | warning | info | error | neutral"
      pillMap: "Map value → variant for column-level configuration"
      status: "Raw status string (auto-maps Draft/Active/… when variant unset)"

  construct EntityIdentity
    kw entity_identity
    mt struct
    desc "Name + optional letter avatar. showAvatar false hides monogram."
    visual
      icon "👤"
      color "#1a9d82"
      label "Entity Identity"
    in App
    group components
    ann
      showAvatar: "true (default) | false"
      size: "md | sm"

  construct ViewModeToggle
    kw view_mode_toggle
    mt struct
    desc "Tile vs list toggle control (used inside CollectionView when viewMode=both)."
    visual
      icon "⊞"
      color "#1a9d82"
      label "View Mode Toggle"
    in App
    group components

  construct PageHeader
    kw page_header
    mt struct
    desc "Page title, description, and action slot (right side)."
    visual
      icon "≡"
      color "#0f6b5a"
      label "Page Header"
    in App
    group components

  construct EmptyState
    kw empty_state
    mt struct
    desc "Empty collection placeholder with optional primary action."
    visual
      icon "∅"
      color "#6fcfbd"
      label "Empty State"
    in App
    group components

  # ─── Create / edit form chrome ──────────────────────────────────────────

  construct CreateFormShell
    kw create_form_shell
    mt struct
    desc "CRUD form page shell (create|edit): back + title | header_actions + FormProgress. Body slots: children (fields), footer (danger zone). loading/error built in. mode=create|edit sets agent role."
    visual
      icon "📝"
      color "#148770"
      label "Form Shell (create/edit)"
    in App
    group components
    ann
      requiredValues: "String values for required fields — non-empty counts as filled"
      submitLabel: "Primary button label (e.g. Create Vendor)"
      backHref: "Back navigation href"
      mode: "create | edit — agent role create-form | edit-form"
      header_actions: "Snippet left of FormProgress (secondary header CTAs)"
      footer: "Snippet below body (delete / secondary actions)"

  construct DetailShell
    kw detail_shell
    mt struct
    desc "CRUD detail/view page shell: back + title | header_actions. Slots: summary, children, sidebar, footer. loading/error built in. Product fills fields via DetailField."
    visual
      icon "👁"
      color "#3eb5a0"
      label "Detail Shell"
    in App
    group components
    ann
      header_actions: "Primary detail actions (e.g. Edit)"
      summary: "Optional band under header"
      children: "Main sections (FormSection + DetailField)"
      sidebar: "Optional right rail"
      footer: "Secondary / danger actions"

  construct DetailField
    kw detail_field
    mt struct
    desc "Read-only labeled value for DetailShell. value/empty_label, mono, pre, or children for custom render (StatusPill, etc.)."
    visual
      icon "▣"
      color "#6fcfbd"
      label "Detail Field"
    in App
    group components

  construct FormProgress
    kw form_progress
    mt struct
    desc "Progress meter (X/N required or Ready) + primary submit button."
    visual
      icon "▰"
      color "#fbbf24"
      label "Form Progress"
    in App
    group components

  construct FormSection
    kw form_section
    mt struct
    desc "Titled form section with 1|2|3 column grid for fields."
    visual
      icon "▦"
      color "#3eb5a0"
      label "Form Section"
    in App
    group components

  construct FormField
    kw form_field
    mt struct
    desc "Labeled input with required indicator (amber empty / green filled) and left status bar. Bind value for any field on any entity."
    visual
      icon "▭"
      color "#22c55e"
      label "Form Field"
    in App
    group components
    ann
      required: "Show required ● and incomplete bar when empty"
      type: "text | date | url | password | select | textarea | email"

  # ─── Tokens (stylesheet only — no component body here) ──────────────────
  # Scaffolded into app.css so dual-loop UIs share brand chrome without Tailwind.

  codegen typescript
    # Match dashlx core: Inter from Google Fonts + dark class
    scaffold "src/app.html"
      emit """
        <!doctype html>
        <html lang="en" class="dark">
          <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1" />
            <link rel="preconnect" href="https://fonts.googleapis.com" />
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
            <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
            %sveltekit.head%
          </head>
          <body data-sveltekit-preload-data="hover">
            <div style="display: contents">%sveltekit.body%</div>
          </body>
        </html>
      """

    scaffold "src/app.css"
      emit """

        /* designkit — modern professional UI (motion · depth · glass) */
        :root {
          --dk-brand: #148770;
          --dk-brand-light: #1fa88a;
          --dk-brand-dark: #0f6b5a;
          --dk-brand-glow: rgba(20, 135, 112, 0.35);
          --dk-bg: #07070c;
          --dk-bg-elevated: #0c0c14;
          --dk-surface: #12121a;
          --dk-surface-2: #1a1a26;
          --dk-surface-3: #22222f;
          --dk-border: #2a2a38;
          --dk-border-soft: rgba(42, 42, 56, 0.55);
          --dk-text: #f4f5f7;
          --dk-text-muted: #9ca3af;
          --dk-radius: 0.85rem;
          --dk-radius-sm: 0.55rem;
          --dk-radius-lg: 1.15rem;
          --dk-amber: #fbbf24;
          --dk-green: #22c55e;
          --dk-red: #ef4444;
          --dk-font: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
          --dk-ease: cubic-bezier(0.22, 1, 0.36, 1);
          --dk-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
          --dk-ease-spring: cubic-bezier(0.34, 1.4, 0.64, 1);
          --dk-dur-fast: 140ms;
          --dk-dur: 240ms;
          --dk-dur-slow: 420ms;
          --dk-shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.28);
          --dk-shadow: 0 8px 28px rgba(0, 0, 0, 0.4), 0 2px 8px rgba(0, 0, 0, 0.25);
          --dk-shadow-lg: 0 24px 64px rgba(0, 0, 0, 0.55), 0 8px 20px rgba(0, 0, 0, 0.35);
          --dk-shadow-glow: 0 0 0 1px rgba(20, 135, 112, 0.2), 0 12px 40px rgba(20, 135, 112, 0.12);
          --dk-glass: rgba(18, 18, 26, 0.72);
          --dk-glass-border: rgba(255, 255, 255, 0.06);
          --bg: var(--dk-bg);
          --surface: var(--dk-surface);
          --border: var(--dk-border);
          --text: var(--dk-text);
          --text-dim: var(--dk-text-muted);
          --accent: var(--dk-brand-light);
          --accent-hover: #6fcfbd;
          --radius: var(--dk-radius-sm);
        }
        * { box-sizing: border-box; margin: 0; }
        html { color-scheme: dark; }
        body {
          font-family: var(--dk-font);
          color: var(--dk-text);
          line-height: 1.6;
          min-height: 100vh;
          -webkit-font-smoothing: antialiased;
          -moz-osx-font-smoothing: grayscale;
          background-color: var(--dk-bg);
          background-image:
            radial-gradient(ellipse 90% 60% at 10% -20%, rgba(20, 135, 112, 0.16), transparent 55%),
            radial-gradient(ellipse 70% 50% at 100% 0%, rgba(79, 70, 229, 0.08), transparent 50%),
            radial-gradient(ellipse 50% 40% at 50% 100%, rgba(20, 135, 112, 0.05), transparent 55%),
            linear-gradient(180deg, var(--dk-bg-elevated) 0%, var(--dk-bg) 40%, #050508 100%);
          background-attachment: fixed;
        }
        /* subtle noise grain (SVG data URI) for depth */
        body::before {
          content: "";
          position: fixed; inset: 0; pointer-events: none; z-index: 0;
          opacity: 0.035;
          background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
        }
        body > * { position: relative; z-index: 1; }
        h1 { font-size: 1.55rem; font-weight: 700; margin-bottom: 0.25rem; letter-spacing: -0.02em; }
        p { color: var(--dk-text-muted); margin-bottom: 0.75rem; }
        a { color: var(--dk-brand-light); text-decoration: none; transition: color var(--dk-dur-fast) var(--dk-ease); }
        a:hover { color: var(--accent-hover); }
        main {
          max-width: 1120px; margin: 0 auto; padding: 1.75rem 1.5rem 3rem;
          animation: dk-fade-in var(--dk-dur-slow) var(--dk-ease-out) both;
        }

        /* ── Buttons ── */
        .btn, .btn-primary, .btn-outline, .btn-ghost, .btn-danger {
          display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
          padding: 0.55rem 1.05rem; border-radius: var(--dk-radius-sm); font-weight: 600;
          font-size: 0.875rem; border: 1px solid transparent; cursor: pointer;
          text-decoration: none; font-family: inherit;
          transition:
            transform var(--dk-dur-fast) var(--dk-ease-spring),
            box-shadow var(--dk-dur) var(--dk-ease),
            background var(--dk-dur-fast) var(--dk-ease),
            border-color var(--dk-dur-fast) var(--dk-ease),
            color var(--dk-dur-fast) var(--dk-ease),
            opacity var(--dk-dur-fast) ease;
          will-change: transform;
        }
        .btn:disabled, .btn-primary:disabled, .btn-outline:disabled, .btn-ghost:disabled, .btn-danger:disabled {
          opacity: 0.5; cursor: not-allowed; transform: none !important; box-shadow: none !important;
        }
        .btn-primary {
          background: linear-gradient(165deg, var(--dk-brand-light) 0%, var(--dk-brand) 55%, var(--dk-brand-dark) 100%);
          color: #fff;
          box-shadow: 0 4px 16px var(--dk-brand-glow), inset 0 1px 0 rgba(255,255,255,0.12);
        }
        .btn-primary:hover:not(:disabled) {
          transform: translateY(-1px) scale(1.02);
          box-shadow: 0 8px 24px var(--dk-brand-glow), inset 0 1px 0 rgba(255,255,255,0.18);
          filter: brightness(1.05);
        }
        .btn-primary:active:not(:disabled) { transform: translateY(0) scale(0.98); }
        .btn-outline {
          border-color: rgba(20, 135, 112, 0.45); color: var(--dk-brand-light);
          background: rgba(20, 135, 112, 0.04);
          backdrop-filter: blur(8px);
        }
        .btn-outline:hover:not(:disabled) {
          background: rgba(20, 135, 112, 0.12);
          border-color: rgba(20, 135, 112, 0.7);
          transform: translateY(-1px);
          box-shadow: 0 4px 16px rgba(20, 135, 112, 0.12);
        }
        .btn-ghost { background: transparent; color: var(--dk-text-muted); }
        .btn-ghost:hover:not(:disabled) {
          background: rgba(255,255,255,0.05); color: var(--dk-text);
          transform: translateY(-1px);
        }
        .btn-danger {
          background: linear-gradient(165deg, #f87171 0%, var(--dk-red) 55%, #b91c1c 100%);
          color: #fff;
          box-shadow: 0 4px 16px rgba(239, 68, 68, 0.3), inset 0 1px 0 rgba(255,255,255,0.1);
        }
        .btn-danger:hover:not(:disabled) {
          transform: translateY(-1px) scale(1.02);
          box-shadow: 0 8px 24px rgba(239, 68, 68, 0.35);
          filter: brightness(1.05);
        }
        .btn {
          background: var(--dk-surface-2); color: var(--dk-brand-light); border-color: var(--dk-border);
        }
        .btn:hover:not(:disabled) { background: var(--dk-surface-3); transform: translateY(-1px); }

        /* ── Cards (2.5D lift) ── */
        .card {
          position: relative;
          background:
            linear-gradient(155deg, rgba(255,255,255,0.03) 0%, transparent 42%),
            linear-gradient(165deg, var(--dk-surface) 0%, var(--dk-bg) 100%);
          border: 1px solid var(--dk-border-soft);
          border-radius: var(--dk-radius);
          box-shadow: var(--dk-shadow-sm), inset 0 1px 0 rgba(255,255,255,0.04);
          transition:
            transform var(--dk-dur) var(--dk-ease),
            box-shadow var(--dk-dur) var(--dk-ease),
            border-color var(--dk-dur) var(--dk-ease);
          transform-style: preserve-3d;
          perspective: 800px;
        }
        .card::before {
          content: "";
          position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
          background: linear-gradient(135deg, rgba(255,255,255,0.06) 0%, transparent 40%, transparent 100%);
          opacity: 0.5;
          transition: opacity var(--dk-dur) var(--dk-ease);
        }

        /* ── Inputs ── */
        .input, input:not([type=checkbox]):not([type=radio]), textarea, select {
          width: 100%; padding: 0.65rem 0.9rem; border-radius: var(--dk-radius-sm);
          border: 1px solid var(--dk-border);
          background: rgba(18, 18, 26, 0.85);
          color: var(--dk-text);
          font-size: 0.9rem; font-family: inherit;
          transition:
            border-color var(--dk-dur-fast) var(--dk-ease),
            box-shadow var(--dk-dur) var(--dk-ease),
            background var(--dk-dur-fast) ease,
            transform var(--dk-dur-fast) var(--dk-ease);
        }
        .input:hover, input:hover, textarea:hover, select:hover {
          border-color: rgba(255,255,255,0.12);
        }
        .input:focus, input:focus, textarea:focus, select:focus {
          outline: none;
          border-color: rgba(20, 135, 112, 0.65);
          background: rgba(18, 18, 26, 0.95);
          box-shadow: 0 0 0 3px rgba(20, 135, 112, 0.18), 0 4px 16px rgba(20, 135, 112, 0.08);
        }
        .input-error { border-color: var(--dk-red) !important; box-shadow: 0 0 0 3px rgba(239,68,68,0.15) !important; }

        /* ── Badges ── */
        .badge {
          display: inline-flex; align-items: center; padding: 0.2rem 0.7rem;
          border-radius: 999px; font-size: 0.72rem; font-weight: 600;
          border: 1px solid transparent; line-height: 1.25; white-space: nowrap;
          letter-spacing: 0.02em;
          box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);
          transition: transform var(--dk-dur-fast) var(--dk-ease), box-shadow var(--dk-dur) ease;
        }
        .badge:hover { transform: translateY(-0.5px); }
        .badge-success { background: rgba(16,185,129,0.18); color: #34d399; border-color: rgba(16,185,129,0.32); }
        .badge-warning { background: rgba(245,158,11,0.18); color: #fbbf24; border-color: rgba(245,158,11,0.32); }
        .badge-info { background: rgba(20,135,112,0.18); color: var(--dk-brand-light); border-color: rgba(20,135,112,0.32); }
        .badge-error { background: rgba(239,68,68,0.18); color: #f87171; border-color: rgba(239,68,68,0.32); }
        .badge-neutral { background: rgba(156,163,175,0.12); color: #9ca3af; border-color: rgba(156,163,175,0.22); }

        /* ── Page header ── */
        .dk-page-header {
          display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between;
          gap: 1rem; margin-bottom: 1.75rem;
          animation: dk-fade-up 0.5s var(--dk-ease-out) both;
        }
        .dk-page-header__title {
          font-size: 1.6rem; font-weight: 700; color: var(--dk-text); margin: 0;
          letter-spacing: -0.025em;
          background: linear-gradient(180deg, #fff 0%, #c8cdd6 100%);
          -webkit-background-clip: text; background-clip: text;
          -webkit-text-fill-color: transparent;
        }
        .dk-page-header__desc { color: var(--dk-text-muted); margin: 0.35rem 0 0; font-size: 0.95rem; max-width: 36rem; }
        .dk-page-header__actions { display: flex; align-items: center; gap: 0.55rem; flex-wrap: wrap; }

        /* ── View toggle ── */
        .dk-view-toggle {
          display: flex; align-items: center;
          border: 1px solid var(--dk-border); border-radius: var(--dk-radius-sm);
          padding: 0.22rem; gap: 0.15rem;
          background: rgba(18, 18, 26, 0.7);
          backdrop-filter: blur(12px);
          box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
        }
        .dk-view-toggle__btn {
          display: inline-flex; padding: 0.4rem; border: none; border-radius: 0.4rem;
          background: transparent; color: var(--dk-text-muted); cursor: pointer;
          transition:
            background var(--dk-dur-fast) var(--dk-ease),
            color var(--dk-dur-fast) var(--dk-ease),
            transform var(--dk-dur-fast) var(--dk-ease-spring),
            box-shadow var(--dk-dur) var(--dk-ease);
        }
        .dk-view-toggle__btn:hover { color: var(--dk-text); background: rgba(255,255,255,0.04); }
        .dk-view-toggle__btn--active {
          background: linear-gradient(165deg, var(--dk-brand-light), var(--dk-brand));
          color: #fff;
          box-shadow: 0 2px 10px var(--dk-brand-glow);
        }

        /* ── Collection / tiles ── */
        .dk-collection { display: flex; flex-direction: column; gap: 1.1rem; }
        .dk-tile-grid {
          display: grid; grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 1.1rem;
          perspective: 1200px;
        }
        @media (min-width: 768px) { .dk-tile-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
        @media (min-width: 1024px) { .dk-tile-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
        .dk-tile {
          padding: 1.15rem 1.15rem 1.2rem;
          position: relative;
          /* visible so ⋮ menus / popovers are not clipped by the card */
          overflow: visible;
          animation: dk-fade-up 0.5s var(--dk-ease-out) both;
          animation-delay: calc(var(--dk-i, 0) * 45ms);
          transform: translateZ(0);
        }
        .dk-tile:hover {
          transform: translateY(-4px) rotateX(1.5deg) scale(1.012);
          border-color: rgba(20, 135, 112, 0.35);
          box-shadow: var(--dk-shadow-glow), var(--dk-shadow);
        }
        .dk-tile:hover::before { opacity: 0.85; }
        .dk-tile::after {
          content: "";
          position: absolute; inset: auto -20% -40% -20%; height: 60%;
          background: radial-gradient(ellipse at center, rgba(20,135,112,0.12), transparent 70%);
          opacity: 0; transition: opacity var(--dk-dur) var(--dk-ease); pointer-events: none;
        }
        .dk-tile:hover::after { opacity: 1; }
        .dk-tile__row { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; padding-right: 2rem; }
        .dk-tile__identity { display: flex; align-items: center; gap: 0.8rem; min-width: 0; }
        .dk-tile__identity-text { min-width: 0; }
        .dk-avatar {
          width: 2.55rem; height: 2.55rem; border-radius: var(--dk-radius-sm);
          background:
            linear-gradient(145deg, rgba(255,255,255,0.1) 0%, transparent 50%),
            linear-gradient(165deg, rgba(31,168,138,0.35) 0%, rgba(20,135,112,0.15) 100%);
          color: var(--dk-brand-light);
          display: flex; align-items: center; justify-content: center;
          font-weight: 700; flex-shrink: 0; font-size: 0.95rem;
          border: 1px solid rgba(20,135,112,0.25);
          box-shadow: 0 4px 12px rgba(20,135,112,0.15), inset 0 1px 0 rgba(255,255,255,0.12);
          transition: transform var(--dk-dur) var(--dk-ease-spring), box-shadow var(--dk-dur) ease;
        }
        .dk-tile:hover .dk-avatar {
          transform: translateZ(12px) scale(1.05);
          box-shadow: 0 8px 20px rgba(20,135,112,0.25), inset 0 1px 0 rgba(255,255,255,0.15);
        }
        .dk-avatar--sm { width: 2rem; height: 2rem; font-size: 0.8rem; }
        .dk-tile__name { font-weight: 600; color: var(--dk-text); margin: 0; letter-spacing: -0.01em; }
        .dk-tile__meta { font-size: 0.82rem; color: var(--dk-text-muted); margin: 0.15rem 0 0; }
        .dk-tile__badges { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1.05rem; align-items: center; }
        .dk-tile__actions {
          position: absolute; top: 0.7rem; right: 0.7rem; z-index: 2;
          opacity: 0.55; transition: opacity var(--dk-dur-fast) ease, transform var(--dk-dur-fast) var(--dk-ease);
        }
        .dk-tile:hover .dk-tile__actions, .dk-tile:focus-within .dk-tile__actions { opacity: 1; }
        .dk-tile--clickable { cursor: pointer; }
        .dk-tile--clickable:focus-visible {
          outline: 2px solid rgba(20, 135, 112, 0.55);
          outline-offset: 2px;
        }

        /* ── Table ── */
        .dk-table-wrap {
          overflow: visible;
          animation: dk-fade-up 0.45s var(--dk-ease-out) both;
        }
        .dk-table { width: 100%; border-collapse: collapse; }
        .dk-table th {
          text-align: left; padding: 0.85rem 1.05rem;
          font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.07em;
          color: #9ca3af;
          background: rgba(12, 12, 20, 0.9);
          backdrop-filter: blur(12px);
          border-bottom: 1px solid var(--dk-border);
          position: sticky; top: 0; z-index: 1;
        }
        .dk-table td {
          padding: 0.85rem 1.05rem;
          border-bottom: 1px solid rgba(34, 34, 46, 0.75);
          vertical-align: middle;
          transition: background var(--dk-dur-fast) ease;
        }
        .dk-table tbody tr {
          transition: background var(--dk-dur-fast) var(--dk-ease), transform var(--dk-dur-fast) var(--dk-ease);
        }
        .dk-table tbody tr:hover {
          background: linear-gradient(90deg, rgba(20,135,112,0.06), rgba(255,255,255,0.02));
        }
        .dk-table tbody tr:last-child td { border-bottom: none; }
        .dk-table__row {
          animation: dk-fade-up 0.4s var(--dk-ease-out) both;
          animation-delay: calc(var(--dk-i, 0) * 28ms);
        }
        .dk-table__row--clickable { cursor: pointer; }
        .dk-table__row--clickable:focus-visible {
          outline: 2px solid rgba(20, 135, 112, 0.45);
          outline-offset: -2px;
        }
        .dk-table td.dk-table__actions { text-align: right; width: 3rem; white-space: nowrap; }
        /* Inline CRUD row-action button groups (View/Edit/Delete) rendered by
           CollectionView via the row_actions snippet. Override the compact
           context-menu defaults so the buttons form a proper inline group. */
        .dk-table td.dk-table__actions { width: 1%; padding-right: 0.85rem; }
        .dk-table__actions .btn-ghost { padding: 0.3rem 0.55rem; }
        .dk-table__actions > .btn-ghost + .btn-ghost { margin-left: 0.15rem; }
        .dk-tile__actions {
          position: static; opacity: 1; display: flex; gap: 0.25rem;
          justify-content: flex-end; margin-top: 0.6rem;
          padding-top: 0.6rem; border-top: 1px solid var(--dk-border-soft, var(--dk-border));
        }
        .dk-tile__actions .btn-ghost { padding: 0.3rem 0.55rem; }
        .dk-crud__danger { color: var(--dk-red, #ef4444); }
        .dk-crud__danger:hover { background: rgba(239, 68, 68, 0.12); }

        /* ── Detail / read-only field values ── */
        .dk-detail__value {
          margin: 0;
          padding: 0.65rem 0.85rem;
          min-height: 2.5rem;
          display: flex;
          align-items: center;
          border-radius: var(--dk-radius-sm, 0.5rem);
          background: rgba(12, 12, 20, 0.55);
          border: 1px solid rgba(34, 34, 46, 0.9);
          color: var(--dk-text, #e5e7eb);
          font-size: 0.925rem;
          word-break: break-word;
        }
        .dk-detail__value--muted { color: var(--dk-text-muted, #9ca3af); }
        .dk-detail__mono {
          font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
          font-size: 0.8rem;
        }
        .dk-detail__pre {
          margin: 0;
          padding: 0.75rem 0.85rem;
          border-radius: var(--dk-radius-sm, 0.5rem);
          background: rgba(12, 12, 20, 0.55);
          border: 1px solid rgba(34, 34, 46, 0.9);
          color: var(--dk-text-muted, #9ca3af);
          font-size: 0.8rem;
          white-space: pre-wrap;
          word-break: break-word;
          overflow-x: auto;
        }

        /* ── Loading / empty / error ── */
        .dk-loading {
          display: flex; align-items: center; justify-content: center; gap: 0.85rem;
          padding: 2.5rem; color: var(--dk-text-muted);
          animation: dk-fade-up 0.35s var(--dk-ease-out) both;
        }
        .dk-spinner {
          width: 1.35rem; height: 1.35rem;
          border: 2px solid rgba(20,135,112,0.2);
          border-top-color: var(--dk-brand-light);
          border-radius: 50%;
          animation: dk-spin 0.65s linear infinite;
          box-shadow: 0 0 12px rgba(20,135,112,0.25);
        }
        .dk-error {
          color: #f87171; margin: 0.5rem 0; padding: 0.75rem 1rem;
          border-radius: var(--dk-radius-sm);
          background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.2);
          animation: dk-fade-up 0.3s var(--dk-ease-out) both;
        }
        .dk-empty {
          text-align: center; padding: 3.25rem 1.5rem;
          animation: dk-fade-up 0.45s var(--dk-ease-out) both;
        }
        .dk-empty__icon {
          width: 4.25rem; height: 4.25rem; margin: 0 auto 1.15rem; border-radius: 1.1rem;
          background:
            linear-gradient(145deg, rgba(255,255,255,0.08), transparent),
            rgba(20,135,112,0.1);
          border: 1px solid rgba(20,135,112,0.25);
          color: var(--dk-brand-light);
          display: flex; align-items: center; justify-content: center;
          box-shadow: 0 12px 32px rgba(20,135,112,0.12), inset 0 1px 0 rgba(255,255,255,0.08);
          animation: dk-float 4s var(--dk-ease) infinite;
        }
        .dk-empty__title { font-size: 1.15rem; font-weight: 650; margin-bottom: 0.5rem; color: var(--dk-text); letter-spacing: -0.015em; }
        .dk-empty__desc { max-width: 24rem; margin: 0 auto 1.35rem; color: var(--dk-text-muted); }

        /* ── Modal / dialogs ── */
        /* Native <dialog> top-layer — escapes card overflow / transform */
        .dk-modal-dialog {
          position: fixed !important;
          inset: 0 !important;
          width: 100vw !important;
          max-width: none !important;
          height: 100vh !important;
          max-height: none !important;
          margin: 0 !important;
          padding: 1rem !important;
          border: none !important;
          background: transparent !important;
          color: inherit;
          display: flex !important;
          align-items: center;
          justify-content: center;
          z-index: 2147483000 !important;
          box-sizing: border-box;
          overflow: visible !important;
        }
        .dk-modal-dialog:not([open]) { display: none !important; }
        .dk-modal-dialog[open] { display: flex !important; }
        .dk-modal-dialog::backdrop {
          background: rgba(3, 3, 8, 0.72);
          backdrop-filter: blur(10px) saturate(1.2);
          -webkit-backdrop-filter: blur(10px) saturate(1.2);
        }
        .dk-modal__panel {
          position: relative;
          z-index: 1;
          width: 100%;
          max-height: min(90vh, 100%);
          display: flex;
          flex-direction: column;
          background:
            linear-gradient(165deg, rgba(255,255,255,0.04) 0%, transparent 40%),
            linear-gradient(165deg, var(--dk-surface) 0%, #0c0c14 100%);
          border: 1px solid var(--dk-glass-border);
          border-radius: var(--dk-radius-lg);
          box-shadow: var(--dk-shadow-lg), 0 0 0 1px rgba(20,135,112,0.08);
          animation: dk-modal-in 0.35s var(--dk-ease-out) both;
          transform-origin: center center;
        }
        .dk-modal__panel--sm { max-width: 24rem; }
        .dk-modal__panel--md { max-width: 28rem; }
        .dk-modal__panel--lg { max-width: 36rem; }
        .dk-modal__header {
          display: flex; align-items: center; justify-content: space-between;
          gap: 0.75rem; padding: 1.05rem 1.15rem;
          border-bottom: 1px solid var(--dk-border-soft);
        }
        .dk-modal__title { margin: 0; font-size: 1.08rem; font-weight: 650; color: var(--dk-text); letter-spacing: -0.015em; }
        .dk-modal__close { padding: 0.35rem !important; }
        .dk-modal__body { padding: 1.15rem; overflow-y: auto; flex: 1; }
        .dk-modal__footer {
          display: flex; justify-content: flex-end; gap: 0.6rem; flex-wrap: wrap;
          padding: 0.95rem 1.15rem;
          border-top: 1px solid var(--dk-border-soft);
          background: rgba(0,0,0,0.15);
        }
        .dk-dialog__message { margin: 0 0 0.5rem; color: var(--dk-text); line-height: 1.55; }
        .dk-dialog__input { margin-top: 0.5rem; }

        /* ── Context menu ── */
        .dk-ctx { position: relative; display: inline-flex; }
        .dk-ctx__trigger {
          display: inline-flex; align-items: center; justify-content: center;
          width: 2rem; height: 2rem; padding: 0;
          border: none; border-radius: var(--dk-radius-sm);
          background: transparent; color: var(--dk-text-muted);
          cursor: pointer; font-family: inherit;
          transition:
            background var(--dk-dur-fast) ease,
            color var(--dk-dur-fast) ease,
            transform var(--dk-dur-fast) var(--dk-ease-spring);
        }
        .dk-ctx__trigger:hover, .dk-ctx--open .dk-ctx__trigger {
          background: rgba(255, 255, 255, 0.07); color: var(--dk-text);
          transform: scale(1.06);
        }
        .dk-ctx__dots { font-size: 1.15rem; line-height: 1; font-weight: 700; }
        .dk-ctx__menu {
          position: absolute; top: calc(100% + 0.35rem); z-index: 10000;
          min-width: 10rem; padding: 0.35rem;
          background: var(--dk-glass);
          backdrop-filter: blur(16px) saturate(1.3);
          -webkit-backdrop-filter: blur(16px) saturate(1.3);
          border: 1px solid var(--dk-glass-border);
          border-radius: var(--dk-radius-sm);
          box-shadow: var(--dk-shadow-lg);
          animation: dk-menu-in 0.2s var(--dk-ease-out) both;
          transform-origin: top right;
        }
        .dk-ctx__menu--right { right: 0; }
        .dk-ctx__menu--left { left: 0; transform-origin: top left; }
        .dk-ctx__item {
          display: flex; align-items: center; gap: 0.5rem;
          width: 100%; padding: 0.55rem 0.8rem;
          border: none; background: transparent;
          color: var(--dk-text); font-size: 0.875rem; font-family: inherit;
          text-align: left; text-decoration: none; cursor: pointer;
          border-radius: 0.4rem;
          transition: background var(--dk-dur-fast) ease, transform var(--dk-dur-fast) ease;
        }
        .dk-ctx__item:hover:not(:disabled) {
          background: rgba(255, 255, 255, 0.07);
          transform: translateX(2px);
        }
        .dk-ctx__item:disabled { opacity: 0.45; cursor: not-allowed; }
        .dk-ctx__item--danger { color: #f87171; }
        .dk-ctx__item--danger:hover:not(:disabled) { background: rgba(239, 68, 68, 0.12); }

        /* ── Create form shell ── */
        /* Shared CRUD page chrome (form + detail) */
        .dk-page-shell {
          display: flex; flex-direction: column;
          min-height: calc(100vh - 3rem);
          margin: -1.5rem;
          animation: dk-fade-in var(--dk-dur-slow) var(--dk-ease-out) both;
        }
        .dk-page-shell__header {
          display: flex; align-items: center; justify-content: space-between; gap: 1rem;
          padding: 1.1rem 1.5rem;
          border-bottom: 1px solid var(--dk-border);
          background: rgba(12, 12, 20, 0.72);
          backdrop-filter: blur(16px);
          position: sticky; top: 0; z-index: 5;
        }
        .dk-page-shell__left { display: flex; align-items: center; gap: 0.75rem; min-width: 0; }
        .dk-page-shell__back { padding: 0.45rem !important; }
        .dk-page-shell__title { font-size: 1.2rem; font-weight: 700; margin: 0; color: var(--dk-text); letter-spacing: -0.02em; }
        .dk-page-shell__subtitle { font-size: 0.8rem; color: var(--dk-text-muted); margin: 0.12rem 0 0; }
        .dk-page-shell__header-actions {
          display: flex; align-items: center; gap: 0.65rem; flex-shrink: 0; flex-wrap: wrap; justify-content: flex-end;
        }
        .dk-page-shell__body { flex: 1; overflow-y: auto; padding: 1.75rem 1.5rem 2.5rem; display: flex; flex-direction: column; gap: 2rem; }
        .dk-page-shell__footer {
          margin-top: 1.5rem; padding-top: 1rem;
          border-top: 1px solid var(--dk-border, #e5e7eb);
        }
        .dk-detail-shell__summary { margin-bottom: 1.25rem; }
        .dk-detail-shell__layout {
          display: grid; gap: 1.25rem;
          grid-template-columns: minmax(0, 1fr);
        }
        @media (min-width: 960px) {
          .dk-detail-shell__layout {
            grid-template-columns: minmax(0, 1fr) minmax(14rem, 18rem);
            align-items: start;
          }
        }
        .dk-detail-shell__sidebar {
          padding: 1rem;
          border-radius: var(--dk-radius-sm, 0.5rem);
          border: 1px solid rgba(34, 34, 46, 0.9);
          background: rgba(12, 12, 20, 0.4);
        }
        .dk-detail-shell__children { display: flex; flex-direction: column; gap: 2rem; }
        .dk-detail-shell__children > .dk-form-section + .dk-form-section { margin-top: 0; }

        .dk-create-shell {
          display: flex; flex-direction: column;
          min-height: calc(100vh - 3rem); margin: -1.5rem;
          animation: dk-fade-in var(--dk-dur-slow) var(--dk-ease-out) both;
        }
        .dk-create-shell__header {
          position: sticky; top: 0; z-index: 20;
          display: flex; align-items: center; justify-content: space-between;
          gap: 1rem; flex-wrap: wrap; padding: 1rem 1.35rem;
          border-bottom: 1px solid var(--dk-border-soft);
          background: var(--dk-glass);
          backdrop-filter: blur(16px) saturate(1.2);
          -webkit-backdrop-filter: blur(16px) saturate(1.2);
          box-shadow: 0 8px 24px rgba(0,0,0,0.25);
        }
        .dk-create-shell__left { display: flex; align-items: center; gap: 0.75rem; min-width: 0; }
        .dk-create-shell__back { padding: 0.45rem !important; }
        .dk-create-shell__title { font-size: 1.2rem; font-weight: 700; margin: 0; color: var(--dk-text); letter-spacing: -0.02em; }
        .dk-create-shell__subtitle { font-size: 0.8rem; color: var(--dk-text-muted); margin: 0.12rem 0 0; }
        .dk-create-shell__body { flex: 1; overflow-y: auto; padding: 1.75rem 1.5rem 2.5rem; }
        .dk-create-shell__body form, form.dk-form {
          max-width: 42rem; margin: 0 auto;
          display: flex; flex-direction: column; gap: 2.1rem;
          animation: dk-fade-up 0.45s var(--dk-ease-out) 0.05s both;
        }
        .dk-form-progress { display: flex; align-items: center; gap: 1rem; }
        .dk-form-progress__meter { display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; color: var(--dk-text-muted); }
        .dk-form-progress__track {
          width: 8.5rem; height: 0.4rem;
          background: var(--dk-border); border-radius: 999px; overflow: hidden;
          box-shadow: inset 0 1px 2px rgba(0,0,0,0.35);
        }
        .dk-form-progress__fill {
          height: 100%; background: linear-gradient(90deg, var(--dk-amber), #f59e0b);
          border-radius: 999px;
          transition: width 0.5s var(--dk-ease), background 0.4s ease, box-shadow 0.3s ease;
        }
        .dk-form-progress__fill--ready {
          background: linear-gradient(90deg, #22c55e, #4ade80);
          box-shadow: 0 0 12px rgba(74, 222, 128, 0.4);
        }
        .dk-form-progress__ready { color: #4ade80; }
        .dk-form-progress__submit--ready:not(:disabled) {
          box-shadow: 0 0 0 2px rgba(74, 222, 128, 0.4), 0 4px 16px rgba(20,135,112,0.25);
        }
        .dk-form-section {
          display: flex; flex-direction: column; gap: 1rem;
          animation: dk-fade-up 0.4s var(--dk-ease-out) both;
        }
        .dk-form-section + .dk-form-section { margin-top: 0.75rem; }
        .dk-form-section:first-child .dk-form-section__title { border-top: none; padding-top: 0; }
        .dk-form-section:nth-child(2) { animation-delay: 0.06s; }
        .dk-form-section:nth-child(3) { animation-delay: 0.12s; }
        .dk-form-section__title {
          font-size: 0.72rem; font-weight: 650; text-transform: uppercase;
          letter-spacing: 0.08em; color: var(--dk-text-muted); margin: 0;
          padding-top: 0.5rem;
          border-top: 1px solid var(--dk-border-soft, rgba(42, 42, 56, 0.55));
        }
        .dk-form-section__grid { display: grid; gap: 1.25rem; }
        .dk-form-section__grid--1 { grid-template-columns: 1fr; }
        .dk-form-section__grid--2 { grid-template-columns: 1fr; }
        .dk-form-section__grid--3 { grid-template-columns: 1fr; }
        @media (min-width: 640px) {
          .dk-form-section__grid--2 { grid-template-columns: 1fr 1fr; }
          .dk-form-section__grid--3 { grid-template-columns: 1fr 1fr 1fr; }
        }
        .dk-field { display: flex; flex-direction: column; gap: 0.3rem; }
        .dk-field__label { display: flex; align-items: center; gap: 0.35rem; font-size: 0.875rem; font-weight: 500; color: #d1d5db; }
        .dk-field__req {
          font-size: 0.65rem; color: var(--dk-amber); line-height: 1;
          transition: color var(--dk-dur) ease, transform var(--dk-dur-fast) var(--dk-ease-spring), text-shadow var(--dk-dur) ease;
        }
        .dk-field__req--filled {
          color: var(--dk-green);
          text-shadow: 0 0 8px rgba(34, 197, 94, 0.5);
          transform: scale(1.15);
        }
        .dk-field__control { position: relative; }
        .dk-field__bar {
          position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
          border-radius: 3px 0 0 3px; background: transparent; z-index: 1; pointer-events: none;
          transition: background 0.25s ease, opacity 0.25s ease, box-shadow 0.25s ease;
        }
        .dk-field__bar--incomplete {
          background: var(--dk-amber); opacity: 0.85;
          box-shadow: 0 0 10px rgba(251, 191, 36, 0.35);
        }
        .dk-field__bar--filled {
          background: var(--dk-green); opacity: 0.95;
          box-shadow: 0 0 10px rgba(34, 197, 94, 0.4);
        }
        .dk-field__bar--error {
          background: var(--dk-red); opacity: 0.85;
          box-shadow: 0 0 10px rgba(239, 68, 68, 0.35);
        }
        .dk-field__hint { font-size: 0.75rem; color: var(--dk-text-muted); margin: 0; }
        .dk-field__error { font-size: 0.75rem; color: #f87171; margin: 0; }

        /* ── Keyframes ── */
        @keyframes dk-spin { to { transform: rotate(360deg); } }
        @keyframes dk-fade-in {
          from { opacity: 0; }
          to { opacity: 1; }
        }
        @keyframes dk-fade-up {
          from { opacity: 0; transform: translateY(10px); }
          to { opacity: 1; transform: translateY(0); }
        }
        @keyframes dk-page-in {
          from { opacity: 0; transform: translateY(8px); }
          to { opacity: 1; transform: translateY(0); }
        }
        @keyframes dk-modal-in {
          from { opacity: 0; transform: translateY(12px) scale(0.96); }
          to { opacity: 1; transform: translateY(0) scale(1); }
        }
        @keyframes dk-menu-in {
          from { opacity: 0; transform: translateY(-6px) scale(0.96); }
          to { opacity: 1; transform: translateY(0) scale(1); }
        }
        @keyframes dk-float {
          0%, 100% { transform: translateY(0); }
          50% { transform: translateY(-5px); }
        }

        /* ── Motion auto-apply for generated components ──────────────────
         * Codegen components use semantic class patterns (re-card, re-row, re-toast,
         * wz-*, etc.). These defaults ensure consistent entry animation + hover
         * micro-interactions without requiring each component to opt-in.
         *
         * Pattern: [prefix]-card, [prefix]-row, [prefix]-list > li, [prefix]-toast
         * Prefix examples: re- (rules), wt- (wear-test), dash- (dashboard)
         */
        [class*="-card"]:not([class*="__"]) {
          animation: dk-fade-up 0.4s var(--dk-ease-out) both;
          animation-delay: calc(var(--dk-i, 0) * 40ms);
        }
        [class*="-row"]:not([class*="__"]) {
          animation: dk-fade-up 0.32s var(--dk-ease-out) both;
          animation-delay: calc(var(--dk-i, 0) * 35ms);
        }
        [class*="-toast"] {
          animation: dk-fade-up 0.28s var(--dk-ease-out) both;
        }
        [class*="-wizard"] {
          animation: dk-modal-in 0.35s var(--dk-ease-out) both;
        }
        [class*="-empty"] {
          animation: dk-fade-up 0.35s var(--dk-ease-out) both;
        }
        /* Hover micro-interactions on interactive list rows */
        [class*="-row"]:not([class*="__"]) {
          transition:
            transform var(--dk-dur-fast) var(--dk-ease),
            box-shadow var(--dk-dur) var(--dk-ease),
            border-color var(--dk-dur-fast) var(--dk-ease);
        }
        [class*="-row"]:not([class*="__"]):hover {
          transform: translateY(-1px);
          box-shadow: 0 2px 12px rgba(0, 0, 0, 0.18);
          border-color: rgba(255, 255, 255, 0.08);
        }
        /* ── CrudResource (declarative CRUD composite) ── */
        .dk-crud { display: flex; flex-direction: column; gap: 1.1rem; }
        .dk-crud__rows { display: flex; flex-direction: column; gap: 0.4rem; }
        .dk-crud__row {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 0.75rem;
          padding: 0.55rem 0.85rem;
          border: 1px solid var(--dk-border, rgba(255, 255, 255, 0.08));
          border-radius: 0.6rem;
          background: var(--dk-surface, rgba(255, 255, 255, 0.02));
        }
        .dk-crud__row-label {
          font-size: 0.9rem;
          font-weight: 550;
          color: var(--dk-text, inherit);
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }
        .dk-crud__row-actions { display: flex; align-items: center; gap: 0.25rem; flex-shrink: 0; }
        .dk-crud__danger { color: var(--dk-danger, #ef4444); }

        /* Stagger helper: parent sets --dk-i per child index (template each blocks) */
        [class*="-list"] > * { --dk-i: 0; }
        [class*="-list"] > :nth-child(1) { --dk-i: 0; }
        [class*="-list"] > :nth-child(2) { --dk-i: 1; }
        [class*="-list"] > :nth-child(3) { --dk-i: 2; }
        [class*="-list"] > :nth-child(4) { --dk-i: 3; }
        [class*="-list"] > :nth-child(5) { --dk-i: 4; }
        [class*="-list"] > :nth-child(6) { --dk-i: 5; }
        [class*="-list"] > :nth-child(n+7) { --dk-i: 6; }

        /* ── Reduced motion ── */
        @media (prefers-reduced-motion: reduce) {
          *, *::before, *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
            scroll-behavior: auto !important;
          }
          .dk-tile:hover, .btn-primary:hover:not(:disabled), .btn-danger:hover:not(:disabled) {
            transform: none !important;
          }
          .dk-empty__icon { animation: none !important; }
        }

      """

  prompt
    designkit layer = IDE vocabulary. designkit.veil = stock Svelte components.
    Products: use designkit (hub resolves sibling project dlx-designkit).
    CollectionView viewMode tiles|list|both; snippets tile/row for any entity.
    CRUD page shells (generic; product fills slots — domain stays product-side):
      CollectionView  — list/grid (tile/row/header_actions, item_href_template)
      CreateFormShell — create|edit form (mode, children, header_actions, footer, loading)
      DetailShell     — read-only detail (header_actions, summary, children, sidebar, footer)
      DetailField     — read-only labeled value (value | pre | mono | children)
    FormField / FormSection / FormProgress — form building blocks inside CreateFormShell.
    ContextMenu = vertical ellipsis (⋮) row/tile actions (Edit, Delete, …).
    ConfirmDialog / AlertDialog / PromptDialog replace window.confirm/alert/prompt.
    Modal is the shared overlay base. Prefer ConfirmDialog(variant="danger") for delete.
    Prefer slots for product extension; use VEIL adapt when the stock shell itself must change.

    ## Agent surface (required on interactive comps)
    Every interactive stock component must emit:
      data-veil-role="<stable-role>"
      data-veil-agent='{"version":1,"role":"…","stock":{component,purpose,howTo,config}, "product"?:…, "runtime"?:…}'
    Stock describes the reusable control (config options + howTo).
    Product (optional prop `agent={{…}}`) binds entity/intent/actions/api —
      e.g. collection stock knows "primary CTA adds an item"; product says entity=WearTest.
    Mount <AgentSurface /> once per app (layout) so window.__veilAgentSurface is published.
    Schema: docs/AGENT_SURFACE.md · offline catalog: docs/agent-catalog.json
    Do NOT overload ARIA for agent metadata — use data-veil-* only.
    Author stock comps in main.veil only (VEIL source of truth). Never maintain a
    parallel src/components Svelte tree or reverse Svelte→VEIL build.
    Future comps: edit main.veil, pick role, document config, accept agent prop,
    put data-veil-* attrs on root, then veil gen.

    Do not put product domain types in this layer.
