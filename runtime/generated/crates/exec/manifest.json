{
  "context": "Exec",
  "crate": "exec",
  "deps": {
    "auth_service": {
      "provided_by": "runtime",
      "strategy": "bus",
      "trait": "AuthService"
    },
    "bus": {
      "provided_by": "runtime",
      "trait": "Bus"
    },
    "entity_repo": {
      "provided_by": "runtime",
      "trait": "EntityRepo"
    },
    "handler": {
      "trait": "Handler"
    },
    "handler_factory": {
      "trait": "HandlerFactory"
    },
    "saga_step": {
      "provided_by": "runtime",
      "trait": "SagaStep"
    }
  },
  "expose": [],
  "handlers": {
    "LoadEnvConfig": {
      "function": "load_env_config",
      "inputs": [
        {
          "name": "manifests",
          "type": "List(Named(\"Manifest\"))"
        }
      ]
    },
    "ParseManifest": {
      "function": "parse_manifest",
      "inputs": [
        {
          "name": "json",
          "type": "Named(\"Str\")"
        }
      ]
    },
    "ReadAllManifests": {
      "function": "read_all_manifests",
      "inputs": [
        {
          "name": "workspace_dir",
          "type": "Named(\"Str\")"
        }
      ]
    },
    "RunSecurityScan": {
      "function": "run_security_scan",
      "inputs": [
        {
          "name": "workspace_dir",
          "type": "Named(\"Str\")"
        },
        {
          "name": "config",
          "type": "Named(\"ScanConfig\")"
        }
      ]
    },
    "StartHarness": {
      "function": "start_harness",
      "inputs": [
        {
          "name": "port",
          "type": "Named(\"Int\")"
        }
      ]
    },
    "WireApplication": {
      "function": "wire_application",
      "inputs": [
        {
          "name": "manifests",
          "type": "List(Named(\"Manifest\"))"
        },
        {
          "name": "env",
          "type": "Named(\"EnvConfig\")"
        }
      ]
    }
  }
}