{
  "context": "Tools",
  "crate": "tools",
  "deps": {
    "auth_service": {
      "provided_by": "runtime",
      "strategy": "bus",
      "trait": "AuthService"
    },
    "bus": {
      "provided_by": "runtime",
      "trait": "Bus"
    },
    "entity_repo": {
      "provided_by": "runtime",
      "trait": "EntityRepo"
    },
    "saga_step": {
      "provided_by": "runtime",
      "trait": "SagaStep"
    }
  },
  "expose": [],
  "handlers": {
    "CompileTool": {
      "function": "compile_tool",
      "inputs": [
        {
          "name": "repo_id",
          "type": "Named(\"Str\")"
        },
        {
          "name": "branch",
          "type": "Named(\"Str\")"
        },
        {
          "name": "target",
          "type": "Named(\"Str\")"
        }
      ]
    },
    "CreateBranchTool": {
      "function": "create_branch_tool",
      "inputs": [
        {
          "name": "repo_id",
          "type": "Named(\"Str\")"
        },
        {
          "name": "name",
          "type": "Named(\"Str\")"
        },
        {
          "name": "from_ref",
          "type": "Named(\"Str\")"
        }
      ]
    },
    "CreateRepoTool": {
      "function": "create_repo_tool",
      "inputs": [
        {
          "name": "name",
          "type": "Named(\"Str\")"
        },
        {
          "name": "description",
          "type": "Optional(Named(\"Str\"))"
        }
      ]
    },
    "DeployTool": {
      "function": "deploy_tool",
      "inputs": [
        {
          "name": "artifact_id",
          "type": "Named(\"Str\")"
        },
        {
          "name": "target",
          "type": "Named(\"Str\")"
        },
        {
          "name": "tag",
          "type": "Optional(Named(\"Str\"))"
        }
      ]
    },
    "DiffTool": {
      "function": "diff_tool",
      "inputs": [
        {
          "name": "repo_id",
          "type": "Named(\"Str\")"
        },
        {
          "name": "from_ref",
          "type": "Named(\"Str\")"
        },
        {
          "name": "to_ref",
          "type": "Named(\"Str\")"
        }
      ]
    },
    "ListBranchesTool": {
      "function": "list_branches_tool",
      "inputs": [
        {
          "name": "repo_id",
          "type": "Named(\"Str\")"
        }
      ]
    },
    "ListFilesTool": {
      "function": "list_files_tool",
      "inputs": [
        {
          "name": "repo_id",
          "type": "Named(\"Str\")"
        },
        {
          "name": "branch",
          "type": "Named(\"Str\")"
        },
        {
          "name": "prefix",
          "type": "Optional(Named(\"Str\"))"
        }
      ]
    },
    "ListReposTool": {
      "function": "list_repos_tool",
      "inputs": []
    },
    "LogTool": {
      "function": "log_tool",
      "inputs": [
        {
          "name": "repo_id",
          "type": "Named(\"Str\")"
        },
        {
          "name": "branch",
          "type": "Optional(Named(\"Str\"))"
        },
        {
          "name": "limit",
          "type": "Optional(Named(\"Int\"))"
        }
      ]
    },
    "ProposeReactionGraphTool": {
      "function": "propose_reaction_graph_tool",
      "inputs": [
        {
          "name": "node_kinds",
          "type": "List(Named(\"Str\"))"
        }
      ]
    },
    "ReadFileTool": {
      "function": "read_file_tool",
      "inputs": [
        {
          "name": "repo_id",
          "type": "Named(\"Str\")"
        },
        {
          "name": "branch",
          "type": "Named(\"Str\")"
        },
        {
          "name": "path",
          "type": "Named(\"Str\")"
        }
      ]
    },
    "ValidateReactionPaletteTool": {
      "function": "validate_reaction_palette_tool",
      "inputs": [
        {
          "name": "node_kinds",
          "type": "List(Named(\"Str\"))"
        }
      ]
    },
    "WriteFileTool": {
      "function": "write_file_tool",
      "inputs": [
        {
          "name": "repo_id",
          "type": "Named(\"Str\")"
        },
        {
          "name": "branch",
          "type": "Named(\"Str\")"
        },
        {
          "name": "path",
          "type": "Named(\"Str\")"
        },
        {
          "name": "content",
          "type": "Named(\"Str\")"
        },
        {
          "name": "message",
          "type": "Named(\"Str\")"
        }
      ]
    }
  }
}