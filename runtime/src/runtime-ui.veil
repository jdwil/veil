# veil-runtime platform shell UI
#
# Stock chrome via designkit (adapt → CollectionView, PageHeader, FormField, …).
# Gen: from repo root —
#   veil gen runtime/src/runtime-ui.veil -o runtime/ui -t typescript
#   (or dual-loop via runtime/veil.toml target)

pkg VeilRuntimeUI
  use designkit
  adapt designkit

  app RuntimeUI
    @proxy("/api", "http://127.0.0.1:3000")

    group stores
      store ConnectionStore
        state
          status: Str
          url: Str

    group components
      comp Sidebar
        state
          open_cr_count: Int
        effect load_open_count
          open_cr_count = 0
          mut resp = ApiClient.fetch("/api/change_requests?status=ReadyForReview")
          open_cr_count = resp.length
        template """
          <aside class="sidebar">
            <div class="logo"><span>◆</span> veil-runtime</div>
            <nav>
              <a href="/dashboard">Dashboard</a>
              <a href="/projects">Projects</a>
              <a href="/changes" class="nav-badge-link">
                Changes
                {#if open_cr_count > 0}
                  <span class="nav-badge">{open_cr_count}</span>
                {/if}
              </a>
              <a href="/deploy">Deploy</a>
              <a href="/registry">Registry</a>
              <a href="/bus">Bus</a>
              <a href="/agents">Agents</a>
              <a href="/config">Config</a>
            </nav>
          </aside>
        """
        style """
          .sidebar {
            width: 240px;
            flex-shrink: 0;
            height: 100%;
            background: var(--dk-glass, var(--surface));
            backdrop-filter: blur(16px) saturate(1.15);
            -webkit-backdrop-filter: blur(16px) saturate(1.15);
            border-right: 1px solid var(--dk-border-soft, var(--border));
            display: flex;
            flex-direction: column;
            padding: 20px 0;
            overflow-y: auto;
            animation: dk-fade-in var(--dk-dur-slow, 420ms) var(--dk-ease-out, ease) both;
          }
          .sidebar .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 20px 28px;
            font-weight: 700;
            font-size: 1.05rem;
            color: var(--text);
            letter-spacing: -0.02em;
          }
          .sidebar .logo span { color: var(--accent); }
          .sidebar nav { display: flex; flex-direction: column; gap: 2px; }
          .sidebar nav a {
            display: block;
            padding: 10px 20px;
            text-decoration: none;
            color: var(--text-dim);
            font-size: 14px;
            border-left: 2px solid transparent;
            transition:
              color var(--dk-dur-fast, 140ms) var(--dk-ease, ease),
              background var(--dk-dur-fast, 140ms) var(--dk-ease, ease),
              border-color var(--dk-dur-fast, 140ms) ease;
          }
          .sidebar nav a:hover {
            color: var(--accent);
            background: color-mix(in srgb, var(--accent) 10%, transparent);
          }
          .sidebar nav a:global([aria-current="page"]) {
            color: var(--accent);
            background: color-mix(in srgb, var(--accent) 12%, transparent);
            border-left-color: var(--accent);
            font-weight: 600;
          }
          .nav-badge-link {
            display: flex !important;
            align-items: center;
            justify-content: space-between;
          }
          .nav-badge {
            font-size: 0.65rem;
            font-weight: 700;
            min-width: 1.15rem;
            height: 1.15rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            background: var(--accent);
            color: #fff;
            padding: 0 0.3rem;
            line-height: 1;
            animation: dk-fade-in 0.3s var(--dk-ease-out, ease) both;
          }
        """

      comp StatusBar
        props
          status: Str
        template """
          <footer class="status-bar">
            <div class="left"><span class="dot"></span><span>{status}</span></div>
            <span class="version">veil-runtime v0.1.0</span>
          </footer>
        """
        style """
          .status-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 8px 16px;
            border-top: 1px solid var(--dk-border-soft, var(--border));
            background: var(--dk-glass, var(--surface));
            backdrop-filter: blur(12px);
            font-size: 11px;
            color: var(--text-dim);
            flex-shrink: 0;
          }
          .left { display: flex; align-items: center; gap: 8px; }
          .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--dk-green, #22c55e);
            box-shadow: 0 0 8px color-mix(in srgb, var(--dk-green, #22c55e) 55%, transparent);
            flex-shrink: 0;
          }
          .version { color: var(--text-dim); }
        """

      comp StatCard
        props
          value: Str
          label: Str
        template """
          <div class="stat-card card"><span class="value">{value}</span><span class="label">{label}</span></div>
        """
        style """
          .stat-card {
            padding: 1.15rem 1.2rem;
            display: flex;
            flex-direction: column;
            gap: 4px;
            animation: dk-fade-up 0.45s var(--dk-ease-out, ease) both;
          }
          .value { font-size: 1.75rem; font-weight: 700; color: var(--accent); letter-spacing: -0.02em; }
          .label { font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.06em; }
        """

      comp DashboardView
        state
          repos: List<Json>
          loading: Bool
          error: Str
          # Literal template for CollectionView (avoid Svelte mustache in static attrs)
          project_href_tpl: Str = "/projects/{id}"
        effect load_on_mount
          loading = true
          error = ""
          repos = ApiClient.fetch("/api/repos")
          loading = false
        template """
          <div class="dashboard">
            <PageHeader title="Dashboard" description="Runtime overview" />
            <div class="stats">
              {#each [{v: String(repos.length), l: "Projects"}, {v: "—", l: "Deploys"}, {v: "—", l: "Layers"}, {v: "—", l: "Artifacts"}] as s}
                <StatCard value={s.v} label={s.l} />
              {/each}
            </div>
            <CollectionView
              title="Recent projects"
              description="Jump into a repository managed by this runtime."
              items={repos}
              loading={loading}
              error={error}
              view_mode="both"
              default_layout="tiles"
              layout_storage_key="veil_runtime.dashboard.projects.layout"
              item_href_template={project_href_tpl}
              empty_title="No projects yet"
              empty_description="Create a project from the Projects page."
              empty_action_href="/projects/new"
              empty_action_label="Create project"
              primary_href="/projects/new"
              primary_label="Create"
              columns={[
                { key: 'name', label: 'Name', cell: 'identity', showAvatar: true, subtitleKey: 'default_branch' },
                { key: 'default_branch', label: 'Branch' },
                { key: 'updated_at', label: 'Updated' },
                { key: 'slug', label: 'Slug' },
              ]}
              agent={{
                intent: 'dashboard-projects',
                entity: 'Repo',
                entityLabel: 'Project',
                actions: [
                  { id: 'list', label: 'All projects', href: '/projects', method: 'navigate' },
                  { id: 'create', label: 'Create', href: '/projects/new', method: 'navigate' },
                  { id: 'view', label: 'Open', hrefTemplate: '/projects/{id}', via: 'item-click', method: 'navigate' },
                ],
                api: { list: 'GET /api/repos', get: 'GET /api/repos/{id}' },
              }}
            />
          </div>
        """
        style """
          .dashboard { max-width: 1120px; animation: dk-fade-in var(--dk-dur-slow, 420ms) var(--dk-ease-out, ease) both; }
          .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 2rem; }
          @media (max-width: 900px) { .stats { grid-template-columns: repeat(2, 1fr); } }
        """

      comp ProjectsView
        state
          repos: List<Json>
          loading: Bool
          error: Str
          project_href_tpl: Str = "/projects/{id}"
          delete_open: Bool
          deleting_id: Str
          delete_name: Str
          delete_busy: Bool
        effect load_on_mount
          loading = true
          error = ""
          repos = ApiClient.fetch("/api/repos")
          loading = false
        effect do_delete
          if deleting_id != ""
            if delete_busy == true
              error = ""
              ApiClient.delete(f"/api/repos/{deleting_id}")
              repos = ApiClient.fetch("/api/repos")
              deleting_id = ""
              delete_name = ""
              delete_busy = false
              delete_open = false
        template """
          <div class="projects">
            <CollectionView
              title="Projects"
              description="Repositories managed by veil-runtime"
              items={repos}
              loading={loading}
              error={error}
              view_mode="both"
              default_layout="list"
              layout_storage_key="veil_runtime.projects.layout"
              show_avatar={true}
              primary_href="/projects/new"
              primary_label="Create"
              empty_title="No projects yet"
              empty_description="Create a project to get started with veil-runtime."
              empty_action_href="/projects/new"
              empty_action_label="Create your first project"
              item_href_template={project_href_tpl}
              columns={[
                { key: 'name', label: 'Name', cell: 'identity', showAvatar: true, subtitleKey: 'default_branch' },
                { key: 'default_branch', label: 'Branch' },
                { key: 'updated_at', label: 'Updated' },
                { key: 'slug', label: 'Slug' },
                { key: '_actions', label: '' },
              ]}
              agent={{
                intent: 'list-projects',
                entity: 'Repo',
                entityLabel: 'Project',
                notes: [
                  'Primary CTA and empty-state CTA open /projects/new.',
                  'Click card or row → /projects/{id}.',
                  'Row ⋮ menu: View or Delete (confirm).',
                ],
                actions: [
                  { id: 'create', label: 'Create', href: '/projects/new', via: 'primary', method: 'navigate' },
                  { id: 'view', label: 'View', hrefTemplate: '/projects/{id}', via: 'item-click', method: 'navigate' },
                  { id: 'delete', label: 'Delete', via: 'context-menu', confirm: true, method: 'api' },
                ],
                api: {
                  list: 'GET /api/repos',
                  get: 'GET /api/repos/{id}',
                  create: 'POST /api/repos',
                  delete: 'DELETE /api/repos/{id}',
                },
              }}
            >
              {#snippet tile(item)}
                {@const repo = /** @type {Record<string, unknown>} */ (item)}
                {@const rid = repo?.id != null && typeof repo.id === 'object' && repo.id.value != null ? String(repo.id.value) : String(repo?.id ?? repo?.slug ?? '')}
                <div class="dk-tile__actions">
                  <ContextMenu
                    agent={{
                      intent: 'project-row-actions',
                      entity: 'Repo',
                      entityLabel: 'Project',
                      itemId: rid,
                      actions: [
                        { id: 'view', label: 'View', href: `/projects/${rid}` },
                        { id: 'delete', label: 'Delete', confirm: true },
                      ],
                    }}
                    items={[
                      { label: 'View', href: `/projects/${rid}` },
                      {
                        label: 'Delete',
                        danger: true,
                        onSelect: () => {
                          deleting_id = rid;
                          delete_name = String(repo?.name ?? rid);
                          delete_open = true;
                        },
                      },
                    ]}
                  />
                </div>
                <div class="dk-tile__row">
                  <EntityIdentity
                    name={String(repo?.name ?? '—')}
                    subtitle={String(repo?.default_branch ?? 'main') + (repo?.slug ? ` · ${repo.slug}` : '')}
                    show_avatar={true}
                  />
                </div>
              {/snippet}
              {#snippet row(item)}
                {@const repo = /** @type {Record<string, unknown>} */ (item)}
                {@const rid = repo?.id != null && typeof repo.id === 'object' && repo.id.value != null ? String(repo.id.value) : String(repo?.id ?? repo?.slug ?? '')}
                <td>
                  <EntityIdentity name={String(repo?.name ?? '—')} show_avatar={true} size="sm" />
                </td>
                <td><span class="dk-tile__meta">{repo?.default_branch ? String(repo.default_branch) : 'main'}</span></td>
                <td><span class="dk-tile__meta">{repo?.updated_at ? String(repo.updated_at).slice(0, 10) : '—'}</span></td>
                <td><span class="dk-tile__meta">{repo?.slug ? String(repo.slug) : '—'}</span></td>
                <td class="dk-table__actions">
                  <ContextMenu
                    agent={{
                      intent: 'project-row-actions',
                      entity: 'Repo',
                      entityLabel: 'Project',
                      itemId: rid,
                      actions: [
                        { id: 'view', label: 'View', href: `/projects/${rid}` },
                        { id: 'delete', label: 'Delete', confirm: true },
                      ],
                    }}
                    items={[
                      { label: 'View', href: `/projects/${rid}` },
                      {
                        label: 'Delete',
                        danger: true,
                        onSelect: () => {
                          deleting_id = rid;
                          delete_name = String(repo?.name ?? rid);
                          delete_open = true;
                        },
                      },
                    ]}
                  />
                </td>
              {/snippet}
            </CollectionView>

            <ConfirmDialog
              bind:open={delete_open}
              title="Delete project"
              message={`Are you sure you want to delete “${delete_name}”? This cannot be undone.`}
              confirm_label="Delete"
              cancel_label="Cancel"
              variant="danger"
              on_confirm={() => { delete_busy = true; }}
            />
          </div>
        """
        style """
          .projects { max-width: 1120px; }
        """

      comp ProjectCreateView
        state
          name: Str
          description: Str
          submitting: Bool
          error: Str
        effect submit
          if submitting == true
            error = ""
            ApiClient.mutate("/api/repos", {name: name, description: description})
            submitting = false
            goto("/projects")
        template """
          <CreateFormShell
            title="Create project"
            subtitle="New repository on this runtime"
            back_href="/projects"
            mode="create"
            submit_label="Create"
            saving_label="Creating…"
            saving={submitting}
            required_values={[name]}
            on_submit={() => { submitting = true; }}
            error={error}
            agent={{
              intent: 'create-project',
              entity: 'Repo',
              entityLabel: 'Project',
              notes: [
                'Required: name. Optional: description.',
                'On submit: POST /api/repos then navigate to /projects.',
              ],
              api: { create: 'POST /api/repos' },
            }}
          >
            <FormSection title="Basics" columns={1}>
              <FormField label="Name" bind:value={name} required={true} placeholder="My project" />
              <FormField label="Description" bind:value={description} input_type="textarea" placeholder="Optional" />
            </FormSection>
          </CreateFormShell>
        """

      comp ProjectDetailView
        state
          id: Str
          name: Str
          slug: Str
          description: Str
          default_branch: Str
          created_at: Str
          updated_at: Str
          loading: Bool
          error: Str
          loaded: Bool
          delete_open: Bool
          delete_busy: Bool
          environment: Str
          env_options: List<Str>
          env_role_hint: Str
          infra: Json
          units: List<Json>
          has_deploy: Bool
          has_toml: Bool
          region: Str
          project_prefix: Str
          network_vpc: Str
          toml_path: Str
          provision_busy: Bool
          provision_msg: Str
          provision_job_id: Str
          provision_percent: Int
          provision_status: Str
          provision_steps: List<Json>
          plan_open: Bool
          plan_loading: Bool
          plan_summary: Str
          plan_mock: Bool
          plan_resources: List<Json>
          plan_steps: List<Json>
          plan_notes: List<Str>
          plan_diff: Json
          plan_cta: Str
          aws_inventory: List<Json>
          stack_base: Str
          provision_cta: Str
          any_provisioned: Bool
          infra_status: Str
          infra_status_variant: Str
        effect init
          error = ""
          loading = true
          loaded = false
          environment = "dev"
          env_options = ["dev", "staging", "prod"]
          env_role_hint = ""
          name = ""
          slug = ""
          description = ""
          default_branch = ""
          created_at = ""
          updated_at = ""
          has_deploy = false
          has_toml = false
          region = ""
          project_prefix = ""
          network_vpc = ""
          toml_path = ""
          provision_msg = ""
          provision_job_id = ""
          provision_percent = 0
          provision_status = ""
          provision_steps = []
          plan_open = false
          plan_loading = false
          plan_summary = ""
          plan_mock = false
          plan_resources = []
          plan_steps = []
          plan_notes = []
          plan_diff = {}
          plan_cta = "Confirm & provision"
          aws_inventory = []
          stack_base = ""
          provision_cta = "Provision"
          any_provisioned = false
          infra_status = "not provisioned"
          infra_status_variant = "warning"
          units = []
          infra = {}
          id = project_id_from_path()
        effect load_existing
          if id != ""
            if loaded == false
              error = ""
              loading = true
              mut repo = ApiClient.fetch(f"/api/repos/{id}", {})
              name = field_str(repo, "name")
              slug = field_str(repo, "slug")
              description = field_str(repo, "description")
              default_branch = field_str(repo, "default_branch")
              if default_branch == ""
                default_branch = "main"
              created_at = field_str(repo, "created_at")
              updated_at = field_str(repo, "updated_at")
              mut catalog = ApiClient.fetch("/api/deploy_environments", {})
              apply_env_catalog(catalog)
              mut wrap = ApiClient.fetch(f"/api/project_infras/{id}", {environment: environment})
              await hydrate_from_infra(wrap)
              loading = false
              loaded = true
        effect do_delete
          if delete_busy == true
            if id != ""
              ApiClient.delete(f"/api/repos/{id}")
              delete_busy = false
              delete_open = false
              goto("/projects")
        effect do_provision
          if provision_busy == true
            if slug != ""
              run_provision()
        fn select_environment(next: Str)
          if next != ""
            if next != environment
              environment = next
              provision_msg = ""
              loaded = false
        fn load_provision_plan()
          plan_loading = true
          plan_open = true
          plan_summary = ""
          plan_resources = []
          plan_steps = []
          plan_notes = []
          plan_diff = {}
          plan_mock = false
          error = ""
          mut plan = ApiClient.mutate("/api/plan-provision", {project_slug: slug, environment: environment, repo_id: id, branch: default_branch})
          apply_plan(plan)
          plan_loading = false
        # Helpers only: browser path, Json shaping, job poll with delay.
        # Orchestration (load / plan / env switch) is Veil effect/fn above.
        script """
          function project_id_from_path(): string {
            if (typeof window === 'undefined') return '';
            const p = window.location.pathname;
            const t = p.endsWith('/') ? p.slice(0, -1) : p;
            const parts = t.split('/').filter(Boolean);
            const i = parts.indexOf('projects');
            if (i >= 0 && parts[i + 1] && parts[i + 1] !== 'new') return parts[i + 1];
            return '';
          }
          function field_str(obj: any, key: string): string {
            const v = obj?.[key];
            return v == null ? '' : String(v);
          }
          function classify_unit_state(state: any): { provisioned: boolean; label: string; kind: string } {
            if (!state) return { provisioned: false, label: 'not provisioned', kind: 'none' };
            const arn = state?.aws_resources?.lambda_arn != null ? String(state.aws_resources.lambda_arn) : '';
            if (!arn) return { provisioned: false, label: 'incomplete', kind: 'partial' };
            if (arn.includes(':mock:') || arn.includes('lambda:mock') || arn.startsWith('arn:aws:lambda:mock')) {
              return { provisioned: false, label: 'mock only', kind: 'mock' };
            }
            const st = state?.status != null ? String(state.status) : 'Active';
            return { provisioned: true, label: st, kind: 'ok' };
          }
          function overall_infra_status(rows: any[]): { label: string; variant: string } {
            if (!rows.length) return { label: `${environment}: no units`, variant: 'warning' };
            const kinds = rows.map((r) => r.kind || 'none');
            if (kinds.every((k) => k === 'ok')) return { label: `${environment}: infra provisioned`, variant: 'success' };
            if (kinds.every((k) => k === 'none')) return { label: `${environment}: not provisioned`, variant: 'warning' };
            if (kinds.some((k) => k === 'mock')) return { label: `${environment}: mock state only`, variant: 'warning' };
            return { label: `${environment}: partial / incomplete`, variant: 'warning' };
          }
          function build_aws_inventory(snap: any, unitRows: any[]): any[] {
            const names = snap?.stack?.names || {};
            const rows: any[] = [];
            const seen = new Set<string>();
            const add = (kind: string, name: string, detail: string, status: string, ref: string) => {
              if (!name || seen.has(`${kind}:${name}`)) return;
              seen.add(`${kind}:${name}`);
              rows.push({ kind, name, detail: detail || '', status: status || 'declared', ref: ref || '' });
            };
            add('DynamoDB', names.dynamodb || '', 'Shared table (PK/SK)', 'stack', '');
            add('SNS', names.sns || '', 'Event topic', 'stack', '');
            add('SQS', names.sqs || '', 'Main queue', 'stack', '');
            add('SQS DLQ', names.sqs_dlq || '', 'Dead-letter queue', 'stack', '');
            for (const u of unitRows) {
              const aws = u.aws || {};
              const ty = String(u.type || '');
              let fn = '';
              if (ty === 'lambda-api') fn = names.lambda_api || '';
              else if (ty === 'lambda-consumer') fn = names.lambda_consumer || '';
              if (!fn && aws.lambda_arn) {
                const m = String(aws.lambda_arn).match(/function:([^:]+)/);
                if (m) fn = m[1];
              }
              if (!fn) fn = `veil-${snap?.service || 'app'}-${u.name}`;
              const st = u.provisioned ? (u.status || 'Active') : 'not provisioned';
              add('Lambda', fn, `${u.name} · ${ty}`, st, aws.lambda_arn || '');
              if (aws.log_group) add('CloudWatch', aws.log_group, `Logs · ${u.name}`, u.provisioned ? 'Active' : 'pending', '');
              if (aws.role_arn) {
                const role = String(aws.role_arn).split('/').pop() || aws.role_arn;
                add('IAM Role', role, `Execution role · ${u.name}`, u.provisioned ? 'attached' : 'pending', aws.role_arn);
              }
              if (ty === 'lambda-api') {
                const gw = u.gateway && u.gateway !== '—' ? String(u.gateway) : 'dashlx-services';
                const path = u.path_prefix && u.path_prefix !== '—' ? String(u.path_prefix) : '/';
                add('API Gateway', gw, `HTTP API attach · path ${path}`, aws.api_gw_id ? `id ${aws.api_gw_id}` : 'fuzzy match on provision', aws.api_gw_id || '');
              }
              if (ty === 'lambda-consumer' && (aws.sqs_queue_url || names.sqs)) {
                add('Event source', fn + ' ← ' + (names.sqs || 'queue'), 'SQS → Lambda mapping', u.provisioned ? 'Active' : 'pending', aws.sqs_queue_arn || '');
              }
              if (aws.sqs_queue_url) {
                const qn = String(aws.sqs_queue_url).split('/').pop() || '';
                if (qn) add('SQS', qn, `Queue (from ${u.name} state)`, 'Active', aws.sqs_queue_url);
              }
            }
            return rows;
          }
          function provision_button_label(): string {
            if (provision_busy) return `Provisioning… ${provision_percent}%`;
            if (plan_loading) return 'Loading plan…';
            if (plan_open) return plan_cta || `Confirm (${environment})`;
            if (any_provisioned) return `Reconcile (${environment})`;
            return `Provision (${environment})`;
          }
          function apply_env_catalog(catalog: any) {
            const list = Array.isArray(catalog?.environments) ? catalog.environments : [];
            if (!list.length) return;
            env_options = list.map((e: any) => String(e.name));
            if (!environment || !env_options.includes(environment)) {
              environment = catalog?.default != null ? String(catalog.default) : env_options[0];
            }
            const cur = list.find((e: any) => e.name === environment);
            if (cur?.has_assume_role) {
              env_role_hint = cur.assume_role_arn != null ? String(cur.assume_role_arn) : 'cross-account role configured';
            } else {
              env_role_hint = 'same-account credentials (no assume_role_arn)';
            }
          }
          /** Load per-unit deploy state + build inventory (uses GET deployment_status). */
          async function hydrate_from_infra(wrap: any) {
            const snap = wrap?.infra ?? wrap ?? {};
            infra = snap;
            has_toml = !!snap.has_toml;
            has_deploy = !!snap.has_deploy;
            region = field_str(snap, 'region');
            project_prefix = field_str(snap, 'project_prefix');
            toml_path = field_str(snap, 'toml_path');
            network_vpc = snap?.network?.vpc != null ? String(snap.network.vpc) : '';
            stack_base = snap?.stack?.base != null
              ? String(snap.stack.base)
              : (snap?.stack?.names?.base != null ? String(snap.stack.names.base) : '');
            const rawUnits = Array.isArray(snap.units) ? snap.units : [];
            const unit_rows = [];
            for (const u of rawUnits) {
              const uname = u?.name != null ? String(u.name) : '';
              let st: any = null;
              if (uname) {
                try {
                  const stRes = await fetch(
                    `/api/deployment_status?environment=${encodeURIComponent(environment)}&unit_name=${encodeURIComponent(uname)}`
                  );
                  if (stRes.ok) {
                    const body = await stRes.json();
                    st = body?.state ?? null;
                  }
                } catch (_) { /* not provisioned */ }
              }
              const classified = classify_unit_state(st);
              const aws = st?.aws_resources || {};
              unit_rows.push({
                name: uname,
                type: u?.type != null ? String(u.type) : '—',
                context: u?.context != null ? String(u.context) : '—',
                description: u?.description != null ? String(u.description) : '',
                memory_mb:
                  u?.lambda?.memory_mb != null
                    ? String(u.lambda.memory_mb)
                    : u?.ecs?.memory_mb != null
                      ? String(u.ecs.memory_mb)
                      : '—',
                timeout: u?.lambda?.timeout_seconds != null ? String(u.lambda.timeout_seconds) : '—',
                arch: u?.lambda?.architecture != null ? String(u.lambda.architecture) : '—',
                path_prefix: u?.api_gateway?.path_prefix != null ? String(u.api_gateway.path_prefix) : '—',
                gateway: u?.api_gateway?.gateway != null ? String(u.api_gateway.gateway) : '—',
                provisioned: classified.provisioned,
                status: classified.label,
                kind: classified.kind,
                version: st?.version != null ? String(st.version) : '',
                aws,
                lambda_arn: aws?.lambda_arn != null ? String(aws.lambda_arn) : '',
              });
            }
            units = unit_rows;
            any_provisioned = unit_rows.some((r) => r.provisioned);
            provision_cta = any_provisioned ? 'Reconcile' : 'Provision';
            aws_inventory = build_aws_inventory(snap, unit_rows);
            const overall = overall_infra_status(unit_rows);
            infra_status = overall.label;
            infra_status_variant = overall.variant;
          }
          function apply_job_snapshot(job: any) {
            provision_job_id = job?.job_id != null ? String(job.job_id) : provision_job_id;
            provision_status = job?.status != null ? String(job.status) : '';
            provision_percent = job?.percent != null ? Number(job.percent) : 0;
            provision_msg = job?.summary != null ? String(job.summary) : '';
            provision_steps = Array.isArray(job?.steps) ? job.steps : [];
            if (job?.error) error = String(job.error);
          }
          function apply_plan(plan: any) {
            plan_summary = plan?.summary != null ? String(plan.summary) : 'Review plan below.';
            plan_mock = !!plan?.mock_mode;
            plan_resources = Array.isArray(plan?.resources) ? plan.resources : [];
            plan_steps = Array.isArray(plan?.steps) ? plan.steps : [];
            plan_notes = Array.isArray(plan?.notes) ? plan.notes.map((n: any) => String(n)) : [];
            plan_diff = plan?.diff && typeof plan.diff === 'object' ? plan.diff : {};
            const c = Number(plan_diff?.create || 0);
            const u = Number(plan_diff?.update || 0);
            if (c === 0 && u === 0) plan_cta = 'All synced ✓';
            else if (c > 0) plan_cta = 'Confirm & provision';
            else if (u > 0) plan_cta = 'Confirm & reconcile';
            else plan_cta = any_provisioned ? 'Confirm redeploy code' : 'Confirm & provision';
          }
          async function poll_provision_job(jobId: string) {
            if (!jobId) throw new Error('No job_id from provision-project');
            const deadline = Date.now() + 30 * 60 * 1000;
            while (Date.now() < deadline) {
              await new Promise((r) => setTimeout(r, 800));
              const r = await fetch(`/api/provision_jobs?job_id=${encodeURIComponent(jobId)}`);
              if (!r.ok) throw new Error(await r.text());
              const job = await r.json();
              apply_job_snapshot(job);
              const st = String(job?.status || '');
              if (st === 'succeeded' || st === 'failed') return job;
            }
            throw new Error('Provision timed out after 30 minutes');
          }
          /** Async provision runner — poll needs setTimeout; kept here so the effect can fire-and-forget. */
          async function run_provision() {
            plan_open = false;
            provision_msg = '';
            error = '';
            provision_percent = 0;
            provision_status = 'starting';
            provision_steps = [];
            try {
              const r = await fetch('/api/provision-project', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ project_slug: slug, environment, repo_id: id, branch: default_branch || 'main' }),
              });
              if (!r.ok) throw new Error(await r.text());
              const started = await r.json();
              apply_job_snapshot(started);
              const jobId = started?.job_id != null ? String(started.job_id) : '';
              const finalJob = await poll_provision_job(jobId);
              if (String(finalJob?.status) === 'failed') {
                throw new Error(finalJob?.error != null ? String(finalJob.error) : 'Provision failed');
              }
              provision_msg = finalJob?.summary != null ? String(finalJob.summary) : 'Provision complete.';
              loaded = false;
            } catch (e: any) {
              error = e?.message != null ? String(e.message) : String(e);
              provision_status = 'failed';
            } finally {
              provision_busy = false;
            }
          }
        """
        template """
          <DetailShell
            title={name || 'Project'}
            subtitle={slug ? `/${slug}` : ''}
            back_href="/projects"
            loading={loading}
            error={error}
            agent={{ intent: 'view-project', entity: 'Repo', entityLabel: 'Project', itemId: id }}
          >
            {#snippet header_actions()}
              {#if has_deploy}
                <label class="env-select-wrap">
                  <span class="env-select-label">Environment</span>
                  <select
                    class="env-select"
                    value={environment}
                    disabled={provision_busy || loading}
                    onchange={(e) => { select_environment((e.currentTarget as HTMLSelectElement).value); }}
                  >
                    {#each env_options as opt}
                      <option value={opt} selected={opt === environment}>{opt}</option>
                    {/each}
                  </select>
                </label>
                <button
                  type="button"
                  class="btn-outline"
                  disabled={provision_busy || plan_loading || loading}
                  onclick={() => { load_provision_plan(); }}
                >
                  {plan_loading ? "Loading plan…" : "Preview plan"}
                </button>
                <button
                  type="button"
                  class="btn-primary"
                  class:btn-primary--reconcile={any_provisioned && !provision_busy}
                  disabled={provision_busy || plan_loading}
                  onclick={() => { if (plan_open) { provision_busy = true; } else { load_provision_plan(); } }}
                >
                  {provision_button_label()}
                </button>
              {/if}
              <button type="button" class="btn-outline" onclick={() => { delete_open = true; }}>Delete</button>
            {/snippet}
            {#snippet summary()}
              <div class="summary card">
                <EntityIdentity name={name || '—'} subtitle={default_branch} show_avatar={true} />
                {#if has_deploy}
                  <div class="summary-meta">
                    <StatusPill label={infra_status} variant={infra_status_variant} />
                    {#if region}<span class="chip">{region}</span>{/if}
                    {#if project_prefix}<span class="chip">prefix: {project_prefix}</span>{/if}
                  </div>
                  {#if env_role_hint}
                    <p class="hint">Provision identity: <code>{env_role_hint}</code></p>
                  {/if}
                {:else if has_toml}
                  <p class="hint">No <code>[deploy]</code> section in veil.toml — infrastructure is not configured for this project.</p>
                {:else}
                  <p class="hint">No veil.toml found on the projects hub for slug <code>{slug}</code>.</p>
                {/if}

                {#if plan_open && !provision_busy}
                  <div class="prov-plan" aria-busy={plan_loading}>
                    <div class="prov-progress__head">
                      <span class="prov-progress__title">Apply plan ({environment})</span>
                      {#if plan_loading}
                        <span class="chip">Checking AWS…</span>
                      {:else if plan_mock}
                        <span class="chip chip--warn">MOCK MODE</span>
                      {/if}
                    </div>
                    {#if plan_loading}
                      <div class="plan-loading" role="status" aria-live="polite">
                        <span class="dk-spinner" aria-hidden="true"></span>
                        <div class="plan-loading__text">
                          <strong>Building plan…</strong>
                          <span>Checking which stack resources exist in {environment} (describe/get). This can take a few seconds.</span>
                        </div>
                      </div>
                      <div class="plan-actions">
                        <button type="button" class="btn-outline" disabled={true}>Cancel</button>
                        <button type="button" class="btn-primary" disabled={true}>Loading…</button>
                      </div>
                    {:else}
                      <p class="prov-progress__summary">{plan_summary}</p>
                      {#if plan_diff && (plan_diff.create != null || plan_diff.update != null)}
                        <div class="plan-diff">
                          <span class="plan-diff__chip plan-diff__chip--create">{plan_diff.create || 0} create</span>
                          <span class="plan-diff__chip plan-diff__chip--update">{plan_diff.update || 0} update</span>
                          <span class="plan-diff__chip plan-diff__chip--noop">{plan_diff.noop || 0} noop</span>
                          <span class="plan-diff__chip plan-diff__chip--destroy">{plan_diff.destroy || 0} destroy</span>
                        </div>
                      {/if}
                      {#if plan_notes.length}
                        <ul class="plan-notes">
                          {#each plan_notes as n}
                            <li>{n}</li>
                          {/each}
                        </ul>
                      {/if}
                      {#if plan_resources.length}
                        <h3 class="plan-h">Resource actions</h3>
                        <ul class="plan-resources">
                          {#each plan_resources as r}
                            <li>
                              <span class="plan-kind">{r.kind}</span>
                              <code class="plan-name">{r.name}</code>
                              <span class={`plan-action plan-action--${r.action || 'ensure'}`}>{r.action || 'ensure'}</span>
                              {#if r.detail}<span class="plan-detail">{r.detail}</span>{/if}
                            </li>
                          {/each}
                        </ul>
                      {/if}
                      {#if plan_steps.length}
                        <h3 class="plan-h">Steps</h3>
                        <ol class="prov-steps">
                          {#each plan_steps as step, i}
                            <li class="prov-step prov-step--pending" style={`--dk-i: ${i}`}>
                              <span class="prov-step__dot" aria-hidden="true"></span>
                              <div class="prov-step__body">
                                <div class="prov-step__label">{step.label || step.id}</div>
                                {#if step.phase || step.action}
                                  <div class="prov-step__detail">
                                    {#if step.phase}phase: {step.phase}{/if}
                                    {#if step.action}
                                      <span class={`plan-action plan-action--${step.action}`}>{step.action}</span>
                                    {/if}
                                  </div>
                                {/if}
                              </div>
                            </li>
                          {/each}
                        </ol>
                      {/if}
                      <div class="plan-actions">
                        <button type="button" class="btn-outline" onclick={() => { plan_open = false; }}>Cancel</button>
                        <button type="button" class="btn-primary" onclick={() => { provision_busy = true; }}>
                          {plan_cta}
                        </button>
                      </div>
                    {/if}
                  </div>
                {/if}

                {#if provision_busy || provision_steps.length > 0}
                  <div class="prov-progress card-inner">
                    <div class="prov-progress__head">
                      <span class="prov-progress__title">
                        {provision_status === 'succeeded' ? 'Provision complete' : provision_status === 'failed' ? 'Provision failed' : 'Provisioning…'}
                      </span>
                      <span class="prov-progress__pct">{provision_percent}%</span>
                    </div>
                    <div class="prov-progress__track" aria-hidden="true">
                      <div
                        class="prov-progress__fill"
                        class:prov-progress__fill--ok={provision_status === 'succeeded'}
                        class:prov-progress__fill--err={provision_status === 'failed'}
                        style={`width: ${Math.min(100, Math.max(0, provision_percent))}%`}
                      ></div>
                    </div>
                    {#if provision_msg}
                      <p class="prov-progress__summary">{provision_msg}</p>
                    {/if}
                    <ol class="prov-steps">
                      {#each provision_steps as step, i}
                        <li class={`prov-step prov-step--${step.status || 'pending'}`} style={`--dk-i: ${i}`}>
                          <span class="prov-step__dot" aria-hidden="true"></span>
                          <div class="prov-step__body">
                            <div class="prov-step__label">{step.label || step.id}</div>
                            {#if step.detail}
                              <div class="prov-step__detail">{step.detail}</div>
                            {/if}
                          </div>
                          <span class="prov-step__status">{step.status}</span>
                        </li>
                      {/each}
                    </ol>
                  </div>
                {:else if provision_msg}
                  <p class="ok-msg">{provision_msg}</p>
                {/if}
              </div>
            {/snippet}

            <FormSection title="Repository" columns={2}>
              <DetailField label="Name" value={name} />
              <DetailField label="Slug" value={slug} mono={true} />
              <DetailField label="Default branch" value={default_branch} />
              <DetailField label="Id" value={id} mono={true} />
              <DetailField label="Created" value={created_at} />
              <DetailField label="Updated" value={updated_at} />
            </FormSection>
            <FormSection title="Description" columns={1}>
              <DetailField label="Description" value={description || '—'} />
            </FormSection>

            {#if has_deploy}
              <FormSection title="Infrastructure (veil.toml [deploy])" columns={2}>
                <DetailField label="Region" value={region || '—'} />
                <DetailField label="Project prefix" value={project_prefix || '—'} />
                <DetailField label="Stack base" value={stack_base || '—'} mono={true} />
                <DetailField label="VPC" value={network_vpc || '—'} />
                <DetailField label="Environment" value={environment} />
                <DetailField label="veil.toml" value={toml_path || '—'} mono={true} />
              </FormSection>

              <div class="units-block">
                <h2 class="units-title">AWS services ({environment})</h2>
                <p class="hint inv-hint">
                  Full inventory from the resolved stack + last provision state. Click <strong>Reconcile</strong> to plan create/update/noop against live AWS (removals are never destroyed automatically).
                </p>
                {#if aws_inventory.length === 0}
                  <p class="hint">No stack resources resolved yet.</p>
                {:else}
                  <div class="dk-table-wrap card">
                    <table class="dk-table">
                      <thead>
                        <tr>
                          <th>Service</th>
                          <th>Name / id</th>
                          <th>Detail</th>
                          <th>Status</th>
                        </tr>
                      </thead>
                      <tbody>
                        {#each aws_inventory as r, i}
                          <tr class="dk-table__row" style="--dk-i: {i}">
                            <td><span class="inv-kind">{r.kind}</span></td>
                            <td>
                              <code class="inv-name">{r.name}</code>
                              {#if r.ref}<div class="dk-tile__meta inv-ref">{r.ref}</div>{/if}
                            </td>
                            <td><span class="dk-tile__meta">{r.detail}</span></td>
                            <td>
                              <StatusPill
                                label={String(r.status)}
                                variant={String(r.status).includes('not ') || r.status === 'pending' || r.status === 'stack' ? 'warning' : 'success'}
                              />
                            </td>
                          </tr>
                        {/each}
                      </tbody>
                    </table>
                  </div>
                {/if}
              </div>

              <div class="units-block">
                <h2 class="units-title">Deploy units</h2>
                {#if units.length === 0}
                  <p class="hint">No [[deploy.units]] declared.</p>
                {:else}
                  <div class="dk-table-wrap card">
                    <table class="dk-table">
                      <thead>
                        <tr>
                          <th>Unit</th>
                          <th>Type</th>
                          <th>Context</th>
                          <th>Gateway</th>
                          <th>Memory</th>
                          <th>Status ({environment})</th>
                        </tr>
                      </thead>
                      <tbody>
                        {#each units as u, i}
                          <tr class="dk-table__row" style="--dk-i: {i}">
                            <td>
                              <div class="unit-name">{u.name}</div>
                              {#if u.description}<div class="dk-tile__meta">{u.description}</div>{/if}
                              {#if u.lambda_arn}<div class="dk-tile__meta inv-ref">{u.lambda_arn}</div>{/if}
                            </td>
                            <td><span class="dk-tile__meta">{u.type}</span></td>
                            <td><span class="dk-tile__meta">{u.context}</span></td>
                            <td><span class="dk-tile__meta">{u.gateway}{u.path_prefix && u.path_prefix !== '—' ? ` ${u.path_prefix}` : ''}</span></td>
                            <td><span class="dk-tile__meta">{u.memory_mb}{u.memory_mb !== '—' ? ' MB' : ''}</span></td>
                            <td>
                              <StatusPill
                                label={u.provisioned ? (u.version ? `${u.status} · v${u.version}` : String(u.status)) : 'not provisioned'}
                                variant={u.provisioned ? 'success' : 'warning'}
                              />
                            </td>
                          </tr>
                        {/each}
                      </tbody>
                    </table>
                  </div>
                {/if}
              </div>
            {/if}
          </DetailShell>

          <ConfirmDialog
            bind:open={delete_open}
            title="Delete project"
            message={`Are you sure you want to delete “${name}”? This cannot be undone.`}
            confirm_label="Delete"
            cancel_label="Cancel"
            variant="danger"
            on_confirm={() => { delete_busy = true; }}
          />
        """
        style """
          .summary { padding: 1rem 1.15rem; margin-bottom: 0.5rem; display: flex; flex-direction: column; gap: 0.75rem; }
          .summary-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
          .chip {
            font-size: 0.75rem;
            color: var(--dk-text-muted);
            border: 1px solid var(--dk-border-soft);
            border-radius: 999px;
            padding: 0.15rem 0.55rem;
          }
          .hint { color: var(--dk-text-muted); font-size: 0.9rem; margin: 0; }
          .ok-msg { color: var(--dk-green, #22c55e); font-size: 0.9rem; margin: 0; }
          .units-block { margin-top: 0.5rem; }
          .units-title {
            font-size: 0.72rem; font-weight: 650; text-transform: uppercase;
            letter-spacing: 0.08em; color: var(--dk-text-muted); margin: 0 0 0.75rem;
          }
          .unit-name { font-weight: 600; }
          .env-select-wrap {
            display: inline-flex; align-items: center; gap: 0.4rem;
            margin-right: 0.35rem;
          }
          .env-select-label {
            font-size: 0.72rem; font-weight: 650; text-transform: uppercase;
            letter-spacing: 0.06em; color: var(--dk-text-muted);
          }
          .env-select {
            font: inherit; font-size: 0.9rem;
            border: 1px solid var(--dk-border-soft);
            border-radius: 0.45rem;
            padding: 0.35rem 0.55rem;
            background: var(--dk-surface, #fff);
            color: inherit;
          }
          .prov-progress {
            margin-top: 0.75rem;
            padding: 0.85rem 1rem;
            border: 1px solid var(--dk-border-soft);
            border-radius: 0.65rem;
            background: var(--dk-surface-2, rgba(0,0,0,0.03));
            display: flex; flex-direction: column; gap: 0.55rem;
            animation: prov-panel-in 0.35s var(--dk-ease-out, cubic-bezier(0.16, 1, 0.3, 1)) both;
          }
          .prov-progress__head { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; }
          .prov-progress__title { font-weight: 650; font-size: 0.92rem; }
          .prov-progress__pct { font-size: 0.8rem; color: var(--dk-text-muted); font-variant-numeric: tabular-nums; }
          .prov-progress__track {
            height: 0.45rem; border-radius: 999px;
            background: var(--dk-border-soft, #e5e7eb); overflow: hidden;
            animation: track-reveal 0.4s 0.15s var(--dk-ease-out, cubic-bezier(0.16, 1, 0.3, 1)) both;
          }
          @keyframes track-reveal {
            from { opacity: 0; transform: scaleX(0.3); }
            to { opacity: 1; transform: scaleX(1); }
          }
          .prov-progress__fill {
            height: 100%; width: 0; border-radius: 999px;
            background: var(--dk-accent, #6366f1);
            transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative; overflow: hidden;
          }
          .prov-progress__fill::after {
            content: '';
            position: absolute; inset: 0;
            background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.25) 50%, transparent 100%);
            animation: prov-shimmer 1.8s ease-in-out infinite;
          }
          @keyframes prov-shimmer {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
          }
          .prov-progress__fill--ok { background: var(--dk-green, #22c55e); }
          .prov-progress__fill--ok::after { animation: none; }
          .prov-progress__fill--err { background: var(--dk-red, #ef4444); }
          .prov-progress__fill--err::after { animation: none; }
          .prov-progress__summary { margin: 0; font-size: 0.85rem; color: var(--dk-text-muted); }
          .prov-steps { list-style: none; margin: 0.25rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.35rem; }
          .prov-step {
            display: grid; grid-template-columns: 0.65rem 1fr auto; gap: 0.55rem;
            align-items: start; font-size: 0.82rem;
            animation: prov-step-in 0.3s var(--dk-ease-out, cubic-bezier(0.16, 1, 0.3, 1)) both;
            animation-delay: calc(var(--dk-i, 0) * 60ms + 80ms);
          }
          @keyframes prov-step-in {
            from { opacity: 0; transform: translateX(-6px); }
            to { opacity: 1; transform: translateX(0); }
          }
          .prov-step__dot {
            width: 0.55rem; height: 0.55rem; border-radius: 999px; margin-top: 0.3rem;
            background: var(--dk-border-soft, #cbd5e1);
            transition: background 0.25s ease, box-shadow 0.25s ease, transform 0.2s ease;
          }
          .prov-step--running .prov-step__dot { background: var(--dk-accent, #6366f1); box-shadow: 0 0 0 3px color-mix(in srgb, var(--dk-accent, #6366f1) 25%, transparent); animation: prov-dot-pulse 1.2s ease-in-out infinite; }
          .prov-step--done .prov-step__dot { background: var(--dk-green, #22c55e); transform: scale(1.15); box-shadow: 0 0 0 2px color-mix(in srgb, var(--dk-green, #22c55e) 20%, transparent); }
          .prov-step--skipped .prov-step__dot { background: var(--dk-text-muted, #94a3b8); }
          .prov-step--error .prov-step__dot { background: var(--dk-red, #ef4444); box-shadow: 0 0 0 2px color-mix(in srgb, var(--dk-red, #ef4444) 20%, transparent); }
          @keyframes prov-dot-pulse {
            0%, 100% { box-shadow: 0 0 0 3px color-mix(in srgb, var(--dk-accent, #6366f1) 25%, transparent); transform: scale(1); }
            50% { box-shadow: 0 0 0 5px color-mix(in srgb, var(--dk-accent, #6366f1) 12%, transparent); transform: scale(1.1); }
          }
          .prov-step__label { font-weight: 550; }
          .prov-step__detail { color: var(--dk-text-muted); font-size: 0.78rem; word-break: break-word; margin-top: 0.1rem; }
          .prov-step__status { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--dk-text-muted); }
          .prov-plan {
            margin-top: 0.75rem; padding: 0.85rem 1rem;
            border: 1px solid var(--dk-border-soft); border-radius: 0.65rem;
            background: var(--dk-surface-2, rgba(0,0,0,0.03));
            display: flex; flex-direction: column; gap: 0.55rem;
            animation: prov-panel-in 0.35s var(--dk-ease-out, cubic-bezier(0.16, 1, 0.3, 1)) both;
          }
          @keyframes prov-panel-in {
            from { opacity: 0; transform: translateY(-8px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
          }
          .plan-notes { margin: 0; padding-left: 1.1rem; color: var(--dk-text-muted); font-size: 0.82rem; }
          .plan-h {
            margin: 0.35rem 0 0; font-size: 0.72rem; font-weight: 650;
            text-transform: uppercase; letter-spacing: 0.06em; color: var(--dk-text-muted);
          }
          .plan-resources { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.35rem; }
          .plan-resources li {
            display: grid; grid-template-columns: 6.5rem 1fr auto; gap: 0.4rem 0.65rem;
            font-size: 0.82rem; align-items: baseline;
            animation: prov-step-in 0.25s var(--dk-ease-out, cubic-bezier(0.16, 1, 0.3, 1)) both;
            animation-delay: calc(var(--dk-i, 0) * 45ms + 50ms);
          }
          .plan-kind { color: var(--dk-text-muted); text-transform: uppercase; font-size: 0.7rem; letter-spacing: 0.04em; }
          .plan-name { font-size: 0.8rem; }
          .plan-action {
            font-size: 0.68rem; font-weight: 650; text-transform: uppercase; letter-spacing: 0.04em;
            border-radius: 999px; padding: 0.1rem 0.45rem;
            border: 1px solid var(--dk-border-soft); color: var(--dk-text-muted);
          }
          .plan-action--create { color: #15803d; border-color: color-mix(in srgb, #22c55e 45%, var(--dk-border-soft)); background: color-mix(in srgb, #22c55e 12%, transparent); }
          .plan-action--update { color: #1d4ed8; border-color: color-mix(in srgb, #3b82f6 45%, var(--dk-border-soft)); background: color-mix(in srgb, #3b82f6 12%, transparent); }
          .plan-action--noop { color: var(--dk-text-muted); }
          .plan-action--skip, .plan-action--ensure { color: #a16207; border-color: color-mix(in srgb, #f59e0b 40%, var(--dk-border-soft)); }
          .plan-detail { grid-column: 1 / -1; color: var(--dk-text-muted); font-size: 0.78rem; }
          .plan-actions { display: flex; gap: 0.5rem; justify-content: flex-end; margin-top: 0.35rem; animation: prov-panel-in 0.3s 0.2s var(--dk-ease-out, cubic-bezier(0.16, 1, 0.3, 1)) both; }
          .plan-loading {
            display: flex; align-items: flex-start; gap: 0.85rem;
            padding: 0.85rem 0.15rem 0.35rem;
            min-height: 4.5rem;
          }
          .plan-loading .dk-spinner {
            flex-shrink: 0; margin-top: 0.15rem;
            width: 1.35rem; height: 1.35rem;
            border: 2px solid color-mix(in srgb, var(--dk-accent, #6366f1) 20%, transparent);
            border-top-color: var(--dk-accent, #6366f1);
            border-radius: 50%;
            animation: plan-spin 0.65s linear infinite;
          }
          @keyframes plan-spin { to { transform: rotate(360deg); } }
          .plan-loading__text {
            display: flex; flex-direction: column; gap: 0.2rem;
            font-size: 0.85rem; color: var(--dk-text-muted);
          }
          .plan-loading__text strong {
            color: inherit; font-weight: 650; font-size: 0.9rem;
          }
          .plan-diff { display: flex; flex-wrap: wrap; gap: 0.4rem; }
          .plan-diff__chip {
            font-size: 0.72rem; font-weight: 650; border-radius: 999px;
            padding: 0.15rem 0.55rem; border: 1px solid var(--dk-border-soft);
            animation: chip-pop 0.3s var(--dk-ease-out, cubic-bezier(0.16, 1, 0.3, 1)) both;
          }
          .plan-diff__chip:nth-child(1) { animation-delay: 0.05s; }
          .plan-diff__chip:nth-child(2) { animation-delay: 0.1s; }
          .plan-diff__chip:nth-child(3) { animation-delay: 0.15s; }
          .plan-diff__chip:nth-child(4) { animation-delay: 0.2s; }
          @keyframes chip-pop {
            from { opacity: 0; transform: scale(0.8); }
            to { opacity: 1; transform: scale(1); }
          }
          .plan-diff__chip--create { color: #15803d; border-color: color-mix(in srgb, #22c55e 45%, var(--dk-border-soft)); }
          .plan-diff__chip--update { color: #1d4ed8; border-color: color-mix(in srgb, #3b82f6 45%, var(--dk-border-soft)); }
          .plan-diff__chip--noop { color: var(--dk-text-muted); }
          .plan-diff__chip--destroy { color: #b91c1c; border-color: color-mix(in srgb, #ef4444 45%, var(--dk-border-soft)); opacity: 0.85; }
          .chip--warn {
            border-color: color-mix(in srgb, #f59e0b 50%, var(--dk-border-soft));
            color: #b45309;
          }
          .inv-hint { margin: 0 0 0.65rem; }
          .inv-kind {
            font-size: 0.72rem; font-weight: 650; text-transform: uppercase;
            letter-spacing: 0.04em; color: var(--dk-text-muted);
          }
          .inv-name { font-size: 0.82rem; }
          .inv-ref { font-size: 0.72rem; word-break: break-all; opacity: 0.85; }
          :global(.btn-primary--reconcile) {
            /* still primary when reconciling existing infra */
          }
        """

      comp DeployView
        state
          artifactId: Str
          targetType: Str
          deploying: Bool
          error: Str
        fn triggerDeploy()
          deploying = true
          error = ""
          ApiClient.mutate("/api/deploy", {artifact_id: artifactId, target: targetType})
          deploying = false
        template """
          <div class="deploy">
            <PageHeader title="Deploy" description="Publish an artifact to a target runtime." />
            <form class="dk-form card" onsubmit={(e) => { e.preventDefault(); triggerDeploy(); }}>
              <FormSection title="Artifact" columns={1}>
                <FormField label="Artifact ID" bind:value={artifactId} required={true} placeholder="art_…" />
                <div class="dk-field">
                  <label class="dk-field__label" for="deploy-target">Target</label>
                  <div class="dk-field__control">
                    <select id="deploy-target" bind:value={targetType}>
                      <option value="lambda">Lambda</option>
                      <option value="container">Container</option>
                    </select>
                  </div>
                </div>
              </FormSection>
              {#if error}
                <p class="dk-error">{error}</p>
              {/if}
              <div class="actions">
                <button type="submit" class="btn-primary" disabled={deploying || !artifactId}>
                  {deploying ? "Deploying…" : "Deploy"}
                </button>
              </div>
            </form>
          </div>
        """
        style """
          .deploy { max-width: 42rem; animation: dk-fade-in var(--dk-dur-slow, 420ms) var(--dk-ease-out, ease) both; }
          .dk-form { padding: 1.25rem 1.35rem 1.5rem; display: flex; flex-direction: column; gap: 1.5rem; }
          .actions { display: flex; justify-content: flex-end; }
        """

      comp RegistryView
        state
          layers: List<Json>
          stubs: List<Json>
          loading: Bool
          error: Str
        effect load_on_mount
          loading = true
          error = ""
          layers = ApiClient.fetch("/api/registry/layers")
          stubs = ApiClient.fetch("/api/registry/stubs")
          loading = false
        template """
          <div class="registry">
            <PageHeader title="Registry" description="Layers and stubs known to this runtime." />
            <CollectionView
              title="Layers"
              items={layers}
              loading={loading}
              error={error}
              view_mode="list"
              default_layout="list"
              show_avatar={false}
              empty_title="No layers registered"
              columns={[
                { key: 'name', label: 'Name', cell: 'identity', showAvatar: false },
                { key: 'version', label: 'Version' },
              ]}
              agent={{ intent: 'list-layers', entity: 'Layer', entityLabel: 'Layer' }}
            />
            <div class="gap"></div>
            <CollectionView
              title="Stubs"
              items={stubs}
              loading={loading}
              view_mode="list"
              default_layout="list"
              show_avatar={false}
              empty_title="No stubs registered"
              columns={[
                { key: 'crate_name', label: 'Crate', cell: 'identity', showAvatar: false },
                { key: 'version', label: 'Version' },
              ]}
              agent={{ intent: 'list-stubs', entity: 'Stub', entityLabel: 'Stub' }}
            />
          </div>
        """
        style """
          .registry { max-width: 1120px; animation: dk-fade-in var(--dk-dur-slow, 420ms) var(--dk-ease-out, ease) both; }
          .gap { height: 1.5rem; }
        """

      comp BusView
        state
          testMessage: Str
          result: Opt<Str>
          sending: Bool
          error: Str
        fn sendTest()
          sending = true
          error = ""
          mut resp = ApiClient.mutate("/api/bus/invoke", {message: testMessage})
          result = resp.result
          sending = false
        template """
          <div class="bus">
            <PageHeader title="Bus" description="Invoke a test message on the runtime bus." />
            <form class="dk-form card" onsubmit={(e) => { e.preventDefault(); sendTest(); }}>
              <FormSection title="Message" columns={1}>
                <FormField label="Payload" bind:value={testMessage} input_type="textarea" placeholder="Message…" />
              </FormSection>
              {#if error}
                <p class="dk-error">{error}</p>
              {/if}
              <div class="actions">
                <button type="submit" class="btn-primary" disabled={sending || !testMessage}>
                  {sending ? "Sending…" : "Send"}
                </button>
              </div>
              {#if result}
                <pre class="result card">{result}</pre>
              {/if}
            </form>
          </div>
        """
        style """
          .bus { max-width: 42rem; animation: dk-fade-in var(--dk-dur-slow, 420ms) var(--dk-ease-out, ease) both; }
          .dk-form { padding: 1.25rem 1.35rem 1.5rem; display: flex; flex-direction: column; gap: 1.25rem; }
          .actions { display: flex; justify-content: flex-end; }
          .result {
            margin: 0;
            padding: 0.85rem 1rem;
            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            font-size: 0.82rem;
            white-space: pre-wrap;
            word-break: break-word;
          }
        """

      comp AgentsView
        state
          messages: List<Json>
          user_input: Str
          sending: Bool
          error: Str
        fn sendMessage()
          sending = true
          error = ""
          messages = messages.concat([{role: "user", content: user_input}])
          mut resp = ApiClient.mutate("/api/agent", {message: user_input})
          messages = messages.concat([{role: "assistant", content: resp.message}])
          user_input = ""
          sending = false
        template """
          <div class="agents">
            <PageHeader title="Agents" description="Chat with the runtime agent over HTTPS." />
            <div class="panel card">
              <div class="msgs">
                {#if messages.length === 0}
                  <EmptyState title="No messages yet" description="Send a prompt to start a conversation." />
                {:else}
                  {#each messages as m, i}
                    <div class="bubble {m.role}" style="--dk-i: {i}">{m.content}</div>
                  {/each}
                {/if}
              </div>
              {#if error}
                <p class="dk-error">{error}</p>
              {/if}
              <div class="row">
                <input bind:value={user_input} placeholder="Message…" aria-label="Agent message" />
                <button type="button" class="btn-primary" onclick={sendMessage} disabled={sending || !user_input}>
                  {sending ? "…" : "Send"}
                </button>
              </div>
            </div>
          </div>
        """
        style """
          .agents { max-width: 52rem; animation: dk-fade-in var(--dk-dur-slow, 420ms) var(--dk-ease-out, ease) both; }
          .panel { padding: 1rem; display: flex; flex-direction: column; gap: 0.85rem; min-height: 22rem; }
          .msgs { flex: 1; min-height: 16rem; max-height: 28rem; overflow-y: auto; display: flex; flex-direction: column; gap: 0.5rem; }
          .bubble {
            padding: 0.65rem 0.85rem;
            border-radius: var(--dk-radius-sm, 0.55rem);
            animation: dk-fade-up 0.32s var(--dk-ease-out, ease) both;
            animation-delay: calc(var(--dk-i, 0) * 30ms);
            max-width: 90%;
          }
          .bubble.user {
            align-self: flex-end;
            background: color-mix(in srgb, var(--accent) 14%, transparent);
            border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
          }
          .bubble.assistant {
            align-self: flex-start;
            background: var(--dk-surface-2, var(--surface));
            border: 1px solid var(--dk-border-soft, var(--border));
          }
          .row { display: flex; gap: 0.55rem; }
          .row input { flex: 1; }
        """

      comp ConfigView
        state
          aws_region: Str
          s3_bucket: Str
          ddb_table: Str
          llm_model: Str
          saving: Bool
          error: Str
        fn save()
          saving = true
          error = ""
          ApiClient.mutate("/api/config", {aws_region, s3_bucket, ddb_table, llm_model})
          saving = false
        template """
          <div class="config">
            <PageHeader title="Config" description="Runtime environment settings for this host." />
            <form class="dk-form card" onsubmit={(e) => { e.preventDefault(); save(); }}>
              <FormSection title="AWS" columns={2}>
                <FormField label="Region" bind:value={aws_region} placeholder="us-west-2" />
                <FormField label="S3 bucket" bind:value={s3_bucket} placeholder="veil-artifacts-dev" />
                <FormField label="DynamoDB table" bind:value={ddb_table} placeholder="veil-runtime-dev" />
                <FormField label="LLM model" bind:value={llm_model} placeholder="…" />
              </FormSection>
              {#if error}
                <p class="dk-error">{error}</p>
              {/if}
              <div class="actions">
                <button type="submit" class="btn-primary" disabled={saving}>
                  {saving ? "Saving…" : "Save"}
                </button>
              </div>
            </form>
          </div>
        """
        style """
          .config { max-width: 42rem; animation: dk-fade-in var(--dk-dur-slow, 420ms) var(--dk-ease-out, ease) both; }
          .dk-form { padding: 1.25rem 1.35rem 1.5rem; display: flex; flex-direction: column; gap: 1.5rem; }
          .actions { display: flex; justify-content: flex-end; }
        """

      comp ChangesView
        state
          change_requests: List<Json>
          loading: Bool
          error: Str
          active_filter: Str
          cr_href_tpl: Str = "/changes/{id}"
        effect load_on_mount
          loading = true
          error = ""
          active_filter = "All"
          change_requests = ApiClient.fetch("/api/change_requests")
          loading = false
        fn set_filter(filter: Str)
          active_filter = filter
          loading = true
          error = ""
          if filter == "All"
            change_requests = ApiClient.fetch("/api/change_requests")
          else
            change_requests = ApiClient.fetch(f"/api/change_requests?status={filter}")
          loading = false
        template """
          <div class="changes">
            <CollectionView
              title="Changes"
              description="Change requests — branch-based review workflow"
              items={change_requests}
              loading={loading}
              error={error}
              view_mode="list"
              default_layout="list"
              layout_storage_key="veil_runtime.changes.layout"
              item_href_template={cr_href_tpl}
              show_avatar={false}
              primary_href="/changes/new"
              primary_label="Create"
              empty_title="No change requests"
              empty_description="Create a change request to start a branch-based review workflow."
              empty_action_href="/changes/new"
              empty_action_label="Create change request"
              columns={[
                { key: 'title', label: 'Title', cell: 'identity', showAvatar: false, subtitleKey: 'source_branch' },
                { key: 'status', label: 'Status' },
                { key: 'author', label: 'Author' },
                { key: 'jira_ticket', label: 'Ticket' },
                { key: 'updated_at', label: 'Updated' },
              ]}
              agent={{
                intent: 'list-change-requests',
                entity: 'ChangeRequest',
                entityLabel: 'Change Request',
                actions: [
                  { id: 'create', label: 'Create', href: '/changes/new', via: 'primary', method: 'navigate' },
                  { id: 'view', label: 'View', hrefTemplate: '/changes/{id}', via: 'item-click', method: 'navigate' },
                ],
                api: { list: 'GET /api/change_requests', get: 'GET /api/change_requests/{id}' },
              }}
            >
              {#snippet header_below()}
                <div class="cr-filters">
                  {#each ['All', 'ReadyForReview', 'Approved', 'Draft', 'Merged'] as f}
                    <button
                      type="button"
                      class="cr-filter-tab"
                      class:cr-filter-tab--active={active_filter === f}
                      onclick={() => { set_filter(f); }}
                    >
                      {f === 'ReadyForReview' ? 'Ready for Review' : f}
                    </button>
                  {/each}
                </div>
              {/snippet}
              {#snippet row(item)}
                {@const cr = /** @type {Record<string, unknown>} */ (item)}
                {@const crid = cr?.id != null && typeof cr.id === 'object' && cr.id.value != null ? String(cr.id.value) : String(cr?.id ?? '')}
                {@const status = String(cr?.status ?? 'Draft')}
                {@const statusVariant = status === 'Draft' ? 'neutral' : status === 'ReadyForReview' ? 'info' : status === 'Approved' ? 'success' : status === 'ChangesRequested' ? 'warning' : status === 'Merged' ? 'success' : status === 'Rejected' ? 'error' : 'neutral'}
                <td>
                  <div class="cr-title-cell">
                    <span class="cr-title">{cr?.title ? String(cr.title) : '—'}</span>
                    <span class="cr-branch">{cr?.source_branch ? String(cr.source_branch) : ''}</span>
                  </div>
                </td>
                <td>
                  <StatusPill label={status === 'ReadyForReview' ? 'Ready for Review' : status} variant={statusVariant} />
                </td>
                <td><span class="dk-tile__meta">{cr?.author ? String(cr.author) : '—'}</span></td>
                <td><span class="dk-tile__meta">{cr?.jira_ticket ? String(cr.jira_ticket) : '—'}</span></td>
                <td><span class="dk-tile__meta">{cr?.updated_at ? String(cr.updated_at).slice(0, 10) : '—'}</span></td>
              {/snippet}
            </CollectionView>
          </div>
        """
        style """
          .changes { max-width: 1120px; animation: dk-fade-in var(--dk-dur-slow, 420ms) var(--dk-ease-out, ease) both; }
          .cr-filters {
            display: flex;
            gap: 0.25rem;
            padding: 0.5rem 0 0.75rem;
            border-bottom: 1px solid var(--dk-border-soft, var(--border));
            margin-bottom: 0.5rem;
            flex-wrap: wrap;
          }
          .cr-filter-tab {
            font-size: 0.8rem;
            font-weight: 550;
            padding: 0.35rem 0.75rem;
            border-radius: 999px;
            border: 1px solid transparent;
            background: transparent;
            color: var(--text-dim);
            cursor: pointer;
            transition:
              color var(--dk-dur-fast, 140ms) ease,
              background var(--dk-dur-fast, 140ms) ease,
              border-color var(--dk-dur-fast, 140ms) ease;
          }
          .cr-filter-tab:hover {
            color: var(--accent);
            background: color-mix(in srgb, var(--accent) 8%, transparent);
          }
          .cr-filter-tab--active {
            color: var(--accent);
            background: color-mix(in srgb, var(--accent) 12%, transparent);
            border-color: color-mix(in srgb, var(--accent) 30%, transparent);
          }
          .cr-title-cell { display: flex; flex-direction: column; gap: 0.15rem; }
          .cr-title { font-weight: 550; font-size: 0.88rem; }
          .cr-branch { font-size: 0.75rem; color: var(--dk-text-muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
        """

      comp ChangeDetailView
        state
          id: Str
          cr: Json
          diff: Json
          comments: List<Json>
          approvals: List<Json>
          ci: Json
          loading: Bool
          error: Str
          loaded: Bool
          action_busy: Bool
          new_comment: Str
          new_comment_path: Str
          comment_submitting: Bool
        effect init
          loading = true
          error = ""
          loaded = false
          action_busy = false
          new_comment = ""
          new_comment_path = ""
          comment_submitting = false
          cr = {}
          diff = {}
          comments = []
          approvals = []
          ci = {}
          id = cr_id_from_path()
        effect load_detail
          if id != ""
            if loaded == false
              loading = true
              error = ""
              mut detail = ApiClient.fetch(f"/api/change_requests/{id}")
              cr = detail
              mut diff_resp = ApiClient.fetch(f"/api/change_requests/{id}/diff")
              diff = diff_resp
              mut comments_resp = ApiClient.fetch(f"/api/change_requests/{id}/comments")
              comments = comments_resp
              mut approvals_resp = ApiClient.fetch(f"/api/change_requests/{id}/approvals")
              approvals = approvals_resp
              mut ci_resp = ApiClient.fetch(f"/api/change_requests/{id}/ci")
              ci = ci_resp
              loading = false
              loaded = true
        effect do_action
          if action_busy == true
            loaded = false
            action_busy = false
        effect submit_comment
          if comment_submitting == true
            error = ""
            ApiClient.mutate(f"/api/change_requests/{id}/comments", {body: new_comment, construct_path: new_comment_path || null})
            new_comment = ""
            new_comment_path = ""
            comment_submitting = false
            loaded = false
        fn submit_for_review()
          error = ""
          ApiClient.mutate(f"/api/change_requests/{id}/submit", {})
          loaded = false
        fn approve()
          error = ""
          ApiClient.mutate(f"/api/change_requests/{id}/approve", {})
          loaded = false
        fn request_changes()
          error = ""
          ApiClient.mutate(f"/api/change_requests/{id}/request-changes", {comment: "Changes requested"})
          loaded = false
        fn merge()
          error = ""
          ApiClient.mutate(f"/api/change_requests/{id}/merge", {})
          loaded = false
        script """
          function cr_id_from_path(): string {
            if (typeof window === 'undefined') return '';
            const p = window.location.pathname;
            const t = p.endsWith('/') ? p.slice(0, -1) : p;
            const parts = t.split('/').filter(Boolean);
            const i = parts.indexOf('changes');
            if (i >= 0 && parts[i + 1]) return parts[i + 1];
            return '';
          }
          function diff_kind_class(kind: string): string {
            if (kind === 'Added') return 'dk-diff-added';
            if (kind === 'Modified') return 'dk-diff-modified';
            if (kind === 'Removed') return 'dk-diff-removed';
            if (kind === 'Moved') return 'dk-diff-modified';
            return '';
          }
          function diff_kind_icon(kind: string): string {
            if (kind === 'Added') return '+';
            if (kind === 'Modified') return '~';
            if (kind === 'Removed') return '−';
            if (kind === 'Moved') return '→';
            return '•';
          }
          function status_variant(status: string): string {
            if (status === 'Draft') return 'neutral';
            if (status === 'ReadyForReview') return 'info';
            if (status === 'Approved') return 'success';
            if (status === 'ChangesRequested') return 'warning';
            if (status === 'Merged') return 'success';
            if (status === 'Rejected') return 'error';
            return 'neutral';
          }
          function status_label(status: string): string {
            if (status === 'ReadyForReview') return 'Ready for Review';
            if (status === 'ChangesRequested') return 'Changes Requested';
            return status;
          }
          function ci_variant(status: string): string {
            if (status === 'Passed') return 'success';
            if (status === 'Failed') return 'error';
            if (status === 'Running') return 'info';
            return 'warning';
          }
        """
        template """
          <DetailShell
            title={cr?.title ? String(cr.title) : 'Change Request'}
            subtitle={cr?.source_branch ? String(cr.source_branch) : ''}
            back_href="/changes"
            loading={loading}
            error={error}
            agent={{ intent: 'view-change-request', entity: 'ChangeRequest', entityLabel: 'Change Request', itemId: id }}
          >
            {#snippet header_actions()}
              {#if cr?.status === 'Draft'}
                <button type="button" class="btn-primary" onclick={() => { submit_for_review(); }}>
                  Submit for Review
                </button>
              {/if}
              {#if cr?.status === 'ReadyForReview'}
                <button type="button" class="btn-outline" onclick={() => { request_changes(); }}>
                  Request Changes
                </button>
                <button type="button" class="btn-primary" onclick={() => { approve(); }}>
                  Approve
                </button>
              {/if}
              {#if cr?.status === 'Approved'}
                <button type="button" class="btn-primary" onclick={() => { merge(); }}>
                  Merge
                </button>
              {/if}
            {/snippet}
            {#snippet summary()}
              <div class="cr-detail-header card">
                <div class="cr-detail-meta">
                  <StatusPill label={status_label(String(cr?.status ?? 'Draft'))} variant={status_variant(String(cr?.status ?? 'Draft'))} />
                  <span class="cr-detail-author">by <strong>{cr?.author ? String(cr.author) : '—'}</strong></span>
                  <span class="cr-detail-branch"><code>{cr?.source_branch ? String(cr.source_branch) : '—'}</code> → <code>{cr?.target_branch ? String(cr.target_branch) : 'main'}</code></span>
                </div>
                {#if cr?.description}
                  <p class="cr-detail-desc">{String(cr.description)}</p>
                {/if}
              </div>
            {/snippet}

            <!-- Structural Diff Section -->
            <div class="cr-section">
              <h2 class="cr-section-title">Structural Diff</h2>
              {#if diff?.description}
                <p class="cr-diff-summary">{String(diff.description)}</p>
              {/if}
              {#if diff?.changes && diff.changes.length > 0}
                <div class="cr-diff-stats">
                  <span class="plan-diff__chip plan-diff__chip--create">{diff.additions ?? 0} additions</span>
                  <span class="plan-diff__chip plan-diff__chip--destroy">{diff.removals ?? 0} removals</span>
                  <span class="plan-diff__chip">{diff.files_changed ?? 0} files</span>
                </div>
                <ul class="cr-diff-list">
                  {#each diff.changes as change, i}
                    <li class={`cr-diff-item ${diff_kind_class(String(change.kind))}`} style="--dk-i: {i}">
                      <span class="cr-diff-icon" aria-hidden="true">{diff_kind_icon(String(change.kind))}</span>
                      <div class="cr-diff-body">
                        <span class="cr-diff-detail">{change.detail ? String(change.detail) : String(change.path)}</span>
                        {#if change.construct_type}
                          <span class="cr-diff-construct">{String(change.construct_type)}</span>
                        {/if}
                        <span class="cr-diff-path">{String(change.path)}</span>
                      </div>
                    </li>
                  {/each}
                </ul>
              {:else if !loading}
                <p class="hint">No structural changes detected.</p>
              {/if}
            </div>

            <!-- Sidebar metadata -->
            <div class="cr-meta-grid">
              <div class="cr-meta-card card">
                <h3 class="cr-meta-title">Metadata</h3>
                <dl class="cr-meta-dl">
                  <dt>Jira Ticket</dt>
                  <dd>{cr?.jira_ticket ? String(cr.jira_ticket) : '—'}</dd>
                  <dt>Created</dt>
                  <dd>{cr?.created_at ? String(cr.created_at).slice(0, 10) : '—'}</dd>
                  <dt>Updated</dt>
                  <dd>{cr?.updated_at ? String(cr.updated_at).slice(0, 10) : '—'}</dd>
                  {#if cr?.merged_at}
                    <dt>Merged</dt>
                    <dd>{String(cr.merged_at).slice(0, 10)} by {cr?.merged_by ? String(cr.merged_by) : '—'}</dd>
                  {/if}
                </dl>
              </div>
              <div class="cr-meta-card card">
                <h3 class="cr-meta-title">CI Status</h3>
                {#if ci?.status}
                  <StatusPill label={String(ci.status)} variant={ci_variant(String(ci.status))} />
                  {#if ci?.duration_ms}
                    <span class="cr-ci-duration">{Math.round(Number(ci.duration_ms) / 1000)}s</span>
                  {/if}
                  {#if ci?.error_summary}
                    <p class="cr-ci-error">{String(ci.error_summary)}</p>
                  {/if}
                {:else}
                  <span class="hint">No CI run yet</span>
                {/if}
              </div>
              <div class="cr-meta-card card">
                <h3 class="cr-meta-title">Approvals</h3>
                {#if approvals.length > 0}
                  <ul class="cr-approvals-list">
                    {#each approvals as a}
                      <li>
                        <strong>{a.reviewer ? String(a.reviewer) : '—'}</strong>
                        <span class="cr-approval-date">{a.approved_at ? String(a.approved_at).slice(0, 10) : ''}</span>
                      </li>
                    {/each}
                  </ul>
                {:else}
                  <span class="hint">No approvals yet</span>
                {/if}
              </div>
            </div>

            <!-- Comments Section -->
            <div class="cr-section">
              <h2 class="cr-section-title">Comments</h2>
              {#if comments.length > 0}
                <div class="cr-comments">
                  {#each comments as comment, i}
                    <div class="cr-comment" style="--dk-i: {i}">
                      {#if comment.construct_path}
                        <span class="cr-comment-anchor">{String(comment.construct_path)}</span>
                      {/if}
                      <div class="cr-comment-header">
                        <strong>{comment.author ? String(comment.author) : '—'}</strong>
                        <span class="cr-comment-time">{comment.created_at ? String(comment.created_at).slice(0, 16).replace('T', ' ') : ''}</span>
                        {#if comment.resolved}
                          <span class="cr-comment-resolved">✓ Resolved</span>
                        {/if}
                      </div>
                      <p class="cr-comment-body">{comment.body ? String(comment.body) : ''}</p>
                    </div>
                  {/each}
                </div>
              {:else if !loading}
                <p class="hint">No comments yet.</p>
              {/if}

              <!-- Add comment form -->
              {#if cr?.status && cr.status !== 'Merged' && cr.status !== 'Rejected' && cr.status !== 'Closed'}
                <div class="cr-comment-form card">
                  <FormField label="Construct path (optional)" bind:value={new_comment_path} placeholder="e.g. HandleListProviders.authorize" />
                  <FormField label="Comment" bind:value={new_comment} input_type="textarea" placeholder="Add a comment…" />
                  <div class="cr-comment-form-actions">
                    <button
                      type="button"
                      class="btn-primary"
                      disabled={comment_submitting || !new_comment}
                      onclick={() => { comment_submitting = true; }}
                    >
                      {comment_submitting ? 'Posting…' : 'Post Comment'}
                    </button>
                  </div>
                </div>
              {/if}
            </div>
          </DetailShell>
        """
        style """
          .cr-detail-header { padding: 1rem 1.15rem; display: flex; flex-direction: column; gap: 0.65rem; margin-bottom: 0.5rem; }
          .cr-detail-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.65rem; }
          .cr-detail-author { font-size: 0.85rem; color: var(--dk-text-muted); }
          .cr-detail-branch { font-size: 0.82rem; color: var(--dk-text-muted); }
          .cr-detail-branch code { font-size: 0.78rem; padding: 0.1rem 0.4rem; background: var(--dk-surface-2, rgba(0,0,0,0.05)); border-radius: 0.3rem; }
          .cr-detail-desc { margin: 0; font-size: 0.9rem; color: var(--text-dim); }
          .cr-section { margin-top: 1.5rem; }
          .cr-section-title {
            font-size: 0.72rem; font-weight: 650; text-transform: uppercase;
            letter-spacing: 0.08em; color: var(--dk-text-muted); margin: 0 0 0.75rem;
          }
          .cr-diff-summary {
            font-size: 0.95rem; font-weight: 600; color: var(--text);
            margin: 0 0 0.75rem; padding: 0.65rem 0.85rem;
            background: color-mix(in srgb, var(--accent) 8%, transparent);
            border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
            border-radius: 0.5rem;
          }
          .cr-diff-stats { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.75rem; }
          .cr-diff-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.25rem; }
          .cr-diff-item {
            display: flex; align-items: flex-start; gap: 0.65rem;
            padding: 0.55rem 0.85rem; border-radius: 0.45rem;
            border-left: 3px solid var(--dk-border-soft);
            background: var(--dk-surface-2, rgba(0,0,0,0.02));
            animation: prov-step-in 0.25s var(--dk-ease-out, cubic-bezier(0.16, 1, 0.3, 1)) both;
            animation-delay: calc(var(--dk-i, 0) * 40ms + 50ms);
          }
          .cr-diff-item.dk-diff-added { border-left-color: var(--dk-green, #22c55e); background: color-mix(in srgb, var(--dk-green, #22c55e) 6%, transparent); }
          .cr-diff-item.dk-diff-modified { border-left-color: var(--dk-amber, #f59e0b); background: color-mix(in srgb, var(--dk-amber, #f59e0b) 6%, transparent); }
          .cr-diff-item.dk-diff-removed { border-left-color: var(--dk-red, #ef4444); background: color-mix(in srgb, var(--dk-red, #ef4444) 6%, transparent); }
          .cr-diff-icon {
            font-weight: 700; font-size: 0.9rem; min-width: 1.1rem; text-align: center;
            color: var(--dk-text-muted); line-height: 1.4;
          }
          .dk-diff-added .cr-diff-icon { color: var(--dk-green, #22c55e); }
          .dk-diff-modified .cr-diff-icon { color: var(--dk-amber, #f59e0b); }
          .dk-diff-removed .cr-diff-icon { color: var(--dk-red, #ef4444); }
          .cr-diff-body { display: flex; flex-direction: column; gap: 0.1rem; }
          .cr-diff-detail { font-size: 0.85rem; font-weight: 550; }
          .cr-diff-construct { font-size: 0.72rem; color: var(--dk-text-muted); text-transform: uppercase; letter-spacing: 0.04em; }
          .cr-diff-path { font-size: 0.75rem; color: var(--dk-text-muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
          .cr-meta-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1.5rem; }
          @media (max-width: 900px) { .cr-meta-grid { grid-template-columns: 1fr; } }
          .cr-meta-card { padding: 0.85rem 1rem; display: flex; flex-direction: column; gap: 0.5rem; }
          .cr-meta-title {
            font-size: 0.72rem; font-weight: 650; text-transform: uppercase;
            letter-spacing: 0.06em; color: var(--dk-text-muted); margin: 0;
          }
          .cr-meta-dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 0.25rem 0.75rem; font-size: 0.82rem; }
          .cr-meta-dl dt { color: var(--dk-text-muted); font-weight: 550; }
          .cr-meta-dl dd { margin: 0; }
          .cr-ci-duration { font-size: 0.8rem; color: var(--dk-text-muted); }
          .cr-ci-error { font-size: 0.82rem; color: var(--dk-red, #ef4444); margin: 0.25rem 0 0; }
          .cr-approvals-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.85rem; }
          .cr-approval-date { font-size: 0.75rem; color: var(--dk-text-muted); margin-left: 0.5rem; }
          .cr-comments { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1rem; }
          .cr-comment {
            padding: 0.75rem 1rem; border-radius: 0.5rem;
            background: var(--dk-surface-2, rgba(0,0,0,0.03));
            border: 1px solid var(--dk-border-soft, var(--border));
            animation: dk-fade-up 0.3s var(--dk-ease-out, ease) both;
            animation-delay: calc(var(--dk-i, 0) * 40ms);
          }
          .cr-comment-anchor {
            display: inline-block; font-size: 0.68rem; font-weight: 650;
            padding: 0.1rem 0.45rem; border-radius: 999px; margin-bottom: 0.35rem;
            background: color-mix(in srgb, var(--accent) 12%, transparent);
            border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
            color: var(--accent);
            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
          }
          .cr-comment-header { display: flex; align-items: center; gap: 0.5rem; font-size: 0.82rem; }
          .cr-comment-time { font-size: 0.75rem; color: var(--dk-text-muted); }
          .cr-comment-resolved { font-size: 0.72rem; color: var(--dk-green, #22c55e); font-weight: 600; }
          .cr-comment-body { margin: 0.35rem 0 0; font-size: 0.88rem; line-height: 1.5; }
          .cr-comment-form { padding: 0.85rem 1rem; display: flex; flex-direction: column; gap: 0.65rem; }
          .cr-comment-form-actions { display: flex; justify-content: flex-end; }
          .hint { color: var(--dk-text-muted); font-size: 0.9rem; margin: 0; }
        """

    group pages
      layout AppLayout
        @route("/")
        template """
          <div class="shell">
            <Sidebar />
            <div class="content">
              <main class="shell-main">
                <AgentSurface />
                {@render children()}
              </main>
              <StatusBar status="connected" />
            </div>
          </div>
        """
        style """
          .shell {
            display: flex;
            height: 100vh;
            width: 100%;
            overflow: hidden;
            background: transparent;
          }
          .content {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
          }
          main.shell-main {
            flex: 1;
            overflow-y: auto;
            max-width: none;
            margin: 0;
            padding: 1.75rem 1.75rem 2rem;
            animation: none;
          }
        """

      page Dashboard
        @route("/dashboard")
        template """
          <DashboardView />
        """

      page Projects
        @route("/projects")
        template """
          <ProjectsView />
        """

      page ProjectCreate
        @route("/projects/new")
        template """
          <ProjectCreateView />
        """

      page ProjectDetail
        @route("/projects/[id]")
        template """
          <ProjectDetailView />
        """

      page Deploy
        @route("/deploy")
        template """
          <DeployView />
        """

      page Registry
        @route("/registry")
        template """
          <RegistryView />
        """

      page Bus
        @route("/bus")
        template """
          <BusView />
        """

      page Agents
        @route("/agents")
        template """
          <AgentsView />
        """

      page Config
        @route("/config")
        template """
          <ConfigView />
        """

      page Changes
        @route("/changes")
        template """
          <ChangesView />
        """

      page ChangeDetail
        @route("/changes/[id]")
        template """
          <ChangeDetailView />
        """
