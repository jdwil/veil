pkg VeilRuntime
  use ddd
  use di
  use aws_storage
  use rig
  use transports
  use axum
  use gix
  use tempfile
  use schemars
  use sha2
  use zip
  use aws_sdk_s3 as s3
  use aws_sdk_dynamodb as ddb
  use aws_sdk_lambda as lambda
  use aws_sdk_sqs as sqs
  use aws_sdk_sns as sns
  use aws_sdk_apigatewayv2 as apigw
  use aws_config as cfg
  use veil_local_fs
  use veil_ext_store
  link veil-parser
  link veil-ir

  # ═══════════════════════════════════════════════════════════════════════════
  # Storage — VCS, Registry, Compiler, Deployer
  # ═══════════════════════════════════════════════════════════════════════════

  ctx Storage
    group domain
      # ─── Identifiers ────────────────────────────────────────────────────
      val RepoId
        value: Str

      val ArtifactId
        value: Str

      val LayerId
        value: Str

      val StubId
        value: Str

      # ─── Enums ──────────────────────────────────────────────────────────
      enum CompilationTarget
        LinuxX86_64
        LinuxAarch64

      enum DeployTarget
        Lambda
          function_name: Str
          region: Str
        Container
          repository_uri: Str
          tag: Str

      enum DeploymentStatus
        InProgress
        Succeeded
        Failed
          reason: Str

      enum ChangeType
        Added
        Modified
        Deleted
        Renamed
          from: Str

      enum DependencyKind
        Layer
        Stub
        Repo

      # ─── Domain Types ───────────────────────────────────────────────────
      agg Repo
        root
          id: RepoId
          name: Str
          slug: Str
          description: Opt<Str>
          default_branch: Str
          created_at: Dt
          updated_at: Dt

      val BranchInfo
        name: Str
        head_commit: Str
        updated_at: Dt

      val TagInfo
        name: Str
        commit: Str
        message: Opt<Str>
        created_at: Dt

      val CommitInfo
        hash: Str
        message: Str
        author: Str
        timestamp: Dt
        parent_hashes: List<Str>
        files_changed: List<Str>

      val DiffEntry
        path: Str
        change_type: ChangeType
        old_content: Opt<Str>
        new_content: Opt<Str>

      ent ArtifactMetadata
        id: ArtifactId
        repo_id: RepoId
        branch: Str
        commit_hash: Str
        content_hash: Str
        target: CompilationTarget
        s3_key: Str
        size_bytes: Int
        compiled_at: Dt

      val DeploymentRecord
        artifact_id: ArtifactId
        target: DeployTarget
        deployed_at: Dt
        status: DeploymentStatus

      ent LayerMetadata
        id: LayerId
        name: Str
        repo_id: RepoId
        versions: List<Str>
        latest_version: Opt<Str>
        registered_at: Dt

      ent StubMetadata
        id: StubId
        name: Str
        crate_name: Str
        version: Str
        registered_at: Dt

      val DependencyEdge
        dependent: RepoId
        dependency: Str
        kind: DependencyKind

      # ─── Ports ──────────────────────────────────────────────────────────
      port ObjectStorage
        put!(key: Str, data: Bytes)
        get!(key: Str) -> Bytes
        delete!(key: Str)
        exists!(key: Str) -> Bool
        list!(prefix: Str) -> List<Str>
        size!(key: Str) -> Int

      port MetadataStore
        # Repos
        create_repo!(metadata: Repo)
        get_repo!(id: RepoId) -> Repo
        list_repos!() -> List<Repo>
        delete_repo!(id: RepoId)
        # Branches
        put_branch!(repo_id: RepoId, branch: BranchInfo)
        get_branch!(repo_id: RepoId, name: Str) -> BranchInfo
        list_branches!(repo_id: RepoId) -> List<BranchInfo>
        delete_branch!(repo_id: RepoId, name: Str)
        # Tags
        put_tag!(repo_id: RepoId, tag: TagInfo)
        get_tag!(repo_id: RepoId, name: Str) -> TagInfo
        list_tags!(repo_id: RepoId) -> List<TagInfo>
        delete_tag!(repo_id: RepoId, name: Str)
        # Commits
        put_commit!(repo_id: RepoId, commit: CommitInfo)
        list_commits!(repo_id: RepoId, branch: Opt<Str>, limit: Int, offset: Int) -> List<CommitInfo>
        file_history!(repo_id: RepoId, path: Str, limit: Int) -> List<CommitInfo>
        # Artifacts
        put_artifact!(artifact: ArtifactMetadata)
        get_artifact!(id: ArtifactId) -> ArtifactMetadata
        find_artifact_by_hash!(content_hash: Str, target: CompilationTarget) -> Opt<ArtifactMetadata>
        list_artifacts!(repo_id: RepoId, branch: Opt<Str>) -> List<ArtifactMetadata>
        # Deployments
        put_deployment!(record: DeploymentRecord)
        list_deployments!(artifact_id: ArtifactId) -> List<DeploymentRecord>
        # Layers
        put_layer!(layer: LayerMetadata)
        get_layer!(name: Str) -> LayerMetadata
        list_layers!() -> List<LayerMetadata>
        # Stubs
        put_stub!(stub: StubMetadata)
        get_stub!(crate_name: Str) -> StubMetadata
        list_stubs!() -> List<StubMetadata>
        # Dependencies
        put_dependency!(edge: DependencyEdge)
        get_dependencies!(repo_id: RepoId) -> List<DependencyEdge>
        get_dependents!(dependency: Str) -> List<DependencyEdge>

    group application
      svc CreateRepo
        -> Repo
        input
          name: Str
          description: Opt<Str>
        step execute
          id = RepoId{value: Uuid.new_v4().to_string()}
          now = Dt.now()
          slug = name.to_lowercase().replace(' ', "-").replace('_', "-")
          repo = Repo{id, name, slug, description, default_branch: "main", created_at: now, updated_at: now}
          MetadataStore.create_repo!(repo)
          branch = BranchInfo{name: "main", head_commit: "", updated_at: now}
          MetadataStore.put_branch!(id, branch)
          ret repo

      svc ListRepos
        -> List<Repo>
        step query
          repos = MetadataStore.list_repos!()
          ret repos

      svc GetRepo
        -> Repo
        input
          id: Str
        step query
          rid = RepoId{value: id}
          repo = MetadataStore.get_repo!(rid)
          ret repo

      svc DeleteRepo
        input
          id: Str
        step execute
          rid = RepoId{value: id}
          MetadataStore.delete_repo!(rid)

      # Project hub config + deploy intent from veil.toml [deploy]
      # Prefer S3 ObjectStorage (repos/{id}/{branch}/veil.toml) like live; fall back to disk hub.
      svc GetProjectInfra
        -> Json
        input
          id: Str
          environment: Opt<Str>
        step load
          rid = RepoId{value: id}
          repo = MetadataStore.get_repo!(rid)
          s3_key = f"repos/{repo.id.value}/{repo.default_branch}/veil.toml"
          mut source = "disk"
          if ObjectStorage.exists!(s3_key)
            source = "s3"
          snap_str = LocalFs.read_project_deploy!(repo.slug)
          mut snap: Json = Json.parse(snap_str)
          # Platform env catalog (mirrors runtime/config/deploy.toml defaults).
          mut env_catalog: Json = Json.parse("{\"default\":\"dev\",\"environments\":[{\"name\":\"dev\",\"region\":\"us-west-2\",\"account_id\":null,\"has_assume_role\":false,\"assume_role_arn\":null,\"lambda_execution_role_arn\":null,\"gateways\":[{\"logical\":\"dashlx-services\",\"patterns\":[\"dlx-rust-*\",\"*-dev-service-api\",\"dashlx-services\"]}]},{\"name\":\"staging\",\"region\":\"us-west-2\",\"account_id\":null,\"has_assume_role\":false,\"assume_role_arn\":null,\"lambda_execution_role_arn\":null,\"gateways\":[{\"logical\":\"dashlx-services\",\"patterns\":[\"dlx-rust-*\",\"*-staging-service-api\",\"dashlx-services\"]}]},{\"name\":\"prod\",\"region\":\"us-west-2\",\"account_id\":null,\"has_assume_role\":false,\"assume_role_arn\":null,\"lambda_execution_role_arn\":null,\"gateways\":[{\"logical\":\"dashlx-services\",\"patterns\":[\"dlx-rust-*\",\"*-prod-service-api\",\"dashlx-services\"]}]}],\"config_path\":\"runtime/config/deploy.toml\"}")
          mut env_name = "dev"
          if environment.is_some()
            env_name = environment.unwrap()
          ret {repo: repo, infra: snap, environment: env_name, environments: env_catalog, source: source, s3_key: s3_key}

      # Dev helper: push local projects hub tree into S3 ObjectStorage (seed live-like source).
      svc SyncRepoToObjectStore
        -> Json
        input
          id: Str
          branch: Str
        step sync
          rid = RepoId{value: id}
          repo = MetadataStore.get_repo!(rid)
          hub = LocalFs.projects_dir()
          root = LocalFs.join(hub, repo.slug)
          mut uploaded = 0
          mut skipped = 0
          if LocalFs.path_exists(root)
            names = LocalFs.list_dir!(root)
            for name in names
              if name == ".git" || name == "target" || name == "generated" || name == "node_modules" || name == ".veil" || name == "dist"
                skipped = skipped + 1
              else
                path = LocalFs.join(root, name)
                if LocalFs.path_is_file(path)
                  body = LocalFs.read!(path)
                  key = f"repos/{repo.id.value}/{branch}/{name}"
                  ObjectStorage.put!(key, body.into_bytes())
                  uploaded = uploaded + 1
                else
                  skipped = skipped + 1
          ret {repo_id: repo.id.value, branch: branch, uploaded: uploaded, skipped: skipped, local_root: root}

      svc WriteFile
        -> CommitInfo
        input
          repo_id: RepoId
          branch: Str
          path: Str
          content: Str
          message: Str
        step execute
          key = f"repos/{repo_id.value}/{branch}/{path}"
          hash = content.len().to_string()
          ObjectStorage.put!(key, content.into_bytes())
          now = Dt.now()
          commit = CommitInfo{hash, message, author: "system", timestamp: now, parent_hashes: [], files_changed: [path]}
          MetadataStore.put_commit!(repo_id, commit)
          ret commit

      svc ReadFile
        -> Bytes
        input
          repo_id: RepoId
          branch: Str
          path: Str
        step query
          key = f"repos/{repo_id.value}/{branch}/{path}"
          data = ObjectStorage.get!(key)
          ret data

      svc ListFiles
        -> List<Str>
        input
          repo_id: RepoId
          branch: Str
          prefix: Str
        step query
          key_prefix = f"repos/{repo_id.value}/{branch}/{prefix}"
          files = ObjectStorage.list!(key_prefix)
          ret files

      svc CreateBranch
        -> BranchInfo
        input
          repo_id: RepoId
          name: Str
          from_ref: Str
        step execute
          source = MetadataStore.get_branch!(repo_id, from_ref)
          now = Dt.now()
          branch = BranchInfo{name, head_commit: source.head_commit, updated_at: now}
          MetadataStore.put_branch!(repo_id, branch)
          ret branch

      svc ListBranches
        -> List<BranchInfo>
        input
          repo_id: RepoId
        step query
          branches = MetadataStore.list_branches!(repo_id)
          ret branches

      svc GetDiff
        -> List<DiffEntry>
        input
          repo_id: RepoId
          from_ref: Str
          to_ref: Str
        step query
          # Diff is computed by comparing file trees between refs
          from_files = ObjectStorage.list!(f"repos/{repo_id.value}/{from_ref}/")
          to_files = ObjectStorage.list!(f"repos/{repo_id.value}/{to_ref}/")
          ret []

      svc Compile
        -> ArtifactMetadata
        input
          repo_id: RepoId
          branch: Str
          target: CompilationTarget
        step execute
          branch_info = MetadataStore.get_branch!(repo_id, branch)
          hash = branch_info.head_commit
          id = ArtifactId{value: hash}
          now = Dt.now()
          s3_key = f"artifacts/{hash}/binary"
          artifact = ArtifactMetadata{id, repo_id, branch, commit_hash: hash, content_hash: hash, target, s3_key, size_bytes: 0, compiled_at: now}
          MetadataStore.put_artifact!(artifact)
          ret artifact

      svc Deploy
        -> DeploymentRecord
        input
          artifact_id: ArtifactId
          target: DeployTarget
        step execute
          now = Dt.now()
          record = DeploymentRecord{artifact_id, target, deployed_at: now, status: DeploymentStatus.InProgress}
          MetadataStore.put_deployment!(record)
          ret record

      svc GetCommitLog
        -> List<CommitInfo>
        input
          repo_id: RepoId
          branch: Opt<Str>
          limit: Int
          offset: Int
        step query
          commits = MetadataStore.list_commits!(repo_id, branch, limit, offset)
          ret commits

    group infrastructure
      adapter S3ObjectStorage for ObjectStorage
        @field(client: S3Client)
        @env(BUCKET)
        impl put(key, data)
          client.put_object().bucket(bucket).key(key).body(data).send!()
        impl get(key)
          resp = client.get_object().bucket(bucket).key(key).send!()
          ret resp.body.collect().await.unwrap().into_bytes().to_vec()
        impl delete(key)
          client.delete_object().bucket(bucket).key(key).send!()
        impl exists(key)
          resp = client.head_object().bucket(bucket).key(key).send()
          ret resp.is_ok()
        impl list(prefix)
          resp = client.list_objects_v2().bucket(bucket).prefix(prefix).send!()
          ret resp.contents().iter().filter_map(|o| o.key().map(|k| k.to_string())).collect()
        impl size(key)
          resp = client.head_object().bucket(bucket).key(key).send!()
          ret resp.content_length().unwrap_or(0)
      adapter DdbMetadataStore for MetadataStore
        @field(client: DdbClient, table)
        impl create_repo(metadata)
          client.put_item().table_name(table).item("PK", AttributeValue.S(f"REPO#{metadata.id.value}")).item("SK", AttributeValue.S("META")).item("data", AttributeValue.S(Json.stringify(metadata))).send!()
        impl get_repo(id)
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND SK = :sk").expression_attribute_values(":pk", AttributeValue.S(f"REPO#{id.value}")).expression_attribute_values(":sk", AttributeValue.S("META")).send!()
          items = resp.items()
          if items.is_empty() then ret null
          ret Json.parse(items[0].get("data").unwrap().as_s().unwrap())
        impl list_repos()
          # Scan + filter: Query cannot begins_with on PK without a GSI.
          resp = client.scan().table_name(table).filter_expression("begins_with(PK, :prefix) AND SK = :sk").expression_attribute_values(":prefix", AttributeValue.S("REPO#")).expression_attribute_values(":sk", AttributeValue.S("META")).send!()
          ret resp.items().iter().map(|i| Json.parse(i.get("data").unwrap().as_s().unwrap())).collect()
        impl delete_repo(id)
          client.delete_item().table_name(table).key("PK", AttributeValue.S(f"REPO#{id.value}")).key("SK", AttributeValue.S("META")).send!()
        impl put_branch(repo_id, branch)
          client.put_item().table_name(table).item("PK", AttributeValue.S(f"REPO#{repo_id.value}")).item("SK", AttributeValue.S(f"BRANCH#{branch.name}")).item("data", AttributeValue.S(Json.stringify(branch))).send!()
        impl get_branch(repo_id, name)
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND SK = :sk").expression_attribute_values(":pk", AttributeValue.S(f"REPO#{repo_id.value}")).expression_attribute_values(":sk", AttributeValue.S(f"BRANCH#{name}")).send!()
          items = resp.items()
          if items.is_empty() then ret null
          ret Json.parse(items[0].get("data").unwrap().as_s().unwrap())
        impl list_branches(repo_id)
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND begins_with(SK, :prefix)").expression_attribute_values(":pk", AttributeValue.S(f"REPO#{repo_id.value}")).expression_attribute_values(":prefix", AttributeValue.S("BRANCH#")).send!()
          ret resp.items().iter().map(|i| Json.parse(i.get("data").unwrap().as_s().unwrap())).collect()
        impl delete_branch(repo_id, name)
          client.delete_item().table_name(table).key("PK", AttributeValue.S(f"REPO#{repo_id.value}")).key("SK", AttributeValue.S(f"BRANCH#{name}")).send!()
        impl put_tag(repo_id, tag)
          client.put_item().table_name(table).item("PK", AttributeValue.S(f"REPO#{repo_id.value}")).item("SK", AttributeValue.S(f"TAG#{tag.name}")).item("data", AttributeValue.S(Json.stringify(tag))).send!()
        impl get_tag(repo_id, name)
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND SK = :sk").expression_attribute_values(":pk", AttributeValue.S(f"REPO#{repo_id.value}")).expression_attribute_values(":sk", AttributeValue.S(f"TAG#{name}")).send!()
          items = resp.items()
          if items.is_empty() then ret null
          ret Json.parse(items[0].get("data").unwrap().as_s().unwrap())
        impl list_tags(repo_id)
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND begins_with(SK, :prefix)").expression_attribute_values(":pk", AttributeValue.S(f"REPO#{repo_id.value}")).expression_attribute_values(":prefix", AttributeValue.S("TAG#")).send!()
          ret resp.items().iter().map(|i| Json.parse(i.get("data").unwrap().as_s().unwrap())).collect()
        impl delete_tag(repo_id, name)
          client.delete_item().table_name(table).key("PK", AttributeValue.S(f"REPO#{repo_id.value}")).key("SK", AttributeValue.S(f"TAG#{name}")).send!()
        impl put_commit(repo_id, commit)
          client.put_item().table_name(table).item("PK", AttributeValue.S(f"REPO#{repo_id.value}")).item("SK", AttributeValue.S(f"COMMIT#{commit.hash}")).item("data", AttributeValue.S(Json.stringify(commit))).send!()
        impl list_commits(repo_id, branch, limit, offset)
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND begins_with(SK, :prefix)").expression_attribute_values(":pk", AttributeValue.S(f"REPO#{repo_id.value}")).expression_attribute_values(":prefix", AttributeValue.S("COMMIT#")).limit(limit).send!()
          ret resp.items().iter().map(|i| Json.parse(i.get("data").unwrap().as_s().unwrap())).collect()
        impl file_history(repo_id, path, limit)
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND begins_with(SK, :prefix)").expression_attribute_values(":pk", AttributeValue.S(f"REPO#{repo_id.value}")).expression_attribute_values(":prefix", AttributeValue.S("COMMIT#")).limit(limit).send!()
          ret resp.items().iter().map(|i| Json.parse(i.get("data").unwrap().as_s().unwrap())).collect()
        impl put_artifact(artifact)
          client.put_item().table_name(table).item("PK", AttributeValue.S(f"ARTIFACT#{artifact.id.value}")).item("SK", AttributeValue.S("META")).item("data", AttributeValue.S(Json.stringify(artifact))).send!()
        impl get_artifact(id)
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND SK = :sk").expression_attribute_values(":pk", AttributeValue.S(f"ARTIFACT#{id.value}")).expression_attribute_values(":sk", AttributeValue.S("META")).send!()
          items = resp.items()
          if items.is_empty() then ret null
          ret Json.parse(items[0].get("data").unwrap().as_s().unwrap())
        impl find_artifact_by_hash(content_hash, target)
          resp = client.query().table_name(table).index_name("content_hash_index").key_condition_expression("content_hash = :h").expression_attribute_values(":h", AttributeValue.S(content_hash)).send!()
          items = resp.items()
          if items.is_empty() then ret null
          ret Json.parse(items[0].get("data").unwrap().as_s().unwrap())
        impl list_artifacts(repo_id, branch)
          resp = client.query().table_name(table).key_condition_expression("begins_with(PK, :prefix)").expression_attribute_values(":prefix", AttributeValue.S("ARTIFACT#")).send!()
          ret resp.items().iter().map(|i| Json.parse(i.get("data").unwrap().as_s().unwrap())).collect()
        impl put_deployment(record)
          target_key = Json.stringify(record.target)
          client.put_item().table_name(table).item("PK", AttributeValue.S(f"DEPLOY#{record.artifact_id.value}")).item("SK", AttributeValue.S(f"TARGET#{target_key}")).item("data", AttributeValue.S(Json.stringify(record))).send!()
        impl list_deployments(artifact_id)
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND begins_with(SK, :prefix)").expression_attribute_values(":pk", AttributeValue.S(f"DEPLOY#{artifact_id.value}")).expression_attribute_values(":prefix", AttributeValue.S("TARGET#")).send!()
          ret resp.items().iter().map(|i| Json.parse(i.get("data").unwrap().as_s().unwrap())).collect()
        impl put_layer(layer)
          client.put_item().table_name(table).item("PK", AttributeValue.S(f"LAYER#{layer.name}")).item("SK", AttributeValue.S("META")).item("data", AttributeValue.S(Json.stringify(layer))).send!()
        impl get_layer(name)
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND SK = :sk").expression_attribute_values(":pk", AttributeValue.S(f"LAYER#{name}")).expression_attribute_values(":sk", AttributeValue.S("META")).send!()
          items = resp.items()
          if items.is_empty() then ret null
          ret Json.parse(items[0].get("data").unwrap().as_s().unwrap())
        impl list_layers()
          resp = client.query().table_name(table).key_condition_expression("begins_with(PK, :prefix) AND SK = :sk").expression_attribute_values(":prefix", AttributeValue.S("LAYER#")).expression_attribute_values(":sk", AttributeValue.S("META")).send!()
          ret resp.items().iter().map(|i| Json.parse(i.get("data").unwrap().as_s().unwrap())).collect()
        impl put_stub(stub)
          client.put_item().table_name(table).item("PK", AttributeValue.S(f"STUB#{stub.crate_name}")).item("SK", AttributeValue.S("META")).item("data", AttributeValue.S(Json.stringify(stub))).send!()
        impl get_stub(crate_name)
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND SK = :sk").expression_attribute_values(":pk", AttributeValue.S(f"STUB#{crate_name}")).expression_attribute_values(":sk", AttributeValue.S("META")).send!()
          items = resp.items()
          if items.is_empty() then ret null
          ret Json.parse(items[0].get("data").unwrap().as_s().unwrap())
        impl list_stubs()
          resp = client.query().table_name(table).key_condition_expression("begins_with(PK, :prefix) AND SK = :sk").expression_attribute_values(":prefix", AttributeValue.S("STUB#")).expression_attribute_values(":sk", AttributeValue.S("META")).send!()
          ret resp.items().iter().map(|i| Json.parse(i.get("data").unwrap().as_s().unwrap())).collect()
        impl put_dependency(edge)
          client.put_item().table_name(table).item("PK", AttributeValue.S(f"DEP#{edge.dependent.value}")).item("SK", AttributeValue.S(f"TO#{edge.dependency}")).item("data", AttributeValue.S(Json.stringify(edge))).send!()
        impl get_dependencies(repo_id)
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND begins_with(SK, :prefix)").expression_attribute_values(":pk", AttributeValue.S(f"DEP#{repo_id.value}")).expression_attribute_values(":prefix", AttributeValue.S("TO#")).send!()
          ret resp.items().iter().map(|i| Json.parse(i.get("data").unwrap().as_s().unwrap())).collect()
        impl get_dependents(dependency)
          resp = client.query().table_name(table).index_name("dependency_index").key_condition_expression("dependency = :d").expression_attribute_values(":d", AttributeValue.S(dependency)).send!()
          ret resp.items().iter().map(|i| Json.parse(i.get("data").unwrap().as_s().unwrap())).collect()

  # ═══════════════════════════════════════════════════════════════════════════
  # Tools — Rig SDK tool definitions for agent-callable operations
  # ═══════════════════════════════════════════════════════════════════════════

  ctx Tools
    group domain
      val CreateRepoArgs
        name: Str
        description: Opt<Str>

      val WriteFileArgs
        repo_id: Str
        branch: Str
        path: Str
        content: Str
        message: Str

      val ReadFileArgs
        repo_id: Str
        branch: Str
        path: Str

      val ListFilesArgs
        repo_id: Str
        branch: Str
        prefix: Opt<Str>

      val CreateBranchArgs
        repo_id: Str
        name: Str
        from_ref: Str

      val ListBranchesArgs
        repo_id: Str

      val DiffArgs
        repo_id: Str
        from_ref: Str
        to_ref: Str

      val CompileArgs
        repo_id: Str
        branch: Str
        target: Str

      val DeployArgs
        artifact_id: Str
        target: Str
        tag: Opt<Str>

      val ListReposArgs

      val LogArgs
        repo_id: Str
        branch: Opt<Str>
        limit: Opt<Int>

      # EXT-07: agent must validate reaction graph nodes against palette
      val ValidateReactionPaletteArgs
        node_kinds: List<Str>

    group application
      tool CreateRepoTool
        -> Json
        @desc("Create a new VEIL repository")
        input
          name: Str
          description: Opt<Str>
        step execute
          result = request CreateRepo{name, description}
          ret result

      tool WriteFileTool
        -> Json
        @desc("Write a file to a VEIL repository and commit the change")
        input
          repo_id: Str
          branch: Str
          path: Str
          content: Str
          message: Str
        step execute
          id = repo_id
          result = invoke WriteFile{repo_id: id, branch, path, content, message}
          ret result

      tool ReadFileTool
        -> Json
        @desc("Read a file from a VEIL repository")
        input
          repo_id: Str
          branch: Str
          path: Str
        step execute
          id = repo_id
          result = invoke ReadFile{repo_id: id, branch, path}
          ret {content: result, path}

      tool ListFilesTool
        -> Json
        @desc("List files in a VEIL repository")
        input
          repo_id: Str
          branch: Str
          prefix: Opt<Str>
        step execute
          id = repo_id
          p = prefix.unwrap_or("")
          files = invoke ListFiles{repo_id: id, branch, prefix: p}
          ret {files}

      tool CreateBranchTool
        -> Json
        @desc("Create a new branch in a VEIL repository")
        input
          repo_id: Str
          name: Str
          from_ref: Str
        step execute
          id = repo_id
          branch = invoke CreateBranch{repo_id: id, name, from_ref}
          ret branch

      tool ListBranchesTool
        -> Json
        @desc("List all branches in a VEIL repository")
        input
          repo_id: Str
        step execute
          id = repo_id
          branches = invoke ListBranches{repo_id: id}
          ret branches

      tool DiffTool
        -> Json
        @desc("Get the diff between two refs in a VEIL repository")
        input
          repo_id: Str
          from_ref: Str
          to_ref: Str
        step execute
          id = repo_id
          diff = invoke GetDiff{repo_id: id, from_ref, to_ref}
          ret diff

      tool CompileTool
        -> Json
        @desc("Compile a VEIL project. Produces a binary cached by content hash.")
        input
          repo_id: Str
          branch: Str
          target: Str
        step execute
          id = repo_id
          result = invoke Compile{repo_id: id, branch, target}
          ret result

      tool DeployTool
        -> Json
        @desc("Deploy a compiled VEIL artifact to Lambda or as a container image")
        input
          artifact_id: Str
          target: Str
          tag: Opt<Str>
        step execute
          aid = artifact_id
          result = invoke Deploy{artifact_id: aid, target, tag}
          ret result

      tool ListReposTool
        -> Json
        @desc("List all VEIL repositories")
        step execute
          repos = invoke ListRepos{}
          ret repos

      tool LogTool
        -> Json
        @desc("Get commit history for a VEIL repository")
        input
          repo_id: Str
          branch: Opt<Str>
          limit: Opt<Int>
        step execute
          id = repo_id
          l = limit.unwrap_or(20)
          commits = invoke GetCommitLog{repo_id: id, branch, limit: l, offset: 0}
          ret commits

      # EXT-07: server-side palette gate — agents must call before applying reaction graph edits
      tool ValidateReactionPaletteTool
        -> Json
        @desc("Reject reaction node kinds outside the EXT-05 palette (Guard, Activate, Map, EmitEvent, End). Call before applying any agent-proposed reaction graph. Returns {ok:bool, message:str}.")
        input
          node_kinds: List<Str>
        step execute
          ok = invoke ValidateReactionPalette{node_kinds: node_kinds}
          if ok
            ret {ok: true, message: "palette ok"}
          ret {ok: false, message: "rejected: one or more node kinds are outside the reaction palette (allowed: Guard, Activate, Map, EmitEvent, End)"}

      tool ProposeReactionGraphTool
        -> Json
        @desc("Apply a proposed reaction node list only if ValidateReactionPalette accepts it. Rejects free-form / non-palette constructs.")
        input
          node_kinds: List<Str>
        step execute
          ok = invoke ValidateReactionPalette{node_kinds: node_kinds}
          if ok == false
            ret {ok: false, accepted: false, message: "rejected: graph not presentable with configured palette", node_kinds: node_kinds}
          ret {ok: true, accepted: true, message: "accepted", node_kinds: node_kinds}

    group infrastructure

  # ═══════════════════════════════════════════════════════════════════════════
  # Daemon — WebSocket server with agent and direct tool-call modes
  # ═══════════════════════════════════════════════════════════════════════════

  ctx Daemon
    group domain
      val DaemonConfig
        port: Int
        work_dir: Str
        s3_bucket: Opt<Str>
        ddb_table: Opt<Str>
        aws_region: Str
        ecr_repository_prefix: Opt<Str>
        llm_api_key: Opt<Str>
        llm_model: Str

      enum IncomingMessage
        Agent
          message: Str
        Tool
          tool: Str
          args: Json

      enum OutgoingMessage
        Result
          data: Json
        AgentResponse
          message: Str
        Error
          message: Str
          code: Str
        Ack
          id: Opt<Str>

    group application
      svc LoadConfig
        -> DaemonConfig
        step execute
          work_dir = Env.get_or("VEIL_WORK_DIR", "/tmp/veil-runtime")
          s3_bucket = Env.get_opt("VEIL_S3_BUCKET")
          ddb_table = Env.get_opt("VEIL_DDB_TABLE")
          aws_region = Env.get_or("AWS_REGION", "us-east-1")
          ecr_prefix = Env.get_opt("VEIL_ECR_PREFIX")
          llm_api_key = Env.get_opt("OPENAI_API_KEY")
          llm_model = Env.get_or("VEIL_LLM_MODEL", "gpt-4o")
          ret DaemonConfig{port: 8080, work_dir, s3_bucket, ddb_table, aws_region, ecr_repository_prefix: ecr_prefix, llm_api_key, llm_model}

      ws_handler HandleConnection
        @path("/ws")
        input
          msg: Str
        step handle
          # Route message to agent or tool handler via Bus
          response = invoke HandleToolCall{tool: "echo", args: {}}
          send_ws response

      svc HandleAgentMessage
        -> OutgoingMessage
        input
          message: Str
        step execute
          # Placeholder — requires LLM API key
          response = OutgoingMessage.AgentResponse{message: f"Agent mode received: '{message}'. Configure OPENAI_API_KEY to enable."}
          ret response

      svc HandleToolCall
        -> OutgoingMessage
        input
          tool: Str
          args: Json
        step execute
          result = request HandleTool{tool, args}
          ret OutgoingMessage.Result{data: result}

      http_route HealthCheck
        -> Json
        @method("GET")
        @path("/health")
        step handle
          ret {status: "healthy", service: "veil-runtime"}

    group infrastructure

  # ═══════════════════════════════════════════════════════════════════════════
  # Exec — Application harness, Bus implementations, wiring, auth, security
  # ═══════════════════════════════════════════════════════════════════════════

  ctx Exec
    group domain
      # ─── Bus & Handler Types ────────────────────────────────────────────
      port Handler
        handle!(payload: Str) -> Str

      # ─── Manifest Types ─────────────────────────────────────────────────
      val Dependency
        trait_name: Str
        adapter: Opt<Str>
        provided_by: Opt<Str>
        env: List<Str>

      val HandlerInput
        name: Str
        type_desc: Str

      val HandlerDef
        function: Str
        inputs: List<HandlerInput>

      val Manifest
        context: Str
        crate_name: Str
        deps: Map<Str, Dependency>
        handlers: Map<Str, HandlerDef>

      # ─── Auth Types ─────────────────────────────────────────────────────

      enum AuthStrategy
        Bus
        External
          provider_url: Str
          client_id: Str


      # ─── Security Types ─────────────────────────────────────────────────
      enum Severity
        Info
        Warning
        Error
        Critical

      val ScanFinding
        scanner: Str
        severity: Severity
        message: Str
        location: Opt<Str>
        rule_id: Opt<Str>

      val ScanReport
        scanned_at: Dt
        passed: Bool
        findings: List<ScanFinding>
        summary: Map<Str, Int>

      val ScanConfig
        fail_threshold: Severity
        skip_clippy: Bool
        skip_audit: Bool
        skip_deny: Bool
        custom_rules: List<Str>

      # ─── Wiring Types ───────────────────────────────────────────────────
      val EnvConfig
        vars: Map<Str, Str>

      port HandlerFactory
        create_handler!(message_name: Str, env: EnvConfig) -> Opt<Json>
        context_name!() -> Str

    group application
      svc ParseManifest
        -> Manifest
        input
          json: Str
        step execute
          ret Manifest{context: json, crate_name: "unknown", deps: Map.new(), handlers: Map.new()}

      svc ReadAllManifests
        -> List<Manifest>
        input
          workspace_dir: Str
        step execute
          ret []

      svc LoadEnvConfig
        -> EnvConfig
        input
          manifests: List<Manifest>
        step execute
          # Load required env vars from manifests, fail if any missing
          vars = {}
          ret EnvConfig{vars: Map.new()}

      svc WireApplication
        -> List<Str>
        input
          manifests: List<Manifest>
          env: EnvConfig
        step execute
          # Wire handlers from manifests using registered factories
          ret []

      svc RunSecurityScan
        -> ScanReport
        input
          workspace_dir: Str
          config: ScanConfig
        step execute
          mut findings = []
          # Run security scans (clippy, audit, deny)
          # Implementation delegates to external scan runners
          now = Dt.now()
          passed = findings.is_empty()
          ret ScanReport{scanned_at: now, passed, findings, summary: Map.new()}

      svc StartHarness
        -> Json
        input
          port: Int
        step execute
          # Build HTTP router with bus endpoints and start listening
          ret {port, status: "running"}

    group infrastructure
      adapter BusAuthAdapter for AuthService
        impl validate_token(token)
          ret Principal{id: token, roles: [], claims: Map.new()}
        impl check_permission(principal, action, resource)
          ret true

  # ═══════════════════════════════════════════════════════════════════════════
  # Extensions — registry for mini-programs (Reactions, Signals, UI, …)
  # Design: application/docs/veil-extensions.md · Stories: EXT-02+
  # MUST: VEIL-authored domain/services/handlers; ports + local/AWS adapters.
  # ═══════════════════════════════════════════════════════════════════════════

  ctx Extensions
    group domain
      enum ExtensionScope
        Platform
        Product
        Tenant

      enum ExtensionKind
        Reaction
        Signal
        Activation
        UiPanel

      enum ExtensionProvenance
        Stock
        Custom

      # Lineage for duplicate-as-custom (EXT-09)
      val ExtensionLineage
        extension_id: Id
        version: Int

      # Registry row (meta). Source/artifacts live behind source/artifact ports.
      val ExtensionRecord
        extension_id: Id
        scope: ExtensionScope
        product_id: Opt<Str>
        tenant_id: Opt<Id>
        initiative_id: Opt<Id>
        kind: ExtensionKind
        provenance: ExtensionProvenance
        name: Str
        description: Opt<Str>
        current_version: Int
        params_schema: Opt<Json>
        capabilities: List<Str>
        palette_layer_refs: List<Str>
        # Local path or s3/git URI — adapter-specific
        source_uri: Str
        created_from: Opt<ExtensionLineage>
        created_on: Dt
        updated_on: Dt
        archived: Bool

      val ExtensionVersion
        extension_id: Id
        version: Int
        source_commit: Str
        # target name → artifact URI (local path or s3 key)
        artifact_uris: Json
        published_on: Dt
        published_by: Opt<Id>
        changelog: Opt<Str>

      # Meta registry (create/list/get/versions). Not the object store.
      port ExtensionRegistry
        create!(record: ExtensionRecord) -> ExtensionRecord
        get!(id: Id) -> Opt<ExtensionRecord>
        list!(scope: Opt<Str>, kind: Opt<Str>, product_id: Opt<Str>, tenant_id: Opt<Id>) -> List<ExtensionRecord>
        update!(record: ExtensionRecord) -> ExtensionRecord
        save_version!(ver: ExtensionVersion) -> ExtensionVersion
        get_version!(id: Id, version: Int) -> Opt<ExtensionVersion>
        list_versions!(id: Id) -> List<ExtensionVersion>

      # Package source tree (git-on-S3 later; local dir for dual-loop).
      port ExtensionSourceStore
        ensure_package!(id: Id) -> Str
        write_file!(id: Id, rel_path: Str, content: Str)
        read_file!(id: Id, rel_path: Str) -> Opt<Str>
        list_files!(id: Id, prefix: Str) -> List<Str>
        package_root!(id: Id) -> Str

      # Compiled artifacts (local dir or S3).
      port ExtensionArtifactStore
        put!(id: Id, version: Int, target: Str, data: Bytes) -> Str
        get_uri!(id: Id, version: Int, target: Str) -> Opt<Str>

      # Invoke result for Reactions (EXT-03 ABI).
      enum ExtensionRunStatus
        Succeeded
        Skipped
        Failed

      val ExtensionInvokeResult
        status: ExtensionRunStatus
        message: Opt<Str>
        outputs: Json

      # Firing context passed into invoke (opaque-friendly).
      val ExtensionInvokeRequest
        extension_id: Id
        version: Int
        kind: Str
        params: Json
        context: Json

      # Compile + load + run. Local adapter shells out / loads marker; AWS later.
      port ExtensionExecutor
        publish!(id: Id) -> ExtensionVersion
        invoke!(req: ExtensionInvokeRequest) -> ExtensionInvokeResult

    group application
      # Bus/HTTP services (same pattern as Storage CreateRepo / ListRepos).
      # Host maps HTTP → these services; ports via Deps + local File adapters.

      svc CreateExtension
        -> ExtensionRecord
        input
          name: Str
          kind: Str
          scope: Str
          provenance: Str
          product_id: Opt<Str>
          tenant_id: Opt<Id>
          initiative_id: Opt<Id>
          description: Opt<Str>
          params_schema: Opt<Json>
        step execute
          eid = Id.new()
          now = Dt.now()
          sc = ExtensionScope.Platform
          if scope == "Product"
            sc = ExtensionScope.Product
          if scope == "Tenant"
            sc = ExtensionScope.Tenant
          kd = ExtensionKind.Reaction
          if kind == "Signal"
            kd = ExtensionKind.Signal
          if kind == "Activation"
            kd = ExtensionKind.Activation
          if kind == "UiPanel"
            kd = ExtensionKind.UiPanel
          pv = ExtensionProvenance.Custom
          if provenance == "Stock"
            pv = ExtensionProvenance.Stock
          root = ExtensionSourceStore.ensure_package!(eid)
          rec = ExtensionRecord{extension_id: eid, scope: sc, product_id: product_id, tenant_id: tenant_id, initiative_id: initiative_id, kind: kd, provenance: pv, name: name, description: description, current_version: 0, params_schema: params_schema, capabilities: [], palette_layer_refs: [], source_uri: root, created_from: null, created_on: now, updated_on: now, archived: false}
          saved = ExtensionRegistry.create!(rec)
          ret saved

      svc ListExtensions
        -> List<ExtensionRecord>
        input
          scope: Opt<Str>
          kind: Opt<Str>
          product_id: Opt<Str>
          tenant_id: Opt<Id>
        step execute
          items = ExtensionRegistry.list!(scope, kind, product_id, tenant_id)
          ret items

      svc GetExtension
        -> ExtensionRecord
        input
          id: Id
        step execute
          # Port returns Opt; unwrap → NotFound when missing
          rec = ExtensionRegistry.get!(id).unwrap()
          ret rec

      svc ListExtensionVersions
        -> List<ExtensionVersion>
        input
          id: Id
        step execute
          items = ExtensionRegistry.list_versions!(id)
          ret items

      svc GetExtensionVersion
        -> ExtensionVersion
        input
          id: Id
          version: Int
        step execute
          ver = ExtensionRegistry.get_version!(id, version).unwrap()
          ret ver

      svc SaveExtensionVersion
        -> ExtensionVersion
        input
          extension_id: Id
          source_commit: Str
          artifact_uris: Json
          changelog: Opt<Str>
        step execute
          rec = ExtensionRegistry.get!(extension_id).unwrap()
          next_v = rec.current_version + 1
          rec.current_version = next_v
          rec.updated_on = Dt.now()
          ExtensionRegistry.update!(rec)
          now = Dt.now()
          ver = ExtensionVersion{extension_id: extension_id, version: next_v, source_commit: source_commit, artifact_uris: artifact_uris, published_on: now, published_by: null, changelog: changelog}
          saved = ExtensionRegistry.save_version!(ver)
          ret saved

      # EXT-03: publish = bump integer version + artifact marker (all VEIL)
      svc PublishExtension
        -> ExtensionVersion
        input
          id: Id
        step execute
          rec = ExtensionRegistry.get!(id).unwrap()
          next_v = rec.current_version + 1
          rec.current_version = next_v
          rec.updated_on = Dt.now()
          ExtensionRegistry.update!(rec)
          uri = ExtensionArtifactStore.put!(id, next_v, "rust.marker", [])
          uris = {}
          now = Dt.now()
          ver = ExtensionVersion{extension_id: id, version: next_v, source_commit: "local", artifact_uris: uris, published_on: now, published_by: null, changelog: null}
          saved = ExtensionRegistry.save_version!(ver)
          ret saved

      svc InvokeExtension
        -> ExtensionInvokeResult
        input
          extension_id: Id
          version: Int
          kind: Str
          params: Json
          context: Json
        step execute
          # Pin check (version record must exist)
          _ver = ExtensionRegistry.get_version!(extension_id, version).unwrap()
          req = ExtensionInvokeRequest{extension_id: extension_id, version: version, kind: kind, params: params, context: context}
          res = ExtensionExecutor.invoke!(req)
          ret res

      # EXT-08: stock catalog — list then provenance filter is adapter-assisted;
      # product path uses EnsureStockCatalog + ListExtensions with provenance Stock.
      svc ListStockExtensions
        -> List<ExtensionRecord>
        input
          scope: Opt<Str>
          kind: Opt<Str>
          product_id: Opt<Str>
        step execute
          items = ExtensionRegistry.list!(scope, kind, product_id, null)
          ret items

      # EXT-08: upsert one stock package by stable id (idempotent create/update).
      # Host may pass well-known UUIDs; all business fields authored here in VEIL.
      svc UpsertStockExtension
        -> ExtensionRecord
        input
          extension_id: Id
          name: Str
          description: Str
          product_id: Opt<Str>
          params_schema: Opt<Json>
          capabilities: List<Str>
          palette_layer_refs: List<Str>
        step execute
          now = Dt.now()
          root = ExtensionSourceStore.ensure_package!(extension_id)
          rec = ExtensionRecord{extension_id: extension_id, scope: ExtensionScope.Platform, product_id: product_id, tenant_id: null, initiative_id: null, kind: ExtensionKind.Reaction, provenance: ExtensionProvenance.Stock, name: name, description: null, current_version: 1, params_schema: params_schema, capabilities: capabilities, palette_layer_refs: palette_layer_refs, source_uri: root, created_from: null, created_on: now, updated_on: now, archived: false}
          rec.description = Opt.some(description)
          saved = ExtensionRegistry.create!(rec)
          ver = ExtensionVersion{extension_id: extension_id, version: 1, source_commit: "stock-seed", artifact_uris: {}, published_on: now, published_by: null, changelog: null}
          ExtensionRegistry.save_version!(ver)
          ExtensionSourceStore.write_file!(extension_id, "README.md", "stock")
          ret saved

      # EXT-08: ensure platform stock Reactions exist (ids from dual-loop fixture).
      # Bodies inlined (same-context svc-to-svc invoke is not used — all logic stays VEIL).
      svc EnsureStockCatalog
        -> List<ExtensionRecord>
        input
          activate_id: Id
          guard_id: Id
          product_id: Opt<Str>
        step execute
          now = Dt.now()
          root_a = ExtensionSourceStore.ensure_package!(activate_id)
          root_g = ExtensionSourceStore.ensure_package!(guard_id)
          caps_a = ["activation.invoke"]
          caps_g = ["enrollment.is_enrolled"]
          palette = ["reaction_guard", "reaction_activate", "reaction_end"]
          schema_a = {}
          schema_g = {}
          rec_a = ExtensionRecord{extension_id: activate_id, scope: ExtensionScope.Platform, product_id: product_id, tenant_id: null, initiative_id: null, kind: ExtensionKind.Reaction, provenance: ExtensionProvenance.Stock, name: "Activate members", description: Opt.some("Invoke the default Activation for matching members"), current_version: 1, params_schema: Opt.some(schema_a), capabilities: caps_a, palette_layer_refs: palette, source_uri: root_a, created_from: null, created_on: now, updated_on: now, archived: false}
          rec_g = ExtensionRecord{extension_id: guard_id, scope: ExtensionScope.Platform, product_id: product_id, tenant_id: null, initiative_id: null, kind: ExtensionKind.Reaction, provenance: ExtensionProvenance.Stock, name: "Guard then end", description: Opt.some("Skip if not enrolled; otherwise end success"), current_version: 1, params_schema: Opt.some(schema_g), capabilities: caps_g, palette_layer_refs: palette, source_uri: root_g, created_from: null, created_on: now, updated_on: now, archived: false}
          a = ExtensionRegistry.create!(rec_a)
          g = ExtensionRegistry.create!(rec_g)
          ver_a = ExtensionVersion{extension_id: activate_id, version: 1, source_commit: "stock-seed", artifact_uris: {}, published_on: now, published_by: null, changelog: Opt.some("seed")}
          ver_g = ExtensionVersion{extension_id: guard_id, version: 1, source_commit: "stock-seed", artifact_uris: {}, published_on: now, published_by: null, changelog: Opt.some("seed")}
          ExtensionRegistry.save_version!(ver_a)
          ExtensionRegistry.save_version!(ver_g)
          ExtensionSourceStore.write_file!(activate_id, "README.md", "Activate members stock reaction")
          ExtensionSourceStore.write_file!(guard_id, "README.md", "Guard then end stock reaction")
          ret [a, g]

      # EXT-09: duplicate stock → custom with lineage + source file copy
      svc ForkExtension
        -> ExtensionRecord
        input
          source_id: Id
          source_version: Int
          name: Str
          tenant_id: Opt<Id>
          initiative_id: Opt<Id>
        step execute
          src = ExtensionRegistry.get!(source_id).unwrap()
          eid = Id.new()
          now = Dt.now()
          root = ExtensionSourceStore.ensure_package!(eid)
          lineage = ExtensionLineage{extension_id: source_id, version: source_version}
          rec = ExtensionRecord{extension_id: eid, scope: ExtensionScope.Tenant, product_id: src.product_id, tenant_id: tenant_id, initiative_id: initiative_id, kind: src.kind, provenance: ExtensionProvenance.Custom, name: name, description: src.description, current_version: 0, params_schema: src.params_schema, capabilities: src.capabilities, palette_layer_refs: src.palette_layer_refs, source_uri: root, created_from: Opt.some(lineage), created_on: now, updated_on: now, archived: false}
          saved = ExtensionRegistry.create!(rec)
          # Mark lineage in package tree (full file copy when read returns Str; Opt handled by adapter write of README)
          ExtensionSourceStore.write_file!(eid, "FORK.md", "forked from stock")
          ExtensionSourceStore.write_file!(eid, "README.md", name)
          ret saved

      # EXT-10: list by scope with tenant isolation (tenant_id required when scope=Tenant)
      svc ListExtensionsByScope
        -> List<ExtensionRecord>
        input
          scope: Str
          kind: Opt<Str>
          product_id: Opt<Str>
          tenant_id: Opt<Id>
        step execute
          # Tenant catalogs require tenant_id — empty list if missing (isolation)
          if scope == "Tenant"
            if tenant_id == null
              ret []
          items = ExtensionRegistry.list!(Opt.some(scope), kind, product_id, tenant_id)
          ret items

      # EXT-10: promotion is dev-gated — only Platform scope may write Stock product_id upgrades
      svc PromoteExtension
        -> ExtensionRecord
        input
          extension_id: Id
          target_scope: Str
          allow_promote: Bool
        step execute
          if allow_promote == false
            rec = ExtensionRegistry.get!(extension_id).unwrap()
            ret rec
          rec = ExtensionRegistry.get!(extension_id).unwrap()
          if target_scope == "Platform"
            rec.scope = ExtensionScope.Platform
          if target_scope == "Product"
            rec.scope = ExtensionScope.Product
          rec.updated_on = Dt.now()
          saved = ExtensionRegistry.update!(rec)
          ret saved

      # EXT-07: palette gate — allowed node kinds for reaction layer (server-side reject)
      svc ValidateReactionPalette
        -> Bool
        input
          node_kinds: List<Str>
        step execute
          # Allowed only EXT-05 constructs: Guard, Activate, Map, EmitEvent, End
          for k in node_kinds
            ok = false
            if k == "Guard"
              ok = true
            if k == "Activate"
              ok = true
            if k == "Map"
              ok = true
            if k == "EmitEvent"
              ok = true
            if k == "End"
              ok = true
            if k == "guard"
              ok = true
            if k == "activate"
              ok = true
            if k == "map"
              ok = true
            if k == "emit_event"
              ok = true
            if k == "end"
              ok = true
            if ok == false
              ret false
          ret true

      # EXT-12: UI mount ABI (frontend extensions)
      val UiMountRequest
        extension_id: Id
        version: Int
        slot: Str
        props: Json

      val UiMountHandle
        mount_id: Str
        asset_uri: Str

      svc MountUiExtension
        -> UiMountHandle
        input
          extension_id: Id
          version: Int
          slot: Str
          props: Json
        step execute
          uri = f"local://extensions/{slot}/{extension_id}@{version}"
          h = UiMountHandle{mount_id: f"{extension_id}", asset_uri: uri}
          ret h

    group infrastructure
      # ── Extension adapters: VEIL bodies call ExtStore only ─────────────────
      # Permanent fix for "stub lowering": never call raw DdbClient/S3Client from
      # VEIL. AWS SDK lives in runtime/ext_store behind veil_ext_store.stub.
      # Backend: VEIL_EXTENSIONS_BACKEND=file (default) | ddb — same adapter code.
      # Dual-loop host wires File* (extensions_deps). Engine has zero FS/AWS knowledge.

      adapter FileExtensionRegistry for ExtensionRegistry
        @env(VEIL_EXTENSIONS_DIR)
        impl create(record)
          ExtStore.put_record!(self.dir, f"{record.extension_id}", Json.stringify(record))
          ret record
        impl get(id)
          raw = ExtStore.get_record!(self.dir, f"{id}")
          if raw == ""
            ret null
          rec = Json.parse(raw)
          ret rec
        impl list(scope, kind, product_id, tenant_id)
          raws = ExtStore.list_records!(self.dir)
          out = []
          for raw in raws
            rec = Json.parse(raw)
            out = out + [rec]
          ret out
        impl update(record)
          ExtStore.put_record!(self.dir, f"{record.extension_id}", Json.stringify(record))
          ret record
        impl save_version(ver)
          ExtStore.put_version!(self.dir, f"{ver.extension_id}", f"{ver.version}", Json.stringify(ver))
          ret ver
        impl get_version(id, version)
          raw = ExtStore.get_version!(self.dir, f"{id}", f"{version}")
          if raw == ""
            ret null
          ver = Json.parse(raw)
          ret ver
        impl list_versions(id)
          raws = ExtStore.list_versions!(self.dir, f"{id}")
          out = []
          for raw in raws
            ver = Json.parse(raw)
            out = out + [ver]
          ret out

      adapter FileExtensionSourceStore for ExtensionSourceStore
        @env(VEIL_EXTENSIONS_DIR)
        impl ensure_package(id)
          root = ExtStore.ensure_package!(self.dir, f"{id}")
          ret root
        impl write_file(id, rel_path, content)
          ExtStore.write_source!(self.dir, f"{id}", rel_path, content)
          ret Ok
        impl read_file(id, rel_path)
          raw = ExtStore.read_source!(self.dir, f"{id}", rel_path)
          if raw == ""
            ret null
          ret raw
        impl list_files(id, prefix)
          names = ExtStore.list_source!(self.dir, f"{id}")
          ret names
        impl package_root(id)
          ret ExtStore.package_root(self.dir, f"{id}")

      adapter FileExtensionArtifactStore for ExtensionArtifactStore
        @env(VEIL_EXTENSIONS_DIR)
        impl put(id, version, target, data)
          uri = ExtStore.put_artifact!(self.dir, f"{id}", f"{version}", target, "artifact")
          ret uri
        impl get_uri(id, version, target)
          uri = ExtStore.get_artifact_uri!(self.dir, f"{id}", f"{version}", target)
          if uri == ""
            ret null
          ret uri

      # Publish bumps via registry services; invoke succeeds when version exists.
      adapter FileExtensionExecutor for ExtensionExecutor
        @env(VEIL_EXTENSIONS_DIR)
        impl publish(id)
          ver = ExtensionVersion{extension_id: id, version: 1, source_commit: "local", artifact_uris: {}, published_on: Dt.now(), published_by: null, changelog: null}
          ret ver
        impl invoke(req)
          res = ExtensionInvokeResult{status: ExtensionRunStatus.Succeeded, message: null, outputs: {}}
          ret res

      # AWS-named adapters: same ExtStore facade (set VEIL_EXTENSIONS_BACKEND=ddb).
      # No @field(DdbClient/S3Client) — raw SDK calls are never lowered from VEIL.
      adapter DdbExtensionRegistry for ExtensionRegistry
        @env(VEIL_EXTENSIONS_DIR)
        impl create(record)
          ExtStore.put_record!(self.dir, f"{record.extension_id}", Json.stringify(record))
          ret record
        impl get(id)
          raw = ExtStore.get_record!(self.dir, f"{id}")
          if raw == ""
            ret null
          rec = Json.parse(raw)
          ret rec
        impl list(scope, kind, product_id, tenant_id)
          raws = ExtStore.list_records!(self.dir)
          out = []
          for raw in raws
            rec = Json.parse(raw)
            out = out + [rec]
          ret out
        impl update(record)
          ExtStore.put_record!(self.dir, f"{record.extension_id}", Json.stringify(record))
          ret record
        impl save_version(ver)
          ExtStore.put_version!(self.dir, f"{ver.extension_id}", f"{ver.version}", Json.stringify(ver))
          ret ver
        impl get_version(id, version)
          raw = ExtStore.get_version!(self.dir, f"{id}", f"{version}")
          if raw == ""
            ret null
          ver = Json.parse(raw)
          ret ver
        impl list_versions(id)
          raws = ExtStore.list_versions!(self.dir, f"{id}")
          out = []
          for raw in raws
            ver = Json.parse(raw)
            out = out + [ver]
          ret out

      adapter S3ExtensionSourceStore for ExtensionSourceStore
        @env(VEIL_EXTENSIONS_DIR)
        impl ensure_package(id)
          root = ExtStore.ensure_package!(self.dir, f"{id}")
          ret root
        impl write_file(id, rel_path, content)
          ExtStore.write_source!(self.dir, f"{id}", rel_path, content)
          ret Ok
        impl read_file(id, rel_path)
          raw = ExtStore.read_source!(self.dir, f"{id}", rel_path)
          if raw == ""
            ret null
          ret raw
        impl list_files(id, prefix)
          names = ExtStore.list_source!(self.dir, f"{id}")
          ret names
        impl package_root(id)
          ret ExtStore.package_root(self.dir, f"{id}")

      adapter S3ExtensionArtifactStore for ExtensionArtifactStore
        @env(VEIL_EXTENSIONS_DIR)
        impl put(id, version, target, data)
          uri = ExtStore.put_artifact!(self.dir, f"{id}", f"{version}", target, "artifact")
          ret uri
        impl get_uri(id, version, target)
          uri = ExtStore.get_artifact_uri!(self.dir, f"{id}", f"{version}", target)
          if uri == ""
            ret null
          ret uri

  # ═══════════════════════════════════════════════════════════════════════════
  # MetaExecution — tenant-authored function execution with sandboxed isolation
  # Architecture: /home/jd/dev/jd/veil-runtime/docs/META_LAYER_EXECUTION.md
  # ═══════════════════════════════════════════════════════════════════════════

  ctx MetaExecution
    group domain
      # ─── Identifiers ────────────────────────────────────────────────────
      val MetaFunctionId
        tenant_id: Str
        function_path: Str
        version: MetaFunctionVersion

      enum MetaFunctionVersion
        Latest
        Pinned
          hash: Str

      # ─── Request / Response ─────────────────────────────────────────────
      val ExecutionRequest
        function_id: MetaFunctionId
        input: Json
        capabilities: List<GrantedCapability>
        timeout_ms: Opt<Int>
        idempotency_key: Opt<Str>

      val ExecutionResult
        output: Json
        metadata: ExecutionMetadata

      val ExecutionMetadata
        duration_ms: Int
        cached: Bool
        compiled: Bool
        artifact_hash: Str

      # ─── Capabilities ───────────────────────────────────────────────────
      enum GrantedCapability
        ServiceRegistry
          service_name: Str
          operations: List<Str>
        StorageRead
          namespace: Str
        StorageWrite
          namespace: Str
        BusEmit
          event_types: List<Str>

      # ─── Errors ─────────────────────────────────────────────────────────
      enum ExecutionError
        NotFound
          function_path: Str
          tenant_id: Str
        CompilationFailed
          details: Str
        Timeout
          timeout_ms: Int
        RuntimePanic
          message: Str
          exit_code: Opt<Int>
        CapabilityDenied
          capability: Str
          reason: Str
        ResourceExceeded
          resource: Str
          limit: Str
        Internal
          message: Str
        Unavailable
          message: Str

      # ─── Subprocess Protocol ────────────────────────────────────────────
      val SubprocessInput
        input: Json
        capabilities: ResolvedCapabilities

      val SubprocessOutput
        success: Bool
        output: Opt<Json>
        error: Opt<Str>
        emitted_events: List<Json>

      val ResolvedCapabilities
        services: Map<Str, ResolvedService>
        storage: Map<Str, ResolvedStorage>
        bus_emit: List<Str>

      val ResolvedService
        endpoint: Str
        token: Str
        operations: List<Str>

      val ResolvedStorage
        endpoint: Str
        mode: StorageAccessMode
        token: Str

      enum StorageAccessMode
        Read
        Write
        ReadWrite

      # ─── Cache ──────────────────────────────────────────────────────────
      val CacheStats
        entries: Int
        total_size_bytes: Int

      # ─── Ports ──────────────────────────────────────────────────────────
      port ObjectStorage
        put!(key: Str, data: Bytes)
        get!(key: Str) -> Bytes
        delete!(key: Str)
        exists!(key: Str) -> Bool
        list!(prefix: Str) -> List<Str>
        size!(key: Str) -> Int

      port MetaLayerExecutor
        execute!(request: ExecutionRequest) -> ExecutionResult
        warm_check!(function_id: MetaFunctionId) -> Bool
        warm!(function_id: MetaFunctionId)

      port MetaCompilationBackend
        compile!(function_id: MetaFunctionId, content_hash: Str, source_data: Bytes) -> Bytes

      port MetaArtifactCache
        get!(content_hash: Str) -> Opt<Str>
        put!(content_hash: Str, binary_data: Bytes) -> Str
        evict!(content_hash: Str)
        stats!() -> CacheStats

      adapter S3MetaObjectStore for ObjectStorage
        @field(client: S3Client, bucket)
        impl put(key, data)
          client.put_object().bucket(bucket).key(key).body(data).send!()
        impl get(key)
          resp = client.get_object().bucket(bucket).key(key).send!()
          ret resp.body.collect().await.unwrap().into_bytes().to_vec()
        impl delete(key)
          client.delete_object().bucket(bucket).key(key).send!()
        impl exists(key)
          resp = client.head_object().bucket(bucket).key(key).send()
          ret resp.is_ok()
        impl list(prefix)
          resp = client.list_objects_v2().bucket(bucket).prefix(prefix).send!()
          ret resp.contents().iter().filter_map(|o| o.key().map(|k| k.to_string())).collect()
        impl size(key)
          resp = client.head_object().bucket(bucket).key(key).send!()
          ret resp.content_length().unwrap_or(0)

      adapter S3ArtifactCache for MetaArtifactCache
        @field(client: S3Client, bucket)
        impl get(content_hash)
          key = f"cache/{content_hash}.bin"
          resp = client.head_object().bucket(bucket).key(key).send()
          if resp.is_err() then ret null
          ret key
        impl put(content_hash, binary_data)
          key = f"cache/{content_hash}.bin"
          client.put_object().bucket(bucket).key(key).body(binary_data).send!()
          ret f"cache/{content_hash}.bin"
        impl evict(content_hash)
          key = f"cache/{content_hash}.bin"
          client.delete_object().bucket(bucket).key(key).send!()
        impl stats()
          ret CacheStats{entries: 0, total_size_bytes: 0}

    group application
      svc ResolveContentHash
        -> Str
        @dep(objects: ObjectStorage)
        input
          function_id: MetaFunctionId
        step resolve
          match function_id.version
            MetaFunctionVersion.Pinned{hash} => ret hash
            MetaFunctionVersion.Latest =>
              key = f"functions/{function_id.tenant_id}/{function_id.function_path}/latest.hash"
              hash_bytes = ObjectStorage.get!(key)
              ret hash_bytes.to_string().trim()

      svc EnsureCompiled
        -> Str
        @dep(cache: MetaArtifactCache)
        @dep(objects: ObjectStorage)
        @dep(compiler: MetaCompilationBackend)
        input
          function_id: MetaFunctionId
          content_hash: Str
        step check_cache
          cached = MetaArtifactCache.get!(content_hash)
          if cached.is_some()
            ret cached.unwrap()
        step fetch_source
          source_key = f"functions/{function_id.tenant_id}/{function_id.function_path}/source/{content_hash}"
          source_data = ObjectStorage.get!(source_key)
        step compile
          binary = MetaCompilationBackend.compile!(function_id, content_hash, source_data)
          path = MetaArtifactCache.put!(content_hash, binary)
          ret path

      svc ExecuteMetaFunction
        -> ExecutionResult
        @dep(objects: ObjectStorage)
        @dep(cache: MetaArtifactCache)
        @dep(compiler: MetaCompilationBackend)
        input
          function_id: MetaFunctionId
          input: Json
          capabilities: List<GrantedCapability>
          timeout_ms: Opt<Int>
          idempotency_key: Opt<Str>
        step resolve
          content_hash = invoke ResolveContentHash{function_id}
        step ensure_compiled
          binary_path = invoke EnsureCompiled{function_id, content_hash}
        step execute
          # Build subprocess input with resolved capabilities
          subprocess_input = SubprocessInput{input, capabilities: ResolvedCapabilities{services: Map.new(), storage: Map.new(), bus_emit: []}}
          # Execute subprocess (delegated to runtime platform)
          # Returns SubprocessOutput parsed from stdout JSON
          timeout = timeout_ms.unwrap_or(30000)
          # Platform-level subprocess execution with rlimits
          output = SubprocessOutput{success: true, output: input, error: null, emitted_events: []}
          ret ExecutionResult{output: output.output.unwrap_or(Json.null()), metadata: ExecutionMetadata{duration_ms: 0, cached: false, compiled: true, artifact_hash: content_hash}}

      svc WarmFunction
        @dep(objects: ObjectStorage)
        @dep(cache: MetaArtifactCache)
        @dep(compiler: MetaCompilationBackend)
        input
          function_id: MetaFunctionId
        step warm
          content_hash = invoke ResolveContentHash{function_id}
          invoke EnsureCompiled{function_id, content_hash}

      svc CheckWarmStatus
        -> Bool
        @dep(objects: ObjectStorage)
        @dep(cache: MetaArtifactCache)
        input
          function_id: MetaFunctionId
        step check
          content_hash = invoke ResolveContentHash{function_id}
          cached = MetaArtifactCache.get!(content_hash)
          ret cached.is_some()

      # ─── Tools ──────────────────────────────────────────────────────────
      tool ExecuteMetaLayerTool
        -> Json
        @desc("Execute a tenant-authored meta-layer function with sandboxed isolation. Returns the function output and execution metadata.")
        input
          tenant_id: Str
          function_path: Str
          version: Opt<Str>
          input: Json
          timeout_ms: Opt<Int>
        step execute
          v_str = version.unwrap_or("latest")
          fn_version = MetaFunctionVersion.Latest
          if v_str != "latest"
            fn_version = MetaFunctionVersion.Pinned{hash: v_str}
          fn_id = MetaFunctionId{tenant_id, function_path, version: fn_version}
          result = invoke ExecuteMetaFunction{function_id: fn_id, input, capabilities: [], timeout_ms, idempotency_key: null}
          ret {output: result.output, metadata: result.metadata, summary: f"Executed {function_path} for tenant {tenant_id} in {result.metadata.duration_ms}ms. Artifact: {result.metadata.artifact_hash}"}

      tool WarmMetaLayerTool
        -> Json
        @desc("Pre-compile a meta-layer function without executing it. Useful for reducing cold-start latency on first invocation.")
        input
          tenant_id: Str
          function_path: Str
          version: Opt<Str>
        step execute
          v_str = version.unwrap_or("latest")
          fn_version = MetaFunctionVersion.Latest
          if v_str != "latest"
            fn_version = MetaFunctionVersion.Pinned{hash: v_str}
          fn_id = MetaFunctionId{tenant_id, function_path, version: fn_version}
          invoke WarmFunction{function_id: fn_id}
          ret {status: "warm", function: f"{tenant_id}::{function_path}", summary: f"Function {function_path} for tenant {tenant_id} is now warm and ready for execution."}

      tool MetaLayerStatusTool
        -> Json
        @desc("Check if a meta-layer function is compiled and cached (warm). Returns warm status and function identifier.")
        input
          tenant_id: Str
          function_path: Str
          version: Opt<Str>
        step execute
          v_str = version.unwrap_or("latest")
          fn_version = MetaFunctionVersion.Latest
          if v_str != "latest"
            fn_version = MetaFunctionVersion.Pinned{hash: v_str}
          fn_id = MetaFunctionId{tenant_id, function_path, version: fn_version}
          warm = invoke CheckWarmStatus{function_id: fn_id}
          status_msg = if warm then "warm and ready" else "cold (will compile on first invocation)"
          ret {warm, function: f"{tenant_id}::{function_path}@{v_str}", summary: f"Function {function_path} for tenant {tenant_id} is {status_msg}"}

    group infrastructure
      adapter MockMetaCompiler for MetaCompilationBackend
        impl compile(function_id, content_hash, source_data)
          # Returns a bash script that echoes a success JSON response
          script = f"#!/bin/bash\necho '{{\"success\":true,\"output\":{{\"mock\":true,\"hash\":\"{content_hash}\"}},\"error\":null,\"emitted_events\":[]}}'"
          ret script.into_bytes()

  # ═══════════════════════════════════════════════════════════════════════════
  # Deploy — imperative control plane for VEIL application deployments
  # Architecture: /home/jd/dev/jd/veil-runtime/docs/DEPLOYMENT_SYSTEM.md
  # ═══════════════════════════════════════════════════════════════════════════

  ctx Deploy
    group domain
      # ─── Unit Types ─────────────────────────────────────────────────────
      enum DeployUnitType
        LambdaApi
        LambdaConsumer
        EcsService
        EcsTask

      # ─── Configuration (from veil.toml) ─────────────────────────────────
      enum EnvVarSource
        Literal
          value: Str
        Ssm
          path: Str
        Secret
          arn: Str
        FromOutput
          reference: Str

      val LambdaConfig
        memory_mb: Int
        timeout_seconds: Int
        architecture: Str
        reserved_concurrency: Opt<Int>
        provisioned_concurrency: Opt<Int>
        layers: List<Str>
        ephemeral_storage_mb: Int

      val ApiGatewayConfig
        gateway: Str
        path_prefix: Str
        cors: Bool
        auth: Str
        throttle_rate: Opt<Int>
        throttle_burst: Opt<Int>

      val QueueConfig
        visibility_timeout_seconds: Int
        max_receive_count: Int
        dlq: Bool
        batch_size: Int
        batch_window_seconds: Int
        fifo: Bool
        content_deduplication: Bool

      val EcsConfig
        cpu: Int
        memory_mb: Int
        desired_count: Int
        min_count: Int
        max_count: Int
        health_check_path: Str
        health_check_interval_seconds: Int
        port: Int

      val ScalingConfig
        metric: Str
        target_value: Int
        scale_in_cooldown: Int
        scale_out_cooldown: Int

      val NetworkConfig
        vpc: Str
        security_groups: List<Str>
        subnets: Str

      val DeployUnitConfig
        name: Str
        unit_type: DeployUnitType
        context: Str
        description: Opt<Str>
        lambda: Opt<LambdaConfig>
        api_gateway: Opt<ApiGatewayConfig>
        queue: Opt<QueueConfig>
        ecs: Opt<EcsConfig>
        scaling: Opt<ScalingConfig>
        env: Map<Str, EnvVarSource>

      val DeployConfig
        region: Str
        project_prefix: Str
        account_id: Opt<Str>
        env: Map<Str, EnvVarSource>
        network: Opt<NetworkConfig>
        units: List<DeployUnitConfig>

      # ─── Deployment State (DDB records) ─────────────────────────────────
      enum DeploymentStatus
        Active
        Deploying
        Failed
        RollingBack
        Inactive

      val ArtifactInfo
        hash: Str
        image_uri: Opt<Str>
        compiled_at: Dt
        source_commit: Opt<Str>

      val DeployedConfig
        memory_mb: Opt<Int>
        timeout_seconds: Opt<Int>
        architecture: Opt<Str>
        reserved_concurrency: Opt<Int>
        cpu: Opt<Int>
        desired_count: Opt<Int>
        env_vars: Map<Str, EnvVarSource>

      val AwsResources
        lambda_arn: Opt<Str>
        lambda_version: Opt<Str>
        api_gw_id: Opt<Str>
        api_gw_route_id: Opt<Str>
        sqs_queue_url: Opt<Str>
        sqs_queue_arn: Opt<Str>
        sqs_dlq_url: Opt<Str>
        ecs_service_arn: Opt<Str>
        ecs_cluster_arn: Opt<Str>
        role_arn: Opt<Str>
        log_group: Opt<Str>
        ecr_repository: Opt<Str>

      enum HealthState
        Healthy
        Degraded
        Unhealthy
        Unknown

      val HealthStatus
        last_check: Opt<Dt>
        status: HealthState
        error_rate_1h: Opt<Str>
        p99_latency_ms: Opt<Int>
        invocations_1h: Opt<Int>

      val DeploymentState
        project: Str
        context: Str
        unit_name: Str
        unit_type: DeployUnitType
        environment: Str
        region: Str
        status: DeploymentStatus
        version: Int
        artifact: ArtifactInfo
        config: DeployedConfig
        aws_resources: AwsResources
        health: HealthStatus
        deployed_at: Dt
        deployed_by: Str
        description: Opt<Str>

      # ─── Events ─────────────────────────────────────────────────────────
      enum EventType
        Deployed
        RolledBack
        Scaled
        ConfigUpdated
        DriftDetected
        DriftResolved
        Failed

      val ConfigChange
        field: Str
        from: Opt<Json>
        to: Opt<Json>

      val DeployEvent
        event_type: EventType
        version: Int
        actor: Str
        changes: List<ConfigChange>
        message: Opt<Str>
        timestamp: Dt
        duration_ms: Opt<Int>

      # ─── Reconciliation ─────────────────────────────────────────────────
      enum ActionRisk
        Low
        Medium
        High

      enum ActionType
        CreateLambda
        UpdateLambdaConfig
        UpdateLambdaCode
        CreateQueue
        UpdateQueue
        CreateEcsService
        UpdateEcsService
        ScaleEcsService
        CreateApiRoute
        UpdateApiRoute
        DeleteLambda
        DeleteQueue
        DeleteEcsService

      val Action
        action_type: ActionType
        description: Str
        risk: ActionRisk
        details: Json

      enum ReconcileResult
        InSync
        Create
          actions: List<Action>
        Update
          actions: List<Action>
        Remove
          actions: List<Action>

      val ActionResult
        success: Bool
        message: Str
        resource_updates: Map<Str, Str>
        duration_ms: Int

      # ─── Ports ──────────────────────────────────────────────────────────
      port DeploymentStateStore
        get_current!(environment: Str, unit_name: Str) -> Opt<DeploymentState>
        save_current!(state: DeploymentState)
        save_version!(state: DeploymentState)
        get_version!(environment: Str, unit_name: Str, version: Int) -> Opt<DeploymentState>
        list_versions!(environment: Str, unit_name: Str, limit: Int) -> List<DeploymentState>
        append_event!(environment: Str, unit_name: Str, event: DeployEvent)
        get_events!(environment: Str, unit_name: Str, limit: Int) -> List<DeployEvent>
        list_deployments!() -> List<DeploymentState>

      port ActionExecutor
        execute_action!(action: Action, state: DeploymentState) -> ActionResult

      # Real AWS provision surface (was veil_deploy_exec crate). Returns JSON strings.
      # Provision jobs: LocalFs under /tmp/veil-provision-jobs/; get advances one step (no threads).
      port DeployExec
        list_environments!() -> Str
        read_project_deploy!(repo_id: Str, branch: Str, slug: Str) -> Str
        sync_hub_to_s3!(repo_id: Str, branch: Str, slug: Str) -> Str
        plan_provision!(project_slug: Str, environment: Str) -> Str
        plan_provision_repo!(repo_id: Str, branch: Str, slug: Str, environment: Str) -> Str
        start_provision!(project_slug: Str, environment: Str) -> Str
        start_provision_repo!(repo_id: Str, branch: Str, slug: Str, environment: Str) -> Str
        get_provision_job!(job_id: Str) -> Str
        provision_unit!(project_slug: Str, environment: Str, unit_name: Str) -> Str
        clear_unit_state!(environment: Str, unit_name: Str) -> Str

    group application
      svc Reconcile
        -> ReconcileResult
        @dep(store: DeploymentStateStore)
        input
          desired: DeployUnitConfig
          environment: Str
          new_artifact_hash: Opt<Str>
        step load_current
          current = DeploymentStateStore.get_current!(environment, desired.name)
        step reconcile
          if current.is_none()
            # First deploy — create all resources
            mut actions = []
            match desired.unit_type
              DeployUnitType.LambdaApi =>
                actions.push(Action{action_type: ActionType.CreateLambda, description: f"Create Lambda function {desired.name}", risk: ActionRisk.Low, details: Json.null()})
                # CreateApiRoute = attach route/integration on an *existing* HTTP API
                # (api_gateway.gateway). Never creates a new API Gateway.
                actions.push(Action{action_type: ActionType.CreateApiRoute, description: f"Attach API routes for {desired.name} on existing gateway (api_gateway.gateway)", risk: ActionRisk.Low, details: Json.null()})
              DeployUnitType.LambdaConsumer =>
                actions.push(Action{action_type: ActionType.CreateLambda, description: f"Create Lambda function {desired.name}", risk: ActionRisk.Low, details: Json.null()})
                actions.push(Action{action_type: ActionType.CreateQueue, description: f"Create SQS queue for {desired.name}", risk: ActionRisk.Low, details: Json.null()})
              DeployUnitType.EcsService =>
                actions.push(Action{action_type: ActionType.CreateEcsService, description: f"Create ECS service {desired.name}", risk: ActionRisk.Medium, details: Json.null()})
              DeployUnitType.EcsTask =>
                actions.push(Action{action_type: ActionType.CreateEcsService, description: f"Create ECS task {desired.name}", risk: ActionRisk.Low, details: Json.null()})
            ret ReconcileResult.Create{actions}
          # Existing deployment — check for config/code changes
          state = current.unwrap()
          mut actions = []
          # Check artifact change
          if new_artifact_hash.is_some()
            if new_artifact_hash.unwrap() != state.artifact.hash
              actions.push(Action{action_type: ActionType.UpdateLambdaCode, description: f"Update code for {desired.name}", risk: ActionRisk.Low, details: Json.null()})
          # Check config changes (memory, timeout, etc.)
          if desired.lambda.is_some()
            lc = desired.lambda.unwrap()
            if state.config.memory_mb.is_some() && state.config.memory_mb.unwrap() != lc.memory_mb
              actions.push(Action{action_type: ActionType.UpdateLambdaConfig, description: f"Update {desired.name} memory: {state.config.memory_mb.unwrap()}MB → {lc.memory_mb}MB", risk: ActionRisk.Low, details: Json.null()})
            if state.config.timeout_seconds.is_some() && state.config.timeout_seconds.unwrap() != lc.timeout_seconds
              actions.push(Action{action_type: ActionType.UpdateLambdaConfig, description: f"Update {desired.name} timeout: {state.config.timeout_seconds.unwrap()}s → {lc.timeout_seconds}s", risk: ActionRisk.Low, details: Json.null()})
          if actions.is_empty()
            ret ReconcileResult.InSync
          ret ReconcileResult.Update{actions}

      svc DeployUnit
        -> DeploymentState
        @dep(store: DeploymentStateStore)
        @dep(executor: ActionExecutor)
        input
          desired: DeployUnitConfig
          environment: Str
          artifact_hash: Str
          actor: Str
          message: Opt<Str>
        step reconcile
          plan = invoke Reconcile{desired, environment, new_artifact_hash: artifact_hash}
        step execute_actions
          state_opt = DeploymentStateStore.get_current!(environment, desired.name)
          match plan
            ReconcileResult.InSync => noop
            ReconcileResult.Create{actions} =>
              # First deploy: no prior state; mock/real executors that need state
              # only run when a provisional current row already exists.
              if state_opt.is_some()
                for action in actions
                  ActionExecutor.execute_action!(action, state_opt.unwrap())
            ReconcileResult.Update{actions} =>
              if state_opt.is_some()
                for action in actions
                  ActionExecutor.execute_action!(action, state_opt.unwrap())
        step save_state
          now = Dt.now()
          current = DeploymentStateStore.get_current!(environment, desired.name)
          version = if current.is_some() then current.unwrap().version + 1 else 1
          new_state = DeploymentState{project: "", context: desired.context, unit_name: desired.name, unit_type: desired.unit_type, environment, region: "", status: DeploymentStatus.Active, version, artifact: ArtifactInfo{hash: artifact_hash, image_uri: null, compiled_at: now, source_commit: null}, config: DeployedConfig{memory_mb: null, timeout_seconds: null, architecture: null, reserved_concurrency: null, cpu: null, desired_count: null, env_vars: Map.new()}, aws_resources: AwsResources{lambda_arn: null, lambda_version: null, api_gw_id: null, api_gw_route_id: null, sqs_queue_url: null, sqs_queue_arn: null, sqs_dlq_url: null, ecs_service_arn: null, ecs_cluster_arn: null, role_arn: null, log_group: null, ecr_repository: null}, health: HealthStatus{last_check: null, status: HealthState.Unknown, error_rate_1h: null, p99_latency_ms: null, invocations_1h: null}, deployed_at: now, deployed_by: actor, description: desired.description}
          DeploymentStateStore.save_current!(new_state)
          DeploymentStateStore.save_version!(new_state)
          event = DeployEvent{event_type: EventType.Deployed, version, actor, changes: [], message, timestamp: now, duration_ms: null}
          DeploymentStateStore.append_event!(environment, desired.name, event)
          ret new_state

      svc RollbackDeployment
        -> DeploymentState
        @dep(store: DeploymentStateStore)
        @dep(executor: ActionExecutor)
        input
          environment: Str
          unit_name: Str
          target_version: Opt<Int>
          actor: Str
          reason: Opt<Str>
        step load
          current = DeploymentStateStore.get_current!(environment, unit_name)
          v = target_version.unwrap_or(current.unwrap().version - 1)
          target = DeploymentStateStore.get_version!(environment, unit_name, v)
        step rollback
          state = target.unwrap()
          now = Dt.now()
          new_version = current.unwrap().version + 1
          rolled_back = DeploymentState{project: state.project, context: state.context, unit_name, unit_type: state.unit_type, environment, region: state.region, status: DeploymentStatus.Active, version: new_version, artifact: state.artifact, config: state.config, aws_resources: state.aws_resources, health: state.health, deployed_at: now, deployed_by: actor, description: state.description}
          DeploymentStateStore.save_current!(rolled_back)
          DeploymentStateStore.save_version!(rolled_back)
          event = DeployEvent{event_type: EventType.RolledBack, version: new_version, actor, changes: [], message: reason, timestamp: now, duration_ms: null}
          DeploymentStateStore.append_event!(environment, unit_name, event)
          ret rolled_back

      svc GetDeploymentStatus
        -> Json
        @dep(store: DeploymentStateStore)
        input
          environment: Str
          unit_name: Str
        step load
          current = DeploymentStateStore.get_current!(environment, unit_name)
          events = DeploymentStateStore.get_events!(environment, unit_name, 10)
          ret {state: current, recent_events: events}

      svc ListAllDeployments
        -> List<DeploymentState>
        @dep(store: DeploymentStateStore)
        input
          environment: Opt<Str>
          project: Opt<Str>
        step query
          # Filters reserved for later; list all CURRENT-shaped deploy rows.
          results = DeploymentStateStore.list_deployments!()
          ret results

      # Platform environments (dev/staging/prod), gateway fuzzy maps, cross-account roles.
      svc ListDeployEnvironments
        -> Json
        @dep(store: DeploymentStateStore)
        @dep(exec: DeployExec)
        step query
          _probe = DeploymentStateStore.get_current!("_", "_")
          raw = DeployExec.list_environments!()
          mut catalog: Json = Json.parse(raw)
          ret catalog

      # Dry-run with repo identity (S3 source). UI always passes repo_id.
      svc PlanProvision
        -> Json
        @dep(store: DeploymentStateStore)
        @dep(exec: DeployExec)
        input
          project_slug: Str
          environment: Str
          repo_id: Str
          branch: Str
        step plan
          _probe = DeploymentStateStore.get_current!(environment, project_slug)
          raw = DeployExec.plan_provision_repo!(repo_id, branch, project_slug, environment)
          mut plan: Json = Json.parse(raw)
          ret plan

      # Start full provision job; compile checks out from S3 when seeded.
      # Job JSON under /tmp/veil-provision-jobs/; GetProvisionJob advances steps.
      svc ProvisionProject
        -> Json
        @dep(store: DeploymentStateStore)
        @dep(exec: DeployExec)
        input
          project_slug: Str
          environment: Str
          repo_id: Str
          branch: Str
        step provision
          _probe = DeploymentStateStore.get_current!(environment, project_slug)
          raw = DeployExec.start_provision_repo!(repo_id, branch, project_slug, environment)
          mut job: Json = Json.parse(raw)
          ret job

      # Poll provision job (steps + percent). Advances one pending step per call (step machine).
      svc GetProvisionJob
        -> Json
        @dep(store: DeploymentStateStore)
        @dep(exec: DeployExec)
        input
          job_id: Str
        step query
          _probe = DeploymentStateStore.get_current!("_", "_")
          raw = DeployExec.get_provision_job!(job_id)
          mut job: Json = Json.parse(raw)
          ret job

      svc ScaleService
        -> DeploymentState
        @dep(store: DeploymentStateStore)
        @dep(executor: ActionExecutor)
        input
          environment: Str
          unit_name: Str
          desired_count: Int
          actor: Str
          reason: Opt<Str>
        step scale
          current = DeploymentStateStore.get_current!(environment, unit_name)
          state = current.unwrap()
          action = Action{action_type: ActionType.ScaleEcsService, description: f"Scale {unit_name} to {desired_count} tasks", risk: ActionRisk.Low, details: Json.null()}
          ActionExecutor.execute_action!(action, state)
          now = Dt.now()
          event = DeployEvent{event_type: EventType.Scaled, version: state.version, actor, changes: [ConfigChange{field: "desired_count", from: state.config.desired_count, to: desired_count}], message: reason, timestamp: now, duration_ms: null}
          DeploymentStateStore.append_event!(environment, unit_name, event)
          ret state

      # ─── Tools ──────────────────────────────────────────────────────────
      tool DeployTool
        -> Json
        @desc("Deploy or update a VEIL application unit. Reads config, reconciles with AWS, and records state. Returns the new version and actions performed.")
        input
          unit_name: Str
          environment: Str
          artifact_hash: Opt<Str>
          message: Opt<Str>
        step execute
          hash = artifact_hash.unwrap_or("latest")
          # In production, would read veil.toml to get DeployUnitConfig
          result = invoke DeployUnit{desired: DeployUnitConfig{name: unit_name, unit_type: DeployUnitType.LambdaApi, context: unit_name, description: null, lambda: null, api_gateway: null, queue: null, ecs: null, scaling: null, env: Map.new()}, environment, artifact_hash: hash, actor: "agent", message}
          ret {version: result.version, unit_name: result.unit_name, environment: result.environment, status: "active", summary: f"Deployed {unit_name} v{result.version} to {environment}. Status: active."}

      tool RollbackTool
        -> Json
        @desc("Rollback a deployment to a previous version. Restores config and artifact from the target version.")
        input
          unit_name: Str
          environment: Str
          target_version: Opt<Int>
          reason: Opt<Str>
        step execute
          result = invoke RollbackDeployment{environment, unit_name, target_version, actor: "agent", reason}
          ret {version: result.version, unit_name, environment, status: "active", summary: f"Rolled back {unit_name} in {environment} to v{result.version}. Reason: {reason.unwrap_or('no reason given')}"}

      tool DeploymentStatusTool
        -> Json
        @desc("Get the current status of a deployment unit including health metrics, config, and recent events.")
        input
          unit_name: Str
          environment: Str
        step execute
          result = invoke GetDeploymentStatus{environment, unit_name}
          ret {state: result.state, recent_events: result.recent_events, summary: f"Deployment {unit_name} in {environment}: status={result.state.status}, version={result.state.version}, health={result.state.health.status}"}

      tool ListDeploymentsTool
        -> Json
        @desc("List all deployments, optionally filtered by environment or project. Returns status overview for each unit.")
        input
          environment: Opt<Str>
          project: Opt<Str>
        step execute
          results = invoke ListAllDeployments{environment, project}
          count = results.len()
          ret {deployments: results, count, summary: f"Found {count} deployments{if environment.is_some() then f' in {environment.unwrap()}' else ''}{if project.is_some() then f' for project {project.unwrap()}' else ''}."}

      tool DeploymentDiffTool
        -> Json
        @desc("Show what would change if you deployed now. Compares desired state from config against current deployed state.")
        input
          unit_name: Str
          environment: Str
        step execute
          # Would read veil.toml and call Reconcile
          desired = DeployUnitConfig{name: unit_name, unit_type: DeployUnitType.LambdaApi, context: unit_name, description: null, lambda: null, api_gateway: null, queue: null, ecs: null, scaling: null, env: Map.new()}
          plan = invoke Reconcile{desired, environment, new_artifact_hash: null}
          match plan
            ReconcileResult.InSync =>
              ret {in_sync: true, changes: [], summary: f"{unit_name} in {environment} is in sync. No changes needed."}
            ReconcileResult.Create{actions} =>
              ret {in_sync: false, changes: actions, summary: f"{unit_name} does not exist in {environment}. Would create with {actions.len()} actions."}
            ReconcileResult.Update{actions} =>
              ret {in_sync: false, changes: actions, summary: f"{unit_name} in {environment} has {actions.len()} pending changes."}
            ReconcileResult.Remove{actions} =>
              ret {in_sync: false, changes: actions, summary: f"{unit_name} in {environment} would be removed ({actions.len()} actions)."}

      tool ScaleTool
        -> Json
        @desc("Scale an ECS service deployment up or down. Only applies to ecs-service type deployments.")
        input
          unit_name: Str
          environment: Str
          desired_count: Int
          reason: Opt<Str>
        step execute
          result = invoke ScaleService{environment, unit_name, desired_count, actor: "agent", reason}
          ret {unit_name, environment, desired_count, summary: f"Scaled {unit_name} in {environment} to {desired_count} tasks. {reason.unwrap_or('')}"}

    group infrastructure
      adapter DdbDeploymentStore for DeploymentStateStore
        @field(client: DdbClient, table)
        impl get_current(environment, unit_name)
          pk = f"DEPLOY#{environment}#{unit_name}"
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND SK = :sk").expression_attribute_values(":pk", AttributeValue.S(pk)).expression_attribute_values(":sk", AttributeValue.S("CURRENT")).send!()
          items = resp.items()
          if items.is_empty() then ret null
          ret Json.parse(items[0].get("data").unwrap().as_s().unwrap())
        impl save_current(state)
          pk = f"DEPLOY#{state.environment}#{state.unit_name}"
          client.put_item().table_name(table).item("PK", AttributeValue.S(pk)).item("SK", AttributeValue.S("CURRENT")).item("data", AttributeValue.S(Json.stringify(state))).send!()
        impl save_version(state)
          pk = f"DEPLOY#{state.environment}#{state.unit_name}"
          sk = f"VERSION#{state.version}"
          client.put_item().table_name(table).item("PK", AttributeValue.S(pk)).item("SK", AttributeValue.S(sk)).item("data", AttributeValue.S(Json.stringify(state))).send!()
        impl get_version(environment, unit_name, version)
          pk = f"DEPLOY#{environment}#{unit_name}"
          sk = f"VERSION#{version}"
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND SK = :sk").expression_attribute_values(":pk", AttributeValue.S(pk)).expression_attribute_values(":sk", AttributeValue.S(sk)).send!()
          items = resp.items()
          if items.is_empty() then ret null
          ret Json.parse(items[0].get("data").unwrap().as_s().unwrap())
        impl list_versions(environment, unit_name, limit)
          pk = f"DEPLOY#{environment}#{unit_name}"
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND begins_with(SK, :prefix)").expression_attribute_values(":pk", AttributeValue.S(pk)).expression_attribute_values(":prefix", AttributeValue.S("VERSION#")).limit(limit).send!()
          ret resp.items().iter().map(|i| Json.parse(i.get("data").unwrap().as_s().unwrap())).collect()
        impl append_event(environment, unit_name, event)
          pk = f"DEPLOY#{environment}#{unit_name}"
          sk = f"EVENT#{event.timestamp}"
          client.put_item().table_name(table).item("PK", AttributeValue.S(pk)).item("SK", AttributeValue.S(sk)).item("data", AttributeValue.S(Json.stringify(event))).send!()
        impl get_events(environment, unit_name, limit)
          pk = f"DEPLOY#{environment}#{unit_name}"
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND begins_with(SK, :prefix)").expression_attribute_values(":pk", AttributeValue.S(pk)).expression_attribute_values(":prefix", AttributeValue.S("EVENT#")).limit(limit).send!()
          ret resp.items().iter().map(|i| Json.parse(i.get("data").unwrap().as_s().unwrap())).collect()
        impl list_deployments()
          resp = client.scan().table_name(table).filter_expression("begins_with(PK, :prefix) AND SK = :sk").expression_attribute_values(":prefix", AttributeValue.S("DEPLOY#")).expression_attribute_values(":sk", AttributeValue.S("CURRENT")).send!()
          ret resp.items().iter().map(|i| Json.parse(i.get("data").unwrap().as_s().unwrap())).collect()

      # VEIL-authored DeployExec (replaces runtime/deploy_exec Rust crate).
      # Jobs: LocalFs /tmp/veil-provision-jobs/{id}.json — start creates; get advances one step.
      # Stack names from veil.toml [deploy.stack] via LocalFs.read_project_deploy (veil-{service}-*).
      adapter LocalDeployExec for DeployExec
        @field(s3: S3Client, ddb: DdbClient, lambda: LambdaClient, sqs: SqsClient, sns: SnsClient, apigw: ApigwClient)
        @env(BUCKET)
        impl list_environments()
          # Prefer explicit path, then ~/.veil/deploy.toml, else monorepo default JSON shape for UI.
          alt = Env.get_or("VEIL_DEPLOY_CONFIG", "")
          if alt != ""
            if LocalFs.path_is_file(alt)
              raw = LocalFs.read_toml_json!(alt)
              ret raw
          home = Env.get_or("HOME", "")
          cfg_path = LocalFs.join(home, ".veil/deploy.toml")
          if LocalFs.path_is_file(cfg_path)
            raw2 = LocalFs.read_toml_json!(cfg_path)
            ret raw2
          # Built-in catalog matching runtime/config/deploy.toml defaults (UI shape).
          ret "{\"default\":\"dev\",\"environments\":[{\"name\":\"dev\",\"region\":\"us-west-2\",\"account_id\":null,\"has_assume_role\":false,\"assume_role_arn\":null,\"lambda_execution_role_arn\":\"arn:aws:iam::086261225885:role/dlx-lambda-dev\",\"gateways\":[{\"logical\":\"dashlx-services\",\"patterns\":[\"dlx-rust-*\",\"*-dev-service-api\",\"dashlx-services\"]}]},{\"name\":\"staging\",\"region\":\"us-west-2\",\"account_id\":null,\"has_assume_role\":false,\"assume_role_arn\":null,\"lambda_execution_role_arn\":null,\"gateways\":[{\"logical\":\"dashlx-services\",\"patterns\":[\"dlx-rust-*\",\"*-staging-service-api\",\"dashlx-services\"]}]},{\"name\":\"prod\",\"region\":\"us-west-2\",\"account_id\":null,\"has_assume_role\":false,\"assume_role_arn\":null,\"lambda_execution_role_arn\":null,\"gateways\":[{\"logical\":\"dashlx-services\",\"patterns\":[\"dlx-rust-*\",\"*-prod-service-api\",\"dashlx-services\"]}]}],\"config_path\":\"runtime/config/deploy.toml\"}"
        impl read_project_deploy(repo_id, branch, slug)
          mode = Env.get_or("VEIL_SOURCE_MODE", "prefer_s3")
          s3_key = f"repos/{repo_id}/{branch}/veil.toml"
          disk = LocalFs.read_project_deploy!(slug)
          mut snap: Json = Json.parse(disk)
          mut source = "disk"
          if mode != "disk" && self.bucket != "" && self.bucket != "default"
            head = s3.head_object().bucket(self.bucket).key(s3_key).send()
            if head.is_ok()
              source = "s3"
          ret Json.stringify({source: source, repo_id: repo_id, branch: branch, bucket: self.bucket, s3_key: s3_key, has_deploy: snap["has_deploy"], region: snap["region"], project_prefix: snap["project_prefix"], resource_prefix: snap["resource_prefix"], service: snap["service"], stack: snap["stack"], units: snap["units"], network: snap["network"], projects_dir: snap["projects_dir"], toml_path: snap["toml_path"], slug: slug})
        impl sync_hub_to_s3(repo_id, branch, slug)
          hub = LocalFs.projects_dir()
          root = LocalFs.join(hub, slug)
          mut uploaded = 0
          mut skipped = 0
          if self.bucket == "" || self.bucket == "default"
            ret Json.stringify({error: "BUCKET / VEIL_S3_BUCKET not set", uploaded: 0, skipped: 0})
          if !LocalFs.path_exists(root)
            ret Json.stringify({error: f"local root missing: {root}", uploaded: 0, skipped: 0})
          names = LocalFs.list_dir!(root)
          for name in names
            if name == ".git" || name == "target" || name == "generated" || name == "node_modules" || name == ".veil" || name == "dist"
              skipped = skipped + 1
            else
              path = LocalFs.join(root, name)
              if LocalFs.path_is_file(path)
                body = LocalFs.read!(path)
                key = f"repos/{repo_id}/{branch}/{name}"
                s3.put_object().bucket(self.bucket).key(key).body(body.into_bytes().into()).send!()
                uploaded = uploaded + 1
              else
                skipped = skipped + 1
          ret Json.stringify({repo_id: repo_id, branch: branch, bucket: self.bucket, uploaded: uploaded, skipped: skipped, local_root: root})
        impl plan_provision(project_slug, environment)
          # Deprecated — UI uses PlanProvision service which calls plan_provision_repo.
          ret Json.stringify({environment: environment, mock_mode: false, resources: [], units: [], steps: [], diff: {create: 0, update: 0, noop: 0, destroy: 0}, notes: ["Deprecated: use plan_provision_repo."], summary: "In sync (stub)", source: "stub"})
        impl plan_provision_repo(repo_id, branch, slug, environment)
          disk = LocalFs.read_project_deploy!(slug)
          mut snap: Json = Json.parse(disk)
          mock_s = Env.get_or("VEIL_DEPLOY_EXECUTOR", "")
          mock = mock_s == "mock" || mock_s == "MOCK"
          stack = snap["stack"]
          names = stack["names"]
          # stack.names strings -> Str via as_str (JSON string values)
          base = names["base"].as_str().unwrap_or("veil-unknown").to_string()
          ddb_name = names["dynamodb"].as_str().unwrap_or("veil-unknown").to_string()
          sns_name = names["sns"].as_str().unwrap_or("veil-unknown").to_string()
          sqs_name = names["sqs"].as_str().unwrap_or("veil-unknown").to_string()
          lambda_api = names["lambda_api"].as_str().unwrap_or("").to_string()
          lambda_consumer = names["lambda_consumer"].as_str().unwrap_or("").to_string()
          service = snap["service"].as_str().unwrap_or("unknown").to_string()
          resource_prefix = snap["resource_prefix"].as_str().unwrap_or("veil").to_string()
          if ddb_name == "veil-unknown"
            ddb_name = base.clone()
          if sns_name == "veil-unknown"
            sns_name = base.clone()
          if sqs_name == "veil-unknown"
            sqs_name = base.clone()
          mut creates = 0
          mut updates = 0
          mut noops = 0
          mut resources = []
          mut unit_actions = []
          mut steps = [{id: "load_config", label: "Load veil.toml deploy config", phase: "plan", action: "noop"}]
          # ── DynamoDB (stack.names.dynamodb) ──
          mut ddb_exists = false
          if !mock
            dr = ddb.describe_table().table_name(ddb_name).send()
            ddb_exists = dr.is_ok()
          if ddb_exists
            noops = noops + 1
            resources = resources + [{kind: "dynamodb", action: "noop", exists: true, name: ddb_name, detail: "Table present - no schema drift check yet"}]
            steps = steps + [{id: "stack_dynamodb", label: f"DynamoDB '{ddb_name}'", phase: "infra", action: "noop"}]
          else
            creates = creates + 1
            resources = resources + [{kind: "dynamodb", action: "create", exists: false, name: ddb_name, detail: "Will CreateTable (PK/SK, pay-per-request)"}]
            steps = steps + [{id: "stack_dynamodb", label: f"DynamoDB '{ddb_name}'", phase: "infra", action: "create"}]
          # ── SNS ──
          mut sns_exists = false
          if !mock
            # create_topic is idempotent (returns existing ARN), so probe via get_topic_attributes on the expected ARN.
            region = Env.get_or("AWS_REGION", "us-east-1")
            acct = Env.get_or("AWS_ACCOUNT_ID", "000000000000")
            sns_arn = f"arn:aws:sns:{region}:{acct}:{sns_name}"
            sns_exists = sns.get_topic_attributes().topic_arn(sns_arn).send().is_ok()
          if sns_exists
            noops = noops + 1
            resources = resources + [{kind: "sns", action: "noop", exists: true, name: sns_name, detail: "Topic present"}]
            steps = steps + [{id: "stack_sns", label: f"SNS '{sns_name}'", phase: "infra", action: "noop"}]
          else
            creates = creates + 1
            resources = resources + [{kind: "sns", action: "create", exists: false, name: sns_name, detail: "Will CreateTopic"}]
            steps = steps + [{id: "stack_sns", label: f"SNS '{sns_name}'", phase: "infra", action: "create"}]
          # ── SQS ──
          mut sqs_exists = false
          if !mock
            qr = sqs.get_queue_url().queue_name(sqs_name).send()
            sqs_exists = qr.is_ok()
          if sqs_exists
            noops = noops + 1
            resources = resources + [{kind: "sqs", action: "noop", exists: true, name: sqs_name, detail: f"Queue + DLQ '{sqs_name}-dlq' present"}]
            steps = steps + [{id: "stack_sqs", label: f"SQS '{sqs_name}' + DLQ", phase: "infra", action: "noop"}]
          else
            creates = creates + 1
            resources = resources + [{kind: "sqs", action: "create", exists: false, name: sqs_name, detail: f"Will CreateQueue + DLQ '{sqs_name}-dlq'"}]
            steps = steps + [{id: "stack_sqs", label: f"SQS '{sqs_name}' + DLQ", phase: "infra", action: "create"}]
          # ── Units (LocalFs names; function names from stack.names) ──
          unit_names = LocalFs.project_unit_names!(slug)
          for uname in unit_names
            uty = LocalFs.project_unit_type!(slug, uname)
            mut fn_name = f"{base}-{uname}"
            if uty == "lambda-api" && lambda_api != ""
              fn_name = lambda_api.clone()
            if uty == "lambda-consumer" && lambda_consumer != ""
              fn_name = lambda_consumer.clone()
            mut lambda_exists = false
            mut action = "create"
            mut detail = f"Create function '{fn_name}'"
            if uty == "ecs-service" || uty == "ecs-task"
              action = "skip"
              detail = "ECS not automated - skip"
              noops = noops + 1
            else
              if !mock
                fr = lambda.get_function().function_name(fn_name).send()
                lambda_exists = fr.is_ok()
              if lambda_exists
                action = "noop"
                detail = f"Exists - no config drift detected on '{fn_name}'"
                if uty == "lambda-api"
                  detail = f"Exists - '{fn_name}' + API GW route present"
                noops = noops + 1
              else
                creates = creates + 1
                if uty == "lambda-api"
                  detail = f"Create '{fn_name}' + routes on existing HTTP API (never create API GW)"
                if uty == "lambda-consumer"
                  detail = f"Create '{fn_name}' + SQS event source <- '{sqs_name}'"
            resources = resources + [{kind: uty, action: action, exists: lambda_exists, name: fn_name, unit: uname, detail: detail}]
            steps = steps + [{id: f"unit:{uname}", label: f"Unit '{uname}' ({uty}) -> '{fn_name}'", phase: "infra", action: action}]
            unit_actions = unit_actions + [{unit: uname, type: uty, function_name: fn_name, exists: lambda_exists, action: action, detail: detail}]
          if creates > 0
            # Code deploy needed for newly created resources
            updates = updates + 1
            steps = steps + [{id: "compile", label: "Compile project sources (veil gen + cargo build --release)", phase: "code", action: "update"}, {id: "deploy_code", label: "Deploy binary to Lambda (UpdateFunctionCode); ECS skipped", phase: "code", action: "update"}, {id: "finalize", label: "Record provision state in DynamoDB", phase: "finalize", action: "update"}]
          else
            steps = steps + [{id: "compile", label: "Compile project sources", phase: "code", action: "noop"}, {id: "deploy_code", label: "Code unchanged - skip deploy", phase: "code", action: "noop"}, {id: "finalize", label: "Finalize", phase: "finalize", action: "noop"}]
          notes = ["Preview only - nothing is written until you confirm.", "Apply is ensure/reconcile: create missing resources, refresh config/code on existing ones.", "Removals are NOT destroyed automatically (no destroy phase). Orphans stay in AWS until cleaned manually.", "API Gateway is never created; only routes/integrations on an existing HTTP API.", "AddPermission source_arn must use the real 12-digit account from the Lambda ARN (never '*')."]
          summary = ""
          if creates == 0 && updates == 0
            summary = f"In sync - all resources provisioned for stack '{base}' in '{environment}'"
          else
            summary = f"Provision: {creates} create, {updates} update/refresh, {noops} noop, 0 destroy - stack '{base}' in '{environment}'"
          if mock
            summary = f"{summary} [MOCK]"
          ret Json.stringify({environment: environment, mock_mode: mock, service: service, resource_prefix: resource_prefix, stack_base: base, stack_names: names, resources: resources, units: unit_actions, steps: steps, diff: {create: creates, update: updates, noop: noops, destroy: 0}, notes: notes, summary: summary, source: "disk", repo_id: repo_id, branch: branch})
        impl start_provision(project_slug, environment)
          # Same job creation as start_provision_repo with empty repo id.
          disk = LocalFs.read_project_deploy!(project_slug)
          mut snap: Json = Json.parse(disk)
          LocalFs.create_dir_all!("/tmp/veil-provision-jobs")
          now = Dt.now()
          job_id = f"prov-{project_slug}-{environment}"
          path = LocalFs.join("/tmp/veil-provision-jobs", f"{job_id}.json")
          names = snap["stack"]["names"]
          base = names["base"].as_str().unwrap_or("veil-unknown").to_string()
          ddb_name = names["dynamodb"].as_str().unwrap_or("veil-unknown").to_string()
          sns_name = names["sns"].as_str().unwrap_or("veil-unknown").to_string()
          sqs_name = names["sqs"].as_str().unwrap_or("veil-unknown").to_string()
          lambda_api = names["lambda_api"].as_str().unwrap_or("").to_string()
          lambda_consumer = names["lambda_consumer"].as_str().unwrap_or("").to_string()
          if ddb_name == "veil-unknown"
            ddb_name = base.clone()
          if sns_name == "veil-unknown"
            sns_name = base.clone()
          if sqs_name == "veil-unknown"
            sqs_name = base.clone()
          mut u0 = ""
          mut u1 = ""
          mut u2 = ""
          mut t0 = ""
          mut t1 = ""
          mut t2 = ""
          mut f0 = ""
          mut f1 = ""
          mut f2 = ""
          mut unit_count = 0
          unit_names = LocalFs.project_unit_names!(project_slug)
          for uname in unit_names
            uty = LocalFs.project_unit_type!(project_slug, uname)
            mut fn_name = f"{base}-{uname}"
            if uty == "lambda-api"
              if lambda_api != ""
                fn_name = lambda_api.clone()
            if uty == "lambda-consumer"
              if lambda_consumer != ""
                fn_name = lambda_consumer.clone()
            if unit_count == 0
              u0 = uname.clone()
              t0 = uty.clone()
              f0 = fn_name.clone()
            if unit_count == 1
              u1 = uname.clone()
              t1 = uty.clone()
              f1 = fn_name.clone()
            if unit_count == 2
              u2 = uname.clone()
              t2 = uty.clone()
              f2 = fn_name.clone()
            unit_count = unit_count + 1
          mut steps = [{id: "load_config", label: "Load veil.toml deploy config", status: "pending", detail: ""}, {id: "stack_dynamodb", label: f"DynamoDB {ddb_name}", status: "pending", detail: ""}, {id: "stack_sns", label: f"SNS {sns_name}", status: "pending", detail: ""}, {id: "stack_sqs", label: f"SQS {sqs_name} + DLQ", status: "pending", detail: ""}]
          if unit_count > 0
            steps = steps + [{id: f"unit:{u0}", label: f"Unit {u0} ({t0}) -> {f0}", status: "pending", detail: ""}]
          if unit_count > 1
            steps = steps + [{id: f"unit:{u1}", label: f"Unit {u1} ({t1}) -> {f1}", status: "pending", detail: ""}]
          if unit_count > 2
            steps = steps + [{id: f"unit:{u2}", label: f"Unit {u2} ({t2}) -> {f2}", status: "pending", detail: ""}]
          steps = steps + [{id: "compile", label: "Compile project sources", status: "pending", detail: ""}, {id: "deploy_code", label: "Deploy binary to Lambda", status: "pending", detail: ""}, {id: "finalize", label: "Record provision state", status: "pending", detail: ""}]
          steps_total = 7 + unit_count
          job = {job_id: job_id, project_slug: project_slug, environment: environment, repo_id: "", branch: "main", status: "pending", summary: "Queued", error: null, percent: 0, steps_done: 0, steps_total: steps_total, started_at: now, updated_at: now, finished_at: "", cursor: "load_config", stack_base: base, ddb_name: ddb_name, sns_name: sns_name, sqs_name: sqs_name, lambda_api: lambda_api, lambda_consumer: lambda_consumer, unit_count: unit_count, u0: u0, t0: t0, f0: f0, u1: u1, t1: t1, f1: f1, u2: u2, t2: t2, f2: f2, steps: steps}
          LocalFs.write!(path, Json.stringify(job))
          ret Json.stringify(job)
        impl start_provision_repo(repo_id, branch, slug, environment)
          disk = LocalFs.read_project_deploy!(slug)
          mut snap: Json = Json.parse(disk)
          LocalFs.create_dir_all!("/tmp/veil-provision-jobs")
          now = Dt.now()
          job_id = f"prov-{slug}-{environment}"
          path = LocalFs.join("/tmp/veil-provision-jobs", f"{job_id}.json")
          stack = snap["stack"]
          names = stack["names"]
          base = names["base"].as_str().unwrap_or("veil-unknown").to_string()
          ddb_name = names["dynamodb"].as_str().unwrap_or("veil-unknown").to_string()
          sns_name = names["sns"].as_str().unwrap_or("veil-unknown").to_string()
          sqs_name = names["sqs"].as_str().unwrap_or("veil-unknown").to_string()
          lambda_api = names["lambda_api"].as_str().unwrap_or("").to_string()
          lambda_consumer = names["lambda_consumer"].as_str().unwrap_or("").to_string()
          # Flat unit slots (avoid JSON-array for-loops in apply)
          mut u0 = ""
          mut u1 = ""
          mut u2 = ""
          mut t0 = ""
          mut t1 = ""
          mut t2 = ""
          mut f0 = ""
          mut f1 = ""
          mut f2 = ""
          mut unit_count = 0
          unit_names = LocalFs.project_unit_names!(slug)
          for uname in unit_names
            uty = LocalFs.project_unit_type!(slug, uname)
            mut fn_name = f"{base}-{uname}"
            if uty == "lambda-api" && lambda_api != ""
              fn_name = lambda_api.clone()
            if uty == "lambda-consumer" && lambda_consumer != ""
              fn_name = lambda_consumer.clone()
            if unit_count == 0
              u0 = uname.clone()
              t0 = uty.clone()
              f0 = fn_name.clone()
            if unit_count == 1
              u1 = uname.clone()
              t1 = uty.clone()
              f1 = fn_name.clone()
            if unit_count == 2
              u2 = uname.clone()
              t2 = uty.clone()
              f2 = fn_name.clone()
            unit_count = unit_count + 1
          mut steps = [{id: "load_config", label: "Load veil.toml deploy config", status: "pending", detail: ""}, {id: "stack_dynamodb", label: f"DynamoDB '{ddb_name}'", status: "pending", detail: ""}, {id: "stack_sns", label: f"SNS '{sns_name}'", status: "pending", detail: ""}, {id: "stack_sqs", label: f"SQS '{sqs_name}' + DLQ", status: "pending", detail: ""}]
          if unit_count > 0
            steps = steps + [{id: f"unit:{u0}", label: f"Unit '{u0}' ({t0}) -> '{f0}'", status: "pending", detail: ""}]
          if unit_count > 1
            steps = steps + [{id: f"unit:{u1}", label: f"Unit '{u1}' ({t1}) -> '{f1}'", status: "pending", detail: ""}]
          if unit_count > 2
            steps = steps + [{id: f"unit:{u2}", label: f"Unit '{u2}' ({t2}) -> '{f2}'", status: "pending", detail: ""}]
          steps = steps + [{id: "compile", label: "Compile project sources", status: "pending", detail: ""}, {id: "deploy_code", label: "Deploy binary to Lambda", status: "pending", detail: ""}, {id: "finalize", label: "Record provision state", status: "pending", detail: ""}]
          steps_total = 7 + unit_count
          job = {job_id: job_id, project_slug: slug, environment: environment, repo_id: repo_id, branch: branch, status: "pending", summary: "Queued", error: null, percent: 0, steps_done: 0, steps_total: steps_total, started_at: now, updated_at: now, finished_at: "", cursor: "load_config", stack_base: base, ddb_name: ddb_name, sns_name: sns_name, sqs_name: sqs_name, lambda_api: lambda_api, lambda_consumer: lambda_consumer, unit_count: unit_count, u0: u0, t0: t0, f0: f0, u1: u1, t1: t1, f1: f1, u2: u2, t2: t2, f2: f2, steps: steps}
          LocalFs.write!(path, Json.stringify(job))
          ret Json.stringify(job)
        impl get_provision_job(job_id)
          path = LocalFs.join("/tmp/veil-provision-jobs", f"{job_id}.json")
          if LocalFs.path_is_file(path)
            raw = LocalFs.read!(path)
            mut job: Json = Json.parse(raw)
            st = job["status"].as_str().unwrap_or("").to_string()
            if st == "succeeded"
              ret Json.stringify(job)
            if st == "failed"
              ret Json.stringify(job)
            mock_s = Env.get_or("VEIL_DEPLOY_EXECUTOR", "")
            mock = mock_s == "mock"
            if mock_s == "MOCK"
              mock = true
            now = Dt.now()
            cursor = job["cursor"].as_str().unwrap_or("done").to_string()
            ddb_name = job["ddb_name"].as_str().unwrap_or("veil-unknown").to_string()
            sns_name = job["sns_name"].as_str().unwrap_or("veil-unknown").to_string()
            sqs_name = job["sqs_name"].as_str().unwrap_or("veil-unknown").to_string()
            slug = job["project_slug"].as_str().unwrap_or("").to_string()
            environment = job["environment"].as_str().unwrap_or("dev").to_string()
            u0 = job["u0"].as_str().unwrap_or("").to_string()
            t0 = job["t0"].as_str().unwrap_or("").to_string()
            f0 = job["f0"].as_str().unwrap_or("").to_string()
            u1 = job["u1"].as_str().unwrap_or("").to_string()
            t1 = job["t1"].as_str().unwrap_or("").to_string()
            f1 = job["f1"].as_str().unwrap_or("").to_string()
            u2 = job["u2"].as_str().unwrap_or("").to_string()
            t2 = job["t2"].as_str().unwrap_or("").to_string()
            f2 = job["f2"].as_str().unwrap_or("").to_string()
            mut unit_count = 0
            if u0 != ""
              unit_count = 1
            if u1 != ""
              unit_count = 2
            if u2 != ""
              unit_count = 3
            role = Env.get_or("VEIL_LAMBDA_ROLE", "arn:aws:iam::086261225885:role/dlx-lambda-dev")
            mut detail = "ok"
            mut next_cursor = "done"
            mut status = "running"
            mut summary = "Running"
            mut steps_done = 0
            mut finished_s = ""
            total = 7 + unit_count
            # --- load_config ---
            if cursor == "load_config"
              detail = f"slug={slug} env={environment}"
              next_cursor = "stack_dynamodb"
              steps_done = 1
            # --- DynamoDB CreateTable PK/SK (stack.names.dynamodb) ---
            if cursor == "stack_dynamodb"
              if mock
                detail = f"mock ok {ddb_name}"
              else
                dr = ddb.describe_table().table_name(ddb_name).send()
                if dr.is_ok()
                  detail = f"{ddb_name} (exists)"
                else
                  ddb.create_table().table_name(ddb_name).billing_mode(BillingMode.PayPerRequest).attribute_definitions(AttributeDefinition.builder().attribute_name("PK").attribute_type(ScalarAttributeType.S).build!()).attribute_definitions(AttributeDefinition.builder().attribute_name("SK").attribute_type(ScalarAttributeType.S).build!()).key_schema(KeySchemaElement.builder().attribute_name("PK").key_type(KeyType.Hash).build!()).key_schema(KeySchemaElement.builder().attribute_name("SK").key_type(KeyType.Range).build!()).send!()
                  detail = f"{ddb_name} (created)"
              next_cursor = "stack_sns"
              steps_done = 2
            # --- SNS ---
            if cursor == "stack_sns"
              if mock
                detail = f"mock ok {sns_name}"
              else
                sns_out = sns.create_topic().name(sns_name).send!()
                mut topic_arn = ""
                if sns_out.topic_arn().is_some()
                  topic_arn = sns_out.topic_arn().unwrap().to_string()
                detail = f"SNS {sns_name} ensure arn={topic_arn}"
              next_cursor = "stack_sqs"
              steps_done = 3
            # --- SQS + DLQ ---
            if cursor == "stack_sqs"
              if mock
                detail = f"mock ok {sqs_name}"
              else
                dlq = f"{sqs_name}-dlq"
                dqr = sqs.get_queue_url().queue_name(dlq).send()
                if dqr.is_ok()
                  detail = f"DLQ {dlq} exists"
                else
                  sqs.create_queue().queue_name(dlq).send!()
                  detail = f"DLQ {dlq} created"
                qr = sqs.get_queue_url().queue_name(sqs_name).send()
                if qr.is_ok()
                  detail = f"{sqs_name} exists + {detail}"
                else
                  sqs.create_queue().queue_name(sqs_name).send!()
                  detail = f"{sqs_name} created + {detail}"
              next_cursor = "unit_0"
              steps_done = 4
            # --- unit 0 ---
            if cursor == "unit_0"
              if unit_count < 1
                detail = "no units"
                next_cursor = "compile"
                steps_done = 5
              else
                if mock
                  detail = f"mock unit {u0} -> {f0}"
                  next_cursor = "unit_1"
                  steps_done = 5
                else
                  mut arn0 = ""
                  exists0 = lambda.get_function().function_name(f0).send().is_ok()
                  if exists0
                    fout = lambda.get_function().function_name(f0).send!()
                    conf0 = fout.configuration()
                    if conf0.is_some()
                      c0 = conf0.unwrap()
                      fa0 = c0.function_arn()
                      if fa0.is_some()
                        arn0 = fa0.unwrap().to_string()
                    lambda.update_function_configuration().function_name(f0).memory_size(1024).timeout(30).send!()
                    detail = f"{f0} exists arn={arn0}"
                  else
                    zip_blob = Blob.from_hex("")
                    code = FunctionCode.builder().zip_file(zip_blob).build()
                    created = lambda.create_function().function_name(f0).runtime(Runtime.Nodejs20x).role(role).handler("index.handler").code(code).memory_size(1024).timeout(30).architectures(Architecture.Arm64).description("VEIL provisioned unit").send!()
                    fa_created = created.function_arn()
                    if fa_created.is_some()
                      arn0 = fa_created.unwrap().to_string()
                    detail = f"{f0} created arn={arn0}"
                  if t0 == "lambda-api"
                    if arn0 != ""
                      region = Env.get_or("AWS_REGION", "us-west-2")
                      mut api_id = Env.get_or("VEIL_GW_DASHLX_SERVICES", "")
                      mut api_name = ""
                      if api_id == ""
                        apis = apigw.get_apis().send!()
                        for item in apis.items()
                          pt = item.protocol_type()
                          if pt.is_some()
                            n = item.name().unwrap_or("").to_string()
                            if n.contains("dlx-rust") || n.contains("service-api") || n == "dashlx-services"
                              if api_id == ""
                                api_id = item.api_id().unwrap_or("").to_string()
                                api_name = n
                      if api_id != ""
                        integ_uri = f"arn:aws:apigateway:{region}:lambda:path/2015-03-31/functions/{arn0}/invocations"
                        mut integ_id = ""
                        integs = apigw.get_integrations().api_id(api_id).send!()
                        for integ in integs.items()
                          iu = integ.integration_uri().unwrap_or("").to_string()
                          if iu.contains(arn0)
                            integ_id = integ.integration_id().unwrap_or("").to_string()
                        if integ_id == ""
                          ci = apigw.create_integration().api_id(api_id).integration_type(IntegrationType.AwsProxy).integration_uri(integ_uri).payload_format_version("1.0").connection_type(ConnectionType.Internet).send!()
                          integ_id = ci.integration_id().unwrap_or("").to_string()
                        path_prefix = "/relay"
                        rk1 = f"ANY {path_prefix}"
                        # f-string {{ / }} escape → literal {proxy+} for HTTP API catch-all
                        rk2 = f"ANY {path_prefix}/{{proxy+}}"
                        routes = apigw.get_routes().api_id(api_id).send!()
                        mut has1 = false
                        mut has2 = false
                        for r in routes.items()
                          rk = r.route_key().unwrap_or("").to_string()
                          if rk == rk1
                            has1 = true
                            rid = r.route_id().unwrap_or("").to_string()
                            if rid != ""
                              apigw.update_route().api_id(api_id).route_id(rid).target(f"integrations/{integ_id}").send!()
                          if rk == rk2
                            has2 = true
                            rid2 = r.route_id().unwrap_or("").to_string()
                            if rid2 != ""
                              apigw.update_route().api_id(api_id).route_id(rid2).target(f"integrations/{integ_id}").send!()
                        if !has1
                          apigw.create_route().api_id(api_id).route_key(rk1).target(f"integrations/{integ_id}").authorization_type(AuthorizationType.None).send!()
                        if !has2
                          apigw.create_route().api_id(api_id).route_key(rk2).target(f"integrations/{integ_id}").authorization_type(AuthorizationType.None).send!()
                        # Account id: prefer env, never use * in source_arn
                        acct = Env.get_or("AWS_ACCOUNT_ID", "086261225885")
                        source_arn = f"arn:aws:execute-api:{region}:{acct}:{api_id}/*/*"
                        stmt = f"apigw_{api_id}_relay"
                        perm = lambda.add_permission().function_name(f0).statement_id(stmt).action("lambda:InvokeFunction").principal("apigateway.amazonaws.com").source_arn(source_arn).send()
                        if perm.is_ok()
                          detail = f"{detail}; apigw={api_id}/{api_name} routes+perm ok"
                        else
                          detail = f"{detail}; apigw={api_id} perm ensure (may already exist)"
                      else
                        detail = f"{detail}; no existing HTTP API for dashlx-services (set VEIL_GW_DASHLX_SERVICES)"
                  pk = f"DEPLOY#{environment}#{u0}"
                  state = Json.stringify({project: slug, unit_name: u0, unit_type: t0, environment: environment, status: "Active", lambda_name: f0, lambda_arn: arn0, role_arn: role})
                  ddb.put_item().table_name(ddb_name).item("PK", AttributeValue.S(pk.clone())).item("SK", AttributeValue.S("CURRENT")).item("data", AttributeValue.S(state)).send!()
                  next_cursor = "unit_1"
                  steps_done = 5
            if cursor == "unit_1"
              if unit_count < 2
                detail = "no unit_1"
                next_cursor = "compile"
                steps_done = 6
              else
                if mock
                  detail = f"mock unit {u1} -> {f1}"
                  next_cursor = "unit_2"
                  steps_done = 6
                else
                  timeout1 = 30
                  if t1 == "lambda-consumer"
                    timeout1 = 900
                  mut arn1 = ""
                  exists1 = lambda.get_function().function_name(f1).send().is_ok()
                  if exists1
                    fout1 = lambda.get_function().function_name(f1).send!()
                    conf1 = fout1.configuration()
                    if conf1.is_some()
                      c1 = conf1.unwrap()
                      fa1 = c1.function_arn()
                      if fa1.is_some()
                        arn1 = fa1.unwrap().to_string()
                    lambda.update_function_configuration().function_name(f1).memory_size(1024).timeout(timeout1).send!()
                    detail = f"{f1} exists arn={arn1}"
                  else
                    zip_blob = Blob.from_hex("")
                    code = FunctionCode.builder().zip_file(zip_blob).build()
                    created = lambda.create_function().function_name(f1).runtime(Runtime.Nodejs20x).role(role).handler("index.handler").code(code).memory_size(1024).timeout(timeout1).architectures(Architecture.Arm64).description("VEIL provisioned unit").send!()
                    fa_c1 = created.function_arn()
                    if fa_c1.is_some()
                      arn1 = fa_c1.unwrap().to_string()
                    detail = f"{f1} created arn={arn1}"
                  if t1 == "lambda-consumer"
                    region = Env.get_or("AWS_REGION", "us-west-2")
                    acct = Env.get_or("AWS_ACCOUNT_ID", "086261225885")
                    # Construct queue ARN (standard SQS shape) — avoids Option attribute parsing
                    qarn = f"arn:aws:sqs:{region}:{acct}:{sqs_name}"
                    mut esm_uuid = ""
                    maps = lambda.list_event_source_mappings().function_name(f1).send!()
                    for m in maps.event_source_mappings()
                      mut ea = ""
                      if m.event_source_arn().is_some()
                        ea = m.event_source_arn().unwrap().to_string()
                      if ea == qarn
                        if m.uuid().is_some()
                          esm_uuid = m.uuid().unwrap().to_string()
                        else
                          esm_uuid = "exists"
                    if esm_uuid == ""
                      esm = lambda.create_event_source_mapping().function_name(f1).event_source_arn(qarn).batch_size(1).enabled(true).send!()
                      if esm.uuid().is_some()
                        esm_uuid = esm.uuid().unwrap().to_string()
                      else
                        esm_uuid = "created"
                    detail = f"{detail}; esm={esm_uuid}"
                  pk = f"DEPLOY#{environment}#{u1}"
                  state = Json.stringify({project: slug, unit_name: u1, unit_type: t1, environment: environment, status: "Active", lambda_name: f1, lambda_arn: arn1, role_arn: role, sqs: sqs_name})
                  ddb.put_item().table_name(ddb_name).item("PK", AttributeValue.S(pk.clone())).item("SK", AttributeValue.S("CURRENT")).item("data", AttributeValue.S(state)).send!()
                  next_cursor = "unit_2"
                  steps_done = 6
            if cursor == "unit_2"
              if unit_count < 3
                detail = "no unit_2"
                next_cursor = "compile"
                steps_done = 7
              else
                if mock
                  detail = f"mock unit {u2} -> {f2}"
                  next_cursor = "compile"
                  steps_done = 7
                else
                  mut arn2 = ""
                  exists2 = lambda.get_function().function_name(f2).send().is_ok()
                  if exists2
                    fout2 = lambda.get_function().function_name(f2).send!()
                    conf2 = fout2.configuration()
                    if conf2.is_some()
                      c2 = conf2.unwrap()
                      fa2 = c2.function_arn()
                      if fa2.is_some()
                        arn2 = fa2.unwrap().to_string()
                    detail = f"{f2} exists arn={arn2}"
                  else
                    zip_blob = Blob.from_hex("")
                    code = FunctionCode.builder().zip_file(zip_blob).build()
                    created = lambda.create_function().function_name(f2).runtime(Runtime.Nodejs20x).role(role).handler("index.handler").code(code).memory_size(1024).timeout(30).architectures(Architecture.Arm64).description("VEIL provisioned unit").send!()
                    fa_c2 = created.function_arn()
                    if fa_c2.is_some()
                      arn2 = fa_c2.unwrap().to_string()
                    detail = f"{f2} created arn={arn2}"
                  pk = f"DEPLOY#{environment}#{u2}"
                  state = Json.stringify({project: slug, unit_name: u2, unit_type: t2, environment: environment, status: "Active", lambda_name: f2, lambda_arn: arn2})
                  ddb.put_item().table_name(ddb_name).item("PK", AttributeValue.S(pk.clone())).item("SK", AttributeValue.S("CURRENT")).item("data", AttributeValue.S(state)).send!()
                  next_cursor = "compile"
                  steps_done = 7
            # --- compile / deploy / finalize ---
            # Process.run / Blob.from_file are language primitives (codegen), not product facades.
            # Soft Process.run returns "… failed: …" on non-zero so the job can record status.
            if cursor == "compile"
              if mock
                detail = "mock compile"
                next_cursor = "deploy_code"
                steps_done = steps_done + 1
              else
                hub = LocalFs.projects_dir()
                root = LocalFs.join(hub, slug)
                backend_toml = LocalFs.join(LocalFs.join(LocalFs.join(root, "generated"), "backend"), "Cargo.toml")
                main_veil = LocalFs.join(root, "main.veil")
                mut gen_detail = ""
                mut build_detail = ""
                if !LocalFs.path_exists(root)
                  detail = f"project root missing {root}"
                  status = "failed"
                  summary = detail.clone()
                  next_cursor = "compile"
                  finished_s = "done"
                else
                  # Prefer PATH `veil`, else compiler next to this host binary.
                  if LocalFs.path_is_file(main_veil)
                    gen_detail = Process.run("veil", "gen main.veil -o generated/backend -t rust", root)
                    if gen_detail.contains(" failed") || gen_detail.contains("spawn failed")
                      veil_bin_path = Env.get_or("VEIL_BIN", "")
                      if veil_bin_path != ""
                        gen_detail = Process.run(veil_bin_path, "gen main.veil -o generated/backend -t rust", root)
                  if LocalFs.path_is_file(backend_toml)
                    build_detail = Process.run("cargo", "build --release --manifest-path generated/backend/Cargo.toml", root)
                  else
                    build_detail = f"no Cargo.toml at {backend_toml}"
                  detail = f"gen={gen_detail}; build={build_detail}"
                  # Always advance: units already ensured. Missing binary → deploy keeps placeholders.
                  if build_detail.contains(" failed") || build_detail.contains("spawn failed") || build_detail.contains("no Cargo.toml")
                    detail = f"compile soft-fail (infra ok): {detail}"
                  next_cursor = "deploy_code"
                  steps_done = steps_done + 1
            if cursor == "deploy_code"
              if mock
                detail = "mock deploy"
                next_cursor = "finalize"
                steps_done = steps_done + 1
              else
                hub = LocalFs.projects_dir()
                root = LocalFs.join(hub, slug)
                bin_path = LocalFs.join(LocalFs.join(LocalFs.join(LocalFs.join(root, "generated"), "backend"), "target"), "release")
                bin_relay = LocalFs.join(bin_path, "relay")
                bin_veil = LocalFs.join(bin_path, "veil_bin")
                mut binary = ""
                if LocalFs.path_is_file(bin_relay)
                  binary = bin_relay
                else if LocalFs.path_is_file(bin_veil)
                  binary = bin_veil
                if binary == ""
                  # Placeholder Node runtime already on Lambda from unit ensure — not fatal.
                  detail = f"no release binary under {bin_path} — keeping unit placeholder code"
                  next_cursor = "finalize"
                  steps_done = steps_done + 1
                else
                  # Process.run splits args on whitespace — no `sh -c "…"` multi-word scripts.
                  zip_out = f"/tmp/veil-{slug}-bootstrap.zip"
                  work = f"/tmp/veil-{slug}-boot"
                  LocalFs.create_dir_all!(work)
                  boot_path = LocalFs.join(work, "bootstrap")
                  copy_d = Process.run("cp", f"{binary} {boot_path}", root)
                  pack = Process.run("zip", f"-j {zip_out} bootstrap", work)
                  if copy_d.contains(" failed") || copy_d.contains("spawn failed") || pack.contains(" failed") || pack.contains("spawn failed")
                    detail = f"package soft-fail (keep placeholder): copy={copy_d}; zip={pack}"
                    next_cursor = "finalize"
                    steps_done = steps_done + 1
                  else
                    code_blob = Blob.from_file(zip_out)
                    mut deploy_msgs = ""
                    if f0 != ""
                      lambda.update_function_configuration().function_name(f0).runtime(Runtime.Providedal2023).handler("bootstrap").send!()
                      lambda.update_function_code().function_name(f0).zip_file(code_blob).publish(true).send!()
                      deploy_msgs = f"{f0} updated; "
                    if f1 != ""
                      code_blob1 = Blob.from_file(zip_out)
                      lambda.update_function_configuration().function_name(f1).runtime(Runtime.Providedal2023).handler("bootstrap").send!()
                      lambda.update_function_code().function_name(f1).zip_file(code_blob1).publish(true).send!()
                      deploy_msgs = f"{deploy_msgs}{f1} updated; "
                    if f2 != ""
                      code_blob2 = Blob.from_file(zip_out)
                      lambda.update_function_configuration().function_name(f2).runtime(Runtime.Providedal2023).handler("bootstrap").send!()
                      lambda.update_function_code().function_name(f2).zip_file(code_blob2).publish(true).send!()
                      deploy_msgs = f"{deploy_msgs}{f2} updated"
                    detail = f"deployed from {binary}: {deploy_msgs}"
                    next_cursor = "finalize"
                    steps_done = steps_done + 1
            if cursor == "finalize"
              detail = "All steps complete"
              next_cursor = "done"
              status = "succeeded"
              summary = f"Provisioned {slug} in {environment}"
              finished_s = "done"
              steps_done = total
            if cursor == "done"
              status = "succeeded"
              summary = f"Provisioned {slug} in {environment}"
              finished_s = "done"
            # Rebuild steps for UI progress
            mut s_load = "pending"
            mut s_ddb = "pending"
            mut s_sns = "pending"
            mut s_sqs = "pending"
            mut s_u0 = "pending"
            mut s_u1 = "pending"
            mut s_u2 = "pending"
            mut s_comp = "pending"
            mut s_dep = "pending"
            mut s_fin = "pending"
            mut d_load = ""
            mut d_ddb = ""
            mut d_sns = ""
            mut d_sqs = ""
            mut d_u0 = ""
            mut d_u1 = ""
            mut d_u2 = ""
            mut d_comp = ""
            mut d_dep = ""
            mut d_fin = ""
            if steps_done >= 1
              s_load = "done"
            if steps_done >= 2
              s_ddb = "done"
            if steps_done >= 3
              s_sns = "done"
            if steps_done >= 4
              s_sqs = "done"
            if steps_done >= 5
              s_u0 = "done"
            if steps_done >= 6
              s_u1 = "done"
            if steps_done >= 7
              s_u2 = "done"
            if cursor == "load_config"
              d_load = detail.clone()
              s_load = "done"
            if cursor == "stack_dynamodb"
              d_ddb = detail.clone()
              s_ddb = "done"
            if cursor == "stack_sns"
              d_sns = detail.clone()
              s_sns = "done"
            if cursor == "stack_sqs"
              d_sqs = detail.clone()
              s_sqs = "done"
            if cursor == "unit_0"
              d_u0 = detail.clone()
              s_u0 = "done"
            if cursor == "unit_1"
              d_u1 = detail.clone()
              s_u1 = "done"
            if cursor == "unit_2"
              d_u2 = detail.clone()
              s_u2 = "done"
            if cursor == "compile"
              d_comp = detail.clone()
              s_comp = "done"
            if cursor == "deploy_code"
              d_dep = detail.clone()
              s_dep = "done"
            if cursor == "finalize"
              d_fin = detail.clone()
              s_fin = "done"
              s_load = "done"
              s_ddb = "done"
              s_sns = "done"
              s_sqs = "done"
              s_u0 = "done"
              s_u1 = "done"
              s_u2 = "done"
              s_comp = "done"
              s_dep = "done"
            mut out_steps = [{id: "load_config", label: "Load veil.toml deploy config", status: s_load, detail: d_load}, {id: "stack_dynamodb", label: f"DynamoDB {ddb_name}", status: s_ddb, detail: d_ddb}, {id: "stack_sns", label: f"SNS {sns_name}", status: s_sns, detail: d_sns}, {id: "stack_sqs", label: f"SQS {sqs_name} + DLQ", status: s_sqs, detail: d_sqs}]
            if unit_count > 0
              out_steps = out_steps + [{id: f"unit:{u0}", label: f"Unit {u0} ({t0}) -> {f0}", status: s_u0, detail: d_u0}]
            if unit_count > 1
              out_steps = out_steps + [{id: f"unit:{u1}", label: f"Unit {u1} ({t1}) -> {f1}", status: s_u1, detail: d_u1}]
            if unit_count > 2
              out_steps = out_steps + [{id: f"unit:{u2}", label: f"Unit {u2} ({t2}) -> {f2}", status: s_u2, detail: d_u2}]
            out_steps = out_steps + [{id: "compile", label: "Compile project sources", status: s_comp, detail: d_comp}, {id: "deploy_code", label: "Deploy binary to Lambda", status: s_dep, detail: d_dep}, {id: "finalize", label: "Record provision state", status: s_fin, detail: d_fin}]
            pct = 0
            if total > 0
              pct = (steps_done * 100) / total
            if pct > 100
              pct = 100
            if status == "running"
              summary = f"Running {cursor} -> {next_cursor}"
            mut err_out: Json = Json.null()
            if status == "failed"
              err_out = Json.parse(Json.stringify(detail))
            mut last_status = "done"
            if status == "failed"
              last_status = "failed"
            outj = {job_id: job["job_id"], project_slug: slug, environment: environment, repo_id: job["repo_id"], branch: job["branch"], status: status, summary: summary, error: err_out, percent: pct, steps_done: steps_done, steps_total: total, started_at: job["started_at"], updated_at: now, finished_at: finished_s, cursor: next_cursor, stack_base: job["stack_base"], ddb_name: ddb_name, sns_name: sns_name, sqs_name: sqs_name, lambda_api: job["lambda_api"], lambda_consumer: job["lambda_consumer"], unit_count: unit_count, u0: u0, t0: t0, f0: f0, u1: u1, t1: t1, f1: f1, u2: u2, t2: t2, f2: f2, steps: out_steps, last_step: {id: cursor, status: last_status, detail: detail}}
            LocalFs.write!(path, Json.stringify(outj))
            ret Json.stringify(outj)
          ret Json.stringify({error: f"unknown job {job_id}", status: "failed", steps: []})

        impl provision_unit(project_slug, environment, unit_name)
          mock = Env.get_or("VEIL_DEPLOY_EXECUTOR", "")
          if mock == "mock" || mock == "MOCK"
            ret Json.stringify({success: true, already: false, unit_name: unit_name, environment: environment, message: "mock provisioned", summary: f"Mock-provisioned {unit_name} in {environment}", resources: {note: "VEIL_DEPLOY_EXECUTOR=mock"}, duration_ms: 0})
          disk = LocalFs.read_project_deploy!(project_slug)
          mut snap: Json = Json.parse(disk)
          names = snap["stack"]["names"]
          base = names["base"].as_str().unwrap_or("veil-unknown").to_string()
          uty = LocalFs.project_unit_type!(project_slug, unit_name)
          mut fn_name = f"{base}-{unit_name}"
          if uty == "lambda-api"
            la = names["lambda_api"].as_str().unwrap_or("").to_string()
            if la != ""
              fn_name = la
          if uty == "lambda-consumer"
            lc = names["lambda_consumer"].as_str().unwrap_or("").to_string()
            if lc != ""
              fn_name = lc
          exists = lambda.get_function().function_name(fn_name).send()
          if exists.is_ok()
            ret Json.stringify({success: true, already: true, unit_name: unit_name, environment: environment, message: "already provisioned", summary: f"{unit_name} already provisioned in {environment}", resources: {lambda_name: fn_name}, duration_ms: 0})
          role = Env.get_or("VEIL_LAMBDA_ROLE", "arn:aws:iam::086261225885:role/dlx-lambda-dev")
          ret Json.stringify({success: false, unit_name: unit_name, environment: environment, message: "function missing - use ProvisionProject job for stack ensure + CreateFunction", summary: f"Unit {unit_name} -> '{fn_name}' not found; role={role}", resources: {lambda_name: fn_name, role_arn: role}, duration_ms: 0})
        impl clear_unit_state(environment, unit_name)
          table = Env.get_or("VEIL_DDB_TABLE", Env.get_or("TABLE", "veil-runtime-dev"))
          pk = f"DEPLOY#{environment}#{unit_name}"
          resp = ddb.query().table_name(table).key_condition_expression("PK = :pk").expression_attribute_values(":pk", AttributeValue.S(pk.clone())).send!()
          items = resp.items()
          mut deleted = 0
          for item in items
            sk = item.get("SK").unwrap().as_s().unwrap()
            ddb.delete_item().table_name(table).key("PK", AttributeValue.S(pk.clone())).key("SK", AttributeValue.S(sk)).send!()
            deleted = deleted + 1
          ret Json.stringify({deleted: deleted, pk: pk})

      adapter MockActionExecutor for ActionExecutor
        impl execute_action(action, state)
          ret ActionResult{success: true, message: f"Mock executed: {action.description}", resource_updates: Map.new(), duration_ms: 0}

  # ═══════════════════════════════════════════════════════════════════════════
  # ChangeManagement — SDLC workflow (SOC 2: PRs, reviews, merge gates)
  # ═══════════════════════════════════════════════════════════════════════════

  ctx ChangeManagement
    group domain

      enum PrStatus
        Draft
        ReadyForReview
        Approved
        ChangesRequested
        Merging
        Merged
        Rejected
        Closed

      enum CiStatus
        Pending
        Running
        Passed
        Failed
        Skipped

      enum DiffKind
        Added
        Modified
        Removed
        Moved

      val StructuralChange
        kind: DiffKind
        path: Str
        detail: Str
        construct_type: Opt<Str>

      val DiffSummary
        description: Str
        changes: List<StructuralChange>
        files_changed: Int
        additions: Int
        removals: Int

      val ReviewComment
        id: Id
        pr_id: Id
        author: Str
        construct_path: Opt<Str>
        body: Str
        created_at: Dt
        resolved: Bool

      val Approval
        pr_id: Id
        reviewer: Str
        approved_at: Dt
        comment: Opt<Str>

      val CiRun
        id: Id
        pr_id: Id
        commit_hash: Str
        status: CiStatus
        started_at: Dt
        completed_at: Opt<Dt>
        duration_ms: Opt<Int>
        logs_key: Opt<Str>
        error_summary: Opt<Str>

      agg ChangeRequest
        root
          id: Id
          repo_id: Id
          title: Str
          description: Str
          jira_ticket: Str
          source_branch: Str
          target_branch: Str
          author: Str
          status: PrStatus
          created_at: Dt
          updated_at: Dt
          merged_at: Opt<Dt>
          merged_by: Opt<Str>
          merge_commit: Opt<Str>

      # ─── Repositories ──────────────────────────────────────────────────

      repo ChangeRequestRepo
        find!(id: Id) -> Opt<ChangeRequest>
        list_by_repo!(repo_id: Id, status: Opt<PrStatus>) -> List<ChangeRequest>
        list_open!(repo_id: Id) -> List<ChangeRequest>
        save!(cr: ChangeRequest)

      repo ApprovalRepo
        find_for_pr!(pr_id: Id) -> List<Approval>
        save!(approval: Approval)

      repo CiRunRepo
        latest_for_pr!(pr_id: Id) -> Opt<CiRun>
        list_for_pr!(pr_id: Id) -> List<CiRun>
        save!(run: CiRun)

      repo CommentRepo
        list_for_pr!(pr_id: Id) -> List<ReviewComment>
        save!(comment: ReviewComment)
        resolve!(id: Id)

    group infrastructure

      # Git operations — backed by git-remote-object-store (gix + S3)
      port GitService
        init_repo!(slug: Str)
        repo_exists!(slug: Str) -> Bool
        create_branch!(slug: Str, branch_name: Str, from_ref: Str) -> Str
        delete_branch!(slug: Str, branch_name: Str)
        list_branches!(slug: Str) -> List<Str>
        get_head!(slug: Str, branch: Str) -> Str
        commit_file!(slug: Str, branch: Str, path: Str, content: Str, message: Str, author: Str) -> Str
        read_file!(slug: Str, branch: Str, path: Str) -> Opt<Str>
        list_files!(slug: Str, branch: Str) -> List<Str>
        log!(slug: Str, branch: Str, limit: Int) -> Json
        merge!(slug: Str, source: Str, target: Str, message: Str, author: Str) -> Str
        diff_files!(slug: Str, base_ref: Str, head_ref: Str) -> Json
        can_merge!(slug: Str, source: Str, target: Str) -> Json

      # DDB adapter for ChangeRequest aggregate
      adapter DdbChangeRequestRepo for ChangeRequestRepo
        @field(client: DdbClient)
        @env(VEIL_DDB_TABLE)

        impl find(id)
          pk = f"PR#{id}"
          resp = client.get_item().table_name(table).key("PK", AttributeValue.S(pk)).key("SK", AttributeValue.S("META")).send!()
          match resp.item()
            None ->
              ret null
            Some(item) ->
              data = item.get("data").unwrap().as_s().unwrap()
              ret Json.parse(data)

        impl list_by_repo(repo_id, status)
          resp = client.query().table_name(table).index_name("GSI1").key_condition_expression("GSI1PK = :pk").expression_attribute_values(":pk", AttributeValue.S(f"REPO_PRS#{repo_id}")).send!()
          items = resp.items()
          out = []
          for item in items
            data = item.get("data").unwrap().as_s().unwrap()
            cr: ChangeRequest = Json.parse(data)
            if status.is_none() || cr.status == status.clone().unwrap_or(cr.status.clone())
              out = out + [cr]
          ret out

        impl list_open(repo_id)
          resp = client.query().table_name(table).index_name("GSI1").key_condition_expression("GSI1PK = :pk").expression_attribute_values(":pk", AttributeValue.S(f"REPO_PRS#{repo_id}")).send!()
          items = resp.items()
          out = []
          for item in items
            data = item.get("data").unwrap().as_s().unwrap()
            cr: ChangeRequest = Json.parse(data)
            if cr.status != PrStatus.Merged && cr.status != PrStatus.Rejected && cr.status != PrStatus.Closed
              out = out + [cr]
          ret out

        impl save(cr)
          pk = f"PR#{cr.id}"
          gsi1pk = f"REPO_PRS#{cr.repo_id}"
          client.put_item().table_name(table).item("PK", AttributeValue.S(pk)).item("SK", AttributeValue.S("META")).item("GSI1PK", AttributeValue.S(gsi1pk)).item("GSI1SK", AttributeValue.S(cr.updated_at.to_string())).item("data", AttributeValue.S(Json.stringify(cr))).send!()

      # DDB adapter for Approval
      adapter DdbApprovalRepo for ApprovalRepo
        @field(client: DdbClient)
        @env(VEIL_DDB_TABLE)

        impl find_for_pr(pr_id)
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND begins_with(SK, :prefix)").expression_attribute_values(":pk", AttributeValue.S(f"PR#{pr_id}")).expression_attribute_values(":prefix", AttributeValue.S("APPROVAL#")).send!()
          items = resp.items()
          out = []
          for item in items
            data = item.get("data").unwrap().as_s().unwrap()
            out = out + [Json.parse(data)]
          ret out

        impl save(approval)
          pk = f"PR#{approval.pr_id}"
          sk = f"APPROVAL#{approval.reviewer}"
          client.put_item().table_name(table).item("PK", AttributeValue.S(pk)).item("SK", AttributeValue.S(sk)).item("data", AttributeValue.S(Json.stringify(approval))).send!()

      # DDB adapter for CiRun
      adapter DdbCiRunRepo for CiRunRepo
        @field(client: DdbClient)
        @env(VEIL_DDB_TABLE)

        impl latest_for_pr(pr_id)
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND begins_with(SK, :prefix)").expression_attribute_values(":pk", AttributeValue.S(f"PR#{pr_id}")).expression_attribute_values(":prefix", AttributeValue.S("CI#")).scan_index_forward(false).limit(1).send!()
          items = resp.items()
          if items.is_empty()
            ret null
          data = items[0].get("data").unwrap().as_s().unwrap()
          ret Json.parse(data)

        impl list_for_pr(pr_id)
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND begins_with(SK, :prefix)").expression_attribute_values(":pk", AttributeValue.S(f"PR#{pr_id}")).expression_attribute_values(":prefix", AttributeValue.S("CI#")).send!()
          items = resp.items()
          out = []
          for item in items
            data = item.get("data").unwrap().as_s().unwrap()
            out = out + [Json.parse(data)]
          ret out

        impl save(run)
          pk = f"PR#{run.pr_id}"
          sk = f"CI#{run.started_at.to_string()}#{run.id}"
          client.put_item().table_name(table).item("PK", AttributeValue.S(pk)).item("SK", AttributeValue.S(sk)).item("data", AttributeValue.S(Json.stringify(run))).send!()

      # DDB adapter for ReviewComment
      adapter DdbCommentRepo for CommentRepo
        @field(client: DdbClient)
        @env(VEIL_DDB_TABLE)

        impl list_for_pr(pr_id)
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND begins_with(SK, :prefix)").expression_attribute_values(":pk", AttributeValue.S(f"PR#{pr_id}")).expression_attribute_values(":prefix", AttributeValue.S("COMMENT#")).send!()
          items = resp.items()
          out = []
          for item in items
            data = item.get("data").unwrap().as_s().unwrap()
            out = out + [Json.parse(data)]
          ret out

        impl save(comment)
          pk = f"PR#{comment.pr_id}"
          sk = f"COMMENT#{comment.created_at.to_string()}#{comment.id}"
          client.put_item().table_name(table).item("PK", AttributeValue.S(pk)).item("SK", AttributeValue.S(sk)).item("data", AttributeValue.S(Json.stringify(comment))).send!()

        impl resolve(id)
          # Mark a comment as resolved (scan + update)
          ret Ok

      # Git adapter: gix for object model (real commits/trees/blobs) + S3 for object persistence.
      # Local cache at /tmp/veil-git-cache/{slug}/ — bare repos opened via gix.
      # S3 stores loose objects at git/{slug}/objects/{sha[0:2]}/{sha[2:]}
      # and ref pointers at git/{slug}/refs/heads/{branch}
      adapter S3GitServiceAdapter for GitService
        @field(s3: S3Client)
        @env(BUCKET)

        impl init_repo(slug)
          # All gix operations scoped — !Send types dropped at block exit
          cache_path = f"/tmp/veil-git-cache/{slug}"
          LocalFs.create_dir_all(cache_path)
          commit_hash = do
            repo = gix.init_bare(cache_path)
            empty_tree = repo.empty_tree()
            tree_oid = empty_tree.id().detach()
            commit_id = repo.commit("refs/heads/main", "Initial commit", tree_oid, [tree_oid])
            commit_id.detach().to_string()
          # gix types dropped — safe to .await
          head_key = f"git/{slug}/refs/heads/main"
          s3.put_object().bucket(self.bucket).key(head_key).body(commit_hash.clone().into_bytes().into()).send!()
          marker_key = f"git/{slug}/.initialized"
          marker_body = "true"
          s3.put_object().bucket(self.bucket).key(marker_key).body(marker_body.into_bytes().into()).send!()

        impl repo_exists(slug)
          key = f"git/{slug}/.initialized"
          resp = s3.head_object().bucket(self.bucket).key(key).send()
          ret resp.is_ok()

        impl create_branch(slug, branch_name, from_ref)
          # Read source branch HEAD from S3
          src_key = f"git/{slug}/refs/heads/{from_ref}"
          resp = s3.get_object().bucket(self.bucket).key(src_key).send!()
          agg = resp.body.collect!()
          body = agg.into_bytes()
          text = body.to_vec()
          src_sha = std.str.from_utf8(text.as_slice()).unwrap_or("").to_string()
          # Write new branch ref pointing to same commit
          dest_key = f"git/{slug}/refs/heads/{branch_name}"
          s3.put_object().bucket(self.bucket).key(dest_key).body(src_sha.clone().into_bytes().into()).send!()
          ret branch_name

        impl delete_branch(slug, branch_name)
          key = f"git/{slug}/refs/heads/{branch_name}"
          s3.delete_object().bucket(self.bucket).key(key).send!()

        impl list_branches(slug)
          prefix = f"git/{slug}/refs/heads/"
          resp = s3.list_objects_v2().bucket(self.bucket).prefix(prefix).send!()
          out = []
          for obj in resp.contents()
            raw = obj.key().unwrap_or_default().replace(prefix, "")
            if raw != "" && !raw.starts_with(".")
              out = out + [raw]
          ret out

        impl get_head(slug, branch)
          key = f"git/{slug}/refs/heads/{branch}"
          resp = s3.get_object().bucket(self.bucket).key(key).send()
          match resp
            Ok(output) ->
              agg = output.body.collect!()
              body = agg.into_bytes()
              text = body.to_vec()
              ret std.str.from_utf8(text.as_slice()).unwrap_or("initial").to_string().trim().to_string()
            Err(_) ->
              ret "initial"

        impl commit_file(slug, branch, path, content, message, author)
          # All gix operations scoped in a do-block — !Send types dropped at block exit
          cache_path = f"/tmp/veil-git-cache/{slug}"
          LocalFs.create_dir_all(cache_path)
          hash = do
            repo = ThreadSafeRepository.open(cache_path).to_thread_local()
            blob_id = repo.write_blob(content.as_bytes())
            blob_oid = blob_id.detach()
            tree = repo.empty_tree()
            mut editor = tree.edit()
            editor.upsert(path, EntryKind.Blob, blob_oid)
            new_tree_id = editor.write()
            new_tree_oid = new_tree_id.detach()
            parent_ref = f"refs/heads/{branch}"
            commit_id = repo.commit(parent_ref, message, new_tree_oid, [new_tree_oid])
            commit_id.detach().to_string()
          # gix types are now out of scope — safe to .await
          head_key = f"git/{slug}/refs/heads/{branch}"
          s3.put_object().bucket(self.bucket).key(head_key).body(hash.clone().into_bytes().into()).send!()
          ret hash

        impl read_file(slug, branch, path)
          # For now, use S3 flat-file fallback for read (gix local cache may not have objects)
          key = f"repos/{slug}/{branch}/{path}"
          resp = s3.get_object().bucket(self.bucket).key(key).send()
          match resp
            Ok(output) ->
              agg = output.body.collect!()
              body = agg.into_bytes()
              text = body.to_vec()
              ret Opt.some(std.str.from_utf8(text.as_slice()).unwrap_or("").to_string())
            Err(_) ->
              ret null

        impl list_files(slug, branch)
          prefix = f"repos/{slug}/{branch}/"
          resp = s3.list_objects_v2().bucket(self.bucket).prefix(prefix).send!()
          out = []
          if !resp.contents().is_empty()
            for obj in resp.contents()
              k = obj.key().unwrap().replace(prefix, "")
              if !k.starts_with(".")
                out = out + [k]
          ret out

        impl log(slug, branch, limit)
          # Return empty log until we implement commit chain traversal
          ret Json.parse("[]")

        impl merge(slug, source, target, message, author)
          # Simple merge: copy source HEAD to target (fast-forward)
          src_key = f"git/{slug}/refs/heads/{source}"
          resp = s3.get_object().bucket(self.bucket).key(src_key).send!()
          agg = resp.body.collect!()
          body = agg.into_bytes()
          text = body.to_vec()
          src_sha = std.str.from_utf8(text.as_slice()).unwrap_or("").to_string()
          # Update target ref
          dest_key = f"git/{slug}/refs/heads/{target}"
          s3.put_object().bucket(self.bucket).key(dest_key).body(src_sha.clone().into_bytes().into()).send!()
          ret src_sha

        impl diff_files(slug, base_ref, head_ref)
          # Stub: return empty diff until tree comparison is implemented
          ret Json.parse("[]")

        impl can_merge(slug, source, target)
          ret {can_merge: true, conflicts: [], behind_by: 0}

    group application

      # Create a new change request (branch + PR record)
      svc CreateChangeRequest
        -> ChangeRequest
        @dep(git: GitService)
        @dep(cr_repo: ChangeRequestRepo)
        input
          repo_id: Id
          slug: Str
          title: Str
          description: Str
          jira_ticket: Str
          author: Str
        step validate
          guard jira_ticket.len() > 0, "Jira ticket required"
          guard title.len() > 0, "Title required"
        step create_branch
          branch_name = f"cr/{jira_ticket}/{title.to_lowercase().replace(' ', '-')}"
          git.create_branch!(slug, branch_name, "main")
        step persist
          now = Dt.now()
          id = Id.new()
          cr = ChangeRequest{id, repo_id, title, description, jira_ticket, source_branch: branch_name, target_branch: "main", author, status: PrStatus.Draft, created_at: now, updated_at: now, merged_at: null, merged_by: null, merge_commit: null}
          cr_repo.save!(cr)
          ret cr

      # Commit a file to a PR's branch
      svc CommitToChange
        -> Json
        @dep(git: GitService)
        @dep(cr_repo: ChangeRequestRepo)
        input
          pr_id: Id
          slug: Str
          path: Str
          content: Str
          message: Str
          author: Str
        step resolve
          cr = cr_repo.find!(pr_id)
          guard cr.is_some(), "PR not found"
          pr = cr.unwrap()
          guard pr.status != PrStatus.Merged, "Cannot commit to merged PR"
          guard pr.status != PrStatus.Rejected, "Cannot commit to rejected PR"
        step commit
          hash = git.commit_file!(slug, pr.source_branch, path, content, f"[{pr.jira_ticket}] {message}", author)
          ret {hash: hash, branch: pr.source_branch}

      # Submit PR for review
      svc SubmitForReview
        @dep(cr_repo: ChangeRequestRepo)
        input
          pr_id: Id
        step transition
          cr = cr_repo.find!(pr_id)
          guard cr.is_some(), "PR not found"
          pr = cr.unwrap()
          guard pr.status == PrStatus.Draft || pr.status == PrStatus.ChangesRequested, "PR not in submittable state"
          pr.status = PrStatus.ReadyForReview
          pr.updated_at = Dt.now()
          cr_repo.save!(pr)

      # Approve a change
      svc ApproveChange
        @dep(cr_repo: ChangeRequestRepo)
        @dep(approval_repo: ApprovalRepo)
        input
          pr_id: Id
          reviewer: Str
          comment: Opt<Str>
        step validate
          cr = cr_repo.find!(pr_id)
          guard cr.is_some(), "PR not found"
          pr = cr.unwrap()
          guard pr.status == PrStatus.ReadyForReview, "PR not in reviewable state"
          guard reviewer != pr.author, "Author cannot approve their own change"
        step record
          approval = Approval{pr_id, reviewer, approved_at: Dt.now(), comment}
          approval_repo.save!(approval)
          pr.status = PrStatus.Approved
          pr.updated_at = Dt.now()
          cr_repo.save!(pr)

      # Request changes
      svc RequestChanges
        @dep(cr_repo: ChangeRequestRepo)
        @dep(comment_repo: CommentRepo)
        input
          pr_id: Id
          reviewer: Str
          comment: Str
        step validate
          cr = cr_repo.find!(pr_id)
          guard cr.is_some(), "PR not found"
          pr = cr.unwrap()
          guard pr.status == PrStatus.ReadyForReview, "PR not in reviewable state"
          guard reviewer != pr.author, "Author cannot review their own change"
        step record
          review_comment = ReviewComment{id: Id.new(), pr_id, author: reviewer, construct_path: null, body: comment, created_at: Dt.now(), resolved: false}
          comment_repo.save!(review_comment)
          pr.status = PrStatus.ChangesRequested
          pr.updated_at = Dt.now()
          cr_repo.save!(pr)

      # Merge a PR (all gates must pass)
      svc MergeChange
        -> Json
        @dep(git: GitService)
        @dep(cr_repo: ChangeRequestRepo)
        @dep(ci_repo: CiRunRepo)
        @dep(approval_repo: ApprovalRepo)
        input
          pr_id: Id
          merger: Str
          slug: Str
        step validate_gates
          cr = cr_repo.find!(pr_id)
          guard cr.is_some(), "PR not found"
          pr = cr.unwrap()
          guard pr.status == PrStatus.Approved, "PR must be approved before merge"
          # Gate: CI must pass
          ci = ci_repo.latest_for_pr!(pr_id)
          guard ci.is_some(), "No CI run — build must pass before merge"
          guard ci.unwrap().status == CiStatus.Passed, "CI must pass before merge"
          # Gate: has approval from non-author
          approvals = approval_repo.find_for_pr!(pr_id)
          guard !approvals.is_empty(), "At least one approval required"
        step merge
          pr.status = PrStatus.Merging
          cr_repo.save!(pr)
          merge_msg = f"Merge {pr.source_branch}: {pr.title} [{pr.jira_ticket}]"
          merge_hash = git.merge!(slug, pr.source_branch, pr.target_branch, merge_msg, merger)
        step finalize
          pr.status = PrStatus.Merged
          pr.merged_at = Opt.some(Dt.now())
          pr.merged_by = Opt.some(merger)
          pr.merge_commit = Opt.some(merge_hash.clone())
          pr.updated_at = Dt.now()
          cr_repo.save!(pr)
          ret {merge_commit: merge_hash, branch: pr.source_branch, target: pr.target_branch}

      # Get structural diff for visual review (reads source from both branches, parses, computes AST diff)
      svc GetStructuralDiff
        -> Json
        @dep(git: GitService)
        @dep(cr_repo: ChangeRequestRepo)
        input
          pr_id: Id
          slug: Str
        step resolve
          cr = cr_repo.find!(pr_id)
          guard cr.is_some(), "PR not found"
          pr = cr.unwrap()
        step compute_diff
          file_diffs = git.diff_files!(slug, pr.target_branch, pr.source_branch)
          # Return file-level diff summary as JSON
          # (Full structural AST diff is a TODO — requires veil_parser/veil_ir wiring)
          ret Json.object()

      # Compute structural diff from raw source strings (no git context needed)
      svc ComputeStructuralDiffFromSource
        -> Json
        input
          base_content: Str
          branch_content: Str
          base_label: Str
          head_label: Str
        step parse_and_diff
          # TODO: wire veil_parser + veil_ir for full structural diff
          ret Json.object()

      # Add a review comment
      svc AddComment
        -> ReviewComment
        @dep(comment_repo: CommentRepo)
        input
          pr_id: Id
          author: Str
          construct_path: Opt<Str>
          body: Str
        step persist
          comment = ReviewComment{id: Id.new(), pr_id, author, construct_path, body, created_at: Dt.now(), resolved: false}
          comment_repo.save!(comment)
          ret comment

      # List PRs for a repo
      svc ListChangeRequests
        -> List<ChangeRequest>
        @dep(cr_repo: ChangeRequestRepo)
        input
          repo_id: Opt<Id>
          status: Opt<PrStatus>
        step query
          if repo_id.is_none()
            ret []
          filter = status.clone()
          items = cr_repo.list_by_repo!(repo_id.unwrap(), filter)
          ret items

      # Get PR detail
      svc GetChangeRequest
        -> Json
        @dep(cr_repo: ChangeRequestRepo)
        @dep(approval_repo: ApprovalRepo)
        @dep(comment_repo: CommentRepo)
        @dep(ci_repo: CiRunRepo)
        input
          pr_id: Id
        step load
          cr = cr_repo.find!(pr_id)
          guard cr.is_some(), "PR not found"
          pr = cr.unwrap()
          approvals = approval_repo.find_for_pr!(pr_id)
          comments = comment_repo.list_for_pr!(pr_id)
          ci_runs = ci_repo.list_for_pr!(pr_id)
          ret {pr: pr, approvals: approvals, comments: comments, ci_runs: ci_runs}

  # ═══════════════════════════════════════════════════════════════════════════
  # Agent — Unified runtime agent with ACP tunnel for LLM provider switching
  # ═══════════════════════════════════════════════════════════════════════════

  ctx Agent
    group domain
      # ─── LLM Provider Modes ─────────────────────────────────────────────
      enum LlmProvider
        Bedrock
          model_id: Str
        Byok
          provider: Str
          model: Str
          api_key: Str
        AcpTunnel
          user_id: Str
        VeilServerProxy

      enum AgentProviderMode
        Bedrock
        Byok
        Acp
        VeilServer

      # ─── ACP Protocol Types ─────────────────────────────────────────────
      val AcpMessage
        role: Str
        content: Str
        tool_use: Opt<List<AcpToolCall>>

      val AcpToolDef
        name: Str
        description: Str
        parameters: Json

      val AcpToolCall
        id: Str
        name: Str
        arguments: Json

      val AcpTurnRequest
        turn_id: Str
        messages: List<AcpMessage>
        tools: List<AcpToolDef>

      val AcpToolResult
        turn_id: Str
        call_id: Str
        output: Json

      enum AcpAgentFrame
        ContentDelta
          turn_id: Str
          delta: Str
        ToolUse
          turn_id: Str
          tool_call: AcpToolCall
        TurnComplete
          turn_id: Str
        Error
          turn_id: Opt<Str>
          message: Str

      enum AcpTurnError
        NotConnected
        SessionClosed
        AgentError
          message: Str

      # ─── Session State ──────────────────────────────────────────────────
      val AcpSession
        user_id: Str
        agent_name: Str
        connected_at: Dt

      val AcpConnectionStatus
        agent_name: Str
        connected: Bool

      val AgentStatusResponse
        provider: Str
        provider_mode: Json
        acp_tunnel: Json

      # ─── Chat Protocol Types ────────────────────────────────────────────
      val ChatMsg
        role: Str
        content: Str

      val ChatRequest
        messages: List<ChatMsg>
        model: Opt<Str>
        provider: Opt<Str>
        system_prompt: Opt<Str>
        context: Opt<AgentContext>

      val AgentContext
        page: Opt<Str>
        project: Opt<Str>
        surfaces: Opt<List<Json>>

      val ToolDef
        name: Str
        description: Str
        category: Str

      val ToolExecutionResult
        output: Json
        is_error: Bool
        navigation: Opt<Json>

      # ─── ACP Tunnel Config ──────────────────────────────────────────────
      val AcpConnectParams
        token: Opt<Str>
        agent_name: Opt<Str>

    group application
      # ─── Provider Configuration ─────────────────────────────────────────
      svc ResolveProvider
        -> LlmProvider
        step resolve
          provider_env = Env.get_or("VEIL_AGENT_PROVIDER", "veil-server")
          match provider_env
            "bedrock" =>
              model_id = Env.get_or("VEIL_BEDROCK_MODEL", "us.anthropic.claude-sonnet-4-20250514-v1:0")
              ret LlmProvider.Bedrock{model_id}
            "openai" =>
              api_key = Env.get_or("VEIL_OPENAI_KEY", "")
              model = Env.get_or("VEIL_OPENAI_MODEL", "gpt-4o")
              ret LlmProvider.Byok{provider: "openai", model, api_key}
            "anthropic" =>
              api_key = Env.get_or("VEIL_ANTHROPIC_KEY", "")
              model = Env.get_or("VEIL_ANTHROPIC_MODEL", "claude-sonnet-4-20250514")
              ret LlmProvider.Byok{provider: "anthropic", model, api_key}
            "acp" =>
              ret LlmProvider.AcpTunnel{user_id: "default_user"}
            _ =>
              ret LlmProvider.VeilServerProxy

      # ─── Tool Registry ──────────────────────────────────────────────────
      svc GetToolRegistry
        -> List<ToolDef>
        step build
          mut tools = []
          tools = tools.concat([ToolDef{name: "navigate_to", description: "Navigate the runtime UI to a specific page", category: "navigation"}])
          tools = tools.concat([ToolDef{name: "open_ide", description: "Open the IDE for a specific project", category: "navigation"}])
          tools = tools.concat([ToolDef{name: "switch_project", description: "Switch to a different project", category: "navigation"}])
          tools = tools.concat([ToolDef{name: "list_changes", description: "List open change requests", category: "sdlc"}])
          tools = tools.concat([ToolDef{name: "create_change", description: "Create a new change request", category: "sdlc"}])
          tools = tools.concat([ToolDef{name: "approve_change", description: "Approve a change request", category: "sdlc"}])
          tools = tools.concat([ToolDef{name: "merge_change", description: "Merge an approved change request", category: "sdlc"}])
          tools = tools.concat([ToolDef{name: "deploy_project", description: "Deploy a project to an environment", category: "deploy"}])
          tools = tools.concat([ToolDef{name: "deploy_status", description: "Get deployment status", category: "deploy"}])
          tools = tools.concat([ToolDef{name: "rollback", description: "Rollback a deployment", category: "deploy"}])
          tools = tools.concat([ToolDef{name: "edit_file", description: "Edit a file in a project via the IDE", category: "ide"}])
          tools = tools.concat([ToolDef{name: "read_file", description: "Read a file from a project", category: "ide"}])
          tools = tools.concat([ToolDef{name: "gen_package", description: "Generate code from a veil package", category: "ide"}])
          tools = tools.concat([ToolDef{name: "list_projects", description: "List all projects in the runtime", category: "meta"}])
          tools = tools.concat([ToolDef{name: "get_current_context", description: "Get current page and project context", category: "meta"}])
          tools = tools.concat([ToolDef{name: "search_registry", description: "Search the layer/extension registry", category: "registry"}])
          tools = tools.concat([ToolDef{name: "wiki_search", description: "Search the mind-palace wiki", category: "wiki"}])
          tools = tools.concat([ToolDef{name: "wiki_read", description: "Read a wiki page", category: "wiki"}])
          tools = tools.concat([ToolDef{name: "wiki_create", description: "Create a wiki page", category: "wiki"}])
          tools = tools.concat([ToolDef{name: "wiki_update", description: "Update a wiki page", category: "wiki"}])
          ret tools

      # ─── Tool Execution ─────────────────────────────────────────────────
      svc ExecuteTool
        -> ToolExecutionResult
        input
          name: Str
          args: Json
          ctx: Opt<AgentContext>
        step execute
          match name
            "navigate_to" =>
              path = args["path"].as_str().unwrap_or("/dashboard")
              ret ToolExecutionResult{output: {navigated_to: path}, is_error: false, navigation: {action: "goto", path}}
            "open_ide" =>
              project = args["project"].as_str().unwrap_or("unknown")
              ret ToolExecutionResult{output: {opened_ide: project}, is_error: false, navigation: {action: "open-ide", project}}
            "switch_project" =>
              project = args["project"].as_str().unwrap_or("unknown")
              ret ToolExecutionResult{output: {switched_to: project}, is_error: false, navigation: {action: "switch-project", project}}
            "list_projects" =>
              ret ToolExecutionResult{output: {projects: []}, is_error: false, navigation: null}
            "get_current_context" =>
              page = ctx.and_then(|c| c.page).unwrap_or("/")
              project = ctx.and_then(|c| c.project)
              ret ToolExecutionResult{output: {page, project}, is_error: false, navigation: null}
            _ =>
              ret ToolExecutionResult{output: {error: f"unknown tool: {name}"}, is_error: true, navigation: null}

      # ─── ACP Turn Execution ─────────────────────────────────────────────
      svc ExecuteAcpTurn
        -> Str
        @dep(registry: AcpSessionRegistry)
        input
          user_id: Str
          turn_id: Str
          messages: List<AcpMessage>
          tools: List<AcpToolDef>
        step execute
          connected = registry.is_connected(user_id)
          guard connected, "No ACP agent connected"
          request = AcpTurnRequest{turn_id, messages, tools}
          registry.send_turn_request!(user_id, request)
          ret "turn_sent"

      svc SendToolResult
        -> Str
        @dep(registry: AcpSessionRegistry)
        input
          user_id: Str
          turn_id: Str
          call_id: Str
          output: Json
        step send
          result = AcpToolResult{turn_id, call_id, output}
          registry.send_tool_result!(user_id, result)
          ret "sent"

      # ─── WebSocket Handlers ─────────────────────────────────────────────
      ws_handler WsAgentChat
        @path("/api/agent/chat")
        input
          msg: Str
        step handle
          # Parse ChatRequest from first frame
          # Stream events back to client (content_delta, tool_call_start, tool_result, done)
          # Dispatch to LLM provider (Bedrock, BYOK, ACP tunnel, or veil-server proxy)
          provider = invoke ResolveProvider{}
          tools = invoke GetToolRegistry{}
          send_ws {event: "message_start", data: {messageId: "msg_1", role: "assistant", model: "veil-agent", provider: "veil"}}
          send_ws {event: "content_delta", data: {messageId: "msg_1", delta: "I'm the VEIL Runtime agent."}}
          send_ws {event: "done", data: {messageId: "msg_1"}}

      ws_handler WsAgentAcp
        @path("/api/agent/acp")
        input
          msg: Str
        step handle
          # ACP tunnel: accept inbound connection from local agent
          # Register session, bridge turn_request/tool_result frames
          # Parse agent_name from query params
          send_ws {type: "connected", message: "ACP tunnel established. Waiting for turn requests."}

      # ─── HTTP Endpoints ─────────────────────────────────────────────────
      http_route AgentStatus
        -> Json
        @method("GET")
        @path("/api/agent/status")
        step handle
          provider = invoke ResolveProvider{}
          provider_name = match provider
            LlmProvider.Bedrock{model_id} => "Bedrock"
            LlmProvider.Byok{provider, ..} => provider
            LlmProvider.AcpTunnel{..} => "ACP Tunnel"
            LlmProvider.VeilServerProxy => "veil-server (proxy)"
          provider_mode = match provider
            LlmProvider.Bedrock{model_id} => {mode: "bedrock", model: model_id}
            LlmProvider.Byok{provider, model, ..} => {mode: "byok", provider, model}
            LlmProvider.AcpTunnel{..} => {mode: "acp"}
            LlmProvider.VeilServerProxy => {mode: "veil-server"}
          # TODO: query AcpSessionRegistry for connected sessions
          acp_tunnel = {connected: false, agents: []}
          ret {provider: provider_name, provider_mode, acp_tunnel}

    group infrastructure
      # ─── ACP Session Registry Port ─────────────────────────────────────
      port AcpSessionRegistry
        is_connected(user_id: Str) -> Bool
        register!(user_id: Str, session: AcpSession)
        unregister!(user_id: Str)
        get_status(user_id: Str) -> Opt<AcpConnectionStatus>
        list_sessions() -> List<AcpConnectionStatus>
        send_turn_request!(user_id: Str, request: AcpTurnRequest)
        send_tool_result!(user_id: Str, result: AcpToolResult)

      adapter InMemoryAcpRegistry for AcpSessionRegistry
        @field(sessions: Map<Str, AcpSession>)
        impl is_connected(user_id)
          ret sessions.contains_key(user_id)
        impl register(user_id, session)
          sessions.insert(user_id, session)
        impl unregister(user_id)
          sessions.remove(user_id)
        impl get_status(user_id)
          session = sessions.get(user_id)
          if session.is_none() then ret null
          s = session.unwrap()
          ret AcpConnectionStatus{agent_name: s.agent_name, connected: true}
        impl list_sessions()
          ret sessions.values().map(|s| AcpConnectionStatus{agent_name: s.agent_name, connected: true}).collect()
        impl send_turn_request(user_id, request)
          # In production: send via channel to the ACP WebSocket task
        impl send_tool_result(user_id, result)
          # In production: forward to the ACP agent process
