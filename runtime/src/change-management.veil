# STALE DRAFT — canonical SDLC lives in runtime.veil ctx PullRequestManagement.
# Do not gen from this file.
# Change Management — SDLC workflow for SOC 2 compliance
#
# Provides: branch-based development, pull requests with structural review,
# approval gates, CI integration, and deploy-from-main.
#
# Git backend: git-remote-object-store (gix-backed, S3 storage)
# Metadata: DDB (PR state, approvals, CI runs, comments)
# Diff engine: veil_ir::struct_diff (AST-level structural diffs)
#
# Standalone package (parse / roundtrip fixture). Live runtime also embeds an
# equivalent PullRequestManagement context in runtime.veil for multi-ctx gen.

pkg PullRequestManagement
  use ddd
  use di
  use aws_storage
  use aws_sdk_dynamodb as ddb
  use aws_sdk_s3 as s3
  use gix
  use veil_local_fs

  # ─── Domain Types ────────────────────────────────────────────────────────

  ctx PullRequestManagement
    group domain

      enum PrStatus
        Draft
        ReadyForReview
        Approved
        ChangesRequested
        Merging
        Merged
        Rejected
        Closed

      enum CiStatus
        Pending
        Running
        Passed
        Failed
        Skipped

      enum DiffKind
        Added
        Modified
        Removed
        Moved

      val StructuralChange
        kind: DiffKind
        path: Str
        detail: Str
        construct_type: Opt<Str>

      val DiffSummary
        description: Str
        changes: List<StructuralChange>
        files_changed: Int
        additions: Int
        removals: Int

      val ReviewComment
        id: Id
        pr_id: Id
        author: Str
        construct_path: Opt<Str>
        body: Str
        created_at: Dt
        resolved: Bool

      val Approval
        pr_id: Id
        reviewer: Str
        approved_at: Dt
        comment: Opt<Str>

      val CiRun
        id: Id
        pr_id: Id
        commit_hash: Str
        status: CiStatus
        started_at: Dt
        completed_at: Opt<Dt>
        duration_ms: Opt<Int>
        logs_key: Opt<Str>
        error_summary: Opt<Str>

      agg PullRequest
        root
          id: Id
          repo_id: Id
          title: Str
          description: Str
          jira_ticket: Str
          source_branch: Str
          target_branch: Str
          author: Str
          status: PrStatus
          created_at: Dt
          updated_at: Dt
          merged_at: Opt<Dt>
          merged_by: Opt<Str>
          merge_commit: Opt<Str>

      # ─── Repositories ──────────────────────────────────────────────────

      repo PullRequestRepo
        find!(id: Id) -> Opt<PullRequest>
        list_by_repo!(repo_id: Id, status: Opt<PrStatus>) -> List<PullRequest>
        list_open!(repo_id: Id) -> List<PullRequest>
        list_all!(status: Opt<PrStatus>) -> List<PullRequest>
        save!(cr: PullRequest)

      repo ApprovalRepo
        find_for_pr!(pr_id: Id) -> List<Approval>
        save!(approval: Approval)

      repo CiRunRepo
        latest_for_pr!(pr_id: Id) -> Opt<CiRun>
        list_for_pr!(pr_id: Id) -> List<CiRun>
        save!(run: CiRun)

      repo CommentRepo
        list_for_pr!(pr_id: Id) -> List<ReviewComment>
        save!(comment: ReviewComment)
        resolve!(id: Id)

    # ─── Ports ──────────────────────────────────────────────────────────────

    group infrastructure

      # Git operations backed by git-remote-object-store + gix
      port GitService
        init_repo!(slug: Str)
        repo_exists!(slug: Str) -> Bool
        create_branch!(slug: Str, branch_name: Str, from_ref: Str) -> Str
        delete_branch!(slug: Str, branch_name: Str)
        list_branches!(slug: Str) -> List<Str>
        get_head!(slug: Str, branch: Str) -> Str
        commit_file!(slug: Str, branch: Str, path: Str, content: Str, message: Str, author: Str) -> Str
        read_file!(slug: Str, branch: Str, path: Str) -> Opt<Str>
        list_files!(slug: Str, branch: Str) -> List<Str>
        log!(slug: Str, branch: Str, limit: Int) -> Json
        merge!(slug: Str, source: Str, target: Str, message: Str, author: Str) -> Str
        diff_files!(slug: Str, base_ref: Str, head_ref: Str) -> Json
        can_merge!(slug: Str, source: Str, target: Str) -> Json

      # DDB adapter for PullRequest aggregate (same pattern as DdbDeploymentStore)
      adapter DdbPullRequestRepo for PullRequestRepo
        @field(client: DdbClient, table)

        impl find(id)
          pk = f"PR#{id}"
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND SK = :sk").expression_attribute_values(":pk", AttributeValue.S(pk)).expression_attribute_values(":sk", AttributeValue.S("META")).send!()
          items = resp.items()
          if items.is_empty() then ret null
          ret Json.parse(items[0].get("data").unwrap().as_s().unwrap())

        impl list_by_repo(repo_id, status)
          resp = client.query().table_name(table).index_name("GSI1").key_condition_expression("GSI1PK = :pk").expression_attribute_values(":pk", AttributeValue.S(f"REPO_PRS#{repo_id}")).send!()
          items = resp.items()
          mut out = []
          for item in items
            data = item.get("data").unwrap().as_s().unwrap()
            cr: PullRequest = Json.parse(data)
            if status.is_none() || cr.status == status.unwrap()
              out = out + [cr]
          ret out

        impl list_open(repo_id)
          resp = client.query().table_name(table).index_name("GSI1").key_condition_expression("GSI1PK = :pk").expression_attribute_values(":pk", AttributeValue.S(f"REPO_PRS#{repo_id}")).send!()
          items = resp.items()
          mut out = []
          for item in items
            data = item.get("data").unwrap().as_s().unwrap()
            cr: PullRequest = Json.parse(data)
            if cr.status != PrStatus.Merged && cr.status != PrStatus.Rejected && cr.status != PrStatus.Closed
              out = out + [cr]
          ret out

        impl list_all(status)
          resp = client.scan().table_name(table).filter_expression("begins_with(PK, :prefix) AND SK = :sk").expression_attribute_values(":prefix", AttributeValue.S("PR#")).expression_attribute_values(":sk", AttributeValue.S("META")).send!()
          items = resp.items()
          mut out = []
          for item in items
            data = item.get("data").unwrap().as_s().unwrap()
            cr: PullRequest = Json.parse(data)
            if status.is_none() || cr.status == status.unwrap()
              out = out + [cr]
          ret out

        impl save(cr)
          pk = f"PR#{cr.id}"
          gsi1pk = f"REPO_PRS#{cr.repo_id}"
          client.put_item().table_name(table).item("PK", AttributeValue.S(pk)).item("SK", AttributeValue.S("META")).item("GSI1PK", AttributeValue.S(gsi1pk)).item("GSI1SK", AttributeValue.S(f"{cr.updated_at}")).item("data", AttributeValue.S(Json.stringify(cr))).send!()

      adapter DdbApprovalRepo for ApprovalRepo
        @field(client: DdbClient, table)

        impl find_for_pr(pr_id)
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND begins_with(SK, :prefix)").expression_attribute_values(":pk", AttributeValue.S(f"PR#{pr_id}")).expression_attribute_values(":prefix", AttributeValue.S("APPROVAL#")).send!()
          items = resp.items()
          mut out = []
          for item in items
            data = item.get("data").unwrap().as_s().unwrap()
            out = out + [Json.parse(data)]
          ret out

        impl save(approval)
          pk = f"PR#{approval.pr_id}"
          sk = f"APPROVAL#{approval.reviewer}"
          client.put_item().table_name(table).item("PK", AttributeValue.S(pk)).item("SK", AttributeValue.S(sk)).item("data", AttributeValue.S(Json.stringify(approval))).send!()

      adapter DdbCiRunRepo for CiRunRepo
        @field(client: DdbClient, table)

        impl latest_for_pr(pr_id)
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND begins_with(SK, :prefix)").expression_attribute_values(":pk", AttributeValue.S(f"PR#{pr_id}")).expression_attribute_values(":prefix", AttributeValue.S("CI#")).scan_index_forward(false).limit(1).send!()
          items = resp.items()
          if items.is_empty() then ret null
          ret Json.parse(items[0].get("data").unwrap().as_s().unwrap())

        impl list_for_pr(pr_id)
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND begins_with(SK, :prefix)").expression_attribute_values(":pk", AttributeValue.S(f"PR#{pr_id}")).expression_attribute_values(":prefix", AttributeValue.S("CI#")).send!()
          items = resp.items()
          mut out = []
          for item in items
            data = item.get("data").unwrap().as_s().unwrap()
            out = out + [Json.parse(data)]
          ret out

        impl save(run)
          pk = f"PR#{run.pr_id}"
          sk = f"CI#{run.started_at}#{run.id}"
          client.put_item().table_name(table).item("PK", AttributeValue.S(pk)).item("SK", AttributeValue.S(sk)).item("data", AttributeValue.S(Json.stringify(run))).send!()

      adapter DdbCommentRepo for CommentRepo
        @field(client: DdbClient, table)

        impl list_for_pr(pr_id)
          resp = client.query().table_name(table).key_condition_expression("PK = :pk AND begins_with(SK, :prefix)").expression_attribute_values(":pk", AttributeValue.S(f"PR#{pr_id}")).expression_attribute_values(":prefix", AttributeValue.S("COMMENT#")).send!()
          items = resp.items()
          mut out = []
          for item in items
            data = item.get("data").unwrap().as_s().unwrap()
            out = out + [Json.parse(data)]
          ret out

        impl save(comment)
          pk = f"PR#{comment.pr_id}"
          sk = f"COMMENT#{comment.created_at}#{comment.id}"
          client.put_item().table_name(table).item("PK", AttributeValue.S(pk)).item("SK", AttributeValue.S(sk)).item("data", AttributeValue.S(Json.stringify(comment))).send!()

        impl resolve(id)
          # Resolve updates the COMMENT# item; callers re-save via save when full body known.
          ret Ok

    # ─── Application Services ──────────────────────────────────────────────

    group application

      # Create a new pull request (branch + PR record).
      # Nested under repo: POST /api/repos/{id}/pull_requests
      @route("POST /api/repos/{id}/pull_requests")
      svc CreatePullRequest
        -> PullRequest
        @dep(git: GitService)
        @dep(pr_repo: PullRequestRepo)
        input
          id: Id
          slug: Str
          title: Str
          description: Str
          jira_ticket: Str
          author: Str
        step validate
          guard jira_ticket.len() > 0, "Jira ticket required"
          guard title.len() > 0, "Title required"
        step create_branch
          branch_name = f"cr/{jira_ticket}/{title.to_lowercase().replace(' ', '-')}"
          git.create_branch!(slug, branch_name, "main")
        step persist
          now = Dt.now()
          pr_id = Id.new()
          cr = PullRequest{id: pr_id, repo_id: id, title, description, jira_ticket, source_branch: branch_name, target_branch: "main", author, status: PrStatus.Draft, created_at: now, updated_at: now, merged_at: null, merged_by: null, merge_commit: null}
          pr_repo.save!(cr)
          ret cr

      # List pull requests for a repo: GET /api/repos/{id}/pull_requests
      @route("GET /api/repos/{id}/pull_requests")
      svc ListPullRequests
        -> List<PullRequest>
        @dep(pr_repo: PullRequestRepo)
        input
          id: Id
          status: Opt<PrStatus>
        step query
          # Local copy avoids codegen auto-unwrap of Opt at the call site.
          filter = status
          items = pr_repo.list_by_repo!(id, filter)
          ret items

      # Global list (dashboard Changes page): GET /api/pull_requests
      @route("GET /api/pull_requests")
      svc ListAllPullRequests
        -> List<PullRequest>
        @dep(pr_repo: PullRequestRepo)
        input
          status: Opt<PrStatus>
        step query
          filter = status
          items = pr_repo.list_all!(filter)
          ret items

      # Get PR detail (approvals, comments, CI): GET /api/pull_requests/{id}
      @route("GET /api/pull_requests/{id}")
      svc GetPullRequest
        -> Json
        @dep(pr_repo: PullRequestRepo)
        @dep(approval_repo: ApprovalRepo)
        @dep(comment_repo: CommentRepo)
        @dep(ci_repo: CiRunRepo)
        input
          id: Id
        step load
          cr = pr_repo.find!(id)
          guard cr.is_some(), "PR not found"
          pr = cr.unwrap()
          approvals = approval_repo.find_for_pr!(id)
          comments = comment_repo.list_for_pr!(id)
          ci_runs = ci_repo.list_for_pr!(id)
          ret {pr: pr, approvals: approvals, comments: comments, ci_runs: ci_runs}

      # Transition PR status (draft → review, approve, reject, close, …)
      @route("PUT /api/pull_requests/{id}/status")
      svc UpdatePullRequestStatus
        -> PullRequest
        @dep(pr_repo: PullRequestRepo)
        input
          id: Id
          status: PrStatus
        step update
          cr = pr_repo.find!(id)
          guard cr.is_some(), "PR not found"
          pr = cr.unwrap()
          pr.status = status
          pr.updated_at = Dt.now()
          pr_repo.save!(pr)
          ret pr

      # Add a review comment (optionally anchored to a construct path)
      @route("POST /api/pull_requests/{id}/comments")
      svc AddReviewComment
        -> ReviewComment
        @dep(comment_repo: CommentRepo)
        input
          id: Id
          author: Str
          construct_path: Opt<Str>
          body: Str
        step persist
          guard body.len() > 0, "Comment body required"
          comment = ReviewComment{id: Id.new(), pr_id: id, author, construct_path, body, created_at: Dt.now(), resolved: false}
          comment_repo.save!(comment)
          ret comment

      # Create via flat collection path (dashboard form without repo path segment)
      @route("POST /api/pull_requests")
      svc CreatePullRequestFlat
        -> PullRequest
        @dep(git: GitService)
        @dep(pr_repo: PullRequestRepo)
        input
          repo_id: Id
          slug: Str
          title: Str
          description: Str
          jira_ticket: Str
          author: Str
        step validate
          guard jira_ticket.len() > 0, "Jira ticket required"
          guard title.len() > 0, "Title required"
        step create_branch
          branch_name = f"cr/{jira_ticket}/{title.to_lowercase().replace(' ', '-')}"
          git.create_branch!(slug, branch_name, "main")
        step persist
          now = Dt.now()
          pr_id = Id.new()
          cr = PullRequest{id: pr_id, repo_id, title, description, jira_ticket, source_branch: branch_name, target_branch: "main", author, status: PrStatus.Draft, created_at: now, updated_at: now, merged_at: null, merged_by: null, merge_commit: null}
          pr_repo.save!(cr)
          ret cr
