# Copy to .env (gitignored) and fill in. scripts/dev-stack.sh sources .env.
# Never commit real account IDs, ARNs, or profile names.

# AWS credential profile, or leave unset to use the default chain.
# AWS_PROFILE=
AWS_REGION=us-west-2

# ProductHost metadata + object store (create these in your account).
VEIL_DDB_TABLE=veil-runtime-dev
BUCKET=veil-runtime-dev

# Optional: used when ProductHost provisions Lambda / HTTP API / SQS.
# AWS_ACCOUNT_ID=
# VEIL_LAMBDA_ROLE=arn:aws:iam::ACCOUNT:role/veil-lambda-dev
# VEIL_GW_HTTP_API=

# Mind Palace (optional wiki for agents)
# MIND_PALACE=1
# MIND_PALACE_REGION=us-west-2
# MIND_PALACE_S3_BUCKET=
# MIND_PALACE_DYNAMO_TABLE=
# MIND_PALACE_S3VECTORS_BUCKET=
# MIND_PALACE_S3VECTORS_INDEX=wiki-pages
