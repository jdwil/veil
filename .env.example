# Copy to .env (gitignored) and fill in. scripts/dev-stack.sh sources .env.
# Never commit real account IDs, ARNs, or profile names.

# AWS credential profile, or leave unset to use the default chain.
# AWS_PROFILE=
AWS_REGION=us-west-2

# ProductHost metadata + object store (create these in your account).
VEIL_DDB_TABLE=veil-runtime-dev
BUCKET=veil-runtime-dev

# Optional: used when ProductHost provisions Lambda / HTTP API / SQS.
# AWS_ACCOUNT_ID=
# VEIL_LAMBDA_ROLE=arn:aws:iam::ACCOUNT:role/veil-lambda-dev
# VEIL_GW_HTTP_API=

# GitHub as git origin for new projects (optional; S3 bundles remain the default
# unless both a token and VEIL_GITHUB_OWNER are set, or VEIL_GIT_DEFAULT_ORIGIN=github).
# Token: VEIL_GITHUB_TOKEN, or GITHUB_TOKEN / GH_TOKEN, or `gh auth login`.
# VEIL_GITHUB_TOKEN=
# VEIL_GITHUB_OWNER=          # user or org that will own new repos
# VEIL_GIT_DEFAULT_ORIGIN=auto  # auto | github | s3
# VEIL_GITHUB_REPO_PRIVATE=1

# Optional: local trees the inner agent may READ (not write) when converting
# existing code to VEIL. Colon-separated; optional name=/path.
# Also configurable in the UI (Config → Reference trees) / ~/.veil/config.json.
# VEIL_REFERENCE_DIRS=~/src/legacy-app:shop=~/code/shop

# Mind Palace (optional wiki for agents)
# MIND_PALACE=1
# MIND_PALACE_REGION=us-west-2
# MIND_PALACE_S3_BUCKET=
# MIND_PALACE_DYNAMO_TABLE=
# MIND_PALACE_S3VECTORS_BUCKET=
# MIND_PALACE_S3VECTORS_INDEX=wiki-pages
