/// Generated in-memory CustomerRepo for local smoke / greenfield runs.
#[derive(Default)]
pub struct InMemoryCustomerRepo {
rows: tokio::sync::RwLock<std::collections::HashMap<String, Customer>>,
}

impl InMemoryCustomerRepo {
pub fn new() -> Self { Self::default() }
fn key(id: impl std::fmt::Display) -> String { id.to_string() }
}

#[async_trait]
impl CustomerRepo for InMemoryCustomerRepo {
    async fn save(&self, c: Customer) -> Result<(), DomainError> {
        let mut g = self.rows.write().await;
g.insert(Self::key(c.id.clone()), c);
Ok(())
    }

    async fn find(&self, id: Uuid) -> Result<Option<Customer>, DomainError> {
        Ok(self.rows.read().await.get(&Self::key(id.clone())).cloned())
    }

    async fn delete(&self, id: Uuid) -> Result<(), DomainError> {
        self.rows.write().await.remove(&Self::key(id.clone()));
Ok(())
    }

}


// ===== crates/identity/src/application/mod.rs =====
//! Application services and flow functions.

#![allow(unused_imports, unused_variables)]

use crate::ports::*;
use crate::domain::types::*;
use crate::domain::messages::*;
use std::sync::Arc;
use std::collections::HashMap;
use uuid::Uuid;
use chrono::{DateTime, Utc};

/// Declared dependency bundle (`deps Deps`).
pub struct Deps {
    pub bus: std::sync::Arc<dyn Bus + Send + Sync>,
    pub customer_repo: std::sync::Arc<dyn CustomerRepo + Send + Sync>,
}

/// DomainService: CreateCustomerService
#[tracing::instrument(skip_all)]
pub async fn create_customer_service(
    deps: &Deps, email: Email,
    phone: Phone
) -> Result<Uuid, DomainError> {
    // step: validate
    email.validate().map_err(|_| DomainError::Validation("invalid email".to_string()))?;

    // step: persist
    let c = Customer::new(Uuid::new_v4(), email.clone(), phone);
    deps.customer_repo.save(c.clone()).await;
    deps.bus.dispatch(serde_json::json!({ "type": "CustomerCreated", "id": serde_json::json!(c.clone())["id"].clone(), "email": email.clone(), "created": serde_json::json!(c.clone())["created"].clone() })).await;

    Ok(c.id.clone())
}


