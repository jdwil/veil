/// Declared dependency bundle (`deps Deps`).
pub struct Deps {
    pub bus: std::sync::Arc<dyn Bus + Send + Sync>,
    pub customer_repo: std::sync::Arc<dyn CustomerRepo + Send + Sync>,
    pub k_y_c_provider: std::sync::Arc<dyn KYCProvider + Send + Sync>,
    pub payment_gateway: std::sync::Arc<dyn PaymentGateway + Send + Sync>,
}

/// Saga: Onboard
/// Step `create_customer` of `Onboard` (impl SagaStep).
struct OnboardStep0 {
    email: Email,
    phone: Phone,
    name: String,
    bus: std::sync::Arc<dyn Bus + Send + Sync>,
    customer_repo: std::sync::Arc<dyn CustomerRepo + Send + Sync>,
    k_y_c_provider: std::sync::Arc<dyn KYCProvider + Send + Sync>,
    payment_gateway: std::sync::Arc<dyn PaymentGateway + Send + Sync>,
}

#[async_trait::async_trait]
impl SagaStep for OnboardStep0 {
    async fn action(&self, mut state: serde_json::Value) -> Result<serde_json::Value, DomainError> {
        state["c"] = serde_json::json!(Customer::new(Uuid::new_v4(), self.email.clone(), self.phone.clone()));
        self.customer_repo.save(serde_json::from_value::<Customer>(state["c"].clone()).map_err(|e| DomainError::External(e.to_string()))?).await;
        self.bus.dispatch(serde_json::json!({ "type": "CustomerCreated", "id": state["c"]["id"].clone(), "email": self.email.clone(), "created": state["c"]["created"].clone() })).await;
        Ok(state)
    }
    async fn compensate(&self, mut state: serde_json::Value) -> Result<(), DomainError> {
        self.customer_repo.delete(serde_json::from_value::<Uuid>(state["c"]["id"].clone()).map_err(|e| DomainError::External(e.to_string()))?).await;
        Ok(())
    }
}

/// Step `verify_identity` of `Onboard` (impl SagaStep).
struct OnboardStep1 {
    email: Email,
    phone: Phone,
    name: String,
    bus: std::sync::Arc<dyn Bus + Send + Sync>,
    customer_repo: std::sync::Arc<dyn CustomerRepo + Send + Sync>,
    k_y_c_provider: std::sync::Arc<dyn KYCProvider + Send + Sync>,
    payment_gateway: std::sync::Arc<dyn PaymentGateway + Send + Sync>,
}

#[async_trait::async_trait]
impl SagaStep for OnboardStep1 {
    async fn action(&self, mut state: serde_json::Value) -> Result<serde_json::Value, DomainError> {
        state["result"] = serde_json::json!(self.k_y_c_provider.check(self.name.clone(), self.email.clone()).await?);
        compile_error!("unstubbed external `c.verify` — install a .stub and call its types (@field + stub methods)");
        Ok(state)
    }
    async fn compensate(&self, mut state: serde_json::Value) -> Result<(), DomainError> {
        compile_error!("unstubbed external `c.reject` — install a .stub and call its types (@field + stub methods)");
        Ok(())
    }
}

/// Step `setup_billing` of `Onboard` (impl SagaStep).
struct OnboardStep2 {
    email: Email,
    phone: Phone,
    name: String,
    bus: std::sync::Arc<dyn Bus + Send + Sync>,
    customer_repo: std::sync::Arc<dyn CustomerRepo + Send + Sync>,
    k_y_c_provider: std::sync::Arc<dyn KYCProvider + Send + Sync>,
    payment_gateway: std::sync::Arc<dyn PaymentGateway + Send + Sync>,
}

#[async_trait::async_trait]
impl SagaStep for OnboardStep2 {
    async fn action(&self, mut state: serde_json::Value) -> Result<serde_json::Value, DomainError> {
        self.payment_gateway.create_customer(self.email.clone().addr.clone()).await?;
        self.bus.invoke(serde_json::json!({ "type": "CreateTrial", "customer_id": state["c"]["id"].clone(), "plan": "FreeTier" })).await?;
        Ok(state)
    }
    async fn compensate(&self, mut state: serde_json::Value) -> Result<(), DomainError> {
        self.bus.invoke(serde_json::json!({ "type": "CancelTrial", "customer_id": state["c"]["id"].clone() })).await?;
        Ok(())
    }
}

#[tracing::instrument(skip_all)]
pub async fn onboard(deps: &Deps, email: Email, phone: Phone, name: String) -> Result<(), DomainError> {
    let steps: Vec<Box<dyn SagaStep + Send + Sync>> = vec![
        Box::new(OnboardStep0 { email: email.clone(), phone: phone.clone(), name: name.clone(), bus: deps.bus.clone(), customer_repo: deps.customer_repo.clone(), k_y_c_provider: deps.k_y_c_provider.clone(), payment_gateway: deps.payment_gateway.clone() }),
        Box::new(OnboardStep1 { email: email.clone(), phone: phone.clone(), name: name.clone(), bus: deps.bus.clone(), customer_repo: deps.customer_repo.clone(), k_y_c_provider: deps.k_y_c_provider.clone(), payment_gateway: deps.payment_gateway.clone() }),
        Box::new(OnboardStep2 { email: email.clone(), phone: phone.clone(), name: name.clone(), bus: deps.bus.clone(), customer_repo: deps.customer_repo.clone(), k_y_c_provider: deps.k_y_c_provider.clone(), payment_gateway: deps.payment_gateway.clone() }),
    ];
    run_saga(&steps).await
}


// ===== crates/veil_bin/Cargo.toml =====
[package]
name = "veil_bin"
version.workspace = true
edition.workspace = true

[[bin]]
name = "veil_bin"
path = "src/main.rs"

[dependencies]
tokio = { workspace = true }
uuid = { workspace = true }
serde = { workspace = true }
serde_json = { workspace = true }
veil_shared = { path = "../veil_shared" }
axum = "0.8"
tower-http = { version = "0.6", features = ["cors"] }
identity = { path = "../identity" }
billing = { path = "../billing" }
onboarding = { path = "../onboarding" }

// ===== crates/veil_bin/src/main.rs =====
//! HTTP harness for package `CustomerOnboarding` (RT-001 / RT-003).
//! Wires adapters + exposes services as REST endpoints.
//! `cargo run -p veil_bin` from the generated workspace root.

#![allow(unused_imports)]

use std::sync::Arc;
use axum::{Router, Json, extract::State, routing::{get, post}, http::{HeaderMap, StatusCode}, middleware::{from_fn, Next}, response::Response, extract::Request};
use tower_http::cors::{{Any, CorsLayer}};
use uuid::Uuid;
use serde_json::Value;
use veil_shared::*;
use identity::application::{self as identity_app, Deps as identity_Deps};
use billing::application::{self as billing_app};
use onboarding::application::{self as onboarding_app, Deps as onboarding_Deps};

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    let port: u16 = std::env::var("PORT").ok().and_then(|s| s.parse().ok()).unwrap_or(3000);

    // ── context Identity ──
    let in_memory_bus_inst: Arc<dyn identity::ports::Bus + Send + Sync> = Arc::new(identity::adapters::InMemoryBus::new());
    let in_memory_customer_repo_inst: Arc<dyn identity::ports::CustomerRepo + Send + Sync> = Arc::new(identity::adapters::InMemoryCustomerRepo::new());
    let identity_deps = Arc::new(identity_Deps {
        bus: in_memory_bus_inst.clone(),
        customer_repo: in_memory_customer_repo_inst.clone(),
    });

    let identity_router = Router::new()
        .route("/api/customer_services", post(identity_create_customer_service_handler))
        .layer(from_fn(veil_api_key_middleware))
        .layer(veil_cors_layer())
        .with_state(identity_deps.clone());

    // ── context Billing ──
    let stripe_adapter_inst: Arc<dyn billing::ports::PaymentGateway + Send + Sync> = Arc::new(billing::adapters::StripeAdapter {
        stripe_key: std::env::var("STRIPE_KEY").unwrap_or_else(|_| "default".into()),
    });
    // ── context Onboarding ──
    let in_memory_bus_inst: Arc<dyn onboarding::ports::Bus + Send + Sync> = Arc::new(onboarding::adapters::InMemoryBus::new());
    let in_memory_customer_repo_inst: Arc<dyn onboarding::ports::CustomerRepo + Send + Sync> = Arc::new(onboarding::adapters::InMemoryCustomerRepo::new());
    let in_memory_k_y_c_provider_inst: Arc<dyn onboarding::ports::KYCProvider + Send + Sync> = Arc::new(onboarding::adapters::InMemoryKYCProvider::new());
    let in_memory_payment_gateway_inst: Arc<dyn onboarding::ports::PaymentGateway + Send + Sync> = Arc::new(onboarding::adapters::InMemoryPaymentGateway::new());
    let onboarding_deps = Arc::new(onboarding_Deps {
        bus: in_memory_bus_inst.clone(),
        customer_repo: in_memory_customer_repo_inst.clone(),
        k_y_c_provider: in_memory_k_y_c_provider_inst.clone(),
        payment_gateway: in_memory_payment_gateway_inst.clone(),
    });

    let onboarding_router = Router::new()
        .route("/api/onboard", post(onboarding_onboard_handler))
        .layer(from_fn(veil_api_key_middleware))
        .layer(veil_cors_layer())
        .with_state(onboarding_deps.clone());

    let app = identity_router.merge(onboarding_router)
        .route("/health", get(|| async { "ok" }));
    println!("veil_bin: profile=axum_http endpoints=2");
    println!("veil_bin: listening on :{}", port);
    let listener = tokio::net::TcpListener::bind(format!("0.0.0.0:{}", port)).await?;
    axum::serve(listener, app.into_make_service()).await?;
    Ok(())
}

async fn identity_create_customer_service_handler(
    State(deps): State<Arc<identity_Deps>>,
    Json(body): Json<Value>,
) -> Result<Json<Value>, StatusCode> {
    let email = serde_json::from_value(body.get("email").cloned().unwrap_or(Value::Null)).map_err(|_| StatusCode::BAD_REQUEST)?;
    let phone = serde_json::from_value(body.get("phone").cloned().unwrap_or(Value::Null)).map_err(|_| StatusCode::BAD_REQUEST)?;
    match identity_app::create_customer_service(&deps, email, phone).await {
        Ok(result) => Ok(Json(veil_json_public(&result))),
        Err(e) => Err(veil_domain_error_status(e)),
    }
}

async fn onboarding_onboard_handler(
    State(deps): State<Arc<onboarding_Deps>>,
    Json(body): Json<Value>,
) -> Result<Json<Value>, StatusCode> {
    let email = serde_json::from_value(body.get("email").cloned().unwrap_or(Value::Null)).map_err(|_| StatusCode::BAD_REQUEST)?;
    let phone = serde_json::from_value(body.get("phone").cloned().unwrap_or(Value::Null)).map_err(|_| StatusCode::BAD_REQUEST)?;
    let name = body.get("name").and_then(|v| v.as_str()).unwrap_or_default().to_string();
    match onboarding_app::onboard(&deps, email, phone, name).await {
        Ok(result) => Ok(Json(veil_json_public(&result))),
        Err(e) => Err(veil_domain_error_status(e)),
    }
}


/// Serialize for HTTP JSON, omitting fields annotated role:secret.
/// Persistence (repos) uses full `Serialize` — secrets still round-trip to storage.
pub fn veil_json_public<T: serde::Serialize>(value: &T) -> serde_json::Value {
    let mut v = serde_json::to_value(value).unwrap_or_default();
    veil_redact_secrets(&mut v);
    v
}

pub fn veil_redact_secrets(v: &mut serde_json::Value) {
    // Scalar secret fields from role:secret annotations (INV-001).
    const SECRET_KEYS: &[&str] = &[];
    // Header maps/lists often carry API keys — redact values, keep names.
    const HEADER_CONTAINERS: &[&str] = &["headers"];
    match v {
        serde_json::Value::Object(map) => {
            for k in SECRET_KEYS {
                map.remove(*k);
            }
            for hk in HEADER_CONTAINERS {
                if let Some(headers) = map.get_mut(*hk) {
                    veil_redact_header_values(headers);
                }
            }
            for (_k, child) in map.iter_mut() {
                veil_redact_secrets(child);
            }
        }
        serde_json::Value::Array(items) => {
            for item in items.iter_mut() {
                veil_redact_secrets(item);
            }
        }
        _ => {}
    }
}

pub fn veil_redact_header_values(v: &mut serde_json::Value) {
    match v {
        serde_json::Value::Array(items) => {
            for item in items.iter_mut() {
                if let serde_json::Value::Object(h) = item {
                    if h.contains_key("value") {
                        h.insert("value".into(), serde_json::Value::String(String::new()));
                    }
                    if h.contains_key("Value") {
                        h.insert("Value".into(), serde_json::Value::String(String::new()));
                    }
                }
            }
        }
        serde_json::Value::Object(map) => {
            // Map-shaped headers: redact all values
            for (_k, val) in map.iter_mut() {
                *val = serde_json::Value::String(String::new());
            }
        }
        _ => {}
    }
}

pub fn veil_domain_error_status(e: DomainError) -> StatusCode {
    match &e {
        DomainError::NotFound => {
            eprintln!("warn: not found: {e}");
            StatusCode::NOT_FOUND
        }
        DomainError::Validation(msg) => {
            eprintln!("warn: validation: {msg}");
            StatusCode::BAD_REQUEST
        }
        DomainError::External(msg) => {
            eprintln!("error: upstream: {msg}");
            StatusCode::BAD_GATEWAY
        }
    }
}

/// Production-oriented auth:
/// - `/health` + OPTIONS always open
/// - `VEIL_DEV=1` → open (local dual-loop only)
/// - else require a key: `VEIL_API_KEY`
/// - Present key via `X-Api-Key` or `Authorization: Bearer <key>`
async fn veil_api_key_middleware(
    headers: HeaderMap,
    request: Request,
    next: Next,
) -> Result<Response, StatusCode> {
    if request.uri().path() == "/health" || request.method() == axum::http::Method::OPTIONS {
        return Ok(next.run(request).await);
    }
    let dev = std::env::var("VEIL_DEV").ok().as_deref() == Some("1");
    let require = std::env::var("VEIL_REQUIRE_AUTH").ok().as_deref() == Some("1");
    let admin_key = std::env::var("VEIL_API_KEY").ok().filter(|s| !s.is_empty());
    let presented = headers
        .get("x-api-key")
        .and_then(|v| v.to_str().ok())
        .map(|s| s.to_string())
        .or_else(|| {
            headers
                .get("authorization")
                .and_then(|v| v.to_str().ok())
                .and_then(|s| s.strip_prefix("Bearer ").map(|t| t.to_string()))
        });

    if dev && !require && admin_key.is_none() {
        return Ok(next.run(request).await);
    }

    let Some(presented) = presented else {
        eprintln!("error: missing X-Api-Key / Authorization Bearer");
        return Err(StatusCode::UNAUTHORIZED);
    };

    if admin_key.as_deref() != Some(presented.as_str()) {
        eprintln!("warn: unauthorized — key not recognized");
        return Err(StatusCode::UNAUTHORIZED);
    }

    Ok(next.run(request).await)
}

/// Restrict CORS: `CORS_ORIGINS=http://a,http://b` or localhost defaults (not *).
pub fn veil_cors_layer() -> CorsLayer {
    use axum::http::{HeaderValue, Method};
    if let Ok(raw) = std::env::var("CORS_ORIGINS") {
        let origins: Vec<HeaderValue> = raw
            .split(',')
            .filter_map(|s| s.trim().parse().ok())
            .collect();
        if !origins.is_empty() {
            return CorsLayer::new()
                .allow_origin(origins)
                .allow_methods([
                    Method::GET,
                    Method::POST,
                    Method::PUT,
                    Method::PATCH,
                    Method::DELETE,
                    Method::OPTIONS,
                ])
                .allow_headers(Any);
        }
    }
    let local = [
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "http://localhost:5174",
        "http://127.0.0.1:5174",
        "http://localhost:3000",
        "http://127.0.0.1:3000",
    ];
    let origins: Vec<HeaderValue> = local.iter().filter_map(|s| s.parse().ok()).collect();
    CorsLayer::new()
        .allow_origin(origins)
        .allow_methods([
            Method::GET,
            Method::POST,
            Method::PUT,
            Method::PATCH,
            Method::DELETE,
            Method::OPTIONS,
        ])
        .allow_headers(Any)
}

/// HTML `<input type="date">` and form empties → JSON values chrono/serde accept.
/// `""` → null; bare `YYYY-MM-DD` → `YYYY-MM-DDT00:00:00Z`.
pub fn veil_normalize_body_dt(v: Value) -> Value {
    match v {
        Value::String(s) if s.is_empty() => Value::Null,
        Value::String(s)
            if s.len() == 10
                && s.as_bytes().get(4) == Some(&b'-')
                && s.as_bytes().get(7) == Some(&b'-')
                && !s.contains('T') =>
        {
            Value::String(format!("{s}T00:00:00Z"))
        }
        other => other,
    }
}
