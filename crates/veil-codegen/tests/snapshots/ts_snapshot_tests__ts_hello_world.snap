export async function CreateUser(name: string, email: string, userRepo: UserRepo, bus: Bus): Promise<void> {
  // Step: validate
  if (!(email !== "")) {
  throw new Error("email required");
};
  // Step: persist
  const user = { id: name, name: email };
  await deps.userRepo.save(user);
  bus.dispatch({ id: user.id, email, now: now() });
}

export async function GreetUser(userId: string, timeOfDay: string, notifier: Notifier): Promise<void> {
  // Step: load
  const user = await deps.userRepo.find(userId);
  // Step: greet
  user.greet(timeOfDay);
  await deps.notifier.sendEmail(user.email, "Greeting sent!", timeOfDay);
}


