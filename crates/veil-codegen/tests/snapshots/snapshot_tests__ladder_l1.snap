// ===== crates/catalog/src/application/mod.rs =====
//! Application services and flow functions.

#![allow(unused_imports, unused_variables)]

use crate::ports::*;
use crate::domain::types::*;
use crate::domain::messages::*;
use std::sync::Arc;
use std::collections::HashMap;
use uuid::Uuid;
use chrono::{DateTime, Utc};

/// Declared dependency bundle (`deps CatalogDeps`).
pub struct CatalogDeps {
    pub item_repo: std::sync::Arc<dyn ItemRepo + Send + Sync>,
}

pub type Deps = CatalogDeps;

/// DomainService: ListItems
#[tracing::instrument(skip_all)]
pub async fn list_items(
    deps: &Deps, 
) -> Result<Vec<Item>, DomainError> {
    // step: query
    let items = deps.item_repo.list_all().await?;
    return Ok(items);

}

/// DomainService: GetItem
#[tracing::instrument(skip_all)]
pub async fn get_item(
    deps: &Deps, id: Uuid
) -> Result<Option<Item>, DomainError> {
    // step: load
    let item = deps.item_repo.find(id).await?;
    return Ok(item);

}

/// DomainService: CreateItem
#[tracing::instrument(skip_all)]
pub async fn create_item(
    deps: &Deps, name: String
) -> Result<Item, DomainError> {
    // step: validate
    if name.is_empty() {
    return Err(DomainError::Validation("name required".to_string()))
};

    // step: persist
    let item = Item::new(Uuid::new_v4(), name);
    deps.item_repo.save(item.clone()).await?;
    return Ok(item);

}


